---
/**
 * Measurement core.
 *
 * One shared layer that every lead path calls, instead of each component
 * re-implementing attribution and firing its own ad-hoc dataLayer shape.
 *
 * It does four things:
 *
 *  1. Derives a machine-readable page context (page_type / service /
 *     service_location / region) at BUILD time, so no suburb or service
 *     table is shipped to the browser and the values can't drift from the
 *     routes that generated them.
 *  2. Persists marketing attribution — first-touch AND last-touch — in
 *     localStorage so a visitor who arrives from Google Ads in March and
 *     converts in May is still credited to that campaign.
 *  3. Exposes `window.naturoAnalytics.track()`, which scrubs PII before
 *     anything reaches the dataLayer.
 *  4. Mints privacy-safe lead ids so the same lead can be joined across
 *     GA4, Google Ads and the CRM without ever sending a name or email.
 *
 * Loaded from Layout.astro on every page, ahead of QuoteLeadGate.
 * See docs/analytics/MEASUREMENT_PLAN.md for the full taxonomy.
 */
import { suburbs } from '../data/suburbs';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const seg = path.split('/').filter(Boolean);

// --- Service taxonomy ------------------------------------------------------
// Route slug -> stable analytics key. Keys are deliberately snake_case and
// decoupled from URLs so a slug can be renamed for SEO without breaking
// historical reporting.
const SERVICE_BY_SLUG: Record<string, string> = {
  'house-cleaning': 'residential_cleaning',
  'deep-clean': 'deep_cleaning',
  'end-of-lease': 'end_of_lease_cleaning',
  'ndis-cleaning': 'ndis_cleaning',
  'aged-care-cleaning': 'aged_care_cleaning',
  'insurance-cleaning': 'insurance_cleaning',
  'veterans-cleaning': 'veterans_cleaning',
  'specialist-cleaning': 'specialist_cleaning',
};

// One-off landing pages that sit outside the /services/<service>/<suburb>
// matrix but still represent a service + location combination.
const STANDALONE: Record<string, { service: string; location: string }> = {
  'end-of-lease-cleaning-geelong': { service: 'end_of_lease_cleaning', location: 'geelong' },
  'end-of-lease-cleaning-port-macquarie': { service: 'end_of_lease_cleaning', location: 'port_macquarie' },
  'ndis-cleaning-geelong': { service: 'ndis_cleaning', location: 'geelong' },
  'ndis-cleaning-port-macquarie': { service: 'ndis_cleaning', location: 'port_macquarie' },
};

const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');

// Suburb slugs are prefixed for SEO ("cleaners-port-macquarie"); the analytics
// key is the bare place name so it stays readable in reports.
const suburbIndex = new Map(
  suburbs.map((s: any) => [
    s.slug,
    { location: norm(String(s.name)), region: norm(String(s.region || '')), state: String(s.stateCode || '') },
  ]),
);

let pageType = 'other';
let service = '';
let location = '';
let region = '';
let state = '';

const applySuburb = (slug: string) => {
  const hit = suburbIndex.get(slug);
  if (!hit) return false;
  location = hit.location;
  region = hit.region;
  state = hit.state;
  return true;
};

if (path === '/') {
  pageType = 'home';
} else if (seg[0] === 'services' && seg.length === 1) {
  pageType = 'service_index';
} else if (seg[0] === 'services' && seg.length === 2) {
  pageType = 'service';
  service = SERVICE_BY_SLUG[seg[1]] || norm(seg[1]);
} else if (seg[0] === 'services' && seg.length === 3) {
  pageType = 'service_location';
  service = SERVICE_BY_SLUG[seg[1]] || norm(seg[1]);
  applySuburb(seg[2]);
} else if (seg[0] === 'quote') {
  pageType = 'quote';
} else if (seg[0] === 'thank-you') {
  pageType = 'thank_you';
} else if (STANDALONE[seg[0]] && seg.length === 1) {
  pageType = 'service_location';
  service = STANDALONE[seg[0]].service;
  location = STANDALONE[seg[0]].location;
} else if (seg[0] === 'end-of-lease-cleaning' && seg.length === 3) {
  // /end-of-lease-cleaning/geelong/<suburb>
  pageType = 'service_location';
  service = 'end_of_lease_cleaning';
  if (!applySuburb(seg[2])) location = norm(seg[2]);
} else if (seg.length === 1 && suburbIndex.has(seg[0])) {
  pageType = 'location';
  applySuburb(seg[0]);
} else if (['resource', 'career', 'contact-us', 'reviews'].includes(seg[0])) {
  pageType = seg[0].replace(/-/g, '_');
} else if (seg[0] === 'blog' || seg[0] === 'resource') {
  pageType = 'article';
}

const pageContext = {
  page_type: pageType,
  service,
  service_location: location,
  region,
  state,
};

// Lead delivery config, read by the shared deliverer below. Kept here rather
// than in each form so all four paths agree on where a lead goes and on what
// the visitor is told when it does not get there.
import { leadCapture, site } from '../data/site';
const leadDelivery = {
  crmUrl: leadCapture.crmUrl,
  webhookUrls: leadCapture.webhookUrls,
  phone: site.phone,
  phoneHref: site.phoneHref,
  email: site.email,
  // Empty until a key is set, and everything below is a no-op while it is —
  // no script loaded, no token asked for, no change to any form.
  turnstileSiteKey: leadCapture.turnstileSiteKey,
};
---

<script type="application/json" id="naturo-page-context" set:html={JSON.stringify(pageContext)}></script>
<script type="application/json" id="naturo-lead-delivery" set:html={JSON.stringify(leadDelivery)}></script>

<script is:inline>
  (function () {
    if (window.naturoAnalytics) return;

    var ATTR_KEY = 'naturo:attribution';
    var LEAD_KEY = 'naturo:lead-id';
    var ATTR_TTL_DAYS = 365;

    // Never let these reach the dataLayer, GA4 or any ad platform. GA4's terms
    // prohibit PII, and GTM tags read the dataLayer indiscriminately.
    var PII_KEYS = [
      'name', 'full_name', 'fullname', 'first_name', 'last_name', 'email',
      'phone', 'mobile', 'tel', 'address', 'street', 'postal_address',
      'notes', 'message', 'comments',
    ];

    function isPii(key) {
      var k = String(key).toLowerCase();
      for (var i = 0; i < PII_KEYS.length; i++) if (k === PII_KEYS[i]) return true;
      return false;
    }

    /** Deep-copy an object with any PII-named field removed. */
    function scrub(value, depth) {
      depth = depth || 0;
      if (depth > 6 || value === null || typeof value !== 'object') return value;
      if (Array.isArray(value)) return value.map(function (v) { return scrub(v, depth + 1); });
      var out = {};
      Object.keys(value).forEach(function (k) {
        if (isPii(k)) return;
        out[k] = scrub(value[k], depth + 1);
      });
      return out;
    }

    function pageContext() {
      try {
        var el = document.getElementById('naturo-page-context');
        return el ? JSON.parse(el.textContent || '{}') : {};
      } catch (e) { return {}; }
    }

    function readParams() {
      var p = new URLSearchParams(window.location.search);
      return {
        utm_source: p.get('utm_source') || '',
        utm_medium: p.get('utm_medium') || '',
        utm_campaign: p.get('utm_campaign') || '',
        utm_term: p.get('utm_term') || '',
        utm_content: p.get('utm_content') || '',
        gclid: p.get('gclid') || '',
        gbraid: p.get('gbraid') || '',
        wbraid: p.get('wbraid') || '',
        fbclid: p.get('fbclid') || '',
        msclkid: p.get('msclkid') || '',
      };
    }

    /** True when this hit carries real campaign information worth recording. */
    function hasCampaign(p) {
      return !!(p.utm_source || p.utm_medium || p.utm_campaign || p.gclid ||
                p.gbraid || p.wbraid || p.fbclid || p.msclkid);
    }

    /** Classify a referrer when no UTMs are present, so organic/referral
     *  traffic still gets a usable source rather than being lost to "direct". */
    function fromReferrer(ref) {
      if (!ref) return { utm_source: '', utm_medium: '' };
      var host = '';
      try { host = new URL(ref).hostname.replace(/^www\./, ''); } catch (e) { return { utm_source: '', utm_medium: '' }; }
      if (host === window.location.hostname) return { utm_source: '', utm_medium: '' };
      if (/(^|\.)google\./.test(host)) return { utm_source: 'google', utm_medium: 'organic' };
      if (/(^|\.)bing\./.test(host)) return { utm_source: 'bing', utm_medium: 'organic' };
      if (/duckduckgo|ecosia|yahoo/.test(host)) return { utm_source: host, utm_medium: 'organic' };
      if (/facebook|instagram|linkedin|tiktok|pinterest|reddit/.test(host)) return { utm_source: host, utm_medium: 'social' };
      return { utm_source: host, utm_medium: 'referral' };
    }

    function load() {
      try {
        var raw = localStorage.getItem(ATTR_KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        var age = Date.now() - (parsed.first_touch_at ? Date.parse(parsed.first_touch_at) : 0);
        if (age > ATTR_TTL_DAYS * 864e5) return null;
        return parsed;
      } catch (e) { return null; }
    }

    /**
     * First-touch is written once and never overwritten — a visitor who found
     * us through an Ads campaign keeps that credit even if they later return
     * via a bookmark. Last-touch updates whenever a new campaign appears.
     */
    function resolveAttribution() {
      var params = readParams();
      var ref = fromReferrer(document.referrer);
      var now = new Date().toISOString();
      var landing = window.location.origin + window.location.pathname; // no query string: avoids leaking PII in params

      var touch = {
        utm_source: params.utm_source || ref.utm_source,
        utm_medium: params.utm_medium || ref.utm_medium,
        utm_campaign: params.utm_campaign,
        utm_term: params.utm_term,
        utm_content: params.utm_content,
        gclid: params.gclid,
        gbraid: params.gbraid,
        wbraid: params.wbraid,
        fbclid: params.fbclid,
        msclkid: params.msclkid,
        landing_page: landing,
        referrer_host: (function () {
          try { return document.referrer ? new URL(document.referrer).hostname : ''; } catch (e) { return ''; }
        })(),
        touched_at: now,
      };

      var stored = load();
      if (!stored) {
        stored = { first: touch, last: touch, first_touch_at: now, session_started_at: now };
      } else if (hasCampaign(params) || (touch.utm_medium && touch.utm_medium !== 'referral' && !stored.last.utm_source)) {
        // Only displace last-touch on a genuine new campaign entry, so internal
        // navigation never rewrites attribution.
        stored.last = touch;
      }
      try { localStorage.setItem(ATTR_KEY, JSON.stringify(stored)); } catch (e) {}
      return stored;
    }

    var attribution = resolveAttribution();

    /** Flat, CRM-friendly attribution payload. Contains no PII. */
    function attributionFields() {
      var f = attribution.first || {};
      var l = attribution.last || {};
      return {
        first_source: f.utm_source || '', first_medium: f.utm_medium || '',
        first_campaign: f.utm_campaign || '', first_landing_page: f.landing_page || '',
        first_touch_at: attribution.first_touch_at || '',
        last_source: l.utm_source || '', last_medium: l.utm_medium || '',
        last_campaign: l.utm_campaign || '', last_term: l.utm_term || '',
        last_content: l.utm_content || '', last_landing_page: l.landing_page || '',
        referrer_host: l.referrer_host || '',
        gclid: l.gclid || f.gclid || '', gbraid: l.gbraid || f.gbraid || '',
        wbraid: l.wbraid || f.wbraid || '', fbclid: l.fbclid || f.fbclid || '',
        msclkid: l.msclkid || f.msclkid || '',
      };
    }

    function uuid() {
      if (window.crypto && window.crypto.randomUUID) return window.crypto.randomUUID();
      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
        var r = (Math.random() * 16) | 0;
        return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
      });
    }

    /** A stable, privacy-safe id for one lead, reused across GA4/Ads/CRM. */
    function leadId(fresh) {
      if (fresh) {
        var id = 'lead_' + uuid();
        try { sessionStorage.setItem(LEAD_KEY, id); } catch (e) {}
        return id;
      }
      try {
        var existing = sessionStorage.getItem(LEAD_KEY);
        if (existing) return existing;
      } catch (e) {}
      return leadId(true);
    }

    function consentGranted() {
      if (window.naturoConsent && window.naturoConsent.granted) return true;
      try {
        var raw = localStorage.getItem('naturo:consent');
        return raw ? !!JSON.parse(raw).granted : false;
      } catch (e) { return false; }
    }

    /**
     * Single entry point for every analytics event.
     * Always merges page context, always scrubs PII, and mirrors to gtag so
     * events land in GA4 whether or not the GTM container has a matching tag.
     */
    function track(eventName, params) {
      var payload = Object.assign({}, pageContext(), scrub(params || {}));
      payload.event = eventName;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(payload);
      if (typeof window.gtag === 'function') {
        var gaParams = Object.assign({}, payload);
        delete gaParams.event;
        try { window.gtag('event', eventName, gaParams); } catch (e) {}
      }
    }

    window.naturoAnalytics = {
      track: track,
      scrub: scrub,
      pageContext: pageContext,
      attribution: function () { return attribution; },
      attributionFields: attributionFields,
      leadId: leadId,
      newLeadId: function () { return leadId(true); },
      consentGranted: consentGranted,
    };

    // ---- Click tracking ----------------------------------------------------
    // Every button and link click, through one delegated listener.
    //
    // Before this, nothing on the site recorded a click. We could see that a
    // quote FORM was submitted, but not that 40 people pressed "Get a Free
    // Quote" and 39 of them left — which is the difference between "not enough
    // traffic" and "traffic that isn't converting", and they need opposite
    // fixes.
    //
    // Delegated from the document so it covers markup added later (the quote
    // gate, the exit-intent modal) without those components knowing about it.
    // Goes through track(), so page context and PII scrubbing come for free.
    var CTA_LABEL_MAX = 80;

    /** What the visitor actually saw on the control, as a stable-ish label. */
    function ctaLabel(el) {
      var explicit = el.getAttribute('data-track');
      if (explicit) return explicit.slice(0, CTA_LABEL_MAX);
      var aria = el.getAttribute('aria-label');
      if (aria) return aria.trim().slice(0, CTA_LABEL_MAX);
      var text = (el.textContent || '').replace(/\s+/g, ' ').trim();
      if (text) return text.slice(0, CTA_LABEL_MAX);
      return el.getAttribute('title') || el.getAttribute('name') || '(unlabelled)';
    }

    /** Nearest enclosing section, so a label like "Book now" is locatable. */
    function ctaSection(el) {
      var sec = el.closest('section, header, footer, nav, dialog, form');
      if (!sec) return '';
      return (sec.getAttribute('data-section') || sec.getAttribute('id') || sec.tagName || '')
        .toString().toLowerCase().slice(0, 40);
    }

    document.addEventListener('click', function (ev) {
      var el;
      try {
        el = ev.target && ev.target.closest
          ? ev.target.closest('a, button, [role="button"], [data-quote-cta]')
          : null;
      } catch (e) { return; }
      if (!el) return;

      var href = el.getAttribute('href') || '';
      var params = {
        cta_label: ctaLabel(el),
        cta_section: ctaSection(el),
        cta_tag: el.tagName.toLowerCase(),
        cta_href: href.slice(0, 200),
        page_path: window.location.pathname,
      };

      // A quote CTA is the one that matters commercially, so it gets its own
      // event name rather than being buried among every other click. All 34
      // of them across the site already carry data-quote-cta.
      if (el.hasAttribute('data-quote-cta') || el.classList.contains('js-quote-cta')) {
        track('quote_cta_click', params);
        return;
      }
      // Phone taps. Worth their own name: the Google Ads call asset shows
      // taps but almost no connected calls, and this is the on-site half of
      // that picture.
      if (href.indexOf('tel:') === 0) { track('phone_click', params); return; }
      if (href.indexOf('mailto:') === 0) { track('email_click', params); return; }

      track('cta_click', params);
    }, true); // capture, so it still fires when a handler stops propagation

    // ---- Lead delivery -----------------------------------------------------
    // Every form ships its lead through here rather than firing its own
    // fetch and ignoring the answer.
    //
    // Two things this fixes. First, `fetch` only rejects on a network
    // failure, so the old code read an HTTP 403 or 500 as success — a lead
    // the CRM refused looked identical to one it filed. Second, there was
    // nowhere to notice that: the visitor was thanked either way. At ~350
    // enquiries a month a quiet afternoon of failures is a dozen customers
    // who think they contacted us and did not.
    //
    // So: both destinations are posted independently, both are checked, and
    // the caller is told whether the lead landed ANYWHERE. It only reports
    // failure when every destination failed.
    var lead = {};
    try {
      var lel = document.getElementById('naturo-lead-delivery');
      if (lel) lead = JSON.parse(lel.textContent || '{}');
    } catch (e) {}

    // Long enough to cover a cold start on the CRM host, short enough that a
    // visitor is not left staring at a spinner.
    var DELIVER_TIMEOUT_MS = 12000;

    function postLead(url, body, contentType) {
      if (!url) return Promise.resolve(null); // destination not configured
      var ctl = typeof AbortController === 'function' ? new AbortController() : null;
      var timer = ctl ? setTimeout(function () { ctl.abort(); }, DELIVER_TIMEOUT_MS) : null;
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': contentType },
        body: body,
        keepalive: true,
        signal: ctl ? ctl.signal : undefined,
      })
        .then(function (res) { return !!res && res.ok; })
        .catch(function () { return false; })
        .then(function (ok) { if (timer) clearTimeout(timer); return ok; });
    }

    /**
     * Content type for a backup destination.
     *
     * text/plain is CORS-safelisted, so the browser sends no preflight. Google
     * Apps Script web apps do not answer preflight requests, which is the only
     * reason they are usable as a free backup at all; doPost parses the body as
     * JSON either way. Everything else takes ordinary JSON.
     */
    function contentTypeFor(url) {
      return String(url).indexOf('script.google.com') !== -1
        ? 'text/plain;charset=utf-8'
        : 'application/json';
    }

    /**
     * Whatever a bot typed into the spam trap, or '' if nothing did.
     *
     * Read here, in the one place every form's delivery passes through, rather
     * than in four separate payload builders — a trap that a new form forgets
     * to wire up is worse than no trap, because it looks like it is working.
     * The value is only carried; the receivers decide what it means.
     */
    function honeypotValue() {
      var fields = document.querySelectorAll('input[name="_gotcha"]');
      for (var i = 0; i < fields.length; i++) {
        var v = String(fields[i].value || '').trim();
        if (v) return v;
      }
      return '';
    }

    /* ---- Cloudflare Turnstile -------------------------------------------
     *
     * A proof that a browser, not a script, made this submission. The honeypot
     * catches bots that fill hidden fields and the CRM's content gate catches
     * the ones whose text gives them away; this catches the ones that do
     * neither — the case that actually got through on 31 August 2026.
     *
     * Three things about how it is wired here:
     *
     *   1. LOADED LAZILY, AND ONLY IF CONFIGURED. With no site key the script
     *      is never fetched and nothing on the page changes. When there is one,
     *      the ~40KB script is still not fetched on page load — it waits until
     *      someone actually opens a form, so a visitor who reads a suburb page
     *      and leaves pays nothing for it.
     *
     *   2. INVISIBLE. `size: invisible` means no checkbox, no "select the
     *      traffic lights", nothing added to any form's layout. In the ordinary
     *      case the visitor never knows it ran.
     *
     *   3. IT CANNOT BLOCK A SUBMISSION. Every failure path — script blocked by
     *      an ad blocker, Cloudflare down, the challenge timing out — resolves
     *      to an empty token and the lead is posted anyway. The server decides
     *      what an empty token means, and it is written to let it through
     *      whenever the fault could be ours. A captcha that can silently eat a
     *      customer is worse than the spam it stops.
     */
    var TURNSTILE_TIMEOUT_MS = 6000;
    var turnstileScript = null;   // the load promise, once started
    var turnstileWidget = null;   // the rendered widget id, once rendered

    /* Who is waiting for the next token.
     *
     * The widget's callbacks are registered ONCE, when it is rendered, so they
     * close over that first submission's resolver and nothing else. Routing
     * them through this variable is what lets the second and third enquiry of a
     * session get a token too — without it the widget answers a resolver that
     * settled minutes ago and the later caller waits out the timeout. Cleared
     * as it is read, so a late duplicate callback resolves nobody. */
    var turnstilePending = null;
    function turnstileSettle(token) {
      var r = turnstilePending;
      turnstilePending = null;
      if (r) r(token || '');
    }

    function turnstileReady() {
      var key = lead.turnstileSiteKey;
      if (!key) return Promise.resolve(null);
      if (turnstileScript) return turnstileScript;

      turnstileScript = new Promise(function (resolve) {
        var s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        s.async = true;
        s.defer = true;
        s.onload = function () { resolve(window.turnstile || null); };
        // A blocked or failed script is not an error worth surfacing — it just
        // means no token, which the server already knows how to handle.
        s.onerror = function () { resolve(null); };
        document.head.appendChild(s);
      });
      return turnstileScript;
    }

    /* One token at a time.
     *
     * A token is single-use: Cloudflare accepts it for exactly one siteverify
     * call and answers "timeout-or-duplicate" to any second. The quote lead
     * gate posts TWO endpoints for one submission, so it needs two tokens, and
     * there is one shared widget to mint them from. Requests are therefore
     * queued rather than run at once — two concurrent executes on one widget
     * would have the later one overwrite the earlier's challenge and the first
     * caller would wait out its timeout for a token that never comes. */
    var turnstileQueue = Promise.resolve('');

    /**
     * A fresh token, or '' if one could not be obtained.
     *
     * Never rejects. Minted per submission rather than held from page load:
     * tokens expire after five minutes, so someone filling in the quote gate
     * slowly would otherwise reach the button with one Cloudflare had retired.
     */
    function turnstileToken() {
      turnstileQueue = turnstileQueue.then(mintToken, mintToken);
      return turnstileQueue;
    }

    function mintToken() {
      return turnstileReady()
        .then(function (ts) {
          if (!ts) return '';
          return new Promise(function (resolve) {
            var settled = false;
            var done = function (v) { if (!settled) { settled = true; resolve(v || ''); } };

            // The queue above guarantees this, but the widget's callbacks are
            // global and a late one from a previous challenge could otherwise
            // land on this resolver.
            turnstilePending = done;

            // The visitor is waiting on this, so it is bounded. Better to send
            // the lead with no token than to hold someone on a spinner.
            setTimeout(function () {
              if (turnstilePending === done) turnstilePending = null;
              done('');
            }, TURNSTILE_TIMEOUT_MS);

            try {
              if (turnstileWidget === null) {
                var host = document.createElement('div');
                host.className = 'nl-hp'; // off-screen; the widget is invisible anyway
                host.setAttribute('aria-hidden', 'true');
                document.body.appendChild(host);
                // An invisible widget runs its challenge as it renders, so this
                // first call is answered by `callback` without an execute().
                turnstileWidget = ts.render(host, {
                  sitekey: lead.turnstileSiteKey,
                  size: 'invisible',
                  callback: turnstileSettle,
                  'error-callback': function () { turnstileSettle(''); },
                  'timeout-callback': function () { turnstileSettle(''); },
                  'expired-callback': function () { turnstileSettle(''); },
                });
              } else {
                // Reset before re-executing: a widget still holding the token
                // it minted for the previous submission hands back that same
                // one, and a token spent once is refused the second time.
                ts.reset(turnstileWidget);
                ts.execute(turnstileWidget);
              }
            } catch (e) {
              if (turnstilePending === done) turnstilePending = null;
              done('');
            }
          });
        })
        .catch(function () { return ''; });
    }

    /**
     * Deliver one lead to every configured destination.
     *
     * Resolves { crm, backups, delivered } — never rejects, so a caller can
     * always render an outcome. `delivered` is false only when NOTHING accepted
     * the lead; that is the case worth interrupting someone for. One
     * destination being down is not the visitor's problem, which is the whole
     * reason for having more than one.
     */
    function deliverLead(payload) {
      // The token is fetched here, not in each form, for the same reason the
      // spam trap is: a form that forgets to attach one looks like it is
      // protected and is not.
      return turnstileToken().then(function (token) {
        return deliverLeadWith(payload, token);
      });
    }

    function deliverLeadWith(payload, token) {
      var trap = honeypotValue();
      var extra = {};
      if (trap) extra._gotcha = trap;
      if (token) extra['cf-turnstile-response'] = token;
      var json = JSON.stringify(
        Object.keys(extra).length ? Object.assign({}, payload, extra) : payload,
      );
      var backups = (lead.webhookUrls || []).filter(Boolean);
      return Promise.all(
        [postLead(lead.crmUrl, json, 'application/json')].concat(
          backups.map(function (url) {
            return postLead(url, json, contentTypeFor(url));
          }),
        ),
      ).then(function (r) {
        var configured = (lead.crmUrl ? 1 : 0) + backups.length;
        return {
          crm: r[0] === true,
          backups: r.slice(1),
          // Nothing configured means nothing to fail — treat as delivered so
          // a misconfiguration can never scare a visitor off the site.
          delivered:
            configured === 0 ||
            r.some(function (ok) {
              return ok === true;
            }),
        };
      });
    }

    /** What to tell someone whose enquiry did not get through. */
    function failureMessage() {
      var phone = lead.phone || '';
      return phone
        ? 'We could not confirm your enquiry reached us. Please call ' + phone + ' so we do not miss you.'
        : 'We could not confirm your enquiry reached us. Please call us so we do not miss you.';
    }

    window.naturoLeads = {
      deliver: deliverLead,
      /* For the quote lead gate, which posts the AI Reception funnel directly
       * as well as delivering here. That endpoint verifies separately, so it
       * needs a token of its own — a token is single-use and reusing one would
       * have Cloudflare refuse the second of the two. Calls queue internally,
       * so asking twice in a row is safe. */
      token: turnstileToken,
      failureMessage: failureMessage,
      phone: lead.phone || '',
      phoneHref: lead.phoneHref || '',
      email: lead.email || '',
    };

    // Baseline page context for GA4/GTM — no PII, no campaign params.
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(Object.assign({ event: 'page_context_ready' }, pageContext()));
  })();
</script>
