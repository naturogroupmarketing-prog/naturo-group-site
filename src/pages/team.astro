---
import Layout from '../layouts/Layout.astro';
import CTABanner from '../components/CTABanner.astro';
import TrustBadges from '../components/TrustBadges.astro';
import { ctaPrimary, ctaPhone, founder, site } from '../data/site';

const values = [
  {
    title: 'Trusted',
    body:
      'Every cleaner is identity-checked, police-checked and trained before they enter a home. We never sub-contract.',
  },
  {
    title: 'Trained',
    body:
      "Our induction draws on Anna’s nursing background — infection control, dignity, attention to detail.",
  },
  {
    title: 'Thorough',
    body:
      'No shortcuts. No rushed visits. Every job is checked against the inclusions list before we leave.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${site.url}/team#webpage`,
    url: `${site.url}/team`,
    name: 'Meet Our Team — Police-Checked Cleaners | Naturo Group',
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'Meet the Team', item: `${site.url}/team` },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${site.url}/team#anna-biram`,
    name: founder.name,
    jobTitle: founder.role,
    worksFor: {
      '@type': 'Organization',
      name: site.name,
      url: site.url,
    },
    description: 'Registered nurse and founder of Naturo Group, bringing clinical-level care and attention to detail to eco-friendly residential cleaning across Australia.',
    image: `${site.url}${founder.image}`,
  },
];
---

<Layout
  title="Meet Our Team — Police-Checked Cleaners"
  description="Naturo Group is a tight-knit team of trained, police-checked Australian cleaners led by founder Anna Biram. Meet the people who care for your home."
  schema={schema}
>
  <section class="ph-hero">
    <div class="ph-bg" style="background-image: url(/images/team-staff.jpg);" aria-hidden="true"></div>
    <div class="ph-overlay" aria-hidden="true"></div>
    <div class="container-site ph-inner">
      <div class="ph-content">
        <p class="ph-eyebrow">Meet the team</p>
        <h1 class="ph-h1">Real people who care<br />for your home.</h1>
        <p class="ph-tagline">Trained, police-checked and led by a registered nurse.</p>
        <div class="ph-ctas">
          <a href={ctaPrimary.href} class="ph-btn-primary">{ctaPrimary.text}</a>
          <a href={ctaPhone.href} class="ph-btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{ctaPhone.text}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site grid lg:grid-cols-2 gap-12 items-start">
      <div class="aspect-[4/5] rounded-3xl bg-gradient-to-br from-[var(--color-bg-light)] to-[var(--color-bg-cream)] flex items-center justify-center">
        <div class="text-center">
          <div class="w-32 h-32 rounded-full bg-[var(--color-navy)] text-white text-4xl font-light flex items-center justify-center mx-auto">AB</div>
          <p class="mt-6 text-xl font-semibold text-[var(--color-navy)]">{founder.name}</p>
          <p class="text-[var(--color-slate)]">{founder.role}</p>
        </div>
      </div>
      <div class="space-y-5 text-[var(--color-slate)] leading-relaxed text-lg">
        <p class="eyebrow !text-[var(--color-accent-blue)]">Founder</p>
        <h2 class="text-3xl text-[var(--color-navy)] font-light leading-tight">
          A nurse with a passion for genuinely clean homes.
        </h2>
        {founder.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-bg-pale)]">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="eyebrow mb-3">Our values</p>
        <h2 class="text-3xl md:text-4xl text-[var(--color-navy)] font-light">
          Trusted. Trained. Thorough.
        </h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {values.map((v) => (
          <div class="bg-white rounded-2xl p-6 border border-[var(--color-border)]">
            <h3 class="text-xl font-semibold text-[var(--color-navy)] mb-2">{v.title}</h3>
            <p class="text-[var(--color-slate)]">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site max-w-3xl text-center">
      <p class="eyebrow mb-3">Join us</p>
      <h2 class="text-3xl text-[var(--color-navy)] font-light mb-4">
        We&rsquo;re always looking for great cleaners.
      </h2>
      <p class="text-[var(--color-slate)] mb-7">
        If you take pride in your work and love seeing the before-and-after, we&rsquo;d love to meet you.
        We pay above award rates, schedule you near home, and back you with the support of a real team.
      </p>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3">
        <a class="btn-primary" href="/career">Become a cleaner</a>
        <a class="btn-secondary" href={ctaPrimary.href}>{ctaPrimary.text}</a>
      </div>
    </div>
  </section>

  <TrustBadges />
  <CTABanner />
</Layout>

<style>
  /* ===== Page Hero — matches homepage Hero.astro exactly ===== */
  .ph-hero { position: relative; overflow: hidden; padding-block: 0; }
  .ph-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center; background-repeat: no-repeat;
  }
  .ph-overlay {
    position: absolute; inset: 0;
    background-image: linear-gradient(90deg, rgb(58, 77, 97) 20%, rgba(5, 170, 232, 0) 81%);
    opacity: 0.91; pointer-events: none;
  }
  .ph-inner {
    position: relative; z-index: 1;
    height: clamp(640px, 86vh, 800px);
    padding-block: clamp(48px, 8vh, 96px);
    display: flex; align-items: center;
  }
  @media (max-width: 640px) {
    .ph-inner { height: min(680px, 88dvh); padding-block: 36px; }
  }
  .ph-content { width: 100%; max-width: 800px; }
  .ph-eyebrow {
    font-family: "Poppins", sans-serif; font-size: 12px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: #FEB91C; margin: 0 0 14px;
  }
  .ph-h1 {
    font-family: "Poppins", sans-serif; font-weight: 300;
    font-size: clamp(30px, 5.2vw, 66px); line-height: 1.08;
    letter-spacing: -0.015em; color: #ffffff; margin: 0;
  }
  .ph-tagline {
    font-family: "Poppins", sans-serif; font-weight: 400;
    font-size: clamp(15px, 1.6vw, 22px); line-height: 1.5;
    color: #FEB91C; margin-top: 16px; letter-spacing: 0.005em;
  }
  .ph-ctas {
    margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
  }
  @media (max-width: 500px) { .ph-ctas { flex-direction: column; align-items: stretch; } }
  .ph-btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    background-color: #3a5dff; color: #ffffff; border: 1px solid #3a5dff;
    border-radius: 6px; padding: 14px 26px; font-size: 14px; font-weight: 500;
    font-family: "Poppins", sans-serif; line-height: 1; letter-spacing: 0.01em;
    min-height: 46px; box-shadow: 0 4px 12px rgba(58, 93, 255, 0.28);
    text-decoration: none; transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .ph-btn-primary:hover {
    background-color: #2548f0; border-color: #2548f0;
    box-shadow: 0 6px 18px rgba(58, 93, 255, 0.4); transform: translateY(-1px);
  }
  .ph-btn-secondary {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    background-color: rgba(255, 255, 255, 0.06); color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.75); backdrop-filter: blur(2px);
    border-radius: 6px; padding: 13px 24px; font-size: 15px; font-weight: 500;
    font-family: "Poppins", sans-serif; line-height: 1; min-height: 46px;
    text-decoration: none; transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .ph-btn-secondary svg { flex-shrink: 0; }
  .ph-btn-secondary:hover { background-color: #ffffff; color: #1C244B; border-color: #ffffff; }
</style>
