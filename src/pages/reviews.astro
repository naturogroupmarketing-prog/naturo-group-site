---
import Layout from '../layouts/Layout.astro';
import CTABanner from '../components/CTABanner.astro';
import TrustBadges from '../components/TrustBadges.astro';
import { ctaPrimary, testimonials, site } from '../data/site';
const stars = '★★★★★';

// Lightweight aggregate-rating schema for SEO. The count and rating
// should be reconciled against your real Google Business Profile before
// going live. Replace the placeholder values below with verified figures.
const reviewCount = 127;
const ratingValue = 4.7;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    telephone: site.phone,
    email: site.email,
    image: { '@type': 'ImageObject', url: `${site.url}/og-default.jpg`, creator: { '@type': 'Organization', name: site.name }, creditText: site.name, copyrightNotice: `© ${new Date().getFullYear()} ${site.name}`, license: `${site.url}/terms-of-service`, acquireLicensePage: `${site.url}/privacy-policies` },
    sameAs: [
      site.social.facebook,
      site.social.instagram,
      site.social.youtube,
    ],
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: ratingValue,
      reviewCount: reviewCount,
      bestRating: 5,
      worstRating: 1,
    },
  },
  ...testimonials.map((t) => ({
    '@context': 'https://schema.org',
    '@type': 'Review',
    itemReviewed: {
      '@type': 'LocalBusiness',
      name: 'Naturo Group',
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: 5,
      bestRating: 5,
      worstRating: 1,
    },
    author: { '@type': 'Person', name: t.name },
    reviewBody: t.text,
  })),
];

const stats = [
  { num: `${ratingValue}\u2605`, label: 'Average Google rating' },
  { num: `${reviewCount}+`, label: 'Verified customer reviews' },
  { num: '800+', label: 'Australian families served' },
  { num: '100%', label: 'Satisfaction guarantee' },
];
---

<Layout
  title="Client Reviews — Eco-Friendly House Cleaning Australia"
  description="Real reviews from Naturo Group customers across NSW, Queensland and Victoria. Eco-friendly cleaning rated 4.7★ by hundreds of Australian families."
  schema={schema}
>
  <section class="bg-[var(--color-bg-pale)] pt-16">
    <div class="container-site max-w-3xl text-center">
      <p class="eyebrow mb-3">Reviews</p>
      <h1 class="text-4xl md:text-5xl text-[var(--color-navy)] font-light leading-tight">
        Hundreds of Australian homes. One consistent standard.
      </h1>
      <p class="mt-5 text-lg text-[var(--color-slate)]">
        We are humbled by what our customers say. Here is a sample of recent reviews.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      {stats.map((s) => (
        <div>
          <p class="text-4xl md:text-5xl font-light text-[var(--color-cyan)]">{s.num}</p>
          <p class="mt-2 text-[var(--color-slate)] text-sm">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-[var(--color-bg-pale)]">
    <div class="container-site">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <article class="bg-white rounded-2xl p-6 border border-[var(--color-border)] flex flex-col">
            <div class="text-[var(--color-yellow)] mb-3" aria-label="5 out of 5 stars">
              {stars}
            </div>
            <p class="text-[var(--color-slate)] leading-relaxed flex-1">{t.text}</p>
            <p class="mt-5 font-semibold text-[var(--color-navy)]">{t.name}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Google Review CTA -->
  <section class="review-cta-section">
    <div class="container-site review-cta-inner">
      <div class="review-cta-icon" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      </div>
      <h2 class="review-cta-h2">Had a clean with us? Share your experience.</h2>
      <p class="review-cta-body">
        Google reviews help local families find a cleaner they can trust. It takes under a minute
        and makes a real difference to our small team.
      </p>
      <a class="review-cta-btn" href={site.googleReviewUrl} target="_blank" rel="noopener noreferrer">
        Leave us a Google review &#8599;
      </a>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site max-w-2xl text-center">
      <h2 class="text-3xl text-[var(--color-navy)] font-light mb-4">
        Ready to experience the difference?
      </h2>
      <p class="text-[var(--color-slate)] mb-7">
        Get a transparent online price in 60 seconds and see what hundreds of Australian families
        have been talking about.
      </p>
      <a class="btn-primary" href={ctaPrimary.href}>{ctaPrimary.text}</a>
    </div>
  </section>

  <TrustBadges />
  <CTABanner />
</Layout>

<style>
  .review-cta-section {
    background: #eef3ff;
    padding: clamp(48px, 6vw, 80px) 0;
    border-top: 1px solid #d4e0ff;
    border-bottom: 1px solid #d4e0ff;
  }
  .review-cta-inner {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }
  .review-cta-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(70, 127, 247, 0.15);
    color: #467FF7;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }
  .review-cta-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(20px, 2.5vw, 26px);
    font-weight: 300;
    color: #1C244B;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
  }
  .review-cta-body {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.7;
    color: #324A6D;
    margin: 0 0 28px;
  }
  .review-cta-btn {
    display: inline-block;
    background: #467FF7;
    color: #fff;
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 500;
    padding: 14px 32px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .review-cta-btn:hover { background: #2f62d4; }
</style>
