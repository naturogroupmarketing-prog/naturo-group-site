---
// Geelong EOL suburb sub-pages
// URL: /end-of-lease-cleaning/geelong/[suburb]

import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import ServiceIntro from '../../../components/ServiceIntro.astro';
import ServiceInclusions from '../../../components/ServiceInclusions.astro';
import Features from '../../../components/Features.astro';
import PricingCards from '../../../components/PricingCards.astro';
import Providers from '../../../components/Providers.astro';
import Testimonials from '../../../components/Testimonials.astro';
import AppPromo from '../../../components/AppPromo.astro';
import FinalCTA from '../../../components/FinalCTA.astro';
import { site, ctaPrimary } from '../../../data/site';

interface SuburbData {
  slug: string;
  name: string;
  stateCode: string;
  postcode: string;
  blurb: string;
  propertyTypes: string;
  nearbyText: string;
}

export async function getStaticPaths() {
  const SUBURBS: SuburbData[] = [
    {
      slug: 'ocean-grove',
      name: 'Ocean Grove',
      stateCode: 'VIC',
      postcode: '3226',
      blurb: "Ocean Grove's coastal rental market moves fast — landlords expect properties returned in immaculate condition, and property managers in the Bellarine routinely use professional bond cleans as their inspection benchmark. With holiday lets, long-term rentals and seasonal turnovers all common here, a thorough clean to the REIV standard is essential.",
      propertyTypes: 'beachside units, holiday lets, weatherboard houses and newer coastal estates',
      nearbyText: 'Barwon Heads, Queenscliff and the wider Bellarine Peninsula',
    },
    {
      slug: 'torquay',
      name: 'Torquay',
      stateCode: 'VIC',
      postcode: '3228',
      blurb: "Torquay's surf-lifestyle rental market is one of the most competitive on the Surf Coast, with properties regularly inspected to showroom standard. Whether you're vacating a townhouse near Surf City Plaza or a beachside unit steps from Jan Juc, our team cleans to the exact checklist your property manager will use at final inspection.",
      propertyTypes: 'surf-side units, townhouses, holiday lets and newer estate homes',
      nearbyText: 'Jan Juc, Bells Beach and the Surf Coast corridor',
    },
    {
      slug: 'newtown',
      name: 'Newtown',
      stateCode: 'VIC',
      postcode: '3220',
      blurb: "Newtown is one of Geelong's most tightly held rental suburbs, with period homes, double-fronted bungalows and modern apartments all in high demand. Property managers here have high expectations — especially for heritage finishes like timber floors, ornate ceilings and original leadlight windows that need specialist care.",
      propertyTypes: 'period homes, double-fronted bungalows, renovated terraces and inner-ring apartments',
      nearbyText: 'Geelong CBD, Chilwell and South Geelong',
    },
    {
      slug: 'lara',
      name: 'Lara',
      stateCode: 'VIC',
      postcode: '3212',
      blurb: "Lara is one of Geelong's fastest-growing suburbs, with a large volume of new estate and established homes turning over regularly as families upsize or relocate toward the city. Real estate agents in Lara are diligent at final inspection — a professional bond clean is the most reliable way to protect your full deposit.",
      propertyTypes: 'new estate homes, established brick houses and family townhouses',
      nearbyText: 'Corio, Little River and the You Yangs corridor',
    },
    {
      slug: 'leopold',
      name: 'Leopold',
      stateCode: 'VIC',
      postcode: '3224',
      blurb: "Leopold sits between Geelong and the Bellarine Peninsula, making it a popular family rental suburb with consistent turnover throughout the year. With a mix of established homes and newer estates, our end-of-lease team covers every property type — from small brick-veneer houses to spacious four-bedroom family homes.",
      propertyTypes: 'established family homes, newer estates and brick-veneer houses',
      nearbyText: 'Clifton Springs, Drysdale and the Bellarine Peninsula',
    },
    {
      slug: 'belmont',
      name: 'Belmont',
      stateCode: 'VIC',
      postcode: '3216',
      blurb: "Belmont is one of Geelong's most active rental markets, with strong demand from families, professionals and university-linked renters due to its proximity to Deakin University's Waurn Ponds campus. High inspection standards from local agents mean a comprehensive bond clean is not optional — it's expected.",
      propertyTypes: 'brick-veneer family homes, dual-occupancy properties, townhouses and units',
      nearbyText: 'Highton, Waurn Ponds and South Geelong',
    },
    {
      slug: 'highton',
      name: 'Highton',
      stateCode: 'VIC',
      postcode: '3216',
      blurb: "Highton is a premium Geelong suburb with a strong owner-occupier and high-quality rental market. Properties here — many of them architect-designed or extensively renovated — command high bonds and attract thorough final inspections. Our cleaning standard means we match what high-end property managers look for.",
      propertyTypes: 'architect-designed homes, large family residences and quality townhouses',
      nearbyText: 'Belmont, Wandana Heights and the Barwon River corridor',
    },
    {
      slug: 'geelong-west',
      name: 'Geelong West',
      stateCode: 'VIC',
      postcode: '3218',
      blurb: "Geelong West's character cottages, Federation homes and inner-city lifestyle have made it one of the most sought-after rental suburbs in greater Geelong. Tenants leaving character-era properties face particularly high expectations around skirting boards, original fixtures, tile grouting and period finishes that standard cleaners often miss.",
      propertyTypes: 'Federation cottages, renovated character homes, period terraces and inner-city units',
      nearbyText: 'Manifold Heights, Herne Hill and the Geelong CBD',
    },
    {
      slug: 'barwon-heads',
      name: 'Barwon Heads',
      stateCode: 'VIC',
      postcode: '3227',
      blurb: "Barwon Heads is a premium coastal village with a concentrated and highly competitive rental and holiday-let market. Landlords in Barwon Heads and Thirteenth Beach expect immaculate turnovers — our team photographs every room before and after so you have documented proof for any bond dispute.",
      propertyTypes: 'coastal cottages, luxury holiday lets, beach houses and Bellarine estates',
      nearbyText: 'Ocean Grove, Connewarre and the Barwon River mouth',
    },
    {
      slug: 'grovedale',
      name: 'Grovedale',
      stateCode: 'VIC',
      postcode: '3216',
      blurb: "Grovedale is a well-established family suburb in south Geelong with consistent rental activity across its 1980s–2000s housing stock. Its proximity to Deakin University, Waurn Ponds Shopping Centre and local schools means strong demand from families and students — and regular bond clean requirements at the end of every tenancy.",
      propertyTypes: 'brick-veneer family homes, townhouses, units and student-oriented rentals',
      nearbyText: 'Waurn Ponds, Highton and Mount Duneed',
    },
  ];

  return SUBURBS.map((s) => ({
    params: { suburb: s.slug },
    props: { suburb: s, allSuburbs: SUBURBS },
  }));
}

interface Props { suburb: SuburbData; allSuburbs: SuburbData[]; }
const { suburb, allSuburbs } = Astro.props;

const pageUrl = `${site.url}/end-of-lease-cleaning/geelong/${suburb.slug}`;

const introStats = [
  { num: '100%', label: 'Bond-back guarantee' },
  { num: '72&nbsp;hr', label: 'Free re-clean window' },
  { num: '24/7', label: 'Booking online' },
];

const inclusions = [
  {
    group: 'All areas',
    items: [
      'Vacuum carpets & sweep all floors',
      'Mop all hard floors',
      'Wipe down skirting boards',
      'Dust cornices & remove cobwebs',
      'Wipe window frames, ledges & tracks',
      'Clean window interiors & tracks',
      'Wipe doors, frames & handles',
      'Clean accessible light fittings',
      'Ceiling fans dusted',
      'Wipe inside & outside wardrobes',
    ],
  },
  {
    group: 'Kitchen',
    items: [
      'Clean all surfaces & sanitise benchtops',
      'Sanitise splashback',
      'Clean stovetop & oven exterior',
      'Clean rangehood & filters',
      'Wipe outside cabinets & appliance exteriors',
      'Clean inside cupboards, shelves & drawers',
      'Polish sink & taps',
    ],
  },
  {
    group: 'Bathrooms',
    items: [
      'Scrub & sanitise toilet',
      'Scrub clean bathtub & shower',
      'Clean mirrors streak-free',
      'Polish sink & taps',
      'Wipe down benchtops',
      'Wipe outside cabinets',
      'Clean inside cabinets, shelves & drawers',
      'Dust accessible exterior fan vents',
    ],
  },
];

const excluded = [
  'Chandeliers',
  'Light bulbs',
  'Fireplaces',
  'Fly screens',
  'Moving furniture or appliances',
  'Putting away dishes, pans or A/C filters',
  'Grout & silicon remediations',
  'Biohazards (excessive mould, faeces, blood)',
  'Odour removal & remediation',
  'Pet hair embedded in carpet fibres',
  'Certain mineral deposits (e.g. toilet stains)',
  'High-reach areas (above two-step ladder)',
];

const faqs = [
  {
    q: `How much does end of lease cleaning cost in ${suburb.name}?`,
    a: `End of lease cleaning in ${suburb.name} starts from $560 for a 1-bedroom property. Pricing scales with bedrooms — 2BR $640, 3BR $800, 4BR $960, 5BR $1,280. Get an exact price in 60 seconds online — no phone call required.`,
  },
  {
    q: `Do you offer a bond-back guarantee for ${suburb.name} properties?`,
    a: `Yes. If your ${suburb.name} property manager raises any issue with our clean, we return within 72 hours and re-clean the affected areas at no charge. No disputes, no chasing — just your bond, back.`,
  },
  {
    q: `Do your cleaners know ${suburb.name} properties?`,
    a: `Our Geelong-based team works across ${suburb.name} and ${suburb.nearbyText} regularly. We understand local property managers' expectations and the specific challenges of ${suburb.propertyTypes}.`,
  },
  {
    q: `Do I need to be home during the clean in ${suburb.name}?`,
    a: `No. Most ${suburb.name} clients provide a key or lockbox code. We complete the clean, photograph every room and send you a photo summary you can share directly with your property manager or real estate agent.`,
  },
  {
    q: 'Does the clean include the oven and carpets?',
    a: 'Yes — the oven interior (racks, walls and door glass), stovetop, rangehood and all bathrooms are included as standard. Carpet steam cleaning is available as an add-on and we can arrange it at the same booking.',
  },
  {
    q: `How far in advance should I book in ${suburb.name}?`,
    a: `We recommend 5–7 days ahead of your vacate date to secure your preferred time slot. For urgent ${suburb.name} bookings call 1300 876 472 and we will do our best to fit you in within 24–48 hours.`,
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${pageUrl}#localbusiness`,
    name: `Naturo Group — End of Lease Cleaning ${suburb.name}`,
    description: `Professional end of lease cleaning in ${suburb.name} ${suburb.stateCode} with a 72-hour bond-back guarantee. Police-checked, eco-conscious team. Part of Naturo Group's Greater Geelong service area.`,
    url: pageUrl,
    telephone: site.phone,
    email: site.email,
    priceRange: '$$$',
    areaServed: [
      { '@type': 'City', name: suburb.name, containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Geelong', containedInPlace: { '@type': 'State', name: 'Victoria' } },
    ],
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:30',
      closes: '17:00',
    },
    offers: {
      '@type': 'Offer',
      price: '560',
      priceCurrency: 'AUD',
      availability: 'https://schema.org/InStock',
      description: `End of lease cleaning ${suburb.name} from $560`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'End of Lease Cleaning Geelong', item: `${site.url}/end-of-lease-cleaning-geelong` },
      { '@type': 'ListItem', position: 3, name: `End of Lease Cleaning ${suburb.name}`, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title={`End of Lease Cleaning ${suburb.name} | Bond Back Guarantee | Naturo Group`}
  description={`End of lease cleaning in ${suburb.name} from $560. Police-checked team, 72-hr bond-back guarantee. Part of Naturo Group's Greater Geelong service area.`}
  schema={schema}
>
  <!-- 1. Hero -->
  <ServiceHero
    eyebrow={`Bond cleaning · ${suburb.name}`}
    heading={`End of Lease Cleaning<br />in ${suburb.name}`}
    tagline="72-hour bond-back guarantee. Police-checked team. Eco-conscious products."
    bg="/images/hero-staff-bathroom.jpg"
  />

  <!-- 2. Stats bar -->
  <section class="bg-[#F8F8F3] border-b border-[var(--color-border)]">
    <div class="container-site">
      <div class="grid sm:grid-cols-3">
        <div class="px-6 py-8 text-center sm:border-r border-[var(--color-border)]">
          <p class="text-3xl font-light text-[var(--color-navy)]">$560</p>
          <p class="text-sm text-[var(--color-slate)] mt-1 uppercase tracking-widest font-semibold">Starting from</p>
        </div>
        <div class="px-6 py-8 text-center sm:border-r border-[var(--color-border)]">
          <p class="text-3xl font-light text-[var(--color-navy)]">72hr</p>
          <p class="text-sm text-[var(--color-slate)] mt-1 uppercase tracking-widest font-semibold">Bond-back guarantee</p>
        </div>
        <div class="px-6 py-8 text-center">
          <p class="text-3xl font-light text-[var(--color-navy)]">Plant-based</p>
          <p class="text-sm text-[var(--color-slate)] mt-1 uppercase tracking-widest font-semibold">Eco-conscious products</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Intro -->
  <ServiceIntro
    kicker="About this service"
    heading={`Get your bond back in ${suburb.name} — or we come back for free.`}
    body={[
      suburb.blurb,
      `Our ${suburb.name} bond cleans are carried out by police-checked, fully insured cleaners who arrive with all equipment and eco-conscious products. We clean to the exact REIV inspection standard — then photograph every room so you have documented proof if anything is ever disputed.`,
      'If your property manager raises any issue, we return within 72 hours at no extra charge. No questions, no arguments — just your bond, back.',
    ]}
    stats={introStats}
  />

  <!-- 4. What's included -->
  <ServiceInclusions
    heading="Every room. Every detail. Every time."
    sub={`Our ${suburb.name} bond clean covers every area your property manager will inspect — nothing skipped, nothing missed.`}
    groups={inclusions}
  />

  <!-- 5. Excluded services -->
  <section style="background: #ffffff; padding: clamp(64px, 7vw, 88px) 0; border-top: 1px solid rgba(15,23,42,0.06);">
    <div class="container-site" style="max-width: 1160px;">
      <div style="text-align: center; max-width: 640px; margin: 0 auto 36px;">
        <p class="eyebrow" style="margin-bottom: 12px;">Excluded services</p>
        <h2 style="font-family: 'Poppins', sans-serif; font-size: clamp(24px, 3vw, 36px); font-weight: 300; line-height: 1.15; letter-spacing: -0.01em; color: #0f172a; margin: 0 0 12px;">
          Not included as standard
        </h2>
        <p style="font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 300; color: rgb(71, 85, 105); line-height: 1.65; margin: 0;">
          The following fall outside our standard bond clean. Contact us and we can quote these separately.
        </p>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; max-width: 880px; margin: 0 auto 28px;">
        {excluded.map((item) => (
          <span style="display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; border-radius: 999px; background: rgba(15,23,42,0.03); border: 1px solid rgba(15,23,42,0.08);">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" style="flex-shrink: 0; color: rgb(148, 163, 184);" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M1 1l8 8M9 1L1 9"/></svg>
            <span style="font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 300; color: rgb(100, 116, 139);">{item}</span>
          </span>
        ))}
      </div>
      <div style="text-align: center;">
        <a href={ctaPrimary.href} style="font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 500; color: #467FF7; text-decoration: none;">
          Enquire about excluded services &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Why Naturo Group -->
  <Features />

  <!-- 6. Social proof -->
  <Testimonials />

  <!-- 7. Pricing -->
  <PricingCards />

  <!-- 8. Providers -->
  <Providers />

  <!-- 9. FAQs -->
  <section class="bg-[#F8F8F3]" style="padding: clamp(88px, 10vw, 128px) 0;">
    <div class="container-site" style="max-width: 768px;">
      <div class="text-center" style="margin-bottom: 2.5rem;">
        <p class="eyebrow" style="margin-bottom: 0.75rem;">FAQs</p>
        <h2 style="font-family: 'Poppins', sans-serif; font-size: clamp(28px, 3.5vw, 40px); font-weight: 300; line-height: 1.1; letter-spacing: -0.015em; color: #0f172a; margin: 0;">
          End of lease cleaning {suburb.name} &mdash; common questions
        </h2>
      </div>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="bg-white rounded-[14px] border border-[rgba(15,23,42,0.08)] shadow-sm group">
            <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer list-none font-medium text-[var(--color-navy)]">
              {f.q}
              <svg class="w-5 h-5 shrink-0 text-[var(--color-slate)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="px-6 pb-5 text-[var(--color-slate)] leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. App promo -->
  <AppPromo />

  <!-- 11. Final CTA -->
  <FinalCTA />

  <!-- 12. Cross-links -->
  <section style="background: #ffffff; padding: clamp(88px, 10vw, 128px) 0;">
    <div class="container-site">
      <div class="text-center" style="margin-bottom: 2rem;">
        <p class="eyebrow" style="margin-bottom: 0.75rem;">Also serving</p>
        <h2 style="font-family: 'Poppins', sans-serif; font-size: clamp(22px, 2.5vw, 32px); font-weight: 300; line-height: 1.1; color: #0f172a; margin: 0;">
          End of lease cleaning across Greater Geelong
        </h2>
      </div>
      <div class="flex flex-wrap gap-2 justify-center" style="margin-bottom: 2rem;">
        {allSuburbs.filter((s) => s.slug !== suburb.slug).map((s) => (
          <a
            href={`/end-of-lease-cleaning/geelong/${s.slug}`}
            class="px-4 py-2 rounded-full border border-[rgba(15,23,42,0.08)] text-sm text-[var(--color-slate)] hover:border-[var(--color-accent-blue)] hover:text-[var(--color-accent-blue)] transition-colors"
          >
            {s.name}
          </a>
        ))}
      </div>
      <div class="text-center space-y-2">
        <a href="/end-of-lease-cleaning-geelong" class="text-sm font-medium text-[var(--color-accent-blue)] hover:underline block">
          &larr; Back to End of Lease Cleaning Geelong (all areas)
        </a>
        <a href="/house-cleaning-geelong" class="text-sm text-[var(--color-slate)] hover:underline block">
          Regular house cleaning in {suburb.name} &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  details > summary::-webkit-details-marker { display: none; }
</style>
