---
import Layout from '../layouts/Layout.astro';
import { site, ctaPrimary, ctaPhone } from '../data/site';

const heroSlides = [
  '/images/team-staff.jpg',
  '/images/banner-staff.jpg',
  '/images/phone-woman.jpg',
];

// Schema: JobPosting (general "Cleaner" role, valid for ~12 months),
// BreadcrumbList, FAQPage. Salary is in AUD, hourly, conservative range
// pitched against the Cleaning Services Award 2020.
const today = new Date();
const validThrough = new Date(today);
validThrough.setMonth(validThrough.getMonth() + 12);
const isoToday = today.toISOString().split('T')[0];
const isoValidThrough = validThrough.toISOString().split('T')[0];

const careerFaqs = [
  {
    q: 'Do I need previous cleaning experience?',
    a: 'Not necessarily. We hire on attitude and reliability first. If you take pride in detail, show up on time and treat clients with respect, our paid induction will teach you the rest.',
  },
  {
    q: 'Will I be an employee or a contractor?',
    a: 'Both options are available depending on the role and your preference. We offer PAYG employment for ongoing residential and aged-care work, and ABN/contractor arrangements for one-off and end-of-lease teams. We will discuss what fits you at interview.',
  },
  {
    q: 'How is pay calculated?',
    a: 'You are paid above the Cleaning Services Award 2020. Pay rates depend on role, experience and shift type. Travel between jobs is reimbursed for employees, and our top performers consistently earn $32–$42 per hour all-in.',
  },
  {
    q: 'Do I need my own car?',
    a: 'A licence and reliable transport make scheduling far easier and unlock more shifts in your area. In high-density suburbs (Sydney CBD, Bondi, Manly, inner Melbourne) public transport is fine — let us know in your application.',
  },
  {
    q: 'How flexible are the hours?',
    a: 'You set your availability. Most cleaners work weekday daytime shifts (between 8:30am and 5:00pm) and choose 3–5 days a week. School-hours-only and weekend availability are both welcome.',
  },
  {
    q: 'Do I need a Police Check or Working with Children Check?',
    a: 'Yes — every cleaner is police-checked before their first shift. We help cover the cost of your check. A WWCC is required for any role visiting NDIS or aged-care participants and we walk you through the application.',
  },
  {
    q: 'How long does the application process take?',
    a: 'From application to first shift typically takes 7–14 days. That includes a phone chat, in-person interview, reference checks, police check and a paid induction shift with one of our senior cleaners.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'JobPosting',
    title: 'Residential & NDIS Cleaner',
    description:
      'Join NATURO GROUP — Australia\u2019s eco-friendly residential and NDIS cleaning team. We are hiring reliable, detail-focused cleaners across NSW, Queensland and Victoria. Above-award pay, flexible hours, all eco-friendly products and equipment supplied, paid training and a supportive area coordinator.',
    datePosted: isoToday,
    validThrough: isoValidThrough,
    employmentType: ['PART_TIME', 'FULL_TIME', 'CONTRACTOR'],
    hiringOrganization: {
      '@type': 'Organization',
      name: site.name,
      sameAs: site.url,
      logo: `${site.url}/images/logo.png`,
    },
    jobLocation: {
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'AU',
        addressRegion: 'NSW',
      },
    },
    applicantLocationRequirements: { '@type': 'Country', name: 'Australia' },
    baseSalary: {
      '@type': 'MonetaryAmount',
      currency: 'AUD',
      value: {
        '@type': 'QuantitativeValue',
        minValue: 32,
        maxValue: 42,
        unitText: 'HOUR',
      },
    },
    industry: 'Residential & Disability Support Cleaning',
    qualifications:
      'Reliable transport in most areas, working rights in Australia, willingness to undergo a Police Check (and WWCC for NDIS work).',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Careers', item: `${site.url}/career` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: careerFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const benefits = [
  {
    title: 'Above-award pay',
    body: 'Top performers earn $32–$42 per hour all-in, paid weekly. Travel reimbursed for employees between jobs.',
  },
  {
    title: 'Pick your hours',
    body: 'You set your availability. School-hours-only, three days a week, full-time — we build a schedule around your life.',
  },
  {
    title: 'Local clients near you',
    body: 'We route you to repeat clients in your suburb. Less driving, more productive hours, real relationships.',
  },
  {
    title: 'Eco products supplied',
    body: 'All non-toxic products, microfibre cloths and equipment provided. No buying or carrying chemicals around.',
  },
  {
    title: 'Paid induction',
    body: 'A senior cleaner trains you on your first shift — paid. Ongoing upskilling for end-of-lease, NDIS and insurance work.',
  },
  {
    title: 'Real coordinator support',
    body: 'Your area coordinator is one phone call away. Shift swaps, client questions, awkward situations — you are never on your own.',
  },
];

const wellLook = [
  'Reliable, on time, and you do what you say you\u2019ll do',
  'Eye for detail — you notice the smudge on the tap',
  'Respectful of clients, their homes and their privacy',
  'Working rights in Australia',
  'Willing to undergo a Police Check (we help with the cost)',
  'Conversational English to read instructions and chat with clients',
];

const niceToHave = [
  'Cleaning, hospitality, hotel housekeeping or aged-care experience',
  'Driver\u2019s licence and reliable transport',
  'Working with Children Check (or willing to apply for one)',
  'First Aid certificate',
  'Experience with NDIS or aged care participants',
  'Bond/end-of-lease cleaning experience',
];

const steps = [
  {
    n: '01',
    title: 'Apply online',
    body: 'Two-minute form below. Tell us where you\u2019re based, your availability and a little about you.',
  },
  {
    n: '02',
    title: 'Phone chat',
    body: 'Quick 10-minute call with your local coordinator within 48 hours of a successful application.',
  },
  {
    n: '03',
    title: 'Meet the team',
    body: 'In-person interview at a local cafe. Bring ID, references and your availability calendar.',
  },
  {
    n: '04',
    title: 'Paid induction',
    body: 'Shadow a senior cleaner for your first shift — paid from minute one. You\u2019re on the team.',
  },
];

const cleanerStories = [
  {
    name: 'Maria T.',
    role: 'Cleaner, Sydney Eastern Suburbs',
    quote:
      'I came from hotel housekeeping where I was burnt out. At NATURO I have my regular Bondi clients, I finish by 2:30pm to pick up my kids, and I get paid more. I\u2019m not going back.',
  },
  {
    name: 'Jacqui H.',
    role: 'Senior Cleaner & Trainer, Gold Coast',
    quote:
      'Anna actually listens. When a client situation is hard, the office has my back. That\u2019s why I\u2019ve stayed three years and trained eight new cleaners.',
  },
  {
    name: 'Sam K.',
    role: 'NDIS Cleaner, Melbourne North',
    quote:
      'The training for NDIS work was thorough — boundaries, dignity, all of it. My participants trust me. It feels like proper care work, not just cleaning.',
  },
];

const availabilityOptions = [
  'Mondays', 'Tuesdays', 'Wednesdays', 'Thursdays', 'Fridays', 'Saturdays',
];

const states = ['NSW', 'QLD', 'VIC', 'Other'];
---

<Layout
  title="Careers — Become a NATURO GROUP Cleaner"
  description="Hiring eco-friendly residential, NDIS and end-of-lease cleaners across Australia. Above-award pay, flexible hours, all products supplied, paid induction. Apply in two minutes."
  schema={schema}
>
  <!-- 1. Hero — mirrors homepage ExperienceBanner: photo right 55%,
       gradient mask on the left, headline over the dark side. -->
  <section class="cr-hero">
    <div class="cr-hero-slides" aria-hidden="true">
      {heroSlides.map((src, i) => (
        <div
          class="cr-hero-slide"
          style={`background-image: url(${src}); animation-delay: ${i * 5}s;`}
        />
      ))}
    </div>
    <div class="cr-hero-overlay" aria-hidden="true"></div>
    <div class="container-site cr-hero-inner">
      <div class="cr-hero-content">
        <p class="cr-hero-eyebrow">Careers</p>
        <h1 class="cr-hero-h1">Cleaning, on<br />better terms.<br />Join the team.</h1>
        <p class="cr-hero-tagline">Above-award pay, flexible hours and clients who know your name.</p>
        <div class="cr-hero-ctas">
          <a href="#apply" class="cr-hero-btn-primary">Apply now</a>
          <a href={ctaPhone.href} class="cr-hero-btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{ctaPhone.text}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Intro — 2-col sticky, mirrors homepage IntroCopy -->
  <section class="cr-intro-section">
    <div class="container-site cr-intro-inner">
      <div class="cr-intro-col cr-intro-col-left">
        <span class="cr-intro-kicker">Why our cleaners stay</span>
        <h2 class="cr-intro-h2">A cleaning job built around your life — not the other way around.</h2>
      </div>
      <div class="cr-intro-col cr-intro-col-right">
        <p class="cr-intro-body">
          NATURO GROUP was founded by a registered nurse, and that care for people runs through how we treat
          our cleaners too. We pay above the Cleaning Services Award, we route you to repeat clients near home,
          and we give you a real coordinator who answers their phone.
        </p>
        <p class="cr-intro-body">
          You won&rsquo;t buy a single chemical. You won&rsquo;t drive across the city for a 90-minute job. And you
          won&rsquo;t feel disposable. We&rsquo;re hiring across NSW, Queensland and Victoria for residential, NDIS,
          aged-care and end-of-lease teams.
        </p>
        <div class="cr-intro-stats">
          <div class="cr-intro-stat">
            <span class="cr-intro-stat-num">$32&ndash;$42</span>
            <span class="cr-intro-stat-label">/hr all-in for top performers</span>
          </div>
          <div class="cr-intro-stat">
            <span class="cr-intro-stat-num">3+&nbsp;yrs</span>
            <span class="cr-intro-stat-label">Average cleaner tenure</span>
          </div>
          <div class="cr-intro-stat">
            <span class="cr-intro-stat-num">7&ndash;14&nbsp;days</span>
            <span class="cr-intro-stat-label">Apply to first shift</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Benefits — 6 cards, mirrors Features pattern -->
  <section class="cr-benefits-section" aria-labelledby="cr-benefits-h2">
    <div class="container-site cr-benefits-inner">
      <div class="cr-benefits-head">
        <p class="cr-benefits-eyebrow">What you get</p>
        <h2 id="cr-benefits-h2" class="cr-benefits-h2">The Naturo cleaner package</h2>
      </div>
    </div>
    <div class="container-site cr-benefits-inner cr-benefits-grid">
      {benefits.map((b) => (
        <div class="cr-benefit-card">
          <h3 class="cr-benefit-title">{b.title}</h3>
          <p class="cr-benefit-body">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. Who we're looking for — 2-col lists -->
  <section class="cr-fit-section" aria-labelledby="cr-fit-h2">
    <div class="container-site cr-fit-inner">
      <div class="cr-fit-head">
        <p class="cr-fit-eyebrow">Who fits in</p>
        <h2 id="cr-fit-h2" class="cr-fit-h2">Who we&rsquo;re looking for</h2>
      </div>
      <div class="cr-fit-grid">
        <div class="cr-fit-col">
          <h3 class="cr-fit-col-title">Must-haves</h3>
          <ul class="cr-fit-list">
            {wellLook.map((it) => (
              <li>
                <svg class="cr-tick" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="cr-fit-col">
          <h3 class="cr-fit-col-title">Nice-to-haves</h3>
          <ul class="cr-fit-list cr-fit-list-soft">
            {niceToHave.map((it) => (
              <li>
                <svg class="cr-plus" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                </svg>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Process — 4 steps -->
  <section class="cr-steps-section" aria-labelledby="cr-steps-h2">
    <div class="container-site cr-steps-inner">
      <div class="cr-steps-head">
        <p class="cr-steps-eyebrow">How it works</p>
        <h2 id="cr-steps-h2" class="cr-steps-h2">From application to first shift in two weeks</h2>
      </div>
      <ol class="cr-steps-grid">
        {steps.map((s) => (
          <li class="cr-step-card">
            <span class="cr-step-num">{s.n}</span>
            <h3 class="cr-step-title">{s.title}</h3>
            <p class="cr-step-body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. Cleaner stories -->
  <section class="cr-stories-section" aria-labelledby="cr-stories-h2">
    <div class="container-site cr-stories-inner">
      <div class="cr-stories-head">
        <p class="cr-stories-eyebrow">From the team</p>
        <h2 id="cr-stories-h2" class="cr-stories-h2">What our cleaners say</h2>
      </div>
      <div class="cr-stories-grid">
        {cleanerStories.map((s) => (
          <figure class="cr-story-card">
            <svg class="cr-quote" width="28" height="22" viewBox="0 0 28 22" fill="none" aria-hidden="true">
              <path d="M0 22V12C0 5.4 4.6 0 11 0v4C7.2 4 4 7.6 4 12h4v10H0zm16 0V12C16 5.4 20.6 0 27 0v4c-3.8 0-7 3.6-7 8h4v10h-8z" fill="currentColor"/>
            </svg>
            <blockquote class="cr-story-quote">{s.quote}</blockquote>
            <figcaption class="cr-story-meta">
              <span class="cr-story-name">{s.name}</span>
              <span class="cr-story-role">{s.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="cr-faq-section" aria-labelledby="cr-faq-h2">
    <div class="container-site cr-faq-inner">
      <div class="cr-faq-head">
        <p class="cr-faq-eyebrow">Frequently asked</p>
        <h2 id="cr-faq-h2" class="cr-faq-h2">Career questions, answered</h2>
      </div>
      <div class="cr-faq-list">
        {careerFaqs.map((f) => (
          <details class="cr-faq-item">
            <summary class="cr-faq-q">{f.q}</summary>
            <p class="cr-faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Application form -->
  <section class="cr-apply-section" id="apply" aria-labelledby="cr-apply-h2">
    <div class="container-site cr-apply-inner">
      <div class="cr-apply-head">
        <p class="cr-apply-eyebrow">Apply now</p>
        <h2 id="cr-apply-h2" class="cr-apply-h2">Two minutes. We&rsquo;ll call you within 48 hours.</h2>
        <p class="cr-apply-sub">
          Prefer to chat first? Call us on <a href={site.phoneHref} class="cr-apply-link">{site.phone}</a>
          or email <a href={`mailto:${site.email}?subject=Career application`} class="cr-apply-link">{site.email}</a>.
        </p>
      </div>

      <form
        class="cr-form"
        action={`mailto:${site.email}`}
        method="post"
        enctype="text/plain"
        aria-describedby="cr-form-note"
      >
        <div class="cr-form-grid">
          <label class="cr-field">
            <span class="cr-field-label">Full name<span aria-hidden="true">*</span></span>
            <input class="cr-input" type="text" name="full_name" autocomplete="name" required />
          </label>

          <label class="cr-field">
            <span class="cr-field-label">Email<span aria-hidden="true">*</span></span>
            <input class="cr-input" type="email" name="email" autocomplete="email" required />
          </label>

          <label class="cr-field">
            <span class="cr-field-label">Mobile<span aria-hidden="true">*</span></span>
            <input class="cr-input" type="tel" name="mobile" autocomplete="tel" inputmode="tel" required />
          </label>

          <label class="cr-field">
            <span class="cr-field-label">Suburb &amp; postcode<span aria-hidden="true">*</span></span>
            <input class="cr-input" type="text" name="suburb_postcode" placeholder="e.g. Bondi 2026" required />
          </label>

          <label class="cr-field">
            <span class="cr-field-label">State<span aria-hidden="true">*</span></span>
            <select class="cr-input" name="state" required>
              <option value="" disabled selected>Choose a state</option>
              {states.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>

          <label class="cr-field">
            <span class="cr-field-label">Cleaning experience</span>
            <select class="cr-input" name="experience">
              <option value="">Choose one</option>
              <option value="none">None — happy to learn</option>
              <option value="under-1">Less than 1 year</option>
              <option value="1-3">1–3 years</option>
              <option value="3-plus">3+ years</option>
            </select>
          </label>
        </div>

        <fieldset class="cr-fieldset">
          <legend class="cr-field-label">Do you have a driver&rsquo;s licence and car?</legend>
          <div class="cr-radio-row">
            <label class="cr-radio">
              <input type="radio" name="transport" value="car_and_licence" required />
              <span>Yes — car and licence</span>
            </label>
            <label class="cr-radio">
              <input type="radio" name="transport" value="licence_only" />
              <span>Licence, no car</span>
            </label>
            <label class="cr-radio">
              <input type="radio" name="transport" value="public_transport" />
              <span>Public transport only</span>
            </label>
          </div>
        </fieldset>

        <fieldset class="cr-fieldset">
          <legend class="cr-field-label">Availability — tick all that apply</legend>
          <div class="cr-check-grid">
            {availabilityOptions.map((d) => (
              <label class="cr-check">
                <input type="checkbox" name="availability" value={d} />
                <span>{d}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="cr-field">
          <span class="cr-field-label">Anything else we should know?</span>
          <textarea class="cr-input cr-textarea" name="message" rows="4" placeholder="Languages, NDIS / WWCC status, when you can start, references…"></textarea>
        </label>

        <p id="cr-form-note" class="cr-form-note">
          Submitting opens your email client with the details ready to send. We&rsquo;ll review every application
          and reply within 48 hours.
        </p>

        <button type="submit" class="cr-submit">Send my application</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Hero — same composition as homepage ExperienceBanner
     (photo pinned to the right, gradient mask on the left, content
     over the dark side). Slideshow rotation matches the homepage
     Hero (15s loop, 3 slides). ----------------------------------- */
  .cr-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* Standard hero height — match across every page. */
    height: clamp(640px, 86vh, 800px);
    background-color: rgb(58, 77, 97);
    display: flex;
    align-items: center;
  }
  .cr-hero-slides {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cr-hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
    opacity: 0;
    animation: crHeroFade 15s infinite;
    will-change: opacity;
  }
  @keyframes crHeroFade {
    0%, 28% { opacity: 1; }
    33%, 95% { opacity: 0; }
    100% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cr-hero-slide { animation: none; }
    .cr-hero-slide:first-child { opacity: 1; }
  }
  /* Same gradient + opacity treatment as the homepage Hero. */
  .cr-hero-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, rgb(58, 77, 97) 20%, rgba(5, 170, 232, 0) 81%);
    opacity: 0.91;
    pointer-events: none;
    z-index: 1;
  }
  .cr-hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: clamp(72px, 10vh, 128px);
  }
  .cr-hero-content {
    max-width: 605px;
    color: #ffffff;
  }
  .cr-hero-eyebrow {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #FEB91C;
    margin: 0 0 14px;
  }
  .cr-hero-h1 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(40px, 5.2vw, 66px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: #ffffff;
    margin: 0;
  }
  .cr-hero-tagline {
    font-family: "Poppins", sans-serif;
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 400;
    line-height: 1.5;
    color: #FEB91C;
    margin: 16px 0 0;
    letter-spacing: 0.005em;
  }
  .cr-hero-ctas {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  @media (max-width: 500px) {
    .cr-hero-ctas { flex-direction: column; align-items: stretch; }
  }
  .cr-hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #3a5dff;
    color: #ffffff;
    border: 1px solid #3a5dff;
    border-radius: 6px;
    padding: 14px 26px;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    min-height: 46px;
    box-shadow: 0 4px 12px rgba(58, 93, 255, 0.28);
    text-decoration: none;
    transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .cr-hero-btn-primary:hover {
    background-color: #2548f0;
    border-color: #2548f0;
    box-shadow: 0 6px 18px rgba(58, 93, 255, 0.4);
    transform: translateY(-1px);
  }
  .cr-hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
