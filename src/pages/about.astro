---
import Layout from '../layouts/Layout.astro';
import Specialties from '../components/Specialties.astro';
import CTABanner from '../components/CTABanner.astro';
import { ctaPrimary, ctaPhone, site } from '../data/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${site.url}/about#webpage`,
    url: `${site.url}/about`,
    name: 'About Naturo Group — Eco-Friendly Cleaners Australia',
    description: 'Founded by registered nurse Anna Biram, Naturo Group brings clinical-level care and eco-friendly products to every residential clean across Australia.',
    isPartOf: { '@id': `${site.url}/#website` },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'About Us', item: `${site.url}/about` },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    legalName: site.legalName,
    url: site.url,
    telephone: site.phone,
    email: site.email,
    description: site.description,
    foundingDate: '2018',
    founder: {
      '@type': 'Person',
      name: 'Anna Biram',
      jobTitle: 'Founder & Managing Director',
      description: 'Registered nurse and founder of Naturo Group, bringing clinical-level care standards to eco-friendly residential cleaning across Australia.',
    },
    areaServed: {
      '@type': 'Country',
      name: 'Australia',
    },
    sameAs: [
      site.social.facebook,
      site.social.instagram,
      site.social.youtube,
    ],
    logo: {
      '@type': 'ImageObject',
      url: `${site.url}/images/logo.avif`,
    },
  },
];
---

<Layout
  title="About Us — Eco-Friendly Cleaners Australia"
  description="Founded by registered nurse Anna Biram, Naturo Group brings clinical-level care and eco-friendly products to every clean — across Australia."
  schema={schema}
>
  <section class="ph-hero">
    <div class="ph-bg" style="background-image: url(/images/banner-staff.jpg);" aria-hidden="true"></div>
    <div class="ph-overlay" aria-hidden="true"></div>
    <div class="container-site ph-inner">
      <div class="ph-content">
        <p class="ph-eyebrow">Our story</p>
        <h1 class="ph-h1">A cleaning company<br />started by a nurse.</h1>
        <p class="ph-tagline">Care, dignity and detail &mdash; the reason Naturo exists.</p>
        <div class="ph-ctas">
          <a href={ctaPrimary.href} class="ph-btn-primary">{ctaPrimary.text}</a>
          <a href={ctaPhone.href} class="ph-btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{ctaPhone.text}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site grid lg:grid-cols-2 gap-12 items-start">
      <div class="aspect-[4/5] rounded-3xl bg-gradient-to-br from-[var(--color-bg-light)] to-[var(--color-bg-cream)] flex items-center justify-center">
        <div class="text-center">
          <div class="w-32 h-32 rounded-full bg-[var(--color-navy)] text-white text-4xl font-light flex items-center justify-center mx-auto">AB</div>
          <p class="mt-6 text-xl font-semibold text-[var(--color-navy)]">Anna Biram</p>
          <p class="text-[var(--color-slate)]">Founder & Managing Director</p>
        </div>
      </div>
      <div class="space-y-5 text-[var(--color-slate)] leading-relaxed text-lg">
        <p>
          Anna spent years working as a registered nurse before launching Naturo Group. In hospital wards and aged care homes, she saw how a truly clean room changed how people felt — physically and emotionally.
        </p>
        <p>
          She also saw how often that level of care was missing in residential cleaning. Rushed jobs. Different cleaners every visit. Harsh chemicals around kids and pets. People paying premium prices for mediocre results.
        </p>
        <p>
          Naturo was built to be the opposite of that. A team trained like clinical staff. Eco-friendly, plant-based products. A consistent team you can trust. Genuine accountability when something\u2019s missed.
        </p>
        <p>
          Today we operate across NSW, Queensland and Victoria, working alongside NDIS plan managers, support coordinators, aged care clients, the Department of Veterans\u2019 Affairs and several major Australian insurers on cleaning jobs every week.
        </p>
      </div>
    </div>
  </section>

  <Specialties />

  <section class="bg-white">
    <div class="container-site grid md:grid-cols-3 gap-8 text-center">
      <div>
        <p class="text-5xl font-light text-[var(--color-cyan)]">800+</p>
        <p class="mt-2 text-[var(--color-slate)]">Australian families served</p>
      </div>
      <div>
        <p class="text-5xl font-light text-[var(--color-cyan)]">4.9★</p>
        <p class="mt-2 text-[var(--color-slate)]">Average Google rating</p>
      </div>
      <div>
        <p class="text-5xl font-light text-[var(--color-cyan)]">100%</p>
        <p class="mt-2 text-[var(--color-slate)]">Satisfaction guarantee on every clean</p>
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>

<style>
  /* ===== Page Hero — matches homepage Hero.astro exactly ===== */
  .ph-hero { position: relative; overflow: hidden; padding-block: 0; }
  .ph-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center; background-repeat: no-repeat;
  }
  .ph-overlay {
    position: absolute; inset: 0;
    background-image: linear-gradient(90deg, rgb(58, 77, 97) 20%, rgba(5, 170, 232, 0) 81%);
    opacity: 0.91; pointer-events: none;
  }
  .ph-inner {
    position: relative; z-index: 1;
    height: clamp(640px, 86vh, 800px);
    padding-block: clamp(48px, 8vh, 96px);
    display: flex; align-items: center;
  }
  @media (max-width: 640px) {
    .ph-inner { height: min(680px, 88dvh); padding-block: 36px; }
  }
  .ph-content { width: 100%; max-width: 800px; }
  .ph-eyebrow {
    font-family: "Poppins", sans-serif; font-size: 12px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: #FEB91C; margin: 0 0 14px;
  }
  .ph-h1 {
    font-family: "Poppins", sans-serif; font-weight: 300;
    font-size: clamp(30px, 5.2vw, 66px); line-height: 1.08;
    letter-spacing: -0.015em; color: #ffffff; margin: 0;
  }
  .ph-tagline {
    font-family: "Poppins", sans-serif; font-weight: 400;
    font-size: clamp(15px, 1.6vw, 22px); line-height: 1.5;
    color: #FEB91C; margin-top: 16px; letter-spacing: 0.005em;
  }
  .ph-ctas {
    margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
  }
  @media (max-width: 500px) { .ph-ctas { flex-direction: column; align-items: stretch; } }
  .ph-btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    background-color: #3a5dff; color: #ffffff; border: 1px solid #3a5dff;
    border-radius: 6px; padding: 14px 26px; font-size: 14px; font-weight: 500;
    font-family: "Poppins", sans-serif; line-height: 1; letter-spacing: 0.01em;
    min-height: 46px; box-shadow: 0 4px 12px rgba(58, 93, 255, 0.28);
    text-decoration: none; transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .ph-btn-primary:hover {
    background-color: #2548f0; border-color: #2548f0;
    box-shadow: 0 6px 18px rgba(58, 93, 255, 0.4); transform: translateY(-1px);
  }
  .ph-btn-secondary {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    background-color: rgba(255, 255, 255, 0.06); color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.75); backdrop-filter: blur(2px);
    border-radius: 6px; padding: 13px 24px; font-size: 15px; font-weight: 500;
    font-family: "Poppins", sans-serif; line-height: 1; min-height: 46px;
    text-decoration: none; transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .ph-btn-secondary svg { flex-shrink: 0; }
  .ph-btn-secondary:hover { background-color: #ffffff; color: #1C244B; border-color: #ffffff; }
</style>
