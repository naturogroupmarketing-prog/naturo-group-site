---
// /career/ — the job board index.
//
// Same JobBoard the per-city listings render, with no city selected: every
// area we advertise in sits in the results column and the role itself fills
// the pane. It used to be a marketing careers page with its own hero, cards
// and a long application form; candidates arriving from a job search were
// reading a different page from the one the ads point at, and applied through
// a different mechanism. Now there is one board and one application.
//
// The JobPosting here still declares the eight cities the business advertises
// nationally, which is wider than the two areas with their own listings.
import Layout from '../layouts/Layout.astro';
import JobBoard from '../components/JobBoard.astro';
import ApplyLeadGate from '../components/ApplyLeadGate.astro';
import { site } from '../data/site';
import { payRange, payLine, jobTitle, careerCities } from '../data/career';

const today = new Date();
const validThrough = new Date(today);
validThrough.setMonth(validThrough.getMonth() + 12);
const isoToday = today.toISOString().split('T')[0];
const isoValidThrough = validThrough.toISOString().split('T')[0];
const listedOn = today.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });

// "Port Macquarie NSW and Geelong VIC" — prose, for the schema description.
const areasProse = careerCities
  .map((c) => `${c.city} ${c.state}`)
  .reduce((acc, a, i, all) => (i === 0 ? a : i === all.length - 1 ? `${acc} and ${a}` : `${acc}, ${a}`), '');

const applyHref = `mailto:${site.email}?subject=${encodeURIComponent('Cleaning job application')}`;

const careerFaqs = [
  {
    q: 'Do I need previous cleaning experience?',
    a: 'Not necessarily. We hire on attitude and reliability first. If you take pride in detail, show up on time and treat clients with respect, our paid induction will teach you the rest.',
  },
  {
    q: 'Will I be an employee or a contractor?',
    a: 'An employee, always. We hire both permanent part-time and casual cleaners — tell us which suits you. Either way superannuation is paid, your training is paid and your travel between jobs is paid. We do not do ABN, contractor or gig arrangements.',
  },
  {
    q: 'How is pay calculated?',
    a: '$36.21 per hour including superannuation and vehicle allowance, with a range up to $45.00 depending on role and experience. Casual staff receive the casual loading. Travel between jobs is paid.',
  },
  {
    q: 'Do I need my own car?',
    a: 'Yes. You must have a reliable car and a current Australian driver\'s licence, because you drive between client homes every shift. Applications without a car cannot be considered.',
  },
  {
    q: 'How flexible are the hours?',
    a: 'Shifts run Monday to Friday between 8am and 4pm — no nights and no weekends. School-hours shifts (9am–3pm) are available. We ask for a minimum of two weekdays, and you choose permanent or casual.',
  },
  {
    q: 'Do I need a Police Check or NDIS Worker Screening Check?',
    a: 'Yes — both. Every cleaner completes a National Police Check and an NDIS Worker Screening Check, because the role includes NDIS and DVA client work. We help cover the cost and walk you through applying.',
  },
  {
    q: 'How long does the application process take?',
    a: 'From application to first shift typically takes 7–14 days. That includes a phone chat, in-person interview, reference checks, police check and a paid induction shift with one of our senior cleaners.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'JobPosting',
    title: jobTitle,
    description:
      `Join NATURO GROUP — Australia\u2019s eco-friendly residential and NDIS cleaning team. We are hiring reliable, detail-focused cleaners in ${areasProse}. ${payLine}, permanent and casual employee roles, no nights or weekends, all products and equipment supplied, paid training and a local Team Leader.`,
    datePosted: isoToday,
    validThrough: isoValidThrough,
    employmentType: ['FULL_TIME', 'PART_TIME'],
    hiringOrganization: {
      '@type': 'Organization',
      name: site.name,
      sameAs: site.url,
      logo: `${site.url}/images/logo.png`,
    },
    // One Place per area we actually advertise in, read from careerCities —
    // the same list the board renders, so the posting can never claim a city
    // without a listing behind it. It used to name eight cities while the
    // page showed two, which put the role in Google for Jobs results in
    // towns we do not roster (narrowed 2026-10-30 on Hubert's call).
    //
    // streetAddress is deliberately omitted: cleaners work in clients' homes,
    // there is no site address to give, and the Geelong base is a private
    // residence that must never be published.
    jobLocation: careerCities.map((l) => ({
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        addressLocality: l.city,
        addressRegion: l.state,
        postalCode: l.postcode,
        addressCountry: 'AU',
      },
    })),
    applicantLocationRequirements: { '@type': 'Country', name: 'Australia' },
    // The pop-up takes the application on this page, same as the listings.
    directApply: true,
    baseSalary: {
      '@type': 'MonetaryAmount',
      currency: 'AUD',
      value: {
        '@type': 'QuantitativeValue',
        minValue: payRange.min,
        maxValue: payRange.max,
        unitText: 'HOUR',
      },
    },
    industry: 'Residential & Disability Support Cleaning',
    qualifications:
      'A reliable car and current Australian driver’s licence; available at least two weekdays between 8am and 4pm; willing to complete a National Police Check and NDIS Worker Screening Check; working rights in Australia.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Careers', item: `${site.url}/career` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: careerFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="Cleaning Jobs in Australia — Join the NATURO GROUP Team"
  description="Cleaner jobs with NATURO GROUP. Permanent and casual employee roles, $36.21/hr incl. super, no nights or weekends, paid training. See every area we're hiring in and apply."
  schema={schema}
>
  <JobBoard
    listedOn={listedOn}
    applyHref={applyHref}
    faqs={careerFaqs}
    faqSubheading="What cleaners ask before joining the team."
  />

  <ApplyLeadGate />
</Layout>
