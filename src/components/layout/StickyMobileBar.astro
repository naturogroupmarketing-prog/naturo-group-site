---
import { ctaPrimary, site } from '../../data/site';
---

<div class="sticky-bar" role="region" aria-label="Quick actions" data-sticky-bar>
  <a class="sticky-btn sticky-btn--primary" href={ctaPrimary.href}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
    <span>Instant Price</span>
  </a>
  <a class="sticky-btn sticky-btn--secondary" href={site.phoneHref}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    <span>Call</span>
  </a>
</div>

<style>
  .sticky-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: none;
    gap: 0;
    background-color: #ffffff;
    border-top: 1px solid var(--c-border);
    padding: 8px 12px env(safe-area-inset-bottom, 8px);
    transform: translateY(0);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .sticky-bar[data-hidden="true"] {
    transform: translateY(110%);
  }
  @media (max-width: 768px) {
    .sticky-bar { display: flex; }
    body { padding-bottom: 76px; }
  }

  .sticky-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding-inline: 8px;
    border-radius: var(--r-pill);
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }
  /* iPhone SE-class viewports (≤360px) — shrink to keep both labels on one line. */
  @media (max-width: 360px) {
    .sticky-btn { font-size: 0.875rem; gap: 6px; }
  }
  .sticky-btn + .sticky-btn { margin-left: 8px; }

  .sticky-btn--primary {
    background-color: var(--c-cyan);
    color: var(--c-navy);
    border: 1px solid var(--c-cyan);
  }
  .sticky-btn--primary:active {
    background-color: var(--c-cyan-700);
  }
  .sticky-btn--secondary {
    background-color: transparent;
    color: var(--c-navy);
    border: 1px solid var(--c-navy);
  }
  .sticky-btn--secondary:active {
    background-color: var(--c-navy);
    color: #ffffff;
  }
</style>

<script>
  // Hide sticky bar when user scrolls up after passing 600px (less obtrusive).
  // Re-show on any scroll-down. Disabled at desktop widths via CSS.
  const bar = document.querySelector('[data-sticky-bar]') as HTMLElement | null;
  if (bar && window.matchMedia('(max-width: 768px)').matches) {
    let lastY = window.scrollY;
    let ticking = false;
    const onScroll = () => {
      const y = window.scrollY;
      const dy = y - lastY;
      if (y > 600 && dy < -8) {
        bar.dataset.hidden = 'true';
      } else if (dy > 8) {
        bar.dataset.hidden = 'false';
      }
      lastY = y;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });
  }
</script>
