---
import { site, ctaPrimary, ctaPhone } from '../data/site';

const slides = [
  '/images/hero-staff-bathroom.jpg',
  '/images/hero-kitchen.jpg',
  '/images/hero-ocean.jpg',
];
---

<section class="hero relative overflow-hidden">
  <div class="hero-slides absolute inset-0">
    {slides.map((src, i) => (
      <div
        class="hero-slide"
        style={`background-image: url(${src}); animation-delay: ${i * 5}s;`}
      />
    ))}
  </div>
  <div class="hero-overlay absolute inset-0"></div>

  <div class="relative container-site hero-inner flex items-center">
    <!-- w-full so the content stretches to fill the flex parent on
         narrow viewports — without it, this div sizes to its widest
         child (the H1), causing CTAs to render ~30px narrower than
         the matching CTAs in the other banner sections. The max-width
         still caps the column on desktop. -->
    <div class="w-full max-w-[800px]">
      <h1 class="hero-h1" style="color:#ffffff;">
        <span class="hero-h1-kicker">Eco-friendly</span>House Cleaning<br />in Australia
      </h1>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="hero-cta-stack">
        <a href={ctaPrimary.href} class="hero-btn-primary">
          <span>{ctaPrimary.text}</span>
          <span class="hero-btn-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>
        <a href={ctaPhone.href} class="hero-btn-secondary">
          <span>{ctaPhone.text}</span>
          <span class="hero-btn-icon" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
        </a>
      </div>
      <div class="hero-partners">
        <p class="hero-partners-label">Partners &amp; Providers</p>
        <img src="/images/partners-composite.png" alt="Partners and providers: NRMA, phsa, ipar, Allianz, QBE" class="hero-partners-img" width="300" height="156" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 0;
  }
  .hero-inner {
    /* Compact hero — between the too-short 72vh and full-screen. */
    height: clamp(600px, 84vh, 760px);
    padding-block: clamp(48px, 8vh, 96px);
  }
  /* On phones the sidebar header + sticky bottom bar already eat ~120px
     of viewport, so a 560px hero pushes the next section well below the
     fold. Cap to ~88dvh so the partner row peeks above the fold. */
  @media (max-width: 640px) {
    .hero-inner {
      height: min(680px, 88dvh);
      padding-block: 36px;
    }
  }
  .hero-h1 {
    /* Matched to NiCE's hero H1 (NiCE Gotham, 64px, medium, lh1.1, -1.5px).
       Gotham is a paid font; Montserrat is the closest free equivalent.
       NiCE's heading is medium weight (not bold) — Montserrat also renders
       a touch heavier than Gotham, so 500 best matches the visual. */
    font-family: "Montserrat", "Poppins", sans-serif;
    font-weight: 500;
    /* NiCE renders Gotham at 64px; Montserrat is visually larger at the
       same px, so 58px matches the apparent size. */
    font-size: clamp(32px, 5vw, 58px);
    line-height: 1.1;
    letter-spacing: -0.023em;
    margin: 0;
  }
  /* "Eco-friendly" is a small kicker above the headline so "House Cleaning
     in Australia" carries the visual weight. */
  .hero-h1-kicker {
    display: block;
    font-size: clamp(16px, 2vw, 24px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.005em;
    margin-bottom: 6px;
  }
  .hero-tagline {
    font-family: "Poppins", sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: clamp(15px, 1.6vw, 22px);
    line-height: 1.5;
    color: #FEB91C;
    margin-top: 16px;
    letter-spacing: 0.005em;
  }
  .hero-cta-stack {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  @media (max-width: 500px) {
    .hero-cta-stack { flex-wrap: nowrap; gap: 8px; }
  }
  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: linear-gradient(135deg, #4a6bff 0%, #2748f2 100%);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Poppins", "Helvetica", sans-serif;
    line-height: 1;
    letter-spacing: 0.01em;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(37, 72, 240, 0.32);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .hero-btn-primary:hover {
    box-shadow: 0 8px 22px rgba(37, 72, 240, 0.45);
    transform: translateY(-1px);
  }
  /* Primary (gradient) — circle is solid white (dark arrow) by default and
     becomes a white outline (white arrow) on hover. */
  .hero-btn-primary .hero-btn-icon {
    background-color: #ffffff;
    border-color: #ffffff;
    color: #1C244B;
  }
  .hero-btn-primary:hover .hero-btn-icon {
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.6);
    color: #ffffff;
  }
  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background-color: #ffffff;
    color: #1C244B;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-size: 15px;
    font-weight: 500;
    font-family: "Poppins", "Helvetica", sans-serif;
    line-height: 1;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  /* NiCE-style circular icon at the right of each hero button */
  .hero-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .hero-btn-icon svg { display: block; width: 14px; height: 14px; }
  /* Phone button (white) — blue outline circle that fills solid blue on hover */
  .hero-btn-secondary .hero-btn-icon {
    border-color: rgba(58, 93, 255, 0.5);
    color: #3a5dff;
  }
  .hero-btn-secondary:hover {
    background-color: #ffffff;
    color: #1C244B;
    border-color: transparent;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.22);
  }
  .hero-btn-secondary:hover .hero-btn-icon {
    background-color: #3a5dff;
    border-color: #3a5dff;
    color: #ffffff;
  }

  .hero-overlay {
    background-image: linear-gradient(90deg, rgb(58, 77, 97) 20%, rgba(5, 170, 232, 0) 81%);
    opacity: 0.91;
    pointer-events: none;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    animation: heroFade 15s infinite;
    will-change: opacity;
  }
  /* First slide is immediately visible — prevents the white-page flash
     on refresh before the animation's first frame kicks in. */
  .hero-slide:first-child { opacity: 1; }
  @keyframes heroFade {
    0%, 28% { opacity: 1; }
    33%, 95% { opacity: 0; }
    100% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide { animation: none; }
    .hero-slide:first-child { opacity: 1; }
  }

  .hero-partners {
    margin-top: 40px;
  }
  .hero-partners-label {
    font-family: "Poppins", sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #ffffff;
    margin: 0 0 14px;
  }
  .hero-partners-img {
    width: 280px;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
    opacity: 0.6;
  }
  @media (max-width: 640px) {
    /* Hide the Partners & Providers logo strip on mobile */
    .hero-partners { display: none; }
  }
  /* Phones: keep both CTAs side by side (shrink + nowrap so each label fits one line). */
  @media (max-width: 500px) {
    .hero-btn-primary, .hero-btn-secondary {
      padding-left: 12px;
      font-size: 12px;
      white-space: nowrap;
    }
    .hero-btn-icon { width: 28px; height: 28px; }
  }
</style>
