---
interface Props {
  color?: 'cyan' | 'navy' | 'white';
  class?: string;
}
const { color = 'cyan', class: className = '' } = Astro.props;
---
<span class:list={['eyebrow-label', `eyebrow-${color}`, className]}>
  <slot />
</span>

<style>
  .eyebrow-label {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }
  .eyebrow-cyan  { color: var(--c-cyan-700); }
  .eyebrow-navy  { color: var(--c-navy); }
  .eyebrow-white { color: rgba(255, 255, 255, 0.85); }
</style>
