---
import { chooseYourClean } from '../data/site';
---

<section class="pricing-section">
  <div class="pricing-head">
    <h2 class="pricing-h2">Choose your clean</h2>
    <p class="pricing-sub">
      Choose the service that fits, then get a fast, obligation-free price. Eco-friendly products, police-checked cleaners, flexible scheduling.
    </p>
  </div>

  <div class="pricing-grid">
    {chooseYourClean.map((card, i) => (
      <div class={`pricing-card ${card.featured ? 'is-featured' : ''}`}>
        {card.featured && <div class="pricing-badge">MOST POPULAR</div>}
        <div class="pricing-card-body">
          <div class="pricing-card-head">
            <div class="pricing-card-icon" aria-hidden="true">
              {i === 0 && (
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
                  <rect x="7" y="10" width="30" height="28" rx="3" stroke="currentColor" stroke-width="2"/>
                  <line x1="7" y1="18" x2="37" y2="18" stroke="currentColor" stroke-width="2"/>
                  <line x1="14" y1="6" x2="14" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="30" y1="6" x2="30" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <path d="M24 22l-5 8h4l-2 7 6-9h-4l1-6z" fill="#ff5f1f"/>
                </svg>
              )}
              {i === 1 && (
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
                  <rect x="10" y="22" width="28" height="18" rx="4" stroke="currentColor" stroke-width="2"/>
                  <path d="M18 22v-7a6 6 0 0 1 12 0v7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="17" y1="29" x2="31" y2="29" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="17" y1="34" x2="31" y2="34" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <circle cx="38" cy="10" r="3.5" fill="#ff5f1f"/>
                  <circle cx="43" cy="17" r="2.2" fill="#ff5f1f"/>
                  <circle cx="40" cy="5" r="1.8" fill="#ff5f1f"/>
                </svg>
              )}
              {i === 2 && (
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
                  <path d="M24 41C24 41 6 31 6 18.5C6 12.7 10.5 9 15 9c3.4 0 6.6 1.8 9 5 2.4-3.2 5.6-5 9-5 4.5 0 9 3.7 9 9.5C42 31 24 41 24 41z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  <path d="M18 23l4.5 4.5L31 18" stroke="#ff5f1f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </div>
            <h3 class="pricing-card-name">{card.name}</h3>
          </div>
          <p class="pricing-card-desc">{card.bullets[0]}</p>
          <div class="pricing-prompt-block">
            <p class="pricing-prompt-sub">Fast, free &amp; no obligation</p>
          </div>
          <ul class="pricing-features">
            {card.bullets.slice(1).map((b) => (
              <li>
                <svg class="pricing-tick" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="pricing-footer">
          <a href={card.cta.href} class={`pricing-btn ${card.featured ? 'is-primary' : ''}`}>
            <span>{card.cta.text}</span>
            <span class="pricing-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </a>
        </div>
      </div>
    ))}
  </div>

  <div class="pricing-trust">
    <div class="pricing-trust-item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Police-checked cleaners
    </div>
    <div class="pricing-trust-item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      60-second online booking
    </div>
    <div class="pricing-trust-item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      Satisfaction guarantee
    </div>
    <div class="pricing-trust-item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 11V7a5 5 0 0 1 10 0v4"/><rect x="3" y="11" width="18" height="11" rx="2"/></svg>
      Fully insured
    </div>
  </div>
</section>

<style>
  .pricing-section {
    background-color: #ffffff;
    padding: clamp(88px, 10vw, 128px) 20px;
  }
  .pricing-head {
    max-width: 720px;
    margin: 0 auto clamp(40px, 5vw, 64px);
    text-align: center;
  }
  .pricing-h2 {
    /* Matched to NiCE's section heading ("The enterprise AI platform…"):
       NiCE font 36px/700/-0.5px. Gotham/NiCE are paid fonts; Montserrat is
       the free stand-in and renders a touch larger, so ~34px matches the
       apparent size. */
    font-family: "Montserrat", "Poppins", sans-serif;
    font-size: clamp(29px, 3.8vw, 38px);
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: -0.014em;
    color: #0f172a;
    margin: 0 0 16px;
  }
  .pricing-sub {
    font-family: "Poppins", sans-serif;
    font-size: clamp(16px, 1.4vw, 18px);
    font-weight: 400;
    line-height: 1.6;
    color: rgb(51, 65, 85);
    margin: 0;
  }
  .pricing-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 20px;
    max-width: 1120px;
    margin: 0 auto;
  }
  .pricing-card {
    position: relative;
    cursor: pointer;
    width: 353px;
    max-width: 100%;
    min-height: 550px;
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.15);
    border-radius: 24px;
    padding: 40px 32px 32px;
    display: flex;
    flex-direction: column;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 4px 16px rgba(15, 23, 42, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .pricing-card:hover {
    transform: translateY(-3px);
    background-color: #3a5dff;
    border-color: #3a5dff;
    box-shadow:
      0 2px 4px rgba(15, 23, 42, 0.06),
      0 18px 36px rgba(58, 93, 255, 0.32);
  }
  .pricing-card:hover .pricing-card-name,
  .pricing-card:hover .pricing-card-desc,
  .pricing-card:hover .pricing-prompt,
  .pricing-card:hover .pricing-prompt-sub,
  .pricing-card:hover .pricing-features li {
    color: #ffffff;
  }
  .pricing-card:hover .pricing-tick {
    color: #ffffff;
  }
  .pricing-card:hover .pricing-btn {
    background: #ffffff;
    border-color: #ffffff;
    color: #3a5dff;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.18);
  }
  .pricing-card:hover .pricing-btn:hover {
    background: #f1f4ff;
    border-color: #f1f4ff;
    color: #2548f0;
  }
  /* On card-hover the card turns blue and the gradient button turns white,
     so its circle icon becomes a blue outline + blue arrow to stay visible. */
  .pricing-card:hover .pricing-btn .pricing-btn-icon {
    background-color: transparent;
    border-color: rgba(58, 93, 255, 0.5);
    color: #3a5dff;
  }
  .pricing-card:hover .pricing-badge {
    background-color: #ffffff;
    color: #3a5dff;
  }
  .pricing-card:hover .pricing-badge::after {
    background-color: #ffffff;
  }

  /* All panels start deselected (no blue "selected" panel by default).
     Selection happens only on hover — see `.pricing-card:hover` above. */
  .pricing-card.is-featured {
    border: 1.5px solid rgba(58, 93, 255, 0.5);
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 10px 28px rgba(58, 93, 255, 0.14);
  }
  .pricing-card.is-featured:hover {
    border-color: #3a5dff;
    box-shadow:
      0 2px 4px rgba(15, 23, 42, 0.06),
      0 18px 36px rgba(58, 93, 255, 0.32);
  }
  /* Speech-bubble badge (EOFY-style): pale-blue bubble pinned to the
     top-right corner with a small tail pointing down. */
  .pricing-badge {
    position: absolute;
    top: -16px;
    right: 18px;
    background-color: #cfe8fc;
    color: #1C244B;
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    padding: 9px 16px;
    border: none;
    border-radius: 14px;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 6px 14px rgba(15, 23, 42, 0.12);
  }
  /* Down-pointing tail at the bottom-right of the bubble. */
  .pricing-badge::after {
    content: "";
    position: absolute;
    bottom: -7px;
    right: 20px;
    width: 16px;
    height: 9px;
    background-color: #cfe8fc;
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }
  .pricing-card-body {
    flex: 1;
  }
  .pricing-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .pricing-card-icon {
    color: #3a5dff;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    transition: color 0.25s ease;
  }
  .pricing-card:hover .pricing-card-icon { color: #ffffff; }
  .pricing-card-name {
    font-family: "Poppins", sans-serif;
    font-size: 26px;
    font-weight: 500;
    line-height: 1.2;
    color: #000000;
    margin: 0;
  }
  .pricing-card-desc {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.55;
    color: rgb(100, 116, 139);
    margin: 0 0 28px;
    min-height: 70px;
  }
  .pricing-prompt-block {
    margin: 0 0 28px;
    text-align: center;
  }
  .pricing-prompt {
    font-family: "Poppins", sans-serif;
    font-size: 21px;
    font-weight: 600;
    color: #3a5dff;
    line-height: 1.25;
    margin: 0 0 5px;
    transition: color 0.25s ease;
  }
  .pricing-prompt-sub {
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: rgb(100, 116, 139);
    margin: 0;
    transition: color 0.25s ease;
  }
  .pricing-features {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pricing-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.5;
    color: #000000;
    text-align: left;
  }
  .pricing-tick {
    color: #3a5dff;
    flex-shrink: 0;
    margin-top: 3px;
  }
  .pricing-footer {
    margin-top: auto;
    display: flex;
    justify-content: center;
  }
  /* Match the hero primary button exactly so every pricing card CTA reads
     as the same brand button. The featured card is already differentiated
     by its "MOST POPULAR" badge and elevated shadow. */
  .pricing-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: linear-gradient(135deg, #4a6bff 0%, #2748f2 100%);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-family: "Poppins", "Helvetica", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(37, 72, 240, 0.32);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  /* Stretched link — makes the whole pricing card clickable (to /quote). */
  .pricing-btn::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .pricing-btn:hover {
    box-shadow: 0 8px 22px rgba(37, 72, 240, 0.45);
    transform: translateY(-1px);
  }
  .pricing-btn .pricing-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background-color: #ffffff;
    border: 1px solid #ffffff;
    color: #1C244B;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .pricing-btn .pricing-btn-icon svg {
    display: block;
    width: 14px;
    height: 14px;
  }
  .pricing-btn:hover .pricing-btn-icon {
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.6);
    color: #ffffff;
  }
  /* .is-primary kept for backward compat — same look as base. */
  .pricing-btn.is-primary {
    background-color: #3a5dff;
    border-color: #3a5dff;
    color: #ffffff;
  }

  .pricing-trust {
    max-width: 1100px;
    margin: 56px auto 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 32px;
  }
  .pricing-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: rgb(100, 116, 139);
  }
  .pricing-trust-item svg {
    color: rgb(148, 163, 184);
  }

  @media (max-width: 768px) {
    .pricing-section { padding: clamp(40px, 8vw, 88px) 0; }
    .pricing-head { padding: 0 20px; }
    .pricing-grid {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      max-width: 100%;
      margin: 0;
      /* left padding creates the inset; right padding lets last card clear edge */
      padding: 20px 40px 40px 20px;
      gap: 16px;
      scroll-padding-left: 20px;
    }
    .pricing-grid::-webkit-scrollbar { display: none; }
    .pricing-card {
      flex-shrink: 0;
      /* 100vw minus left-padding(20) minus peek(40) = clean one-at-a-time feel */
      width: calc(100vw - 60px);
      max-width: 353px;
      scroll-snap-align: start;
    }
    .pricing-trust { padding: 0 20px; }
  }
</style>
