---
import Layout from '../layouts/Layout.astro';
import { ctaPhone, site } from '../data/site';
---

<Layout
  title="Thanks \u2014 we've got your enquiry"
  description="Thanks for your booking enquiry. Our coordinator will be in touch within the hour during business hours to lock in your clean."
  noindex
>
  <section class="bg-[var(--color-bg-pale)] pt-16">
    <div class="container-site max-w-2xl text-center">
      <div class="mx-auto mb-6 w-16 h-16 rounded-full bg-[var(--color-cyan)]/15 text-[var(--color-cyan)] flex items-center justify-center">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12.5l4.5 4.5L19 7" />
        </svg>
      </div>
      <p class="eyebrow mb-3">Got it</p>
      <h1 class="text-4xl md:text-5xl text-[var(--color-navy)] font-light leading-tight">
        Thanks \u2014 your enquiry is in.
      </h1>
      <p class="mt-5 text-lg text-[var(--color-slate)]">
        Our coordinator will reach out within the hour during business hours to confirm your
        postcode, lock in your time and finalise the price.
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a class="btn-primary" href={ctaPhone.href}>Call {ctaPhone.text}</a>
        <a class="btn-secondary" href="/">Back to home</a>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site max-w-3xl grid md:grid-cols-3 gap-6">
      <div class="rounded-2xl border border-[var(--color-border)] p-6">
        <p class="text-sm font-semibold text-[var(--color-accent-blue)] uppercase tracking-wider mb-2">Step 1</p>
        <h2 class="text-lg font-semibold text-[var(--color-navy)] mb-2">We confirm your area</h2>
        <p class="text-[var(--color-slate)] text-sm">
          We double-check we service your postcode and any special access requirements.
        </p>
      </div>
      <div class="rounded-2xl border border-[var(--color-border)] p-6">
        <p class="text-sm font-semibold text-[var(--color-accent-blue)] uppercase tracking-wider mb-2">Step 2</p>
        <h2 class="text-lg font-semibold text-[var(--color-navy)] mb-2">We lock in the price</h2>
        <p class="text-[var(--color-slate)] text-sm">
          A short call (or SMS, if you prefer) to confirm the final price and any extras.
        </p>
      </div>
      <div class="rounded-2xl border border-[var(--color-border)] p-6">
        <p class="text-sm font-semibold text-[var(--color-accent-blue)] uppercase tracking-wider mb-2">Step 3</p>
        <h2 class="text-lg font-semibold text-[var(--color-navy)] mb-2">Your team is booked</h2>
        <p class="text-[var(--color-slate)] text-sm">
          You\u2019ll receive an email and SMS with the cleaners assigned to your home.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-bg-pale)]">
    <div class="container-site max-w-2xl text-center">
      <h2 class="text-2xl text-[var(--color-navy)] font-light mb-4">
        Need to talk now?
      </h2>
      <p class="text-[var(--color-slate)] mb-6">
        Call <a class="underline" href={ctaPhone.href}>{ctaPhone.text}</a> or email
        <a class="underline" href={site.emailHref}>{site.email}</a> &mdash; we usually reply
        within the hour during business hours.
      </p>
    </div>
  </section>

  <!-- Server-side conversion ping for Google Tag Manager / GA4 / Meta if
       installed. The lead-gate already fired the lead event; this fires
       a more specific 'quote_submitted' event on the dedicated thank-you
       page so you can build accurate conversion audiences. -->
  <script is:inline>
    (function () {
      try {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'quote_submitted',
          page: { url: window.location.href, title: document.title },
        });
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'SubmitApplication');
        }
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'quote_submitted', {
            event_category: 'lead',
            event_label: 'quote_form',
          });
        }
      } catch (e) { /* analytics is best-effort */ }
    })();
  </script>
</Layout>
