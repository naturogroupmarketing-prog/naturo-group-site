---
import { ctaPrimary, ctaPhone, site } from '../data/site';
---

<section class="experience-banner">
  <img class="experience-bg-img" src="/images/experience-staff.jpg" alt="Naturo Group cleaning staff" loading="lazy" />
  <div class="experience-overlay"></div>
  <div class="container-site relative experience-inner">
    <div class="experience-content">
      <h2 class="experience-h1">Experience<br />and Reliable</h2>
      <p class="experience-sub">View pricing and book online.</p>
      <div class="experience-ctas">
        <a href={ctaPrimary.href} class="experience-btn-primary">
          <span>{ctaPrimary.text}</span>
          <span class="experience-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </a>
        <a href={site.phoneHref} class="experience-btn-secondary">
          <span>{ctaPhone.text}</span>
          <span class="experience-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .experience-banner {
    position: relative;
    min-height: clamp(520px, 70vh, 720px);
    margin-inline: clamp(12px, 2.5vw, 32px);
    background-color: rgb(58, 77, 97);
    display: flex;
    align-items: center;
    overflow: hidden;
    border-radius: clamp(24px, 2.5vw, 40px);
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.12);
  }
  .experience-bg-img {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: 70% center;
    z-index: 0;
  }
  .experience-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, rgb(58, 77, 97) 20%, rgba(58, 77, 97, 0) 88%);
    opacity: 0.91;
    pointer-events: none;
    z-index: 1;
  }
  .experience-inner {
    z-index: 2;
    width: 100%;
    /* IMPORTANT: padding-block only — `padding: ... 0` would reset
       padding-inline and clobber `.container-site`'s horizontal
       padding, making the headline hug the viewport edge on mobile. */
    padding-block: clamp(80px, 9vw, 112px);
  }
  /* Mobile/tablet: keep the original horizontal grey gradient and 55%
     photo treatment from desktop. Only adjust min-height + padding-block
     for narrower viewports. (The padding-block override is critical:
     `padding: ... 0` would clobber `.container-site`'s padding-inline.) */
  @media (max-width: 860px) {
    .experience-banner {
      min-height: 520px;
    }
    .experience-inner {
      padding-block: clamp(56px, 9vw, 96px);
    }
    /* On the narrow mobile crop, centre the staff (she sits mid-image) so she
       lands in the clear right of the banner instead of being pushed left,
       behind the text, with the bright window filling the visible strip. */
    .experience-bg-img { object-position: 50% center; }
  }
  .experience-content {
    max-width: 605px;
    color: #fff;
  }
  .experience-h1 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #ffffff;
    margin: 0 0 24px;
  }
  .experience-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
  }
  .experience-bullets li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 0;
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-weight: 300;
    line-height: 21.6px;
    color: #ffffff;
  }
  .experience-sub {
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-weight: 300;
    line-height: 23.4px;
    color: #ffffff;
    margin: 0 0 20px;
  }
  .experience-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  /* Match the hero CTA stack: at very narrow viewports, switch to a
     full-width vertical stack so each button is comfortably tappable. */
  @media (max-width: 500px) {
    .experience-ctas { flex-direction: column; align-items: stretch; }
  }
  .experience-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: linear-gradient(135deg, #4a6bff 0%, #2748f2 100%);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Poppins", sans-serif;
    line-height: 1;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(37, 72, 240, 0.32);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .experience-btn-primary:hover {
    box-shadow: 0 8px 22px rgba(37, 72, 240, 0.45);
    transform: translateY(-1px);
  }
  .experience-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: #ffffff;
    color: #1C244B;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-size: 15px;
    font-weight: 500;
    font-family: "Poppins", sans-serif;
    line-height: 1;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
    transition: background-color 0.2s, color 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .experience-btn-secondary:hover {
    background: #ffffff;
    color: #1C244B;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.22);
  }
  .experience-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .experience-btn-icon svg {
    display: block;
    width: 14px;
    height: 14px;
  }
  .experience-btn-primary .experience-btn-icon {
    background-color: #ffffff;
    border-color: #ffffff;
    color: #1C244B;
  }
  .experience-btn-primary:hover .experience-btn-icon {
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.6);
    color: #ffffff;
  }
  .experience-btn-secondary .experience-btn-icon {
    border-color: rgba(58, 93, 255, 0.5);
    color: #3a5dff;
  }
  .experience-btn-secondary:hover .experience-btn-icon {
    background-color: #3a5dff;
    border-color: #3a5dff;
    color: #ffffff;
  }
</style>

