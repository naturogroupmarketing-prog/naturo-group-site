---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import IntroCopy from '../../components/IntroCopy.astro';
import PricingCards from '../../components/PricingCards.astro';
import Features from '../../components/Features.astro';
import IncludesChecklist from '../../components/IncludesChecklist.astro';
import Providers from '../../components/Providers.astro';
import Testimonials from '../../components/Testimonials.astro';
import FAQ from '../../components/FAQ.astro';
import AppPromo from '../../components/AppPromo.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { site, services, faqs } from '../../data/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Cleaning Services',
    url: `${site.url}/services`,
    description:
      'Compare every Naturo Group cleaning service — regular house cleaning, deep clean, and end-of-lease bond clean. Eco-friendly products, police-checked cleaners, transparent pricing.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${site.url}/services/${s.slug}`,
      name: s.title,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="Cleaning Services — House, Deep & Bond"
  description="Compare house cleaning, deep cleans and end-of-lease bond cleans. Eco-friendly, police-checked, fully insured. Book online in 60 seconds."
  schema={schema}
>
  <!-- 1. Hero -->
  <ServiceHero
    eyebrow="Our services"
    heading="Cleaning Services<br />Tailored to your home"
  />

  <!-- 2. Intro (about Naturo) -->
  <IntroCopy />

  <!-- 3. Pricing — the main "what we do" view on the index page -->
  <PricingCards />

  <!-- 4. What can be included -->
  <IncludesChecklist />

  <!-- 5. Why choose Naturo -->
  <Features />

  <!-- 6. Trusted-by logos -->
  <Providers />

  <!-- 7. Social proof -->
  <Testimonials />

  <!-- 7b. Comparison — someone on the services index is choosing, and the
       question behind "which service" is often "which company". -->
  <section class="svc-compare">
    <div class="container-site svc-compare-inner">
      <h2 class="svc-compare-h2">Weighing us up against someone else?</h2>
      <p class="svc-compare-p">
        We put NATURO beside Jim&rsquo;s Cleaning, Absolute Domestics, Houseproud, Maid2Match and
        Airtasker &mdash; who employs the cleaner, which checks they hold, who supplies the products,
        what you pay and who you pay it to. Every line is sourced from their own websites, including
        the lines where we come off worse.
      </p>
      <a href="/compare-cleaning-services/" class="svc-compare-link">See the comparison &rarr;</a>
    </div>
  </section>

  <!-- 8. FAQ -->
  <FAQ />

  <!-- 9. App promo -->
  <AppPromo />

  <!-- 10. Final CTA banner -->
  <FinalCTA />
</Layout>

<style>
  .svc-compare { background: #ffffff; }
  .svc-compare-inner { max-width: 760px; text-align: center; }
  .svc-compare-h2 {
    font-family: 'Poppins', sans-serif; font-size: clamp(24px, 3vw, 34px);
    font-weight: 300; line-height: 1.15; letter-spacing: -0.015em;
    color: #0f172a; margin: 0 0 14px;
  }
  .svc-compare-p {
    font-family: 'Poppins', sans-serif; font-size: 16px; font-weight: 300;
    line-height: 1.7; color: rgb(71, 85, 105); margin: 0 0 18px;
  }
  .svc-compare-link {
    font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 500;
    color: #3a5dff; text-decoration: none;
  }
  .svc-compare-link:hover { text-decoration: underline; }
</style>
