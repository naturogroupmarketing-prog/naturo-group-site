---
import { ctaPrimary, ctaPhone, site } from '../data/site';
interface Props { location?: string }
const { location = 'Australia' } = Astro.props;
---

<section class="bookcta-section">
  <div class="bookcta-overlay"></div>
  <div class="container-site relative bookcta-inner">
    <div class="bookcta-content">
      <h2 class="bookcta-h2">Book a House Cleaner in {location}</h2>
      <p class="bookcta-sub">View pricing and book online.</p>
      <div class="bookcta-ctas">
        <a href={ctaPrimary.href} class="bookcta-btn-primary">{ctaPrimary.text}</a>
        <a href={site.phoneHref} class="bookcta-btn-secondary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {ctaPhone.text}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .bookcta-section {
    position: relative;
    min-height: clamp(520px, 70vh, 720px);
    background-image: url("/images/book-cta.jpg");
    background-position: center center;
    background-size: cover;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    overflow: hidden;
    /* padding-block only: the inner element uses `.container-site` which
       owns padding-inline. Using shorthand `padding: X 0` here would be
       harmless (different element), but using padding-block is clearer
       and matches the other banner sections. */
    padding-block: clamp(80px, 9vw, 112px);
  }
  .bookcta-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, rgb(151, 151, 151) 45%, rgba(151, 151, 151, 0) 65%);
    opacity: 0.98;
    pointer-events: none;
  }
  .bookcta-inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  /* Mobile/tablet: keep the original horizontal grey gradient. Only
     adjust min-height + padding-block. */
  @media (max-width: 860px) {
    .bookcta-section { min-height: 480px; padding-block: clamp(56px, 9vw, 96px); }
  }
  .bookcta-content {
    max-width: 605px;
    color: #ffffff;
    text-align: left;
  }
  .bookcta-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #ffffff;
    margin: 0 0 16px;
  }
  @media (max-width: 768px) {
    .bookcta-h2 { font-size: 32px; line-height: 1.2; }
  }
  .bookcta-sub {
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-weight: 300;
    color: #ffffff;
    margin: 0 0 28px;
  }
  .bookcta-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  @media (max-width: 500px) {
    .bookcta-ctas { flex-direction: column; align-items: stretch; }
  }
  .bookcta-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #3a5dff;
    color: #ffffff;
    border: 1px solid #3a5dff;
    border-radius: 6px;
    padding: 14px 26px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Poppins", sans-serif;
    letter-spacing: 0.01em;
    line-height: 1;
    min-height: 46px;
    box-shadow: 0 4px 12px rgba(58, 93, 255, 0.28);
    transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .bookcta-btn-primary:hover {
    background-color: #2548f0;
    border-color: #2548f0;
    box-shadow: 0 6px 18px rgba(58, 93, 255, 0.4);
    transform: translateY(-1px);
  }
  .bookcta-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(2px);
    border-radius: 6px;
    padding: 13px 24px;
    font-size: 15px;
    font-weight: 500;
    font-family: "Poppins", sans-serif;
    line-height: 1;
    min-height: 46px;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .bookcta-btn-secondary:hover {
    background-color: #ffffff;
    color: #1C244B;
    border-color: #ffffff;
  }
</style>
