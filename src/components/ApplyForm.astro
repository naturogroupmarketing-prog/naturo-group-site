---
// The job application form.
//
// Shared by the national /career/ page and every per-city
// /cleaning-jobs-<city>/ listing, so the fields, the CRM delivery path and the
// success state cannot drift apart. Previously only /career/ carried it and
// the city pages linked across to it; applicants now apply on the page they
// landed on, the way Seek and Indeed do.
//
// The CRM payload is unchanged — `service: 'Job application'` and
// `lead_type: 'job_application'` are what the Inbox filters on. Only
// form_location and the new job_city vary by page, and both are read from
// data- attributes because an Astro <script> cannot see frontmatter.
import { site } from '../data/site';

interface Props {
  heading?: string;
  /** Lands in the CRM as form_location, so applications can be traced to a page. */
  formLocation?: string;
  /** City whose listing this is, for the Inbox. Empty on the national page. */
  jobCity?: string;
}

const {
  heading = 'Two minutes. We’ll call you within 48 hours.',
  formLocation = 'career-application',
  jobCity = '',
} = Astro.props;

const availabilityOptions = [
  'Mondays', 'Tuesdays', 'Wednesdays', 'Thursdays', 'Fridays', 'Saturdays',
];

const states = ['NSW', 'QLD', 'VIC', 'Other'];
---

  <section class="cr-apply-section" id="apply" aria-labelledby="cr-apply-h2">
    <div class="container-site cr-apply-inner">
      <div class="cr-apply-head">
        <h2 id="cr-apply-h2" class="cr-apply-h2">{heading}</h2>
        <p class="cr-apply-sub">
          Prefer to chat first? Call us on <a href={site.phoneHref} class="cr-apply-link">{site.phone}</a>
          or email <a href={`mailto:${site.email}?subject=Career application`} class="cr-apply-link">{site.email}</a>.
        </p>
      </div>

      {/* action= is the no-JS fallback only. With JS the submit is intercepted
          below and delivered to the CRM the same way the quote form is, so an
          application lands in the Inbox instead of depending on the applicant
          having a configured mail client. */}
      <form
        class="cr-form"
        id="cr-apply-form"
        action={`mailto:${site.email}`}
        method="post"
        enctype="text/plain"
        aria-describedby="cr-form-note"
        data-form-location={formLocation}
        data-job-city={jobCity}
        novalidate
      >
        <label class="cr-trap" aria-hidden="true">Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        <div class="cr-form-grid">
          <label class="cr-field">
            <span class="cr-field-label">Full name<span aria-hidden="true">*</span></span>
            <input class="cr-input" type="text" name="full_name" autocomplete="name" required />
          </label>

          <label class="cr-field">
            <span class="cr-field-label">Email<span aria-hidden="true">*</span></span>
            <input class="cr-input" type="email" name="email" autocomplete="email" required />
          </label>

          <label class="cr-field">
            <span class="cr-field-label">Mobile<span aria-hidden="true">*</span></span>
            <input class="cr-input" type="tel" name="mobile" autocomplete="tel" inputmode="tel" required />
          </label>

          <label class="cr-field">
            <span class="cr-field-label">Suburb &amp; postcode<span aria-hidden="true">*</span></span>
            <input class="cr-input" type="text" name="suburb_postcode" placeholder="e.g. Bondi 2026" required />
          </label>

          <label class="cr-field">
            <span class="cr-field-label">State<span aria-hidden="true">*</span></span>
            <select class="cr-input" name="state" required>
              <option value="" disabled selected>Choose a state</option>
              {states.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>

          <label class="cr-field">
            <span class="cr-field-label">Cleaning experience</span>
            <select class="cr-input" name="experience">
              <option value="">Choose one</option>
              <option value="none">None — happy to learn</option>
              <option value="under-1">Less than 1 year</option>
              <option value="1-3">1–3 years</option>
              <option value="3-plus">3+ years</option>
            </select>
          </label>
        </div>

        <fieldset class="cr-fieldset">
          <legend class="cr-field-label">Do you have a driver&rsquo;s licence and car?</legend>
          <div class="cr-radio-row">
            <label class="cr-radio">
              <input type="radio" name="transport" value="car_and_licence" required />
              <span>Yes — car and licence</span>
            </label>
            <label class="cr-radio">
              <input type="radio" name="transport" value="licence_only" />
              <span>Licence, no car</span>
            </label>
            <label class="cr-radio">
              <input type="radio" name="transport" value="public_transport" />
              <span>Public transport only</span>
            </label>
          </div>
        </fieldset>

        <fieldset class="cr-fieldset">
          <legend class="cr-field-label">Availability — tick all that apply</legend>
          <div class="cr-check-grid">
            {availabilityOptions.map((d) => (
              <label class="cr-check">
                <input type="checkbox" name="availability" value={d} />
                <span>{d}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="cr-field">
          <span class="cr-field-label">Anything else we should know?</span>
          <textarea class="cr-input cr-textarea" name="message" rows="4" placeholder="Permanent or casual? Your suburb, which weekdays you can work, Police Check / NDIS Worker Screening status, when you can start…"></textarea>
        </label>

        <p id="cr-form-note" class="cr-form-note">
          We&rsquo;ll review every application and your local coordinator will call within 48 hours.
        </p>
        <p class="cr-form-status" id="cr-form-status" role="status" aria-live="polite" hidden></p>

        <button type="submit" class="cr-submit"><span>Send my application</span><span class="cr-submit-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span></button>
      </form>

      <div class="cr-apply-done" id="cr-apply-done" hidden tabindex="-1">
        <h3 class="cr-apply-done-h3">Application received.</h3>
        <p class="cr-apply-done-p">
          Thanks &mdash; it&rsquo;s with your local coordinator now. Expect a call within 48 hours.
          If you don&rsquo;t hear from us, ring <a href={site.phoneHref} class="cr-apply-link">{site.phone}</a>.
        </p>
      </div>
    </div>
  </section>

<script>
  // Deliver the application to the CRM via the shared lead helper. Falls back
  // to the form's own mailto action if the helper is missing.
  (function () {
    var form = document.getElementById('cr-apply-form');
    var status = document.getElementById('cr-form-status');
    var done = document.getElementById('cr-apply-done');
    if (!form || !status || !done) return;

    function uuid() {
      if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
        var r = (Math.random() * 16) | 0;
        return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
      });
    }
    function val(name) {
      var el = form.elements[name];
      if (!el) return '';
      if (el.length && el[0] && el[0].type === 'radio') {
        for (var i = 0; i < el.length; i++) if (el[i].checked) return el[i].value;
        return '';
      }
      return String(el.value || '').trim();
    }
    function checked(name) {
      var out = [];
      var els = form.querySelectorAll('input[name="' + name + '"]:checked');
      for (var i = 0; i < els.length; i++) out.push(els[i].value);
      return out;
    }
    function showStatus(text, isError) {
      status.textContent = text;
      status.hidden = false;
      status.classList.toggle('is-error', !!isError);
    }

    var submitting = false;
    form.addEventListener('submit', function (ev) {
      if (!window.naturoLeads || typeof window.naturoLeads.deliver !== 'function') return; // no-JS path: mailto
      ev.preventDefault();
      if (submitting) return;

      // Native validation, since the form is novalidate for the JS path.
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submitting = true;
      var btn = form.querySelector('.cr-submit');
      if (btn) btn.disabled = true;
      showStatus('Sending your application…', false);

      var payload = {
        name: val('full_name'),
        email: val('email'),
        phone: val('mobile'),
        message: val('message'),
        // Labelled into the Inbox message by the CRM's intake.
        suburb_postcode: val('suburb_postcode'),
        state: val('state'),
        experience: val('experience'),
        transport: val('transport'),
        availability: checked('availability'),
        // Subject becomes "Website enquiry — Job application", so it is never
        // mistaken for a cleaning quote in the Inbox.
        service: 'Job application',
        lead_type: 'job_application',
        form_location: form.dataset.formLocation || 'career-application',
        job_city: form.dataset.jobCity || '',
        lead_id: uuid(),
        page: window.location.pathname,
      };

      window.naturoLeads.deliver(payload).then(function (r) {
        if (r && r.delivered) {
          form.hidden = true;
          done.hidden = false;
          done.focus();
          try {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'generate_lead', { currency: 'AUD', value: 0, transaction_id: payload.lead_id, lead_type: 'job_application' });
            }
          } catch (e) {}
        } else {
          submitting = false;
          if (btn) btn.disabled = false;
          showStatus(window.naturoLeads.failureMessage(), true);
        }
      }).catch(function () {
        submitting = false;
        if (btn) btn.disabled = false;
        showStatus(window.naturoLeads.failureMessage(), true);
      });
    });
  })();
</script>

<style>
  /* ---------- Apply form ---------- */
  .cr-apply-section {
    background: linear-gradient(150deg, #e8eeff 0%, #f0f4ff 60%, #edf2ff 100%);
    padding: clamp(88px, 10vw, 128px) 0 clamp(96px, 12vw, 144px);
    scroll-margin-top: 100px;
  }
  .cr-apply-inner {
    max-width: 880px;
  }
  .cr-apply-head {
    margin: 0 0 clamp(32px, 4vw, 48px);
  }
  .cr-apply-eyebrow {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #3a5dff;
    margin: 0 0 14px;
  }
  .cr-apply-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #0f172a;
    margin: 0 0 16px;
  }
  .cr-apply-sub {
    font-family: "Poppins", sans-serif;
    font-size: clamp(15px, 1.2vw, 17px);
    font-weight: 300;
    line-height: 1.7;
    color: rgb(71, 85, 105);
    margin: 0;
  }
  .cr-apply-link {
    color: #3a5dff;
    text-decoration: none;
    font-weight: 500;
  }
  .cr-apply-link:hover { text-decoration: underline; }

  .cr-form {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: clamp(28px, 4vw, 40px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .cr-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  @media (max-width: 640px) {
    .cr-form-grid { grid-template-columns: 1fr; }
    .cr-submit { align-self: stretch; width: 100%; }
  }
  .cr-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cr-field-label {
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #0f172a;
    letter-spacing: 0.01em;
  }
  .cr-field-label span[aria-hidden="true"] {
    color: #3a5dff;
    margin-left: 2px;
  }
  .cr-input {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: #0f172a;
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 12px 14px;
    line-height: 1.4;
    width: 100%;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .cr-input:focus {
    outline: none;
    border-color: #3a5dff;
    box-shadow: 0 0 0 3px rgba(58, 93, 255, 0.2);
  }
  .cr-textarea {
    resize: vertical;
    min-height: 110px;
    font-family: "Poppins", sans-serif;
  }
  .cr-fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cr-radio-row,
  .cr-check-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cr-check-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  @media (max-width: 640px) {
    .cr-check-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .cr-radio,
  .cr-check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #0f172a;
    background-color: #EFEEE9;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 8px;
    padding: 10px 14px;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .cr-radio:hover,
  .cr-check:hover {
    border-color: #3a5dff;
  }
  .cr-radio input,
  .cr-check input {
    accent-color: #3a5dff;
  }
  .cr-form-note {
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgb(100, 116, 139);
    margin: 0;
    line-height: 1.55;
  }
  .cr-submit {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: linear-gradient(135deg, #4a6bff 0%, #2748f2 100%);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(37, 72, 240, 0.32);
    cursor: pointer;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .cr-submit:hover {
    box-shadow: 0 8px 22px rgba(37, 72, 240, 0.45);
    transform: translateY(-1px);
  }
  .cr-submit .cr-submit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background-color: #ffffff;
    border: 1px solid #ffffff;
    color: #1C244B;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .cr-submit .cr-submit-icon svg {
    display: block;
    width: 14px;
    height: 14px;
  }
  .cr-submit:hover .cr-submit-icon {
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.6);
    color: #ffffff;
  }

  /* ---- 5b. Hiring locally ---- */
  .cr-local-section { background: #ffffff; padding: clamp(64px, 8vw, 96px) 0; border-top: 1px solid rgba(15,23,42,0.06); }
  .cr-local-inner { max-width: 1160px; }
  .cr-local-h2 { font-family: 'Poppins', sans-serif; font-size: clamp(28px, 3.6vw, 42px); font-weight: 300; line-height: 1.15; letter-spacing: -0.015em; color: #0f172a; margin: 0 0 10px; text-align: center; }
  .cr-local-lede { font-family: 'Poppins', sans-serif; font-size: 17px; font-weight: 300; line-height: 1.6; color: rgb(71,85,105); margin: 0 auto 36px; max-width: 640px; text-align: center; }
  .cr-local-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; max-width: 760px; margin: 0 auto; }
  .cr-local-card { display: flex; flex-direction: column; gap: 4px; padding: 26px 26px 22px; background: #fff; border: 1px solid rgba(15,23,42,0.08); border-radius: 14px; text-decoration: none; box-shadow: 0 1px 2px rgba(15,23,42,0.04), 0 4px 16px rgba(15,23,42,0.05); transition: box-shadow .2s, transform .2s; }
  .cr-local-card:hover { box-shadow: 0 8px 28px rgba(15,23,42,0.10); transform: translateY(-2px); }
  .cr-local-kicker { font-family: 'Poppins', sans-serif; font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: #467FF7; }
  .cr-local-city { font-family: 'Poppins', sans-serif; font-size: 24px; font-weight: 500; color: #0f172a; line-height: 1.2; }
  .cr-local-region { font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 300; color: rgb(71,85,105); }
  .cr-local-arrow { font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 500; color: #467FF7; margin-top: 10px; }

  /* ---- application delivery states ---- */
  .cr-trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .cr-form-status { font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 400; color: rgb(71,85,105); margin: 0 0 14px; }
  .cr-form-status.is-error { color: #b42318; }
  .cr-submit:disabled { opacity: .6; cursor: default; }
  .cr-apply-done { background: #fff; border: 1px solid rgba(15,23,42,0.08); border-radius: 14px; padding: 32px 30px; box-shadow: 0 1px 2px rgba(15,23,42,0.04), 0 4px 16px rgba(15,23,42,0.05); outline: none; }
  .cr-apply-done-h3 { font-family: 'Poppins', sans-serif; font-size: 24px; font-weight: 500; color: #0f172a; margin: 0 0 10px; }
  .cr-apply-done-p { font-family: 'Poppins', sans-serif; font-size: 16px; font-weight: 300; line-height: 1.65; color: rgb(71,85,105); margin: 0; }
</style>
