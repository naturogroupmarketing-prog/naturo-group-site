---
const trustPoints = [
  {
    title: 'Police-checked cleaners',
    body: 'Every cleaner is vetted, trained and insured — so you can feel safe welcoming them into your home.',
    icon: 'shield',
  },
  {
    title: 'Flexible bookings',
    body: 'One-off, weekly or fortnightly. Reschedule or change your preferences any time, online in seconds.',
    icon: 'clock',
  },
  {
    title: 'Spotless, every time',
    body: 'Eco-friendly products and a thorough checklist. Not happy? We\'ll come back and make it right.',
    icon: 'sparkle',
  },
];
---

<section class="loc-section">
  <div class="container-site loc-top">
    <div class="loc-head">
      <h2 class="loc-h2">Trusted cleaning professionals across Australia &amp; in your local area</h2>
    </div>
    <div class="loc-copy">
      <p>Australia is a vast and diverse country known for its stunning natural landscapes, unique wildlife, and laid-back lifestyle. Whether you&rsquo;re in a major metropolitan area or a quiet regional town, we offer professional cleaning services designed to meet the needs of households and businesses across Australia.</p>
      <p>At NATURO GROUP, we&rsquo;re committed to delivering exceptional customer service and spotless results every time &mdash; whether you need a regular cleaner or a one-time deep clean.</p>
    </div>
  </div>

  <div class="container-site">
    <div class="loc-grid">
      {trustPoints.map((p) => (
        <div class="loc-card">
          <div class="loc-icon" aria-hidden="true">
            {p.icon === 'shield' && (
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M24 5L10 10v12c0 9 6 16 14 19 8-3 14-10 14-19V10L24 5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                <path d="M17 23l5 5 9-10" stroke="#ff5f1f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
            {p.icon === 'clock' && (
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="24" cy="24" r="17" stroke="currentColor" stroke-width="2"/>
                <line x1="24" y1="14" x2="24" y2="24" stroke="#ff5f1f" stroke-width="2.4" stroke-linecap="round"/>
                <line x1="24" y1="24" x2="31" y2="28" stroke="#ff5f1f" stroke-width="2.4" stroke-linecap="round"/>
                <circle cx="24" cy="24" r="1.6" fill="currentColor"/>
              </svg>
            )}
            {p.icon === 'sparkle' && (
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M22 6l3 8 8 3-8 3-3 8-3-8-8-3 8-3 3-8z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                <path d="M36 26l1.5 4 4 1.5-4 1.5L36 37l-1.5-4-4-1.5 4-1.5L36 26z" fill="#ff5f1f"/>
                <path d="M14 34l1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3z" fill="#ff5f1f"/>
              </svg>
            )}
          </div>
          <h3 class="loc-card-title">{p.title}</h3>
          <p class="loc-card-body">{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .loc-section {
    background-color: #f6f8fa;
    padding: clamp(88px, 10vw, 128px) 0;
  }
  .loc-top {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
    margin-bottom: clamp(40px, 5vw, 56px);
  }
  @media (max-width: 860px) {
    .loc-top { grid-template-columns: 1fr; gap: 24px; }
  }
  .loc-head { text-align: left; }
  .loc-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #0f172a;
    margin: 0;
  }
  @media (max-width: 768px) {
    .loc-h2 { font-size: 32px; line-height: 1.2; }
  }
  .loc-copy { text-align: left; }
  .loc-copy p {
    font-family: "Poppins", sans-serif;
    font-size: clamp(15px, 1.2vw, 17px);
    font-weight: 300;
    line-height: 1.75;
    color: rgb(71, 85, 105);
    margin: 0 0 14px;
  }
  .loc-copy p:last-child { margin-bottom: 0; }
  .loc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) {
    .loc-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .loc-grid { grid-template-columns: 1fr; }
  }
  .loc-card {
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 14px;
    padding: 28px 26px;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 4px 16px rgba(15, 23, 42, 0.05);
    transition: transform 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .loc-card:hover {
    transform: translateY(-3px);
    background-color: #3a5dff;
    border-color: #3a5dff;
    box-shadow:
      0 2px 4px rgba(15, 23, 42, 0.06),
      0 18px 36px rgba(58, 93, 255, 0.32);
  }
  .loc-card:hover .loc-card-title,
  .loc-card:hover .loc-card-body {
    color: #ffffff;
  }
  .loc-card:hover .loc-icon {
    color: #ffffff;
  }
  .loc-icon {
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 16px;
    color: #3a5dff;
    transition: color 0.25s ease;
  }
  .loc-icon svg { width: 48px; height: 48px; display: block; }
  .loc-card-title {
    font-family: "Poppins", sans-serif;
    font-size: clamp(18px, 1.6vw, 20px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: #0f172a;
    margin: 0 0 8px;
    transition: color 0.25s ease;
  }
  .loc-card-body {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.6;
    color: rgb(71, 85, 105);
    margin: 0;
    transition: color 0.25s ease;
  }
</style>
