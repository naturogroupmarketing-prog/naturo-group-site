<script
  is:inline
  define:vars={{
    webhookUrl: leadCapture.webhookUrl,
    crmUrl: leadCapture.crmUrl,
    googleAdsId: leadCapture.googleAdsId,
    googleAdsLabel: leadCapture.googleAdsLabel,
  }}
>
  // Progressive enhancement for the contact form.
  // Without JS the form still posts straight to the webhook (see `action`).
  // With JS we post in the background, record the conversion, and land the
  // user on /thank-you instead of a third-party confirmation page.
  (function () {
    var form = document.getElementById('ct-contact-form');
    if (!form) return;

    var statusEl = document.getElementById('ct-form-status');
    var button = document.getElementById('ct-submit');

    function setStatus(message, isError) {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.hidden = !message;
      statusEl.classList.toggle('is-error', !!isError);
    }

    function post(url, payload) {
      if (!url) return Promise.resolve();
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        keepalive: true,
      }).catch(function () {
        /* Never block the user on a reporting failure. */
      });
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      var data = new FormData(form);
      var name = (data.get('full_name') || '').toString().trim();
      var email = (data.get('email') || '').toString().trim();
      var phone = (data.get('phone') || '').toString().trim();
      var suburb = (data.get('suburb_postcode') || '').toString().trim();
      var state = (data.get('state') || '').toString().trim();
      var service = (data.get('service') || '').toString().trim();
      var message = (data.get('message') || '').toString().trim();

      if (!form.reportValidity()) return;

      // Correlates the CRM record, GA4 event and Ads conversion so the same
      // lead is never counted twice across systems.
      var eventId =
        'contact-' +
        Date.now().toString(36) +
        '-' +
        Math.random().toString(36).slice(2, 8);

      var params = new URLSearchParams(window.location.search);
      var payload = {
        name: name,
        email: email,
        phone: phone,
        location: suburb + (state ? ', ' + state : ''),
        service: service,
        message: message,
        source: 'Web form — contact page',
        lead_id: eventId,
        lead_type: 'contact',
        page: window.location.pathname,
        attribution: {
          utm_source: params.get('utm_source') || '',
          utm_medium: params.get('utm_medium') || '',
          utm_campaign: params.get('utm_campaign') || '',
          utm_content: params.get('utm_content') || '',
          referrer: document.referrer || '',
        },
      };

      if (button) {
        button.disabled = true;
        button.textContent = 'Sending…';
      }
      setStatus('Sending your message…', false);

      // GA4 — the conversion the local-SEO program is measured on.
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'quote_submit', {
          form_location: 'contact_page',
          service_type: service,
          suburb: suburb,
          page_path: window.location.pathname,
          transaction_id: eventId,
        });
        if (googleAdsId && googleAdsLabel) {
          window.gtag('event', 'conversion', {
            send_to: googleAdsId + '/' + googleAdsLabel,
            transaction_id: eventId,
          });
        }
      }
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'lead_captured', lead_source: 'contact_form', lead_id: eventId });

      Promise.all([post(webhookUrl, payload), post(crmUrl, payload)]).then(function () {
        window.location.href = '/thank-you';
      });

      // Never strand the user if a network call hangs.
      setTimeout(function () {
        if (document.visibilityState !== 'hidden') window.location.href = '/thank-you';
      }, 4000);
    });
  })();
</script>

<style>
  .ct-form-status {
    margin: 12px 0 0;
    font-size: 0.95rem;
    color: rgb(71, 85, 105);
  }
