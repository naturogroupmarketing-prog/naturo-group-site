---
import { ctaPrimary, site } from '../../data/site';
---

<div class="sticky-bar" role="region" aria-label="Quick actions" data-sticky-bar>
  <a class="sticky-btn sticky-btn--primary" href={ctaPrimary.href} data-quote-cta>
    <span>Instant Price</span>
    <span class="sticky-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
  </a>
  <a class="sticky-btn sticky-btn--secondary" href={site.phoneHref}>
    <span>Call</span>
    <span class="sticky-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
  </a>
</div>

<style>
  .sticky-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: none;
    gap: 0;
    background-color: #ffffff;
    border-top: 1px solid var(--c-border);
    padding: 8px 12px env(safe-area-inset-bottom, 8px);
    transform: translateY(0);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .sticky-bar[data-hidden="true"] {
    transform: translateY(110%);
  }
  @media (max-width: 768px) {
    .sticky-bar { display: flex; }
    body { padding-bottom: 76px; }
  }

  .sticky-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding-inline: 8px;
    border-radius: var(--r-pill);
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }
  /* iPhone SE-class viewports (≤360px) — shrink to keep both labels on one line. */
  @media (max-width: 360px) {
    .sticky-btn { font-size: 0.875rem; gap: 6px; }
  }
  .sticky-btn + .sticky-btn { margin-left: 8px; }

  .sticky-btn--primary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: linear-gradient(135deg, #4a6bff 0%, #2748f2 100%);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    min-height: 40px;
    box-shadow: 0 4px 14px rgba(37, 72, 240, 0.32);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .sticky-btn--primary:hover {
    box-shadow: 0 8px 22px rgba(37, 72, 240, 0.45);
    transform: translateY(-1px);
  }
  .sticky-btn--secondary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: #ffffff;
    color: #1C244B;
    border: 1px solid rgba(28, 36, 75, 0.18);
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    min-height: 40px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
    transition: background-color 0.2s, color 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .sticky-btn--secondary:hover {
    background: #ffffff;
    color: #1C244B;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.22);
  }

  .sticky-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .sticky-btn-icon svg {
    display: block;
    width: 14px;
    height: 14px;
  }
  .sticky-btn--primary .sticky-btn-icon {
    background-color: #ffffff;
    border-color: #ffffff;
    color: #1C244B;
  }
  .sticky-btn--primary:hover .sticky-btn-icon {
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.6);
    color: #ffffff;
  }
  .sticky-btn--secondary .sticky-btn-icon {
    border-color: rgba(58, 93, 255, 0.5);
    color: #3a5dff;
  }
  .sticky-btn--secondary:hover .sticky-btn-icon {
    background-color: #3a5dff;
    border-color: #3a5dff;
    color: #ffffff;
  }
</style>

<script>
  // Hide sticky bar when user scrolls up after passing 600px (less obtrusive).
  // Re-show on any scroll-down. Disabled at desktop widths via CSS.
  const bar = document.querySelector('[data-sticky-bar]') as HTMLElement | null;
  if (bar && window.matchMedia('(max-width: 768px)').matches) {
    let lastY = window.scrollY;
    let ticking = false;
    const onScroll = () => {
      const y = window.scrollY;
      const dy = y - lastY;
      if (y > 600 && dy < -8) {
        bar.dataset.hidden = 'true';
      } else if (dy > 8) {
        bar.dataset.hidden = 'false';
      }
      lastY = y;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });
  }
</script>
