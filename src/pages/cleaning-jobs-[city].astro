---
// Per-city hiring page: /cleaning-jobs-port-macquarie/, /cleaning-jobs-geelong/
//
// Exists because "cleaning jobs <city>" searches had nothing on the site to
// land on — only the national /career/ page, whose single JobPosting spans
// eight cities. Google for Jobs ranks one-job-one-place listings; that is how
// Indeed and Seek show up for these searches. Each city here gets its own
// posting with a single jobLocation.
//
// All pay, requirement and process copy comes from src/data/career.ts, the
// same source the national page uses. Nothing here is city-specific except
// the suburbs served and the kind of work — both taken from pages the site
// already publishes.
//
// The layout is Indeed's: the results column on the left lists every city we
// advertise in, with the current one selected, and the pane on the right is
// the chosen job. Type scale and weights follow Indeed too — 16px body at
// weight 400, bold section rules — because that is what a candidate coming
// off a job search is reading against. Applying opens the pop-up; nothing
// sends them to another page.
import Layout from '../layouts/Layout.astro';
import FAQ from '../components/FAQ.astro';
import ApplyLeadGate from '../components/ApplyLeadGate.astro';
import ApplyForm from '../components/ApplyForm.astro';
import { site } from '../data/site';
import { benefits, wellLook, niceToHave, steps, dailyWork, careerCities, payRange, payLine, jobTitle, type CareerCity } from '../data/career';

export function getStaticPaths() {
  return careerCities.map((c) => ({ params: { city: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: CareerCity };
const pageUrl = `${site.url}/cleaning-jobs-${c.slug}`;
// Applying opens the conversational pop-up (ApplyLeadGate), the hiring twin
// of the quote funnel. The href is the no-JS fallback only.
const applyHref = `mailto:${site.email}?subject=${encodeURIComponent(`Application — cleaning jobs ${c.city}`)}`;

// Every city we advertise in, for the results column. The one being viewed is
// marked active; the others are links, which is how a job board switches
// between listings on a static site.
const otherCities = careerCities;

// Same posting window the national page uses.
const today = new Date();
const validThrough = new Date(today);
validThrough.setFullYear(validThrough.getFullYear() + 1);
const isoToday = today.toISOString().split('T')[0];
const isoValidThrough = validThrough.toISOString().split('T')[0];

const listedOn = today.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });

// The summary rows a job board puts at the top of a listing, in the order
// candidates scan them: pay, work type, where, when.
const jobMeta = [
  { icon: 'pay', text: `$${payRange.min.toFixed(2)} – $${payRange.max.toFixed(2)} per hour incl. super & vehicle allowance` },
  { icon: 'type', text: 'Full time, Part time and Casual — employee roles, no ABN' },
  { icon: 'place', text: `${c.city} ${c.state} ${c.postcode} · ${c.region}` },
  { icon: 'clock', text: 'Monday to Friday, 8am–4pm. No nights, no weekends' },
];

const jobDetails = [
  { label: 'Pay', value: `$${payRange.min.toFixed(2)} – $${payRange.max.toFixed(2)} per hour` },
  { label: 'Work type', value: 'Permanent part time, full time or casual' },
  { label: 'Classification', value: 'Cleaning Services (Trades & Services)' },
  { label: 'Location', value: `${c.city} ${c.state} ${c.postcode}` },
  { label: 'Hours', value: 'Mon–Fri, 8am–4pm. School-hours shifts available' },
  { label: 'Checks', value: 'National Police Check + NDIS Worker Screening' },
  { label: 'Start', value: 'Immediate start for the right candidates' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'JobPosting',
    title: `${jobTitle} | ${c.city}`,
    description: c.intro.join(' '),
    datePosted: isoToday,
    validThrough: isoValidThrough,
    // Employee roles only — the listing is explicit that this is not ABN or
    // contractor work. Casual has no schema.org value; PART_TIME covers it.
    employmentType: ['FULL_TIME', 'PART_TIME'],
    hiringOrganization: {
      '@type': 'Organization',
      name: site.name,
      sameAs: site.url,
      logo: `${site.url}/images/logo.png`,
    },
    // One place, on purpose. streetAddress deliberately omitted: cleaners work
    // in clients' homes, and there is no site address to give.
    jobLocation: {
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        addressLocality: c.city,
        addressRegion: c.state,
        postalCode: c.postcode,
        addressCountry: 'AU',
      },
    },
    applicantLocationRequirements: { '@type': 'Country', name: 'Australia' },
    // The form is on this page now, so Google for Jobs can mark it apply-here.
    directApply: true,
    baseSalary: {
      '@type': 'MonetaryAmount',
      currency: payRange.currency,
      value: {
        '@type': 'QuantitativeValue',
        minValue: payRange.min,
        maxValue: payRange.max,
        unitText: payRange.unit,
      },
    },
    industry: 'Residential & Disability Support Cleaning',
    qualifications:
      'A reliable car and current Australian driver’s licence; living within about 25 minutes of the town centre; available at least two weekdays between 8am and 4pm; willing to complete a National Police Check and NDIS Worker Screening Check; working rights in Australia.',
    responsibilities: dailyWork.join('; '),
    jobBenefits:
      'Superannuation and vehicle allowance included; paid induction and training; paid travel between jobs; all equipment, uniforms and products supplied; career progression to Team Leader and Management.',
    workHours: 'Monday to Friday, 8am–4pm. No nights or weekends. School-hours shifts available.',
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Careers', item: `${site.url}/career` },
      { '@type': 'ListItem', position: 3, name: `Cleaning Jobs ${c.city}`, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
// Monochrome line icons for the summary rows, inlined so the listing header
// costs no extra request.
const icons: Record<string, string> = {
  pay: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M14.5 9.2a3 3 0 0 0-5 2.2c0 2.6 5 1.6 5 4.2a3 3 0 0 1-5 2.1"/><path d="M12 6.5v11"/></svg>',
  type: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg>',
  place: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>',
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/></svg>',
};
---

<Layout
  title={`Cleaning Jobs in ${c.city} ${c.state} ${c.postcode}`}
  description={`Cleaner jobs in ${c.city} ${c.state}. Permanent & casual employee roles, $${payRange.min}/hr incl. super. No nights or weekends, paid training. Apply now.`}
  schema={schema}
>
  <section class="ij">
    <div class="container-site ij-inner">
      <nav class="ij-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/career/">Cleaning jobs</a><span aria-hidden="true">/</span>
        <span aria-current="page">{c.city}</span>
      </nav>

      <p class="ij-count">
        <strong>{otherCities.length} location{otherCities.length === 1 ? '' : 's'}</strong> hiring cleaners · listed {listedOn}
      </p>

      <div class="ij-split">
        <!-- LEFT · every area we advertise in. Selecting one loads its listing,
             which on a static site means following the link. -->
        <div class="ij-results" aria-label="Open positions">
          {otherCities.map((o) => (
            o.slug === c.slug ? (
              <div class="ij-result is-active" aria-current="true">
                <h2 class="ij-result-title">{jobTitle}</h2>
                <p class="ij-result-org">{site.name}</p>
                <p class="ij-result-place">{o.city} {o.state} {o.postcode}</p>
                <p class="ij-result-pay">${payRange.min.toFixed(2)} – ${payRange.max.toFixed(2)} an hour</p>
                <div class="ij-chips">
                  <span class="ij-chip">Permanent</span>
                  <span class="ij-chip">Casual</span>
                  <span class="ij-chip">No weekends</span>
                </div>
                <p class="ij-result-current">Showing this job</p>
              </div>
            ) : (
              <a class="ij-result" href={`/cleaning-jobs-${o.slug}/`}>
                <h2 class="ij-result-title">{jobTitle}</h2>
                <p class="ij-result-org">{site.name}</p>
                <p class="ij-result-place">{o.city} {o.state} {o.postcode}</p>
                <p class="ij-result-pay">${payRange.min.toFixed(2)} – ${payRange.max.toFixed(2)} an hour</p>
                <div class="ij-chips">
                  <span class="ij-chip">Permanent</span>
                  <span class="ij-chip">Casual</span>
                  <span class="ij-chip">No weekends</span>
                </div>
              </a>
            )
          ))}
          <p class="ij-results-note">
            Hiring in other areas soon. Can't see your town? <a href="/contact-us/">Tell us where you are</a>.
          </p>
        </div>

        <!-- RIGHT · the selected job -->
        <div class="ij-pane">
          <div class="ij-pane-head">
            <h1 class="ij-title">{jobTitle}</h1>
            <p class="ij-org"><a href="/">{site.name}</a></p>
            <p class="ij-place">{c.city} {c.state} {c.postcode}</p>
            <p class="ij-headline">${payRange.min.toFixed(2)} – ${payRange.max.toFixed(2)} an hour · Part-time, Casual, Full-time</p>
            <div class="ij-actions">
              <button type="button" class="ij-apply" data-apply-cta data-job-city={c.city} data-form-location={`cleaning-jobs-${c.slug}`}>
                <span>Apply now</span>
                <span class="ij-apply-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
              </button>
              <a class="ij-call" href={site.phoneHref}>Or call {site.phone}</a>
              <a class="ij-fallback" href={applyHref}>Email your application</a>
            </div>
          </div>

          <div class="ij-section">
            <h2 class="ij-h2">Job details</h2>
            {jobMeta.map((m) => (
              <div class="ij-detail">
                <span class="ij-detail-icon" aria-hidden="true" set:html={icons[m.icon]} />
                <span class="ij-detail-text">{m.text}</span>
              </div>
            ))}
            <div class="ij-detail">
              <span class="ij-detail-icon" aria-hidden="true" set:html={icons.type} />
              <span class="ij-detail-text">
                <strong>Benefits</strong>
                <span>Paid induction and training, paid travel between jobs, superannuation, vehicle allowance, all equipment and uniforms supplied, progression to Team Leader.</span>
              </span>
            </div>
          </div>

          <div class="ij-section">
            <h2 class="ij-h2">Full job description</h2>

            <p class="ij-lead"><strong>{jobTitle}</strong><br />{site.name} · {c.city} {c.state} {c.postcode}</p>
            {c.intro.map((p) => <p class="ij-p">{p}</p>)}

            <h3 class="ij-h3">Your daily work</h3>
            <ul class="ij-ul">{dailyWork.map((w) => <li>{w}</li>)}</ul>

            <h3 class="ij-h3">What you must have</h3>
            <p class="ij-p">These are the hard requirements. Applications that don't meet them can't be considered.</p>
            <ul class="ij-ul">{wellLook.map((t) => <li>{t}</li>)}</ul>

            <h3 class="ij-h3">What we look for</h3>
            <p class="ij-p">Preferred, not essential — we'll train the right person.</p>
            <ul class="ij-ul">{niceToHave.map((t) => <li>{t}</li>)}</ul>

            <h3 class="ij-h3">What we offer</h3>
            <ul class="ij-ul">
              {benefits.map((b) => <li><strong>{b.title}.</strong> {b.body}</li>)}
            </ul>

            <h3 class="ij-h3">How the application process works</h3>
            <ol class="ij-ol">
              {steps.map((s) => <li><strong>{s.title}.</strong> {s.body}</li>)}
            </ol>

            <h3 class="ij-h3">Where our {c.city} cleaners work</h3>
            <p class="ij-p">We roster locally across {c.region}:</p>
            <div class="ij-suburbs">
              {c.suburbs.map((s) => <a href={`/${s.slug}/`}>{s.name}</a>)}
            </div>

            <div class="ij-cta">
              <button type="button" class="ij-apply" data-apply-cta data-job-city={c.city} data-form-location={`cleaning-jobs-${c.slug}`}>
                <span>Apply for this job</span>
                <span class="ij-apply-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
              </button>
              <p class="ij-cta-note">
                Six quick questions, about a minute. Your local Team Leader calls within 48 hours.
                Prefer one long form? <a href="#apply">Fill it in below</a>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FAQ
    items={c.faqs}
    eyebrow={`Cleaning jobs ${c.city} — common questions`}
    subheading={`What cleaners ask before joining the ${c.city} team.`}
  />

  <section class="ij-foot">
    <div class="container-site">
      <p class="ij-foot-note">Looking for a cleaner rather than a job?</p>
      <p class="ij-foot-links">
        <a href={c.hubHref}>{c.hubLabel} &rarr;</a>
        <span aria-hidden="true">·</span>
        <a href="/career/">All cleaning jobs &rarr;</a>
      </p>
    </div>
  </section>

  <!-- The same application, as a single form, for anyone who would rather
       see every question at once. Both paths deliver the same payload. -->
  <ApplyForm
    heading={`Apply for cleaning jobs in ${c.city}`}
    formLocation={`cleaning-jobs-${c.slug}`}
    jobCity={c.city}
  />

  <ApplyLeadGate />
</Layout>

<style>
  /* ---------------------------------------------------------------------
     Indeed's results layout: the areas we advertise in down the left, the
     selected job in the pane on the right. Type follows Indeed's scale and
     weights — 16px body at 400, bold headings, bold rules between blocks —
     rather than the site's marketing 300-weight display type, because this
     page is read the way a job board is read. Colour, buttons and the
     pop-up stay NATURO's.
     --------------------------------------------------------------------- */
  .ij { background: #f3f2f1; padding: 20px 0 clamp(40px, 5vw, 64px); }
  .ij-inner { max-width: 1240px; }

  .ij-crumbs {
    display: flex; flex-wrap: wrap; gap: 8px;
    font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 400;
    color: #595959; margin: 0 0 12px;
  }
  .ij-crumbs a { color: #595959; text-decoration: none; }
  .ij-crumbs a:hover { color: #3a5dff; text-decoration: underline; }

  .ij-count {
    font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 400;
    color: #595959; margin: 0 0 14px;
  }
  .ij-count strong { font-weight: 700; color: #2d2d2d; }

  .ij-split {
    display: grid;
    grid-template-columns: 380px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }
  @media (max-width: 1000px) {
    .ij-split { grid-template-columns: minmax(0, 1fr); }
    /* On a phone the job comes first; the other areas sit underneath it. */
    .ij-results { order: 2; }
    .ij-pane { order: 1; }
  }

  /* ---------- Left: the results column ---------- */
  .ij-results { display: flex; flex-direction: column; gap: 12px; position: sticky; top: 16px; }
  @media (max-width: 1000px) { .ij-results { position: static; } }

  .ij-result {
    display: block;
    background: #ffffff;
    border: 1px solid #d4d2d0;
    border-radius: 8px;
    padding: 16px;
    text-decoration: none;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }
  a.ij-result:hover { box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14); border-color: #a1a09f; }
  .ij-result.is-active {
    border: 2px solid #3a5dff;
    box-shadow: 0 2px 10px rgba(58, 93, 255, 0.14);
    padding: 15px;
  }
  .ij-result-title {
    font-family: 'Poppins', sans-serif;
    font-size: 18px; font-weight: 600; line-height: 1.3;
    color: #2557a7; margin: 0 0 6px;
  }
  .ij-result.is-active .ij-result-title { color: #2d2d2d; }
  a.ij-result:hover .ij-result-title { text-decoration: underline; }
  .ij-result-org,
  .ij-result-place,
  .ij-result-pay {
    font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 400;
    line-height: 1.45; color: #595959; margin: 0;
  }
  .ij-result-org { color: #2d2d2d; }
  .ij-result-pay { font-weight: 600; color: #2d2d2d; margin-top: 8px; }
  .ij-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .ij-chip {
    font-family: 'Poppins', sans-serif; font-size: 12px; font-weight: 500;
    color: #2d2d2d; background: #f3f2f1; border-radius: 4px; padding: 4px 8px;
  }
  .ij-result-current {
    font-family: 'Poppins', sans-serif; font-size: 12px; font-weight: 600;
    letter-spacing: 0.04em; text-transform: uppercase; color: #3a5dff;
    margin: 12px 0 0;
  }
  .ij-results-note {
    font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 400;
    line-height: 1.5; color: #595959; margin: 4px 0 0; padding: 0 4px;
  }
  .ij-results-note a { color: #2557a7; }

  /* ---------- Right: the selected job ---------- */
  .ij-pane {
    background: #ffffff;
    border: 1px solid #d4d2d0;
    border-radius: 8px;
    padding: clamp(20px, 2.4vw, 32px);
  }
  .ij-pane-head { padding-bottom: 20px; }
  .ij-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(22px, 2.3vw, 26px); font-weight: 700; line-height: 1.25;
    color: #2d2d2d; margin: 0 0 10px;
  }
  .ij-org { margin: 0 0 2px; font-family: 'Poppins', sans-serif; font-size: 16px; font-weight: 400; }
  .ij-org a { color: #2557a7; text-decoration: underline; }
  .ij-place {
    font-family: 'Poppins', sans-serif; font-size: 16px; font-weight: 400;
    color: #2d2d2d; margin: 0 0 12px;
  }
  .ij-headline {
    font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 600;
    color: #2d2d2d; margin: 0 0 18px;
  }

  .ij-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  /* The site's own CTA, unchanged: gradient pill, white arrow disc. */
  .ij-apply {
    display: inline-flex; align-items: center; justify-content: space-between; gap: 10px;
    background: linear-gradient(135deg, #4a6bff 0%, #2748f2 100%);
    color: #ffffff; border: 1px solid transparent; border-radius: 999px;
    padding: 6px 6px 6px 22px;
    font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 600; line-height: 1;
    min-height: 46px; cursor: pointer;
    box-shadow: 0 4px 14px rgba(37, 72, 240, 0.32);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .ij-apply:hover { box-shadow: 0 8px 22px rgba(37, 72, 240, 0.45); transform: translateY(-1px); }
  .ij-apply-icon {
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
    width: 32px; height: 32px; border-radius: 999px;
    background: #ffffff; border: 1px solid #ffffff; color: #1C244B;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .ij-apply:hover .ij-apply-icon { background: transparent; border-color: rgba(255,255,255,0.6); color: #ffffff; }
  .ij-apply-icon svg { display: block; width: 14px; height: 14px; }
  .ij-call {
    font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 500;
    color: #2d2d2d; text-decoration: none;
  }
  .ij-call:hover { color: #3a5dff; text-decoration: underline; }
  /* Only useful without JavaScript, where the pop-up cannot open. */
  .ij-fallback {
    font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 400;
    color: #595959; text-decoration: underline;
  }

  .ij-section { border-top: 1px solid #e4e2e0; padding: 22px 0 4px; }
  .ij-h2 {
    font-family: 'Poppins', sans-serif; font-size: 20px; font-weight: 700;
    line-height: 1.3; color: #2d2d2d; margin: 0 0 16px;
  }
  .ij-h3 {
    font-family: 'Poppins', sans-serif; font-size: 16px; font-weight: 700;
    line-height: 1.4; color: #2d2d2d; margin: 26px 0 8px;
  }
  .ij-detail { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px; }
  .ij-detail-icon { flex: none; width: 20px; height: 20px; color: #2d2d2d; margin-top: 2px; }
  .ij-detail-icon :global(svg) { width: 20px; height: 20px; display: block; }
  .ij-detail-text {
    display: block;
    font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 600;
    line-height: 1.5; color: #2d2d2d;
  }
  .ij-detail-text strong { display: block; font-weight: 700; margin-bottom: 2px; }
  .ij-detail-text span { display: block; font-weight: 400; color: #595959; }

  .ij-lead, .ij-p {
    font-family: 'Poppins', sans-serif; font-size: 16px; font-weight: 400;
    line-height: 1.6; color: #2d2d2d; margin: 0 0 14px;
  }
  .ij-lead strong { font-weight: 700; }
  .ij-ul, .ij-ol {
    font-family: 'Poppins', sans-serif; font-size: 16px; font-weight: 400;
    line-height: 1.6; color: #2d2d2d; margin: 0 0 14px; padding-left: 22px;
  }
  .ij-ul li, .ij-ol li { margin-bottom: 7px; }
  .ij-ul li strong, .ij-ol li strong { font-weight: 700; }

  .ij-suburbs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; }
