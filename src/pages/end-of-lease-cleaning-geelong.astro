---
import Layout from '../layouts/Layout.astro';
import ServiceHero from '../components/ServiceHero.astro';
import ServiceIntro from '../components/ServiceIntro.astro';
import ServiceInclusions from '../components/ServiceInclusions.astro';
import Features from '../components/Features.astro';
import PricingCards from '../components/PricingCards.astro';
import Providers from '../components/Providers.astro';
import Testimonials from '../components/Testimonials.astro';
import AppPromo from '../components/AppPromo.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { site, ctaPrimary , aggregateRatingSchema} from '../data/site';

const pageUrl = `${site.url}/end-of-lease-cleaning-geelong`;

const introBody = [
  'Moving out is stressful enough. Our Geelong end-of-lease team arrives fully equipped with eco-conscious products and cleans to the exact standard your property manager will inspect against &mdash; documenting every room with photos you can share in any dispute.',
  'Every cleaner is police-checked, identity-verified and trained on our detailed REIV inspection checklist before working in a Geelong home. We never subcontract &mdash; you always get a trained Naturo Group team member.',
  'If your property manager raises any issue, we return within 72 hours at no extra cost. No disputes, no chasing. Just your bond, back.',
];

const introStats = [
  { num: '100%', label: 'Bond-back guarantee' },
  { num: '72&nbsp;hr', label: 'Free re-clean window' },
  { num: '24/7', label: 'Booking online' },
];

const inclusions = [
  {
    group: 'All areas',
    items: [
      'Vacuum carpets & sweep all floors',
      'Mop all hard floors',
      'Wipe down skirting boards',
      'Dust cornices & remove cobwebs',
      'Wipe window frames, ledges & tracks',
      'Clean window interiors & tracks',
      'Wipe doors, frames & handles',
      'Clean accessible light fittings',
      'Ceiling fans dusted',
      'Wipe inside & outside wardrobes',
    ],
  },
  {
    group: 'Kitchen',
    items: [
      'Clean all surfaces & sanitise benchtops',
      'Sanitise splashback',
      'Clean stovetop & oven exterior',
      'Clean rangehood & filters',
      'Wipe outside cabinets & appliance exteriors',
      'Clean inside cupboards, shelves & drawers',
      'Polish sink & taps',
    ],
  },
  {
    group: 'Bathrooms',
    items: [
      'Scrub & sanitise toilet',
      'Scrub clean bathtub & shower',
      'Clean mirrors streak-free',
      'Polish sink & taps',
      'Wipe down benchtops',
      'Wipe outside cabinets',
      'Clean inside cabinets, shelves & drawers',
      'Dust accessible exterior fan vents',
    ],
  },
];

const excluded = [
  'Chandeliers',
  'Light bulbs',
  'Fireplaces',
  'Fly screens',
  'Moving furniture or appliances',
  'Putting away dishes, pans or A/C filters',
  'Grout & silicon remediations',
  'Biohazards (excessive mould, faeces, blood)',
  'Odour removal & remediation',
  'Pet hair embedded in carpet fibres',
  'Certain mineral deposits (e.g. toilet stains)',
  'High-reach areas (above two-step ladder)',
];

const suburbLinks = [
  { name: 'Geelong CBD', slug: 'house-cleaning-geelong' },
  { name: 'Newtown', slug: 'house-cleaning-newtown-geelong' },
  { name: 'Highton', slug: 'house-cleaning-highton' },
  { name: 'Belmont', slug: 'house-cleaning-belmont-geelong' },
  { name: 'Geelong West', slug: 'house-cleaning-geelong-west' },
  { name: 'Lara', slug: 'house-cleaning-lara' },
  { name: 'Leopold', slug: 'house-cleaning-leopold' },
  { name: 'Ocean Grove', slug: 'house-cleaning-ocean-grove' },
  { name: 'Torquay', slug: 'house-cleaning-torquay' },
  { name: 'Barwon Heads', slug: 'house-cleaning-barwon-heads' },
  { name: 'Armstrong Creek', slug: 'house-cleaning-armstrong-creek' },
  { name: 'Grovedale', slug: 'house-cleaning-grovedale' },
  { name: 'Waurn Ponds', slug: 'house-cleaning-waurn-ponds' },
  { name: 'Mount Duneed', slug: 'house-cleaning-mount-duneed' },
];

const faqs = [
  {
    q: 'How much does end of lease cleaning cost in Geelong?',
    a: 'Our Geelong bond cleaning is priced on the size and condition of the property. Prices vary by size and condition. Get an instant online price in under 60 seconds — no phone call needed.',
  },
  {
    q: 'Do you offer a bond-back guarantee?',
    a: 'Yes. If your property manager identifies any issue with our clean, we will return and re-clean the affected areas at no extra cost within 72 hours. We back every Geelong end-of-lease job with this promise.',
  },
  {
    q: 'What areas of Geelong do you cover for end of lease cleaning?',
    a: 'We cover all of Greater Geelong and the Bellarine Peninsula — including the CBD, Newtown, Highton, Belmont, Geelong West, Lara, Leopold, Ocean Grove, Torquay, Barwon Heads, Armstrong Creek and surrounding suburbs.',
  },
  {
    q: 'Does the end of lease clean include the oven and carpets?',
    a: 'Yes. Our standard bond clean includes a full oven clean (interior, racks and door glass), stovetop, rangehood, all bathrooms, kitchen, bedrooms, living areas, skirting boards, light fittings and window tracks. Carpet steam cleaning is available as an add-on.',
  },
  {
    q: 'Do I need to be present during the clean?',
    a: 'No — most Geelong clients hand us a key or use a lockbox. We complete the clean, photograph the results and send you a summary you can share with your property manager.',
  },
  {
    q: 'How far in advance should I book?',
    a: 'We recommend booking 5–7 days ahead of your vacate date to secure your preferred slot. For urgent bookings, call 1300 876 472 and we will do our best to fit you in.',
  },
  {
    q: 'Are your Geelong cleaners police-checked and insured?',
    a: 'Every cleaner is police-checked, identity-verified and covered by $20M public liability insurance before they step foot in a property. We never subcontract — you always get a trained Naturo Group team member.',
  },
  {
    q: 'What eco-friendly products do you use?',
    a: 'We use plant-based, non-toxic, biodegradable cleaners that are safe for pets, kids and asthma sufferers — and kind to the Corio Bay and Bellarine waterways. Tough on grime, gentle on the planet.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${pageUrl}#localbusiness`,
    name: 'Naturo Group End of Lease Cleaning Geelong',
    description:
      'Professional end of lease cleaning in Geelong with a 72-hour bond-back guarantee. Police-checked, eco-conscious team covering Greater Geelong and the Bellarine Peninsula.',
    url: pageUrl,
    telephone: site.phone,
    email: site.email,
    image: {
      '@type': 'ImageObject',
      url: `${site.url}/images/suburbs/house-cleaning-geelong.jpg`,
      creator: { '@type': 'Organization', name: site.name },
      creditText: site.name,
      copyrightNotice: `© ${new Date().getFullYear()} ${site.name}`,
      license: `${site.url}/terms-of-service`,
      acquireLicensePage: `${site.url}/privacy-policies`,
    },
    priceRange: '$$$',
    areaServed: [
      { '@type': 'City', name: 'Geelong', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Newtown', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Highton', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Belmont', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Ocean Grove', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Torquay', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Armstrong Creek', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Leopold', containedInPlace: { '@type': 'State', name: 'Victoria' } },
    ],
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:30',
      closes: '17:00',
    },
    ...aggregateRatingSchema('geelong'),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Geelong Cleaning', item: `${site.url}/house-cleaning-geelong` },
      { '@type': 'ListItem', position: 3, name: 'End of Lease Cleaning Geelong', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="End of Lease Cleaning Geelong | Bond Back"
  description="End of lease cleaning in Geelong. Police-checked team, 72-hr bond-back guarantee. Serving Newtown, Highton, Belmont, Ocean Grove & all of Greater Geelong."
  schema={schema}
>
  <!-- 1. Hero -->
  <ServiceHero
    eyebrow="Bond cleaning · Geelong"
    heading="End of Lease Cleaning<br />in Geelong"
    tagline="72-hour bond-back guarantee. Police-checked team. Eco-conscious products."
    bg="/images/hero-staff-bathroom.webp"
  />

  <!-- 2. Stats bar -->
  <section class="bg-[#EFEEE9] border-b border-[var(--color-border)]">
    <div class="container-site">
      <div class="grid sm:grid-cols-3">
        <div class="px-6 py-8 text-center sm:border-r border-[var(--color-border)]">
          <p class="text-3xl font-light text-[var(--color-navy)]">Police-checked</p>
          <p class="text-sm text-[var(--color-slate)] mt-1 uppercase tracking-widest font-semibold">Every cleaner</p>
        </div>
        <div class="px-6 py-8 text-center sm:border-r border-[var(--color-border)]">
          <p class="text-3xl font-light text-[var(--color-navy)]">72hr</p>
          <p class="text-sm text-[var(--color-slate)] mt-1 uppercase tracking-widest font-semibold">Bond-back guarantee</p>
        </div>
        <div class="px-6 py-8 text-center">
          <p class="text-3xl font-light text-[var(--color-navy)]">Plant-based</p>
          <p class="text-sm text-[var(--color-slate)] mt-1 uppercase tracking-widest font-semibold">Eco-conscious products</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Intro -->
  <ServiceIntro
    kicker="About this service"
    heading="Get your bond back — or we come back for free."
    body={introBody}
    stats={introStats}
  />

  <!-- 4. What's included -->
  <ServiceInclusions
    heading="Every room. Every detail. Every time."
    sub="Our Geelong bond clean covers every area a property manager will inspect — nothing skipped, nothing missed."
    groups={inclusions}
  />

  <!-- 5. Excluded services -->
  <section style="background: #ffffff; padding: clamp(64px, 7vw, 88px) 0; border-top: 1px solid rgba(15,23,42,0.06);">
    <div class="container-site" style="max-width: 1160px;">
      <div style="text-align: center; max-width: 640px; margin: 0 auto 36px;">
        <h2 style="font-family: 'Poppins', sans-serif; font-size: clamp(24px, 3vw, 36px); font-weight: 300; line-height: 1.15; letter-spacing: -0.01em; color: #0f172a; margin: 0 0 12px;">
          Not included as standard
        </h2>
        <p style="font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 300; color: rgb(71, 85, 105); line-height: 1.65; margin: 0;">
          The following fall outside our standard bond clean. Contact us and we can quote these separately.
        </p>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; max-width: 880px; margin: 0 auto 28px;">
        {excluded.map((item) => (
          <span style="display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; border-radius: 999px; background: rgba(15,23,42,0.03); border: 1px solid rgba(15,23,42,0.08);">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" style="flex-shrink: 0; color: rgb(148, 163, 184);" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M1 1l8 8M9 1L1 9"/></svg>
            <span style="font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 300; color: rgb(100, 116, 139);">{item}</span>
          </span>
        ))}
      </div>
      <div style="text-align: center;">
        <a href={ctaPrimary.href} style="font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 500; color: #467FF7; text-decoration: none;">
          Enquire about excluded services &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Why Naturo Group -->
  <Features />

  <!-- 6. Social proof -->
  <Testimonials />

  <!-- 7. Pricing -->
  <PricingCards />

  <!-- 8. Providers -->
  <Providers />

  <!-- 9. FAQs -->
  <section class="bg-[#EFEEE9]" style="padding: clamp(88px, 10vw, 128px) 0;">
    <div class="container-site" style="max-width: 768px;">
      <div class="text-center" style="margin-bottom: 2.5rem;">
        <h2 style="font-family: 'Poppins', sans-serif; font-size: clamp(28px, 3.5vw, 40px); font-weight: 300; line-height: 1.1; letter-spacing: -0.015em; color: #0f172a; margin: 0;">
          End of lease cleaning Geelong &mdash; common questions
        </h2>
      </div>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="bg-white rounded-[14px] border border-[rgba(15,23,42,0.08)] shadow-sm group">
            <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer list-none font-medium text-[var(--color-navy)]">
              {f.q}
              <svg class="w-5 h-5 shrink-0 text-[var(--color-slate)] transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="px-6 pb-5 text-[var(--color-slate)] leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. App promo -->
  <AppPromo />

  <!-- 11. Final CTA -->
  <FinalCTA />

  <!-- 12. Suburb sub-pages + area links -->
  <section style="background: #ffffff; padding: clamp(88px, 10vw, 128px) 0;">
    <div class="container-site">
      <div class="text-center" style="margin-bottom: 2rem;">
        <h2 style="font-family: 'Poppins', sans-serif; font-size: clamp(22px, 2.5vw, 32px); font-weight: 300; line-height: 1.1; color: #0f172a; margin: 0 0 0.75rem;">
          End of lease cleaning — by Geelong suburb
        </h2>
        <p style="font-family: 'Poppins', sans-serif; font-size: 14px; color: rgb(71, 85, 105);">Each suburb page covers local property types, pricing and what your property manager will inspect.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-3" style="margin-bottom: 3rem;">
        {[
          { name: 'Ocean Grove', slug: 'ocean-grove' },
          { name: 'Torquay', slug: 'torquay' },
          { name: 'Newtown', slug: 'newtown' },
          { name: 'Lara', slug: 'lara' },
          { name: 'Leopold', slug: 'leopold' },
          { name: 'Belmont', slug: 'belmont' },
          { name: 'Highton', slug: 'highton' },
          { name: 'Geelong West', slug: 'geelong-west' },
          { name: 'Barwon Heads', slug: 'barwon-heads' },
          { name: 'Grovedale', slug: 'grovedale' },
        ].map((s) => (
          <a
            href={`/end-of-lease-cleaning/geelong/${s.slug}`}
            class="flex items-center gap-2 px-4 py-3 rounded-[14px] border border-[rgba(15,23,42,0.08)] text-sm font-medium text-[var(--color-navy)] hover:border-[var(--color-accent-blue)] hover:text-[var(--color-accent-blue)] transition-colors"
          >
            <svg class="w-4 h-4 shrink-0 text-[var(--color-accent-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            EOL Cleaning {s.name}
          </a>
        ))}
      </div>
      <div>
        <div class="flex flex-wrap gap-2 justify-center">
          {suburbLinks.map((s) => (
            <a
              href={`/${s.slug}`}
              class="px-4 py-2 rounded-full border border-[rgba(15,23,42,0.08)] text-sm text-[var(--color-slate)] hover:border-[var(--color-accent-blue)] hover:text-[var(--color-accent-blue)] transition-colors"
            >
              {s.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  details > summary::-webkit-details-marker { display: none; }
</style>
