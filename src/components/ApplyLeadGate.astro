---
// Conversational job application — the hiring twin of QuoteLeadGate.
//
// Candidates arrive from a job search on a phone. A sixteen-field form is the
// wrong thing to put in front of them, so the application is asked one
// question at a time in the same pop-up the quote funnel uses: same card,
// same progress chrome, same option tiles, same gradient pill.
//
// Anything on the page carrying `data-apply-cta` opens it. The button may also
// carry `data-job-city` and `data-form-location`, which ride along in the
// payload so the Inbox shows which listing was answered.
//
// Delivery is the shared CRM helper (window.naturoLeads), with the same
// `service` / `lead_type` values the application form has always sent — the
// Inbox filters on those, so they must not change. Without JavaScript the
// trigger keeps its own href, which is a mailto to the office.
import { site } from '../data/site';

const weekdays = ['Mondays', 'Tuesdays', 'Wednesdays', 'Thursdays', 'Fridays'];
---

<div class="alg-overlay" id="algOverlay" aria-labelledby="algHeading" hidden>
  <div class="alg-card" role="document">
    <button type="button" class="alg-close" id="algClose" aria-label="Close">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <div class="alg-chrome" id="algChrome" hidden>
      <button type="button" class="alg-back" id="algBack" aria-label="Go back">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        <span>Back</span>
      </button>
      <div class="alg-progress">
        <span class="alg-progress-label" id="algProgressLabel" aria-live="polite">Question 1 of 6</span>
        <div class="alg-progress-track"><div class="alg-progress-fill" id="algProgressFill"></div></div>
      </div>
    </div>

    <form class="alg-stage" id="algForm" novalidate>
      <div class="nl-hp" aria-hidden="true">
        <label>Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </div>

      <!-- STEP 0 · intro -->
      <section class="alg-screen" data-step="intro">
        <div class="alg-intro">
          <h2 class="alg-heading" id="algHeading"><span class="alg-wave" aria-hidden="true">👋</span> Hi, I'm Naturo.</h2>
          <p class="alg-lede" id="algLede">Let's get your application in — about 60&nbsp;seconds, six quick questions.</p>
          <button type="button" class="alg-btn alg-btn-primary" id="algStart">
            <span>Start My Application</span>
            <span class="alg-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </button>
        </div>
      </section>

      <!-- STEP 1 · hours -->
      <section class="alg-screen" data-step="hours" hidden>
        <h2 class="alg-q" tabindex="-1">What hours are you after?</h2>
        <div class="alg-options" data-single="hours">
          <button type="button" class="alg-option" data-value="Permanent part time">
            <span class="alg-option-icon" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="17" stroke="currentColor" stroke-width="2"/><path d="M24 14v10l7 4" stroke="#ff5f1f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="alg-option-text">
              <span class="alg-option-title">Permanent part time</span>
              <span class="alg-option-desc">Set weekdays, school hours available</span>
            </span>
            <span class="alg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          </button>
          <button type="button" class="alg-option" data-value="Full time">
            <span class="alg-option-icon" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 48 48" fill="none"><rect x="7" y="14" width="34" height="26" rx="4" stroke="currentColor" stroke-width="2"/><path d="M18 14v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="7" y1="25" x2="41" y2="25" stroke="#ff5f1f" stroke-width="2.6"/></svg></span>
            <span class="alg-option-text">
              <span class="alg-option-title">Full time</span>
              <span class="alg-option-desc">Monday to Friday, 8am–4pm</span>
            </span>
            <span class="alg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          </button>
          <button type="button" class="alg-option" data-value="Casual">
            <span class="alg-option-icon" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 48 48" fill="none"><rect x="8" y="11" width="32" height="30" rx="4" stroke="currentColor" stroke-width="2"/><line x1="8" y1="20" x2="40" y2="20" stroke="currentColor" stroke-width="2"/><rect x="14" y="26" width="7" height="7" rx="1.5" fill="#ff5f1f"/></svg></span>
            <span class="alg-option-text">
              <span class="alg-option-title">Casual</span>
              <span class="alg-option-desc">Flexible days, casual loading paid</span>
            </span>
            <span class="alg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          </button>
        </div>
      </section>

      <!-- STEP 2 · transport. A car is a hard requirement, so it is asked early
           rather than buried at the bottom of a form. -->
      <section class="alg-screen" data-step="transport" hidden>
        <h2 class="alg-q" tabindex="-1">Do you have a car and licence?</h2>
        <div class="alg-options" data-single="transport">
          <button type="button" class="alg-option" data-value="car_and_licence">
            <span class="alg-option-icon" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 48 48" fill="none"><path d="M9 30v-5l4-9a3 3 0 0 1 2.8-2h16.4A3 3 0 0 1 35 16l4 9v5" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="7" y="30" width="34" height="8" rx="2.5" stroke="currentColor" stroke-width="2"/><circle cx="15" cy="38" r="2.6" fill="#ff5f1f"/><circle cx="33" cy="38" r="2.6" fill="#ff5f1f"/></svg></span>
            <span class="alg-option-text">
              <span class="alg-option-title">Yes — car and licence</span>
              <span class="alg-option-desc">You'll drive between client homes</span>
            </span>
            <span class="alg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          </button>
          <button type="button" class="alg-option" data-value="licence_only">
            <span class="alg-option-icon" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 48 48" fill="none"><rect x="7" y="13" width="34" height="22" rx="3" stroke="currentColor" stroke-width="2"/><circle cx="17" cy="23" r="3.5" stroke="currentColor" stroke-width="2"/><line x1="26" y1="21" x2="36" y2="21" stroke="#ff5f1f" stroke-width="2.4" stroke-linecap="round"/><line x1="26" y1="27" x2="33" y2="27" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
            <span class="alg-option-text">
              <span class="alg-option-title">Licence, no car</span>
              <span class="alg-option-desc">Tell us more at the end</span>
            </span>
            <span class="alg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          </button>
          <button type="button" class="alg-option" data-value="public_transport">
            <span class="alg-option-icon" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 48 48" fill="none"><rect x="12" y="8" width="24" height="28" rx="4" stroke="currentColor" stroke-width="2"/><line x1="12" y1="26" x2="36" y2="26" stroke="currentColor" stroke-width="2"/><circle cx="17" cy="31" r="2" fill="#ff5f1f"/><circle cx="31" cy="31" r="2" fill="#ff5f1f"/><line x1="17" y1="40" x2="17" y2="36" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="31" y1="40" x2="31" y2="36" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
            <span class="alg-option-text">
              <span class="alg-option-title">Public transport only</span>
              <span class="alg-option-desc">Roles are limited without a car</span>
            </span>
            <span class="alg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          </button>
        </div>
      </section>

      <!-- STEP 3 · availability (multi-select) -->
      <section class="alg-screen" data-step="availability" hidden>
        <h2 class="alg-q" tabindex="-1">Which weekdays can you work?</h2>
        <p class="alg-help">Pick every day that suits. We ask for a minimum of two.</p>
        <div class="alg-options alg-options-compact" data-multi="availability">
          {weekdays.map((d) => (
            <button type="button" class="alg-option alg-option-compact" data-value={d}>
              <span class="alg-option-text"><span class="alg-option-title">{d}</span></span>
              <span class="alg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            </button>
          ))}
        </div>
        <button type="button" class="alg-btn alg-btn-primary" data-next disabled id="algAvailNext">
          <span>Continue</span>
          <span class="alg-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </button>
      </section>

      <!-- STEP 4 · experience -->
      <section class="alg-screen" data-step="experience" hidden>
        <h2 class="alg-q" tabindex="-1">How much cleaning experience do you have?</h2>
        <p class="alg-help">Preferred, not essential — training is paid either way.</p>
        <div class="alg-options alg-options-compact" data-single="experience">
          <button type="button" class="alg-option alg-option-compact" data-value="none"><span class="alg-option-text"><span class="alg-option-title">None — happy to learn</span></span><span class="alg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></button>
          <button type="button" class="alg-option alg-option-compact" data-value="under-1"><span class="alg-option-text"><span class="alg-option-title">Less than 1 year</span></span><span class="alg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></button>
          <button type="button" class="alg-option alg-option-compact" data-value="1-3"><span class="alg-option-text"><span class="alg-option-title">1–3 years</span></span><span class="alg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></button>
          <button type="button" class="alg-option alg-option-compact" data-value="3-plus"><span class="alg-option-text"><span class="alg-option-title">3+ years</span></span><span class="alg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></button>
        </div>
      </section>

      <!-- STEP 5 · contact -->
      <section class="alg-screen" data-step="contact" hidden>
        <h2 class="alg-q" tabindex="-1">How do we reach you?</h2>
        <div class="alg-field">
          <label class="alg-label" for="algName">Full name</label>
          <input class="alg-input" type="text" name="full_name" id="algName" autocomplete="name" placeholder="Your name" />
          <span class="alg-error" data-error-for="full_name"></span>
        </div>
        <div class="alg-field">
          <label class="alg-label" for="algPhone">Mobile</label>
          <input class="alg-input" type="tel" name="mobile" id="algPhone" autocomplete="tel" inputmode="tel" placeholder="0400 000 000" />
          <span class="alg-error" data-error-for="mobile"></span>
        </div>
        <div class="alg-field">
          <label class="alg-label" for="algEmail">Email</label>
          <input class="alg-input" type="email" name="email" id="algEmail" autocomplete="email" placeholder="you@example.com" />
          <span class="alg-error" data-error-for="email"></span>
        </div>
        <div class="alg-field">
          <label class="alg-label" for="algSuburb">Suburb &amp; postcode</label>
          <input class="alg-input" type="text" name="suburb_postcode" id="algSuburb" placeholder="e.g. Wauchope 2446" />
          <span class="alg-error" data-error-for="suburb_postcode"></span>
        </div>
        <button type="button" class="alg-btn alg-btn-primary" data-next>
          <span>Continue</span>
          <span class="alg-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </button>
      </section>

      <!-- STEP 6 · notes -->
      <section class="alg-screen" data-step="notes" hidden>
        <h2 class="alg-q" tabindex="-1">Anything else we should know?</h2>
        <textarea class="alg-input alg-textarea" name="message" id="algNotes" rows="3" placeholder="When you can start · Police Check or NDIS Worker Screening status · anything about your availability"></textarea>
        <p class="alg-error" id="algSendError" hidden></p>
        <button type="button" class="alg-btn alg-btn-primary alg-btn-final" id="algSubmit">
          <span>Send my application</span>
          <span class="alg-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </button>
        <button type="button" class="alg-skip" id="algSkip">Skip and send</button>
      </section>

      <!-- STEP 7 · done -->
      <section class="alg-screen" data-step="done" hidden>
        <div class="alg-done">
          <span class="alg-done-check" aria-hidden="true">✅</span>
          <h2 class="alg-heading">Application received.</h2>
          <p class="alg-lede">
            It's with your local coordinator now — expect a call within 48 hours.
            If you don't hear from us, ring <a href={site.phoneHref}>{site.phone}</a>.
          </p>
          <button type="button" class="alg-btn alg-btn-primary" id="algDone"><span>Done</span></button>
        </div>
      </section>
    </form>
  </div>
</div>

<script is:inline>
  // One pop-up per page; every [data-apply-cta] on the page opens it.
  (function () {
    var overlay = document.getElementById('algOverlay');
    if (!overlay) return;

    var form = document.getElementById('algForm');
    var chrome = document.getElementById('algChrome');
    var label = document.getElementById('algProgressLabel');
    var fill = document.getElementById('algProgressFill');
    var lede = document.getElementById('algLede');
    var sendError = document.getElementById('algSendError');
    var screens = {};
    var order = ['intro', 'hours', 'transport', 'availability', 'experience', 'contact', 'notes', 'done'];
    var QUESTIONS = 6; // everything between intro and done
    Array.prototype.forEach.call(form.querySelectorAll('.alg-screen'), function (s) {
      screens[s.getAttribute('data-step')] = s;
    });

    var answers = {};
    var ctx = { jobCity: '', formLocation: 'career-application' };
    var at = 0;
    var sending = false;
    var lastFocus = null;

    function show(i) {
      at = i;
      var step = order[i];
      order.forEach(function (name) { screens[name].hidden = name !== step; });
      var isQuestion = i > 0 && step !== 'done';
      chrome.hidden = !isQuestion;
      if (isQuestion) {
        label.textContent = 'Question ' + i + ' of ' + QUESTIONS;
        fill.style.width = Math.round((i / QUESTIONS) * 100) + '%';
      }
      var h = screens[step].querySelector('.alg-q, .alg-heading');
      if (h && h.focus) h.focus();
      screens[step].scrollTop = 0;
    }

    function next() { if (at < order.length - 1) show(at + 1); }

    function open(trigger) {
      lastFocus = document.activeElement;
      ctx.jobCity = (trigger && trigger.getAttribute('data-job-city')) || '';
      ctx.formLocation = (trigger && trigger.getAttribute('data-form-location')) || 'career-application';
      if (lede) {
        lede.innerHTML = ctx.jobCity
          ? 'Let’s get your application in for ' + ctx.jobCity + ' — about 60 seconds, six quick questions.'
          : 'Let’s get your application in — about 60 seconds, six quick questions.';
      }
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      show(0);
    }

    function close() {
      overlay.hidden = true;
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    document.addEventListener('click', function (ev) {
      var t = ev.target.closest ? ev.target.closest('[data-apply-cta]') : null;
      if (!t) return;
      ev.preventDefault();
      open(t);
    });

    document.getElementById('algClose').addEventListener('click', close);
    document.getElementById('algDone').addEventListener('click', close);
    overlay.addEventListener('click', function (ev) { if (ev.target === overlay) close(); });
    document.addEventListener('keydown', function (ev) {
      if (ev.key === 'Escape' && !overlay.hidden) close();
    });
    document.getElementById('algBack').addEventListener('click', function () { if (at > 0) show(at - 1); });
    document.getElementById('algStart').addEventListener('click', next);

    // Single-choice tiles answer and advance; multi-choice tiles toggle and
    // enable Continue. Same behaviour as the quote funnel.
    form.addEventListener('click', function (ev) {
      var opt = ev.target.closest ? ev.target.closest('.alg-option') : null;
      if (opt) {
        var group = opt.parentElement;
        var single = group.getAttribute('data-single');
        var multi = group.getAttribute('data-multi');
        if (single) {
          Array.prototype.forEach.call(group.children, function (b) { b.classList.remove('is-selected'); });
          opt.classList.add('is-selected');
          answers[single] = opt.getAttribute('data-value');
          setTimeout(next, 180);
        } else if (multi) {
          opt.classList.toggle('is-selected');
          var picked = [];
          Array.prototype.forEach.call(group.querySelectorAll('.is-selected'), function (b) {
            picked.push(b.getAttribute('data-value'));
          });
          answers[multi] = picked;
          var cont = document.getElementById('algAvailNext');
          if (cont) cont.disabled = picked.length === 0;
        }
        return;
      }
      var nextBtn = ev.target.closest ? ev.target.closest('[data-next]') : null;
      if (nextBtn) {
        if (order[at] === 'contact' && !validateContact()) return;
        next();
      }
    });

    function field(name) { return form.querySelector('[name="' + name + '"]'); }
    function setError(name, msg) {
      var el = form.querySelector('[data-error-for="' + name + '"]');
      var input = field(name);
      if (el) el.textContent = msg || '';
      if (input) input.setAttribute('aria-invalid', msg ? 'true' : 'false');
    }
    function validateContact() {
      var ok = true;
      var name = field('full_name').value.trim();
      var mobile = field('mobile').value.trim();
      var email = field('email').value.trim();
      var suburb = field('suburb_postcode').value.trim();
      setError('full_name', name ? '' : 'Please tell us your name.');
      setError('mobile', mobile.replace(/\D/g, '').length >= 8 ? '' : 'A mobile we can call you on.');
      setError('email', /.+@.+\..+/.test(email) ? '' : 'A valid email address.');
      setError('suburb_postcode', suburb ? '' : 'Which suburb do you live in?');
      [name, mobile, email, suburb].forEach(function () {});
      if (!name || mobile.replace(/\D/g, '').length < 8 || !/.+@.+\..+/.test(email) || !suburb) ok = false;
      if (!ok) {
        var firstBad = form.querySelector('.alg-screen:not([hidden]) [aria-invalid="true"]');
        if (firstBad) firstBad.focus();
      }
      return ok;
    }

    function uuid() {
      if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
        var r = (Math.random() * 16) | 0;
        return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
      });
    }

    function send() {
      if (sending) return;
      if (form.querySelector('[name="_gotcha"]').value) { show(order.length - 1); return; }
      sending = true;
      var btn = document.getElementById('algSubmit');
      btn.disabled = true;
      if (sendError) sendError.hidden = true;

      var payload = {
        name: field('full_name').value.trim(),
        email: field('email').value.trim(),
        phone: field('mobile').value.trim(),
        message: field('message').value.trim(),
        suburb_postcode: field('suburb_postcode').value.trim(),
        hours: answers.hours || '',
        experience: answers.experience || '',
        transport: answers.transport || '',
        availability: answers.availability || [],
        // Unchanged: the Inbox filters applications on these two values.
        service: 'Job application',
        lead_type: 'job_application',
        form_location: ctx.formLocation,
        job_city: ctx.jobCity,
        lead_id: uuid(),
        page: window.location.pathname,
      };

      function failed() {
        sending = false;
        btn.disabled = false;
        if (sendError) {
          sendError.textContent = window.naturoLeads && window.naturoLeads.failureMessage
            ? window.naturoLeads.failureMessage()
            : 'That didn’t send. Please call 1300 876 472.';
          sendError.hidden = false;
        }
      }

      if (!window.naturoLeads || typeof window.naturoLeads.deliver !== 'function') { failed(); return; }

      window.naturoLeads.deliver(payload).then(function (r) {
        if (r && r.delivered) {
          show(order.length - 1);
          try {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'generate_lead', { currency: 'AUD', value: 0, transaction_id: payload.lead_id, lead_type: 'job_application' });
            }
          } catch (e) {}
        } else { failed(); }
      }).catch(failed);
    }

    document.getElementById('algSubmit').addEventListener('click', send);
    document.getElementById('algSkip').addEventListener('click', function () {
      field('message').value = '';
      send();
    });
    form.addEventListener('submit', function (ev) { ev.preventDefault(); });
  })();
</script>
<style>
  /* ============================ Overlay + card ======================== */
  .alg-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(15, 23, 42, 0.55);
