---
import Layout from '../../layouts/Layout.astro';
import BlogBody from '../../components/BlogBody.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { posts, postsBySlug } from '../../data/posts';
import { site, ctaPrimary, ctaPhone } from '../../data/site';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = postsBySlug[slug as string];
if (!post) {
  throw new Error(`Unknown blog post slug: ${slug}`);
}

// Build related posts
const related = post.related
  .map((s) => postsBySlug[s])
  .filter(Boolean)
  .slice(0, 2);

const formattedDate = new Date(post.publishedDate).toLocaleDateString('en-AU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.title,
    description: post.metaDescription,
    image: {
      '@type': 'ImageObject',
      url: `${site.url}${post.heroImage}`,
      creator: { '@type': 'Organization', name: site.name },
      creditText: site.name,
      copyrightNotice: `© ${new Date().getFullYear()} ${site.name}`,
      license: `${site.url}/terms-of-service`,
      acquireLicensePage: `${site.url}/privacy-policies`,
    },
    author: { '@type': 'Organization', name: site.name, url: site.url },
    publisher: {
      '@type': 'Organization',
      name: site.name,
      logo: {
        '@type': 'ImageObject',
        url: `${site.url}/images/logo.png`,
        creator: { '@type': 'Organization', name: site.name },
        creditText: site.name,
        copyrightNotice: `© ${new Date().getFullYear()} ${site.name}`,
        license: `${site.url}/terms-of-service`,
        acquireLicensePage: `${site.url}/privacy-policies`,
      },
    },
    datePublished: post.publishedDate,
    dateModified: post.updatedDate ?? post.publishedDate,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${site.url}/resource/${post.slug}`,
    },
    articleSection: post.category,
    keywords: post.keywords.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: `${site.url}/resource` },
      { '@type': 'ListItem', position: 3, name: post.title, item: `${site.url}/resource/${post.slug}` },
    ],
  },
  // FAQPage schema only when the post has a faq section
  ...(() => {
    const faqSection = post.sections.find((s) => s.type === 'faq') as
      | { type: 'faq'; items: { q: string; a: string }[] }
      | undefined;
    if (!faqSection) return [];
    return [
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqSection.items.map((qa) => ({
          '@type': 'Question',
          name: qa.q,
          acceptedAnswer: { '@type': 'Answer', text: qa.a },
        })),
      },
    ];
  })(),
];
---

<Layout
  title={post.metaTitle}
  description={post.metaDescription}
  schema={schema}
>
  <!-- 1. Article hero -->
  <header class="post-hero">
    <div class="post-hero-bg" style={`background-image: url(${post.heroImage});`}></div>
    <div class="post-hero-overlay"></div>
    <div class="container-site post-hero-inner">
      <nav class="post-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/resource">Resources</a>
        <span aria-hidden="true">/</span>
        <span class="post-breadcrumb-current">{post.category}</span>
      </nav>
      <p class="post-hero-eyebrow">{post.category}</p>
      <h1 class="post-hero-h1">{post.title}</h1>
      <div class="post-hero-meta">
        <span>By {site.name}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.publishedDate}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{post.readMinutes} min read</span>
      </div>
    </div>
  </header>

  <!-- 2. Article body -->
  <article class="post-article">
    <div class="container-site post-article-inner">
      <p class="post-intro">{post.intro}</p>
      <BlogBody sections={post.sections} />
    </div>
  </article>

  <!-- 3. Related guides -->
  {related.length > 0 && (
    <section class="post-related" aria-labelledby="post-related-h2">
      <div class="container-site post-related-inner">
        <p class="post-related-eyebrow">Keep reading</p>
        <h2 id="post-related-h2" class="post-related-h2">Related guides</h2>
        <div class="post-related-grid">
          {related.map((r) => (
            <a class="post-related-card" href={`/resource/${r.slug}`}>
              <span class="post-related-cat">{r.category}</span>
              <h3 class="post-related-title">{r.title}</h3>
              <span class="post-related-arrow">Read article &rarr;</span>
            </a>
          ))}
        </div>
        <p class="post-related-back">
          <a href="/resource">&larr; Back to all guides</a>
        </p>
      </div>
    </section>
  )}

  <!-- 4. Final CTA -->
  <FinalCTA />
</Layout>

<style>
  /* ---------- Article hero ---------- */
  .post-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* Standard hero height — match across every page. */
    height: clamp(640px, 86vh, 800px);
    display: flex;
    align-items: center;
  }
  @media (max-width: 640px) {
    .post-hero { height: min(680px, 88dvh); }
  }
  .post-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: -2;
  }
  .post-hero-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, rgb(58, 77, 97) 20%, rgba(5, 170, 232, 0) 81%);
    opacity: 0.91;
    pointer-events: none;
    z-index: -1;
  }
  .post-hero-inner {
    padding-block: clamp(72px, 10vh, 128px);
    color: #ffffff;
    width: 100%;
  }
  .post-breadcrumb {
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .post-breadcrumb a {
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .post-breadcrumb a:hover { color: #ffffff; text-decoration: underline; }
  .post-breadcrumb-current {
    color: #ffffff;
    font-weight: 500;
  }
  .post-hero-eyebrow {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #FEB91C;
    margin: 0 0 18px;
  }
  .post-hero-h1 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(32px, 4.6vw, 56px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #ffffff;
    margin: 0 0 24px;
    max-width: 880px;
  }
  .post-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.85);
  }

  /* ---------- Article body ---------- */
  .post-article {
    background-color: #ffffff;
    padding: clamp(56px, 8vw, 96px) 0 clamp(72px, 10vw, 128px);
  }
  .post-article-inner {
    max-width: 720px;
  }
  .post-intro {
    font-family: "Poppins", sans-serif;
    font-size: clamp(18px, 1.4vw, 21px);
    font-weight: 300;
    line-height: 1.7;
    color: #0f172a;
    margin: 0 0 32px;
    padding: 0 0 28px;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  }

  /* ---------- Related ---------- */
  .post-related {
    background-color: #F8F8F3;
    padding: clamp(64px, 8vw, 96px) 0;
  }
  .post-related-inner { max-width: 1040px; }
  .post-related-eyebrow {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #3a5dff;
    margin: 0 0 12px;
  }
  .post-related-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: #0f172a;
    margin: 0 0 32px;
  }
  .post-related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }
  @media (max-width: 720px) {
    .post-related-grid { grid-template-columns: 1fr; }
  }
  .post-related-card {
    text-decoration: none;
    color: inherit;
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 14px;
    padding: 28px 24px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 4px 16px rgba(15, 23, 42, 0.05);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  }
  .post-related-card:hover {
    transform: translateY(-3px);
    background-color: #3a5dff;
    border-color: #3a5dff;
    box-shadow: 0 18px 36px rgba(58, 93, 255, 0.32);
  }
  .post-related-card:hover .post-related-cat,
  .post-related-card:hover .post-related-title,
  .post-related-card:hover .post-related-arrow { color: #ffffff; }
  .post-related-cat {
    font-family: "Poppins", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #3a5dff;
    margin-bottom: 12px;
    transition: color 0.25s ease;
  }
  .post-related-title {
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    color: rgb(28, 36, 75);
    margin: 0 0 14px;
    flex: 1;
    transition: color 0.25s ease;
  }
  .post-related-arrow {
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #3a5dff;
    transition: color 0.25s ease;
  }
  .post-related-back {
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    margin: 0;
  }
  .post-related-back a {
    color: #3a5dff;
    text-decoration: none;
    font-weight: 500;
  }
  .post-related-back a:hover { text-decoration: underline; }
</style>
