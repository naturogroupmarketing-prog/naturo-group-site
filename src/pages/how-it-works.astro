---
import Layout from '../layouts/Layout.astro';
import CTABanner from '../components/CTABanner.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FAQ from '../components/FAQ.astro';
import BookingCalendar from '../components/BookingCalendar.astro';
import { ctaPrimary, ctaPhone, site } from '../data/site';

const steps = [
  {
    n: '01',
    title: 'Get your instant price',
    body:
      'Tell us a few details about your home and the type of clean you need. Our calculator gives you a transparent price in 60 seconds — no callbacks, no hidden fees.',
  },
  {
    n: '02',
    title: 'Choose a date that suits you',
    body:
      'Pick the day you would like the cleaners to arrive. Same-week and recurring slots are usually available across NSW, Victoria and Queensland.',
  },
  {
    n: '03',
    title: 'We confirm your booking',
    body:
      'You receive an email and SMS confirmation with the cleaning team assigned to you, the start time and the inclusions.',
  },
  {
    n: '04',
    title: 'Police-checked cleaners arrive',
    body:
      'Our trained, fully insured team arrives on time with eco-friendly supplies and equipment. You do not need to be home — secure access can be arranged.',
  },
  {
    n: '05',
    title: 'You enjoy a spotless home',
    body:
      'After the clean we follow up to make sure everything met your expectations. If anything is missed, we make it right — that is our satisfaction guarantee.',
  },
];

const promises = [
  {
    title: 'Transparent pricing',
    body: 'See your price before you book. No surprise fees and no callback gauntlet to find out the cost.',
  },
  {
    title: 'Trained, consistent team',
    body: 'Wherever possible, the same cleaners return each visit. Familiarity builds trust and a better clean.',
  },
  {
    title: 'Eco-friendly products',
    body: 'Plant-based, non-toxic supplies that are safe for kids, pets, sensitive lungs — and the planet.',
  },
  {
    title: 'Insurance & police checks',
    body: 'Every cleaner is police-checked. We hold full public liability and workers compensation cover.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    '@id': `${site.url}/how-it-works#howto`,
    name: 'How to Book a Naturo Group Cleaning Service',
    description: 'Book an eco-friendly cleaning service in 5 easy steps — instant price, pick a date, meet your cleaners, and enjoy a spotless home.',
    totalTime: 'PT1M',
    step: steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.title,
      text: s.body,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${site.url}/how-it-works#webpage`,
    url: `${site.url}/how-it-works`,
    name: 'How Our Cleaning Service Works — 5 Easy Steps',
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'How It Works', item: `${site.url}/how-it-works` },
      ],
    },
  },
];
---

<Layout
  title="How Our Cleaning Service Works — 5 Easy Steps"
  description="Booking eco-friendly cleaning with Naturo Group takes about 60 seconds. Get an instant price, pick a date, meet your cleaners, and enjoy a spotless home — backed by our satisfaction guarantee."
  schema={schema}
>
  <section class="ph-hero">
    <div class="ph-bg" style="background-image: url(/images/hero-staff-bathroom.jpg);" aria-hidden="true"></div>
    <div class="ph-overlay" aria-hidden="true"></div>
    <div class="container-site ph-inner">
      <div class="ph-content">
        <p class="ph-eyebrow">How it works</p>
        <h1 class="ph-h1">From quote to clean<br />in five simple steps.</h1>
        <p class="ph-tagline">Booking an eco-friendly clean takes about 60 seconds.</p>
        <div class="ph-ctas">
          <a href={ctaPrimary.href} class="ph-btn-primary">
            <span>{ctaPrimary.text}</span>
            <span class="ph-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </a>
          <a href={ctaPhone.href} class="ph-btn-secondary">
            <span>{ctaPhone.text}</span>
            <span class="ph-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site max-w-3xl">
      <ol class="space-y-8">
        {steps.map((s) => (
          <li class="flex gap-5 md:gap-7 items-start">
            <span
              class="shrink-0 w-12 h-12 rounded-full border border-[var(--color-cyan)] text-[var(--color-cyan)] flex items-center justify-center font-medium"
              aria-hidden="true"
            >{s.n}</span>
            <div>
              <h2 class="text-xl text-[var(--color-navy)] font-semibold mb-2">{s.title}</h2>
              <p class="text-[var(--color-slate)] leading-relaxed">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-[var(--color-bg-pale)]">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="eyebrow mb-3">Our promise</p>
        <h2 class="text-3xl md:text-4xl text-[var(--color-navy)] font-light">
          What every Naturo clean includes.
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-6">
        {promises.map((p) => (
          <div class="bg-white rounded-2xl p-6 border border-[var(--color-border)]">
            <h3 class="text-lg font-semibold text-[var(--color-navy)] mb-2">{p.title}</h3>
            <p class="text-[var(--color-slate)]">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <BookingCalendar />
  <TrustBadges />
  <FAQ />
  <CTABanner />
</Layout>

<style>
  /* ===== Page Hero — matches homepage Hero.astro exactly ===== */
  .ph-hero { position: relative; overflow: hidden; padding-block: 0; }
  .ph-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center; background-repeat: no-repeat;
  }
  .ph-overlay {
    position: absolute; inset: 0;
    background-image: linear-gradient(90deg, rgb(58, 77, 97) 20%, rgba(5, 170, 232, 0) 81%);
    opacity: 0.91; pointer-events: none;
  }
  .ph-inner {
    position: relative; z-index: 1;
    height: clamp(640px, 86vh, 800px);
    padding-block: clamp(48px, 8vh, 96px);
    display: flex; align-items: center;
  }
  @media (max-width: 640px) {
    .ph-inner { height: min(680px, 88dvh); padding-block: 36px; }
  }
  .ph-content { width: 100%; max-width: 800px; }
  .ph-eyebrow {
    font-family: "Poppins", sans-serif; font-size: 12px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: #FEB91C; margin: 0 0 14px;
  }
  .ph-h1 {
    font-family: "Poppins", sans-serif; font-weight: 300;
    font-size: clamp(30px, 5.2vw, 66px); line-height: 1.08;
    letter-spacing: -0.015em; color: #ffffff; margin: 0;
  }
  .ph-tagline {
    font-family: "Poppins", sans-serif; font-weight: 400;
    font-size: clamp(15px, 1.6vw, 22px); line-height: 1.5;
    color: #FEB91C; margin-top: 16px; letter-spacing: 0.005em;
  }
  .ph-ctas {
    margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
  }
  @media (max-width: 500px) { .ph-ctas { flex-direction: column; align-items: stretch; } }
  .ph-btn-primary {
    display: inline-flex; align-items: center; justify-content: space-between; gap: 10px;
    background: linear-gradient(135deg, #4a6bff 0%, #2748f2 100%); color: #ffffff; border: 1px solid transparent;
    border-radius: 999px; padding: 6px 6px 6px 20px; font-size: 14px; font-weight: 500;
    font-family: "Poppins", sans-serif; line-height: 1; min-height: 44px;
    box-shadow: 0 4px 14px rgba(37, 72, 240, 0.32);
    text-decoration: none; transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .ph-btn-primary:hover {
    box-shadow: 0 8px 22px rgba(37, 72, 240, 0.45); transform: translateY(-1px);
  }
  .ph-btn-secondary {
    display: inline-flex; align-items: center; justify-content: space-between; gap: 10px;
    background: #ffffff; color: #1C244B; border: 1px solid transparent;
    border-radius: 999px; padding: 6px 6px 6px 20px; font-size: 15px; font-weight: 500;
    font-family: "Poppins", sans-serif; line-height: 1; min-height: 44px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
    text-decoration: none; transition: background-color 0.2s, color 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .ph-btn-secondary:hover { background: #ffffff; color: #1C244B; box-shadow: 0 6px 18px rgba(15, 23, 42, 0.22); }
  .ph-btn-icon {
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
    width: 32px; height: 32px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.6);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .ph-btn-icon svg { display: block; width: 14px; height: 14px; }
  .ph-btn-primary .ph-btn-icon { background-color: #ffffff; border-color: #ffffff; color: #1C244B; }
  .ph-btn-primary:hover .ph-btn-icon { background-color: transparent; border-color: rgba(255, 255, 255, 0.6); color: #ffffff; }
  .ph-btn-secondary .ph-btn-icon { border-color: rgba(58, 93, 255, 0.5); color: #3a5dff; }
  .ph-btn-secondary:hover .ph-btn-icon { background-color: #3a5dff; border-color: #3a5dff; color: #ffffff; }
</style>
