---
import { services } from '../data/site';

const icons: Record<string, string> = {
  home: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  sparkles: '<path d="M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2z"/><path d="M19 3v4M21 5h-4"/>',
  key: '<circle cx="8" cy="15" r="4"/><path d="M10.85 12.15L19 4M18 5l2 2M15 8l2 2"/>',
};
---

<section class="bg-white" id="services">
  <div class="container-site">
    <div class="max-w-2xl mb-12">
      <h2 class="text-3xl md:text-4xl text-[var(--color-navy)] font-light">Pick the clean that fits your week.</h2>
      <p class="mt-4 text-[var(--color-slate)]">Transparent pricing, no surprises. Same-day quote, online booking in 60 seconds.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {services.map((service) => (
        <article class="group relative bg-white border border-[var(--color-border)]/50 rounded-2xl p-8 hover:shadow-xl hover:border-[var(--color-cyan)]/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-cyan)]/10 text-[var(--color-cyan)] flex items-center justify-center mb-6">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[service.icon]} />
          </div>

          <h3 class="text-xl font-semibold text-[var(--color-navy)]">{service.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-slate)] leading-relaxed">{service.short}</p>

          <ul class="mt-5 space-y-2">
            {service.features.slice(0, 3).map((f) => (
              <li class="flex items-start gap-2 text-sm text-[var(--color-slate)]">
                <svg width="14" height="14" class="mt-1 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                {f}
              </li>
            ))}
          </ul>

          <div class="mt-6 pt-5 border-t border-[var(--color-border)]/50 flex items-center justify-end">
            <a href={`/services/${service.slug}`} class="text-sm font-medium text-[var(--color-navy)] group-hover:text-[var(--color-cyan)] inline-flex items-center gap-1">
              Learn more
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
