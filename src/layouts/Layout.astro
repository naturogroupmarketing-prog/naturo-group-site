---
import '../styles/global.css';
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
// Montserrat — closest free equivalent to NiCE's "Gotham" hero font (used on the hero H1).
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteLeadGate from '../components/QuoteLeadGate.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';
import { site, founder } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = site.description,
  ogImage = '/og-default.jpg',
  noindex = false,
  schema,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const isHome = Astro.url.pathname === '/';

// ---------------------------------------------------------------------------
// Site-wide Organization entity.
//
// Every page carried a LocalBusiness or Service block, but nothing tied them
// together into one identifiable business. A generative engine deciding
// whether "NATURO GROUP" on this page is the same NATURO GROUP it saw on
// Facebook, YouTube or a directory had nothing to join on — no stable @id, and
// no sameAs. Entity confidence is what decides whether an assistant will name
// a business in an answer rather than describe it vaguely, so this is the
// difference between being cited and being paraphrased away.
//
// The @id is a fragment on the homepage URL, which is the conventional stable
// identifier. Per-page LocalBusiness blocks point back at it, so all 453 pages
// resolve to one entity instead of 453 unrelated businesses.
//
// sameAs lists only profiles verified to return 200. An unreachable sameAs is
// worse than none: it invites the engine to distrust the whole block.
// ---------------------------------------------------------------------------
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: `${site.url}/images/logo.png`,
  description: site.description,
  email: site.email,
  telephone: site.phone,
  slogan: site.tagline,
  founder: {
    '@type': 'Person',
    name: founder.name,
    jobTitle: founder.role,
  },
  areaServed: { '@type': 'Country', name: 'Australia' },
  sameAs: [site.social.facebook, site.social.instagram, site.social.youtube],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.phone,
    email: site.email,
    contactType: 'customer service',
    areaServed: 'AU',
    availableLanguage: 'en',
  },
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="/Favicon_NG.png" />
<meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {isHome && (
      <link rel="preload" as="image" href="/images/hero-staff-bathroom.webp" fetchpriority="high" />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).toString()} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, site.url).toString()} />
    <meta name="twitter:site" content="@naturogroup" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    {/* Measurement core — must load before QuoteLeadGate so every lead path
        can call window.naturoAnalytics. See docs/analytics/MEASUREMENT_PLAN.md */}
    <Analytics />
    <TopBar />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <QuoteLeadGate />
    <CookieConsent />

    <!-- ----------------------------------------------------------------
         Contact-intent tracker. Delegated at document level so every
         tel:/mailto: link on the site attributes the same way — hero,
         header, sticky mobile bar, suburb pages, footer.

         Two corrections vs the previous version:
          * It now genuinely checks consent. The old comment claimed it was
            "consent-gated by design" but it only depended on fbq/gtag
            existing, so a returning visitor still pushed to dataLayer
            before any consent check ran.
          * The phone number is no longer sent. A phone number is personal
            information; the CTA's page context is what's actually useful
            for reporting, and GA4 forbids PII.
         ---------------------------------------------------------------- -->
    <script is:inline>
      (function () {
        function handle(ev) {
          var t = ev.target;
          var a = t && t.closest ? t.closest('a[href^="tel:"], a[href^="mailto:"]') : null;
          if (!a) return;
          var na = window.naturoAnalytics;
          if (!na || !na.consentGranted()) return;
          var href = a.getAttribute('href') || '';
          var isPhone = href.indexOf('tel:') === 0;
          try {
            na.track(isPhone ? 'phone_click' : 'email_click', {
              cta_text: (a.textContent || '').trim().slice(0, 80),
              page_path: window.location.pathname,
            });
            if (typeof window.fbq === 'function') window.fbq('track', 'Contact');
          } catch (e) { /* best-effort */ }
        }
        document.addEventListener('click', handle, true);
      })();
    </script>

    {/* Sophiie AI chat widget (chat bubble + lead form) — loaded async from the
        receptionist app; manage it in the Sophiie dashboard → Settings →
        Website widgets.
        TEMPORARILY HIDDEN 2026-08-02 (user request: "hide chatbot for now").
        To bring it back, un-comment the <script> line below. */}
    {/* <script src="https://receptionist.naturogroup.com.au/api/widget/embed" async is:inline></script> */}
  </body>
</html>
