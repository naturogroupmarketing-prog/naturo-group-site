---
import { site, ctaPrimary, ctaPhone } from '../data/site';

const slides = [
  '/images/hero-staff-bathroom.webp',
  '/images/hero-kitchen.webp',
  '/images/hero-ocean.webp',
];
---

<section class="hero relative overflow-hidden">
  <div class="hero-slides absolute inset-0">
    {slides.map((src) => (
      <div
        class="hero-slide"
        style={`background-image: url(${src});`}
      />
    ))}
  </div>
  <div class="hero-overlay absolute inset-0"></div>

  <div class="relative container-site hero-inner flex items-center">
    <!-- w-full so the content stretches to fill the flex parent on
         narrow viewports — without it, this div sizes to its widest
         child (the H1), causing CTAs to render ~30px narrower than
         the matching CTAs in the other banner sections. The max-width
         still caps the column on desktop. -->
    <div class="w-full max-w-[800px]">
      <h1 class="hero-h1" style="color:#ffffff;">
        <span class="hero-h1-kicker">Eco-friendly</span>House Cleaning<br />in Australia
      </h1>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="hero-cta-stack">
        <a href={ctaPrimary.href} class="hero-btn-primary">
          <span>{ctaPrimary.text}</span>
          <span class="hero-btn-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>
        <a href={ctaPhone.href} class="hero-btn-secondary">
          <span>{ctaPhone.text}</span>
          <span class="hero-btn-icon" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
        </a>
      </div>
      <div class="hero-partners">
        <p class="hero-partners-label">Partners &amp; Providers</p>
        <img src="/images/partners-composite.webp" alt="Partners and providers: NRMA, phsa, ipar, Allianz, QBE" class="hero-partners-img" width="300" height="156" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 0;
  }
  .hero-inner {
    /* Compact hero — between the too-short 72vh and full-screen. */
    height: clamp(600px, 84vh, 760px);
    padding-block: clamp(48px, 8vh, 96px);
  }
  /* On phones the sidebar header + sticky bottom bar already eat ~120px
     of viewport, so a 560px hero pushes the next section well below the
     fold. Cap to ~88dvh so the partner row peeks above the fold. */
  @media (max-width: 640px) {
    .hero-inner {
      height: min(680px, 88dvh);
      padding-block: 36px;
    }
  }
  .hero-h1 {
    /* Matched to NiCE's hero H1 (NiCE Gotham, 64px, medium, lh1.1, -1.5px).
       Gotham is a paid font; Montserrat is the closest free equivalent.
       NiCE's heading is medium weight (not bold) — Montserrat also renders
       a touch heavier than Gotham, so 500 best matches the visual. */
    font-family: "Montserrat", "Poppins", sans-serif;
    font-weight: 500;
    /* NiCE renders Gotham at 64px; Montserrat is visually larger at the
       same px, so 58px matches the apparent size. */
    font-size: clamp(32px, 5vw, 58px);
    line-height: 1.1;
    letter-spacing: -0.023em;
    margin: 0;
  }
  /* "Eco-friendly" is a small kicker above the headline so "House Cleaning
     in Australia" carries the visual weight. */
  .hero-h1-kicker {
    display: block;
    font-size: clamp(16px, 2vw, 24px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.005em;
    margin-bottom: 6px;
  }
  .hero-tagline {
    font-family: "Poppins", sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: clamp(15px, 1.6vw, 22px);
    line-height: 1.5;
    color: #FEB91C;
    margin-top: 16px;
    letter-spacing: 0.005em;
  }
  .hero-cta-stack {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  @media (max-width: 500px) {
    .hero-cta-stack { flex-direction: column; align-items: stretch; }
  }
  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: linear-gradient(135deg, #4a6bff 0%, #2748f2 100%);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Poppins", "Helvetica", sans-serif;
    line-height: 1;
    letter-spacing: 0.01em;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(37, 72, 240, 0.32);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .hero-btn-primary:hover {
    box-shadow: 0 8px 22px rgba(37, 72, 240, 0.45);
    transform: translateY(-1px);
  }
  /* Primary (gradient) — circle is solid white (dark arrow) by default and
     becomes a white outline (white arrow) on hover. */
  .hero-btn-primary .hero-btn-icon {
    background-color: #ffffff;
    border-color: #ffffff;
    color: #1C244B;
  }
  .hero-btn-primary:hover .hero-btn-icon {
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.6);
    color: #ffffff;
  }
  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background-color: #ffffff;
    color: #1C244B;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-size: 15px;
    font-weight: 500;
    font-family: "Poppins", "Helvetica", sans-serif;
    line-height: 1;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  /* NiCE-style circular icon at the right of each hero button */
  .hero-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .hero-btn-icon svg { display: block; width: 14px; height: 14px; }
  /* Phone button (white) — blue outline circle that fills solid blue on hover */
  .hero-btn-secondary .hero-btn-icon {
    border-color: rgba(58, 93, 255, 0.5);
    color: #3a5dff;
  }
  .hero-btn-secondary:hover {
    background-color: #ffffff;
    color: #1C244B;
    border-color: transparent;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.22);
  }
  .hero-btn-secondary:hover .hero-btn-icon {
    background-color: #3a5dff;
    border-color: #3a5dff;
    color: #ffffff;
  }

  .hero-overlay {
    background-image: linear-gradient(90deg, rgb(58, 77, 97) 20%, rgba(58, 77, 97, 0) 88%);
    opacity: 0.91;
    pointer-events: none;
  }

  /* ------------------------------------------------------------------
     Hero crossfade.

     The slides are stacked, so the obvious approach — every slide runs
     the same fade on a staggered delay — leaves a gap: mid-crossfade
     both layers sit near 50% opacity, and stacked alpha compositing
     means coverage is only 1-(1-.5)(1-.5) = 75%. Measured on the old
     version it bottomed out at 69%, so the page background bled through
     three times a loop. The overlay is transparent over the right of
     the hero, so that read as a white flash every ~5s.

     Fix: keep something fully opaque at all times. Slide 1 is the
     permanent base; slide 2 fades in on top of it; slide 3 fades in on
     top of that; then slide 3 fades back out to reveal slide 1 again.
     Slide 2 is reset to 0 while it sits hidden beneath an opaque slide
     3, so the reset is never seen. Coverage stays at exactly 1 for the
     whole loop, which is what makes the fades read as smooth.

     Timings assume the 3 slides above on a 15s loop: each image holds
     alone for 3.85s with 1.15s crossfades between, so all three get an
     equal turn. Percentages are of 15s (1s = 6.667%).
     ------------------------------------------------------------------ */
  .hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
  }
  /* Base layer — always visible. The layers above hide it when opaque,
     and it's what slide 3 fades back to at the end of the loop. Also
     means the correct image is painted on first load, with no flash. */
  .hero-slide:nth-child(1) { opacity: 1; }
  .hero-slide:nth-child(2),
  .hero-slide:nth-child(3) {
    animation-duration: 15s;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
    will-change: opacity;
  }
  .hero-slide:nth-child(2) { animation-name: heroSlide2; }
  .hero-slide:nth-child(3) { animation-name: heroSlide3; }

  @keyframes heroSlide2 {
    0%, 25.667%  { opacity: 0; }  /* 0-3.85s  slide 1 showing alone */
    33.333%      { opacity: 1; }  /* 5.0s     faded in over slide 1 */
    66.667%      { opacity: 1; }  /* 10.0s    slide 3 now covers it */
    67.333%, 100%{ opacity: 0; }  /* reset while hidden underneath */
  }
  @keyframes heroSlide3 {
    0%, 59%      { opacity: 0; }  /* 8.85s */
    66.667%      { opacity: 1; }  /* 10.0s    faded in over slide 2 */
    92.333%      { opacity: 1; }  /* 13.85s */
    100%         { opacity: 0; }  /* 15s      faded out to slide 1 */
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide { animation: none; }
    .hero-slide:nth-child(1) { opacity: 1; }
  }

  .hero-partners {
    margin-top: 40px;
  }
  .hero-partners-label {
    font-family: "Poppins", sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #ffffff;
    margin: 0 0 14px;
  }
  .hero-partners-img {
    width: 280px;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
    opacity: 0.6;
  }
  @media (max-width: 640px) {
    /* Hide the Partners & Providers logo strip on mobile */
    .hero-partners { display: none; }
  }
</style>
