---
interface Props {
  kicker?: string;
  heading: string;
  body: string[];
  stats?: { num: string; label: string }[];
}

const { kicker = 'About this service', heading, body, stats } = Astro.props;
---

<section class="svc-intro-section">
  <div class="container-site svc-intro-inner">
    <div class="svc-intro-col svc-intro-col-left">
      <h2 class="svc-intro-h2">{heading}</h2>
    </div>
    <div class="svc-intro-col svc-intro-col-right">
      {body.map((p) => <p class="svc-intro-body" set:html={p} />)}
      {stats && stats.length > 0 && (
        <div class="svc-intro-stats">
          {stats.map((s) => (
            <div class="svc-intro-stat">
              <span class="svc-intro-stat-num" set:html={s.num} />
              <span class="svc-intro-stat-label">{s.label}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .svc-intro-section {
    background-color: #ffffff;
    padding: clamp(88px, 10vw, 128px) 0;
  }
  .svc-intro-inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .svc-intro-inner { grid-template-columns: 1fr; gap: 24px; }
  }
  .svc-intro-col-left {
    position: sticky;
    top: 96px;
  }
  @media (max-width: 860px) {
    .svc-intro-col-left { position: static; }
  }
  .svc-intro-kicker {
    display: inline-block;
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #3a5dff;
    margin: 0 0 14px;
  }
  .svc-intro-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #0f172a;
    margin: 0;
  }
  .svc-intro-body {
    font-family: "Poppins", sans-serif;
    font-size: clamp(16px, 1.3vw, 18px);
    font-weight: 400;
    line-height: 1.5;
    color: rgb(91, 94, 102);
    margin: 0 0 18px;
  }
  .svc-intro-body:last-of-type { margin-bottom: 32px; }
  .svc-intro-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
  }
  @media (max-width: 540px) {
    .svc-intro-stats { grid-template-columns: 1fr; gap: 20px; }
  }
  .svc-intro-stat { display: flex; flex-direction: column; gap: 4px; }
  .svc-intro-stat-num {
    font-family: "Poppins", sans-serif;
    font-size: clamp(24px, 2.4vw, 30px);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #0f172a;
    line-height: 1.1;
  }
  .svc-intro-stat-label {
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgb(71, 85, 105);
    line-height: 1.3;
  }
</style>
