---
import { pricingCards } from '../data/site';
---

<section class="pricing-section">
  <div class="pricing-head">
    <h2 class="pricing-h2">Choose your clean</h2>
    <p class="pricing-sub">
      Pick your perfect house cleaning service. Eco-friendly products, police-checked cleaners, and flexible scheduling on every visit.
    </p>
  </div>

  <div class="pricing-grid">
    {pricingCards.map((card) => (
      <div class={`pricing-card ${card.featured ? 'is-featured' : ''}`}>
        {card.featured && <div class="pricing-badge">MOST POPULAR</div>}
        <div class="pricing-card-body">
          <h3 class="pricing-card-name">{card.name}</h3>
          <p class="pricing-card-desc">{card.bullets[0]}</p>
          <div class="pricing-card-price">
            <span class="pricing-currency">$</span><span class="pricing-integer">{card.priceFrom}</span><span class="pricing-unit">/from</span>
          </div>
          <ul class="pricing-features">
            {card.bullets.slice(1).map((b) => (
              <li>
                <svg class="pricing-tick" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="pricing-footer">
          <a href={card.cta.href} class={`pricing-btn ${card.featured ? 'is-primary' : ''}`}>{card.cta.text}</a>
        </div>
      </div>
    ))}
  </div>

  <div class="pricing-trust">
    <div class="pricing-trust-item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Police-checked cleaners
    </div>
    <div class="pricing-trust-item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      60-second online booking
    </div>
    <div class="pricing-trust-item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      Satisfaction guarantee
    </div>
    <div class="pricing-trust-item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 11V7a5 5 0 0 1 10 0v4"/><rect x="3" y="11" width="18" height="11" rx="2"/></svg>
      Fully insured
    </div>
  </div>
</section>

<style>
  .pricing-section {
    background-color: #ffffff;
    padding: clamp(88px, 10vw, 128px) 20px;
  }
  .pricing-head {
    max-width: 720px;
    margin: 0 auto clamp(40px, 5vw, 64px);
    text-align: center;
  }
  .pricing-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #0f172a;
    margin: 0 0 16px;
  }
  .pricing-sub {
    font-family: "Poppins", sans-serif;
    font-size: clamp(16px, 1.4vw, 18px);
    font-weight: 300;
    line-height: 1.6;
    color: rgb(100, 116, 139);
    margin: 0;
  }
  .pricing-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 20px;
    max-width: 1120px;
    margin: 0 auto;
  }
  .pricing-card {
    position: relative;
    width: 353px;
    max-width: 100%;
    min-height: 550px;
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 14px;
    padding: 40px 32px 32px;
    display: flex;
    flex-direction: column;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 4px 16px rgba(15, 23, 42, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .pricing-card:hover {
    transform: translateY(-3px);
    background-color: #3a5dff;
    border-color: #3a5dff;
    box-shadow:
      0 2px 4px rgba(15, 23, 42, 0.06),
      0 18px 36px rgba(58, 93, 255, 0.32);
  }
  .pricing-card:hover .pricing-card-name,
  .pricing-card:hover .pricing-card-desc,
  .pricing-card:hover .pricing-currency,
  .pricing-card:hover .pricing-integer,
  .pricing-card:hover .pricing-unit,
  .pricing-card:hover .pricing-features li {
    color: #ffffff;
  }
  .pricing-card:hover .pricing-tick {
    color: #ffffff;
  }
  .pricing-card:hover .pricing-btn {
    background-color: #ffffff;
    border-color: #ffffff;
    color: #3a5dff;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.18);
  }
  .pricing-card:hover .pricing-btn:hover {
    background-color: #f1f4ff;
    border-color: #f1f4ff;
    color: #2548f0;
  }
  .pricing-card:hover .pricing-badge {
    background-color: #ffffff;
    color: #3a5dff;
    border-color: #ffffff;
  }
  .pricing-card.is-featured {
    border: 1.5px solid rgba(58, 93, 255, 0.5);
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 10px 28px rgba(58, 93, 255, 0.14);
  }
  .pricing-card.is-featured:hover {
    border-color: #3a5dff;
    box-shadow:
      0 2px 4px rgba(15, 23, 42, 0.06),
      0 18px 36px rgba(58, 93, 255, 0.32);
  }
  .pricing-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background-color: #3a5dff;
    color: #ffffff;
    font-family: "Poppins", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 9px 18px;
    border: 1px solid #3a5dff;
    border-radius: 6px;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 4px 12px rgba(58, 93, 255, 0.35);
  }
  .pricing-card-body {
    flex: 1;
  }
  .pricing-card-name {
    font-family: "Poppins", sans-serif;
    font-size: 26px;
    font-weight: 500;
    line-height: 1.2;
    color: #000000;
    margin: 0 0 10px;
  }
  .pricing-card-desc {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.55;
    color: rgb(100, 116, 139);
    margin: 0 0 28px;
    min-height: 70px;
  }
  .pricing-card-price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 2px;
    margin: 0 0 28px;
    text-align: center;
  }
  .pricing-currency {
    font-family: "Poppins", sans-serif;
    font-size: 54px;
    font-weight: 300;
    color: #000000;
    line-height: 1;
  }
  .pricing-integer {
    font-family: "Poppins", sans-serif;
    font-size: 54px;
    font-weight: 300;
    color: #000000;
    line-height: 1;
  }
  .pricing-unit {
    font-family: "Poppins", sans-serif;
    font-size: 16px;
    font-weight: 300;
    color: rgb(100, 116, 139);
    margin-left: 4px;
  }
  .pricing-features {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pricing-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.5;
    color: #000000;
    text-align: left;
  }
  .pricing-tick {
    color: #3a5dff;
    flex-shrink: 0;
    margin-top: 3px;
  }
  .pricing-footer {
    margin-top: auto;
    display: flex;
    justify-content: center;
  }
  /* Match the hero primary button exactly so every pricing card CTA reads
     as the same brand button. The featured card is already differentiated
     by its "MOST POPULAR" badge and elevated shadow. */
  .pricing-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: "Poppins", "Helvetica", sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #ffffff;
    background-color: #3a5dff;
    border: 1px solid #3a5dff;
    border-radius: 6px;
    padding: 14px 26px;
    min-height: 46px;
    line-height: 1;
    box-shadow: 0 4px 12px rgba(58, 93, 255, 0.28);
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .pricing-btn:hover {
    background-color: #2548f0;
    border-color: #2548f0;
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(58, 93, 255, 0.4);
    transform: translateY(-1px);
  }
  /* .is-primary kept for backward compat — same look as base. */
  .pricing-btn.is-primary {
    background-color: #3a5dff;
    border-color: #3a5dff;
    color: #ffffff;
  }

  .pricing-trust {
    max-width: 1100px;
    margin: 56px auto 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 32px;
  }
  .pricing-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: rgb(100, 116, 139);
  }
  .pricing-trust-item svg {
    color: rgb(148, 163, 184);
  }

  @media (max-width: 640px) {
    .pricing-section { padding: 40px 16px; }
    .pricing-h2 { font-size: 24px; }
    .pricing-card { padding: 24px 20px 20px; min-height: unset; }
    .pricing-currency, .pricing-integer { font-size: 38px; }
    .pricing-card-price { margin: 0 0 18px; }
    .pricing-features { gap: 8px; margin-bottom: 20px; }
    .pricing-features li { font-size: 14px; }
    .pricing-card-name { font-size: 20px; }
    .pricing-card-desc { font-size: 13px; margin-bottom: 12px; }
  }
</style>
