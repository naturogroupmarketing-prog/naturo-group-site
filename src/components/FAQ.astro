---
import { faqs as defaultFaqs } from '../data/site';

interface FaqItem { q: string; a: string }
interface Props {
  /** Optional override list — eg. per-suburb FAQs from suburbs.ts. */
  items?: FaqItem[];
  /** Optional eyebrow override — defaults to "FAQ". */
  eyebrow?: string;
  /** Optional sub-heading override — defaults to "Frequently asked Questions". */
  subheading?: string;
}

const { items, eyebrow = 'FAQ', subheading = 'Frequently asked Questions' } = Astro.props;
const faqs = items ?? defaultFaqs;
---

<section class="faq-section">
  <div class="container-site faq-inner">
    <div class="faq-head">
      <h2 class="faq-sub">{subheading}</h2>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <details class="faq-item" name="naturo-faq">
          <summary class="faq-summary">
            <span class="faq-q">{item.q}</span>
            <span class="faq-icon faq-icon-plus" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><polygon points="8.39 7.64 8.39 0 7.61 0 7.61 7.64 0 7.64 0 8.4 7.61 8.4 7.61 16 8.39 16 8.39 8.4 16 8.4 16 7.64 8.39 7.64"/></svg>
            </span>
            <span class="faq-icon faq-icon-minus" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="2" y="7" width="12" height="2" rx="1"/></svg>
            </span>
          </summary>
          <div class="faq-content" set:html={item.a} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    background-color: #ffffff;
    padding: clamp(88px, 10vw, 128px) 0;
  }
  .faq-inner { max-width: 1100px; }
  .faq-head {
    margin-bottom: clamp(32px, 4vw, 48px);
    max-width: 720px;
  }
  /* "Frequently asked Questions" — a standard section <h2>; the global h2
     rule supplies the uniform heading typography, so only colour/margin here. */
  .faq-sub {
    color: #0f172a;
    margin: 0;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  /* NiCE-style accordion: no cards — a thin left accent rail per item, a
     grey question that turns bold-black when open, and a circular +/-
     toggle (pale-grey "+" → solid-black "−"). */
  .faq-item {
    background: none;
    border: none;
    border-left: 2px solid #e5e7eb;
    border-radius: 0;
    margin: 0;
  }
  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 17px 4px 17px 22px;
    cursor: pointer;
    list-style: none;
  }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-q {
    font-family: "Poppins", sans-serif;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.005em;
    color: #9ca3af;
    flex: 1;
    transition: color 0.2s ease;
  }
  .faq-item:hover .faq-q { color: #6b7280; }
  .faq-item[open] .faq-q {
    color: #0f172a;
    font-weight: 700;
  }
  .faq-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background-color: #f0f0f2;
    color: #9ca3af;
    flex-shrink: 0;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .faq-icon svg { width: 13px; height: 13px; }
  .faq-item:hover .faq-icon { background-color: #e6e6ea; color: #6b7280; }
  .faq-item[open] .faq-icon {
    background-color: #1d1d1f;
    color: #ffffff;
  }
  .faq-icon-minus { display: none; }
  .faq-item[open] .faq-icon-plus { display: none; }
  .faq-item[open] .faq-icon-minus { display: inline-flex; }
  .faq-content {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.55;
    color: rgb(91, 94, 102);
    padding: 2px 22px 20px 22px;
    max-width: 660px;
  }
</style>
