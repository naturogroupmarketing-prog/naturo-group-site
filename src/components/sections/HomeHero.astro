---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import { ctaPrimary, site } from '../../data/site';
---

<section class="hero" aria-label="Hero">
  <Container width="wide">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="hero-pretitle">
          <Badge tone="cyan" size="md">Eco-friendly · Police-checked · Insured</Badge>
        </div>
        <h1 class="hero-h1">Eco-friendly house cleaning, trusted across Australia.</h1>
        <p class="hero-sub">
          Police-checked cleaners. NDIS, Aged Care, DVA &amp; insurance jobs welcome. Non-toxic products that
          are safe for children and pets — every clean.
        </p>
        <div class="hero-ctas">
          <Button href={ctaPrimary.href} class="js-quote-cta" variant="primary" size="lg">{ctaPrimary.text}</Button>
          <Button href={site.phoneHref} variant="secondary" size="lg">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {site.phone}
          </Button>
        </div>
        <ul class="hero-trust" aria-label="Trust signals">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Police-checked cleaners
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Fully insured
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Eco-friendly products
          </li>
        </ul>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <img src="/images/hero-bathroom-wide.webp" alt="" width="900" height="700" fetchpriority="high" decoding="async" />
        <div class="hero-visual-glow"></div>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    background:
      radial-gradient(ellipse at top right, rgba(36, 210, 242, 0.06), transparent 55%),
      linear-gradient(180deg, var(--c-cream) 0%, var(--c-bg) 100%);
    padding-block: clamp(40px, 6vw, 72px) clamp(56px, 8vw, 96px);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
  }

  .hero-pretitle {
    margin-bottom: var(--s-5);
  }
  .hero-h1 {
    font-family: var(--font-sans);
    font-size: var(--fs-display);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--c-navy);
    margin: 0 0 var(--s-5);
    max-width: 18ch;
  }
  @media (max-width: 900px) {
    .hero-h1 { max-width: none; }
  }
  .hero-sub {
    font-family: var(--font-sans);
    font-size: var(--fs-body-lg);
    font-weight: 300;
    line-height: var(--lh-relaxed);
    color: var(--c-slate);
    margin: 0 0 var(--s-8);
    max-width: 48ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-bottom: var(--s-8);
  }
  .hero-trust {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-6);
  }
  .hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    color: var(--c-slate);
  }
  .hero-trust svg { color: var(--c-cyan-700); flex-shrink: 0; }

  .hero-visual {
    position: relative;
    isolation: isolate;
  }
  .hero-visual img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-md);
    position: relative;
    z-index: 1;
  }
  .hero-visual-glow {
    position: absolute;
    inset: 8% -8% -8% 8%;
    background: linear-gradient(135deg, rgba(36, 210, 242, 0.18), rgba(28, 36, 75, 0.06));
    border-radius: var(--r-xl);
    z-index: 0;
    filter: blur(2px);
  }
  @media (max-width: 900px) {
    .hero-visual img { aspect-ratio: 16 / 11; }
  }
</style>
