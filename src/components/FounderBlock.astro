---
import { founder, ctaPrimary, ctaPhone, site } from '../data/site';
interface Props { body?: string[] }
const { body = founder.body } = Astro.props;
---

<section class="founder-section">
  <div class="container-site founder-grid">
    <div class="founder-media">
      <div class="founder-portrait">
        <div class="founder-dots" aria-hidden="true">
          <svg width="96" height="96" viewBox="0 0 96 96" fill="none">
            {Array.from({ length: 6 }).map((_, row) =>
              Array.from({ length: 6 }).map((_, col) => (
                <circle cx={8 + col * 16} cy={8 + row * 16} r="2" fill="#3a5dff" fill-opacity="0.35" />
              ))
            )}
          </svg>
        </div>
        <img
          src={founder.image}
          alt={founder.imageAlt}
          width="276"
          height="382"
          class="founder-image"
          loading="lazy"
        />
        <div class="founder-chip" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Nursing-led care</span>
        </div>
      </div>
    </div>

    <div class="founder-content">
      <h2 class="founder-h2">Transforming standards in the cleaning industry</h2>
      {body.map((p) => <p class="founder-body">{p}</p>)}

      <div class="founder-signature">
        <div class="founder-signature-bar" aria-hidden="true"></div>
        <div class="founder-signature-text">
          <span class="founder-name">{founder.name}</span>
          <span class="founder-role">{founder.role}</span>
        </div>
      </div>

      <div class="founder-ctas">
        <a href={ctaPrimary.href} data-quote-cta class="founder-btn-primary">
          <span>{ctaPrimary.text}</span>
          <span class="founder-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </a>
        <a href={site.phoneHref} class="founder-btn-secondary">
          <span>{ctaPhone.text}</span>
          <span class="founder-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .founder-section {
    background-color: #EFEEE9;
    padding: clamp(88px, 10vw, 128px) 0;
  }
  .founder-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  @media (max-width: 860px) {
    .founder-grid { grid-template-columns: 1fr; gap: 40px; }
  }
  .founder-media {
    display: flex;
    justify-content: center;
  }
  .founder-portrait {
    position: relative;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .founder-dots {
    position: absolute;
    top: 6%;
    right: -10px;
    z-index: 0;
    opacity: 0.9;
    pointer-events: none;
  }
  .founder-image {
    position: relative;
    z-index: 1;
    width: 88%;
    height: auto;
    display: block;
    filter: drop-shadow(0 20px 30px rgba(15, 23, 42, 0.18));
  }
  .founder-chip {
    position: absolute;
    bottom: 18px;
    left: -12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 999px;
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    font-weight: 500;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 10px 24px rgba(15, 23, 42, 0.08);
  }
  .founder-chip svg {
    color: #3a5dff;
    flex-shrink: 0;
  }
  @media (max-width: 860px) {
    .founder-portrait { max-width: 320px; }
  }
  @media (max-width: 600px) {
    .founder-section { padding: 48px 0; }
    .founder-portrait { max-width: 180px; }
    .founder-h2 { font-size: 26px; }
  }
  .founder-kicker {
    display: inline-block;
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #3a5dff;
    margin: 0 0 14px;
  }
  .founder-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #0f172a;
    margin: 0 0 24px;
  }
  @media (max-width: 768px) {
    .founder-h2 { font-size: 32px; line-height: 1.2; }
  }
  .founder-body {
    font-family: "Poppins", sans-serif;
    font-size: clamp(15px, 1.2vw, 17px);
    font-weight: 400;
    line-height: 1.5;
    color: rgb(91, 94, 102);
    margin: 0 0 16px;
  }
  .founder-signature {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 28px 0 0;
    padding-top: 24px;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
  }
  .founder-signature-bar {
    width: 4px;
    height: 40px;
    border-radius: 4px;
    background-color: #3a5dff;
    flex-shrink: 0;
  }
  .founder-signature-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .founder-name {
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: #0f172a;
    letter-spacing: -0.005em;
  }
  .founder-role {
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgb(71, 85, 105);
    margin-top: 2px;
  }
  .founder-ctas {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .founder-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: linear-gradient(135deg, #4a6bff 0%, #2748f2 100%);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Poppins", sans-serif;
    line-height: 1;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(37, 72, 240, 0.32);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .founder-btn-primary:hover {
    box-shadow: 0 8px 22px rgba(37, 72, 240, 0.45);
    transform: translateY(-1px);
  }
  .founder-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: #ffffff;
    color: #1C244B;
    border: 1px solid rgba(28, 36, 75, 0.18);
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-size: 15px;
    font-weight: 500;
    font-family: "Poppins", sans-serif;
    line-height: 1;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
    transition: background-color 0.2s, color 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .founder-btn-secondary:hover {
    background: #ffffff;
    color: #1C244B;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.22);
  }
  .founder-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .founder-btn-icon svg {
    display: block;
    width: 14px;
    height: 14px;
  }
  .founder-btn-primary .founder-btn-icon {
    background-color: #ffffff;
    border-color: #ffffff;
    color: #1C244B;
  }
  .founder-btn-primary:hover .founder-btn-icon {
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.6);
    color: #ffffff;
  }
  .founder-btn-secondary .founder-btn-icon {
    border-color: rgba(58, 93, 255, 0.5);
    color: #3a5dff;
  }
  .founder-btn-secondary:hover .founder-btn-icon {
    background-color: #3a5dff;
    border-color: #3a5dff;
    color: #ffffff;
  }
</style>
