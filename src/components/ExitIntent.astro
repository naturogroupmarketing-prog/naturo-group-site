---
// Exit-intent capture modal.
//
// Fires ONCE per session when the user signals they're leaving:
//   - Desktop: mouse leaves the top of the viewport (classic exit-intent)
//   - Mobile: scroll-up bounce after 8s on page (mobile users don't have
//     a mouse to leave the viewport, so we approximate intent with a
//     fast upward scroll back to the top)
//
// The form ships through the same leadCapture pipeline as QuoteLeadGate
// (Sophiie CRM + dataLayer + Meta Pixel `Lead`) so all leads land in the
// same inbox regardless of which entry point captured them. Tagged with
// `source: exit_intent` so we can attribute later.
//
// Cooldown / suppression rules
// ----------------------------
//   - Skipped entirely if the user has already submitted a quote / lead
//     this session (naturo:lead is set)
//   - Skipped on /quote and /thank-you (nothing to retain)
//   - Suppressed for 14 days once shown OR dismissed via localStorage
//     so we don't badger returning visitors
import { leadCapture, ctaPrimary } from '../data/site';
const lc = leadCapture;
---

<div
  class="exi-overlay"
  id="exiOverlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exiTitle"
  aria-describedby="exiSub"
  hidden
>
  <div class="exi-card" role="document">
    <button type="button" class="exi-close" id="exiClose" aria-label="Close">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <div class="exi-grid">
      <div class="exi-side">
        <h2 class="exi-title" id="exiTitle">Save $30 on your first clean</h2>
        <p class="exi-sub" id="exiSub">
          Drop your details and we&rsquo;ll text a one-time $30 discount code
          you can use on any first booking — no commitment, opt out any time.
        </p>
        <ul class="exi-checks">
          <li>Eco-friendly, non-toxic products</li>
          <li>Police-checked, fully insured cleaners</li>
          <li>100% satisfaction guarantee</li>
        </ul>
      </div>

      <form class="exi-form" id="exiForm" novalidate>
        <label class="exi-field">
          <span class="exi-label">Full name</span>
          <input class="exi-input" type="text" name="name" id="exiName" autocomplete="name" required placeholder="Your name" />
          <span class="exi-error" data-error-for="name"></span>
        </label>

        <label class="exi-field">
          <span class="exi-label">Phone</span>
          <input class="exi-input" type="tel" name="phone" id="exiPhone" autocomplete="tel" required inputmode="tel" placeholder="0400 000 000" />
          <span class="exi-error" data-error-for="phone"></span>
        </label>

        <label class="exi-field">
          <span class="exi-label">Email</span>
          <input class="exi-input" type="email" name="email" id="exiEmail" autocomplete="email" required placeholder="you@example.com" />
          <span class="exi-error" data-error-for="email"></span>
        </label>

        <label class="exi-consent">
          <input type="checkbox" name="sms_optin" id="exiSmsOptIn" value="yes" checked />
          <span class="exi-consent-text">
            I'm happy to receive my $30 code and booking updates by SMS and email. I can opt out any time.
          </span>
        </label>

        <button type="submit" class="exi-submit" id="exiSubmit">
          <span>Email me my $30 code</span>
          <span class="exi-submit-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </button>
        <a href={ctaPrimary.href} class="exi-noFmt" id="exiSkip">No thanks, I'll get my price now &rarr;</a>

        <p class="exi-fineprint">
          See our <a href="/privacy-policies">Privacy Policy</a> for how we handle your details.
          Discount applies to first-time bookings only.
        </p>
      </form>
    </div>
  </div>
</div>

<script is:inline define:vars={{ lc }}>
  (function () {
    const STORAGE_SHOWN = 'naturo:exit-intent-shown';
    const SESSION_LEAD = 'naturo:lead';
    const SUPPRESS_DAYS = 14;

    const overlay = document.getElementById('exiOverlay');
    if (!overlay) return;

    // Skip on the quote and thank-you pages.
    const skipPaths = ['/quote', '/thank-you'];
    if (skipPaths.includes(window.location.pathname)) return;

    // Skip if we've already shown / they've already converted.
    function isSuppressed() {
      try {
        if (sessionStorage.getItem(SESSION_LEAD)) return true;
        const shownAt = localStorage.getItem(STORAGE_SHOWN);
        if (!shownAt) return false;
        const days = (Date.now() - parseInt(shownAt, 10)) / (1000 * 60 * 60 * 24);
        return days < SUPPRESS_DAYS;
      } catch (e) {
        return false;
      }
    }

    if (isSuppressed()) return;

    let shown = false;
    function show() {
      if (shown) return;
      shown = true;
      try { localStorage.setItem(STORAGE_SHOWN, String(Date.now())); } catch (e) {}
      overlay.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
      // Push a state so back-button closes the modal instead of leaving.
      try { history.pushState({ exi: true }, '', window.location.pathname + window.location.search); } catch (e) {}
      // Track impression.
      try {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'exit_intent_shown', location: window.location.pathname });
      } catch (e) {}
      // Focus the first input for keyboard users.
      const first = document.getElementById('exiName');
      if (first) setTimeout(() => first.focus(), 50);
    }

    function hide() {
      overlay.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }

    // Desktop trigger: mouse leaves through the top edge.
    document.addEventListener('mouseout', function (ev) {
      if (shown) return;
      if (ev.clientY > 8) return;
      if (ev.relatedTarget || ev.toElement) return;
      show();
    });

    // Mobile trigger: a fast upward scroll after 8s on page.
    let armedAt = 0;
    setTimeout(() => { armedAt = Date.now(); }, 8000);
    let lastY = window.scrollY;
    let lastT = Date.now();
    window.addEventListener('scroll', function () {
      if (shown || !armedAt) return;
      const now = Date.now();
      const y = window.scrollY;
      const dy = lastY - y;          // positive means scrolling up
      const dt = now - lastT || 1;
      const speed = dy / dt;          // px/ms
      lastY = y;
      lastT = now;
      // Fast scroll up (>1.2 px/ms) AND user is back near top.
      if (speed > 1.2 && y < 120) show();
    }, { passive: true });

    // Closers.
    document.getElementById('exiClose').addEventListener('click', hide);
    overlay.addEventListener('click', (ev) => { if (ev.target === overlay) hide(); });
    document.addEventListener('keydown', (ev) => {
      if (!overlay.hasAttribute('hidden') && ev.key === 'Escape') hide();
    });
    window.addEventListener('popstate', () => {
      if (!overlay.hasAttribute('hidden')) hide();
    });

    // Form submit — ship lead with `source: exit_intent` and close.
    const form = document.getElementById('exiForm');
    const submit = document.getElementById('exiSubmit');
    const config = lc || {};

    function shipLead(values) {
      const na = window.naturoAnalytics;
      const ctx = na ? na.pageContext() : {};
      const payload = {
        name: values.name,
        phone: values.phone,
        email: values.email,
        sms_optin: values.sms_optin ? 'yes' : 'no',
        source: 'exit_intent',
        page: window.location.pathname,
        ts: new Date().toISOString(),
        // Attribution + business dimensions, so an exit-intent lead is as
        // traceable as one from the main quote gate. Previously this form
        // sent no campaign data at all.
        lead_id: na ? na.newLeadId() : '',
        service: ctx.service || '',
        service_location: ctx.service_location || '',
        form_location: 'exit_intent',
        attribution: na ? na.attributionFields() : {},
      };
      if (config.webhookUrl) {
        try {
          fetch(config.webhookUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(payload),
            keepalive: true,
          }).catch(() => {});
        } catch (e) {}
      }
      // Also post to the Sophiie CRM (Inbox + auto-capture), non-blocking.
      if (config.crmUrl) {
        try {
          fetch(config.crmUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            keepalive: true,
          }).catch(() => {});
        } catch (e) {}
      }
      try {
        // Spreading `payload` here previously pushed name/phone/email into the
        // dataLayer in plaintext. Send only non-identifying dimensions; the
        // lead_id joins back to the CRM record that holds the contact details.
        const evt = {
          lead_id: payload.lead_id,
          service: payload.service,
          service_location: payload.service_location,
          form_location: 'exit_intent',
          currency: 'AUD',
          value: 0,
        };
        if (na) {
          na.track('generate_lead', evt);
        } else {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(Object.assign({ event: 'generate_lead' }, evt));
        }
        if (typeof window.fbq === 'function') window.fbq('track', 'Lead', { source: 'exit_intent' });
      } catch (e) {}
      try { sessionStorage.setItem(SESSION_LEAD, JSON.stringify(payload)); } catch (e) {}
    }

    form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      const fd = new FormData(form);
      const values = {
        name: String(fd.get('name') || '').trim(),
        phone: String(fd.get('phone') || '').trim(),
        email: String(fd.get('email') || '').trim(),
        sms_optin: fd.get('sms_optin') === 'yes',
      };
      if (!values.name || !values.phone || !values.email) return;
      submit.disabled = true;
      submit.textContent = 'Sending…';
      shipLead(values);
      // Show a short thank-you state in place of the form.
      const card = overlay.querySelector('.exi-card');
      if (card) {
        card.innerHTML =
          '<div class="exi-thanks">' +
            '<h2 class="exi-title">Check your phone</h2>' +
            '<p class="exi-sub">Your $30 first-clean code is on its way. Browse our services or grab an instant price whenever you\u2019re ready.</p>' +
            '<a href="/quote" class="exi-submit" style="display:inline-block;text-align:center;text-decoration:none;">Get my instant price</a>' +
          '</div>';
      }
    });
  })();
</script>

<style>
  .exi-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(15, 23, 42, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    animation: exi-fade 220ms ease;
    overflow-y: auto;
  }
  .exi-overlay[hidden] { display: none; }
  @keyframes exi-fade { from { opacity: 0; } to { opacity: 1; } }

  .exi-card {
    position: relative;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.38);
    width: 100%;
    max-width: 760px;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    margin: auto;
    padding: 0;
  }
  .exi-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 720px) {
    .exi-grid { grid-template-columns: 1fr; }
  }
  .exi-side {
    background: linear-gradient(135deg, #1c244b 0%, #3a5dff 100%);
    color: #ffffff;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* On mobile, compress the info panel — hide the checklist to save height */
  @media (max-width: 480px) {
    .exi-side { padding: 22px 20px; }
    .exi-checks { display: none; }
    .exi-sub { margin-bottom: 0; font-size: 13px; }
    .exi-form { padding: 20px; gap: 10px; }
    .exi-title { font-size: 22px; }
  }
  .exi-form {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .exi-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    background: rgba(255, 255, 255, 0.15);
    border: 0;
    color: #ffffff;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .exi-close:hover { background: rgba(255, 255, 255, 0.30); }
  @media (max-width: 720px) {
    .exi-close { background: rgba(15, 23, 42, 0.6); }
  }

  .exi-eyebrow {
    font-family: "Poppins", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 12px;
  }
  .exi-title {
    font-family: "Poppins", sans-serif;
    font-size: 26px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #ffffff;
    margin: 0 0 12px;
  }
  .exi-form .exi-eyebrow { color: #3a5dff; }
  .exi-form .exi-title { color: #0f172a; }
  .exi-sub {
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.86);
    margin: 0 0 16px;
  }
  .exi-form .exi-sub { color: rgb(71, 85, 105); }
  .exi-checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .exi-checks li {
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.92);
    padding-left: 20px;
    position: relative;
  }
  .exi-checks li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #ffffff;
    font-weight: 600;
  }

  .exi-field { display: flex; flex-direction: column; gap: 4px; }
  .exi-label {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #0f172a;
  }
  .exi-input {
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    padding: 10px 12px;
    border: 1px solid rgba(15, 23, 42, 0.18);
    border-radius: 8px;
    background: #ffffff;
    color: #0f172a;
    width: 100%;
    transition: border-color 0.15s ease;
  }
  .exi-input:focus {
    outline: none;
    border-color: #3a5dff;
    box-shadow: 0 0 0 3px rgba(58, 93, 255, 0.18);
  }
  .exi-error {
    color: #b3261e;
    font-size: 12px;
    font-family: "Poppins", sans-serif;
  }

  .exi-consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px;
    align-items: start;
    margin-top: 4px;
  }
  .exi-consent input { margin-top: 4px; }
  .exi-consent-text {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    line-height: 1.45;
    color: rgb(71, 85, 105);
  }

  .exi-submit {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: linear-gradient(135deg, #4a6bff 0%, #2748f2 100%);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(37, 72, 240, 0.32);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    cursor: pointer;
  }
  .exi-submit:hover { box-shadow: 0 8px 22px rgba(37, 72, 240, 0.45); transform: translateY(-1px); }
  .exi-submit[disabled] { opacity: 0.6; cursor: wait; }
  .exi-submit .exi-submit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background-color: #ffffff;
    border: 1px solid #ffffff;
    color: #1C244B;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .exi-submit .exi-submit-icon svg { display: block; width: 14px; height: 14px; }
  .exi-submit:hover .exi-submit-icon { background-color: transparent; border-color: rgba(255,255,255,0.6); color: #ffffff; }

  .exi-noFmt {
    text-align: center;
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    color: rgb(71, 85, 105);
    text-decoration: none;
    margin-top: 4px;
  }
  .exi-noFmt:hover { color: #3a5dff; }
  .exi-fineprint {
    font-family: "Poppins", sans-serif;
    font-size: 11px;
    color: rgb(100, 116, 139);
    margin: 8px 0 0;
    line-height: 1.45;
  }
  .exi-fineprint a { color: #3a5dff; text-decoration: underline; }

  .exi-thanks {
    padding: 36px 28px;
    text-align: center;
  }
  .exi-thanks .exi-title { color: #0f172a; }
  .exi-thanks .exi-eyebrow { color: #3a5dff; }
  .exi-thanks .exi-sub { color: rgb(71, 85, 105); margin-bottom: 18px; }
</style>
