---
import { nav, site, ctaPrimary } from '../data/site';
---

<header class="lg:sticky lg:top-0 lg:z-50 bg-white/95 backdrop-blur border-b border-[var(--color-border)]/40">
  <div class="header-inner flex items-center">
    <a href="/" class="flex items-center" aria-label={`${site.name} home`}>
      <img src="/images/logo.avif" alt="Naturo Group" class="w-[130px] sm:w-[170px] h-auto" width="170" height="79" />
    </a>

    <div class="header-right ml-auto flex items-center gap-6">
      <nav class="hidden lg:flex items-center" aria-label="Primary">
        {nav.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class="nav-link flex items-center gap-1"
            >
              {item.label}
              {item.children && (
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              )}
            </a>
            {item.children && (
              <div class="absolute left-0 top-full pt-3 hidden group-hover:block min-w-[220px] z-50">
                <ul class="bg-white rounded-xl shadow-lg border border-[var(--color-border)]/40 py-2">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} class="block px-4 py-2 text-sm text-[var(--color-slate)] hover:bg-[var(--color-bg-light)] hover:text-[var(--color-navy)]">
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a href={site.phoneHref} class="header-phone-btn hidden md:inline-flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {site.phone}
        </a>
        <a href={ctaPrimary.href} class="header-cta-btn">
          <span class="header-cta-long">{ctaPrimary.text}</span>
          <span class="header-cta-short">Get Quote</span>
        </a>
        <button id="mobile-menu-toggle" class="lg:hidden p-2" aria-label="Open menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile menu lives outside <header> so the backdrop-filter stacking
     context on the header cannot affect this fixed overlay. -->
<div id="mobile-menu" class="mob-menu" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Navigation menu">
    <div class="mob-menu-inner">
      <!-- Top bar: logo + close — padding matches header-inner exactly so logo doesn't shift -->
      <div class="mob-menu-topbar">
        <a href="/" class="mob-menu-logo" aria-label="Naturo Group home">
          <img src="/images/logo.avif" alt="Naturo Group" width="140" height="65" />
        </a>
        <button id="mobile-menu-close" class="mob-close-btn" aria-label="Close menu">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Nav items -->
      <nav class="mob-nav" aria-label="Mobile navigation">
        {nav.map((item, i) => (
          <div class="mob-nav-item" data-index={i}>
            {item.children ? (
              <>
                <button class="mob-nav-row mob-nav-toggle" type="button" aria-expanded="false" data-target={`mob-sub-${i}`}>
                  <span>{item.label}</span>
                  <svg class="mob-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <ul id={`mob-sub-${i}`} class="mob-sub" hidden>
                  {item.children.map((c) => (
                    <li><a href={c.href} class="mob-sub-link">{c.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={item.href} class="mob-nav-row">
                <span>{item.label}</span>
                <svg class="mob-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            )}
          </div>
        ))}
      </nav>

      <!-- Bottom CTAs + social -->
      <div class="mob-menu-footer">
        <div class="mob-cta-row">
          <a href={site.phoneHref} class="mob-btn-ghost">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {site.phone}
          </a>
          <a href={ctaPrimary.href} class="mob-btn-primary">Get an Instant Price</a>
        </div>
        <div class="mob-social-row">
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="mob-social-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="mob-social-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        </div>
        <p class="mob-location">Sydney · Melbourne · Brisbane · Australia-wide</p>
      </div>
    </div>
  </div>

<style>
  .header-inner {
      max-width: 1250px;
      margin-inline: auto;
      padding-inline: 20px;
    }
    .nav-link {
      font-family: "Poppins", sans-serif;
      font-weight: 300;
      font-size: 16px;
      line-height: 20px;
      color: rgb(114, 114, 114);
      padding: 0 16px;
      transition: color 0.2s;
    }
    .nav-link:hover { color: #1C244B; }
    .header-phone-btn {
      font-family: "Helvetica", sans-serif;
      font-weight: 400;
      font-size: 15px;
      line-height: 15px;
      color: rgb(153, 153, 153);
      padding: 12px 24px;
      border: 0.5px solid rgb(153, 153, 153);
      border-radius: 5px;
      background: transparent;
      transition: border-color 0.2s, color 0.2s;
    }
    .header-phone-btn:hover { border-color: #3a5dff; color: #3a5dff; }
    .header-phone-btn svg { width: 15px; height: 15px; }
    /* Header CTA matches the hero primary button shape (6px radius, 14/26
       padding) so the button users see at the top is identical to the
       button they see in the hero photo. Slightly slimmer vertical padding
       keeps the header compact. */
    .header-cta-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
      font-family: "Poppins", "Helvetica", sans-serif;
      font-weight: 500;
      font-size: 14px;
      line-height: 1;
      letter-spacing: 0.01em;
      color: #ffffff;
      padding: 13px 24px;
      border: 1px solid #3a5dff;
      border-radius: 6px;
      background: #3a5dff;
      box-shadow: 0 4px 12px rgba(58, 93, 255, 0.28);
      transition: background-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s;
    }
    .header-cta-btn:hover { background: #2548f0; color: #ffffff; }
    .header-cta-short { display: none; }
    /* Tight viewport: header has logo + CTA + hamburger fighting for 375px.
       Use the shorter label and trim padding so nothing wraps. */
    @media (max-width: 1023px) {
      .header-cta-btn { display: none; }
    }
    /* Trim header vertical padding on small screens so the chrome doesn't
       eat too much above-the-fold space. */
    .header-inner { padding-top: 28px; padding-bottom: 28px; }
    @media (max-width: 767px) {
      .header-inner { padding-top: 14px; padding-bottom: 14px; }
    }
  </style>

<style>
  .mob-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100dvh;
    z-index: 200;
    background: #ffffff;
    flex-direction: column;
    overflow-y: auto;
  }
  .mob-menu.is-open { display: flex !important; }

  .mob-menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 0 20px 32px;
  }

  .mob-menu-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0 14px;
    border-bottom: 1px solid rgba(15,23,42,0.08);
    margin-bottom: 8px;
  }
  .mob-menu-logo img { width: 130px; height: auto; }
  .mob-close-btn {
    width: 40px; height: 40px;
    border-radius: 999px;
    background: rgba(15,23,42,0.05);
    border: none;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    color: #0f172a;
    transition: background 0.15s;
  }
  .mob-close-btn:hover { background: rgba(15,23,42,0.1); }

  .mob-nav { flex: 1; }
  .mob-nav-item { border-bottom: 1px solid rgba(15,23,42,0.07); }

  .mob-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 18px 0;
    font-family: "Poppins", sans-serif;
    font-size: 17px;
    font-weight: 500;
    color: #0f172a;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s;
  }
  .mob-nav-row:hover { color: #3a5dff; }
  .mob-chevron { flex-shrink: 0; color: #94a3b8; transition: transform 0.2s; }
  .mob-nav-toggle[aria-expanded="true"] .mob-chevron { transform: rotate(180deg); }

  .mob-sub {
    padding: 0 0 12px 0;
  }
  .mob-sub[hidden] { display: none; }
  .mob-sub-link {
    display: block;
    padding: 10px 12px;
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: #475569;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .mob-sub-link:hover { background: rgba(58,93,255,0.06); color: #3a5dff; }

  .mob-menu-footer {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .mob-cta-row {
    display: flex;
    gap: 10px;
  }
  .mob-btn-ghost {
    flex: 1;
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    padding: 13px 12px;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #0f172a;
    border: 1px solid rgba(15,23,42,0.18);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .mob-btn-ghost:hover { border-color: #3a5dff; color: #3a5dff; }
  .mob-btn-primary {
    flex: 1;
    display: inline-flex; align-items: center; justify-content: center;
    padding: 13px 12px;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    background: #3a5dff;
    border: 1px solid #3a5dff;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .mob-btn-primary:hover { background: #2548f0; }

  .mob-social-row {
    display: flex;
    gap: 12px;
  }
  .mob-social-icon {
    width: 40px; height: 40px;
    border-radius: 999px;
    background: rgba(15,23,42,0.04);
    border: 1px solid rgba(15,23,42,0.10);
    display: flex; align-items: center; justify-content: center;
    color: #475569;
    text-decoration: none;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .mob-social-icon:hover { background: #3a5dff; border-color: #3a5dff; color: #ffffff; }

  .mob-location {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    color: #94a3b8;
    margin: 0;
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');

  let scrollY = 0;
  function openMenu() {
    scrollY = window.scrollY;
    menu?.classList.add('is-open');
    menu?.removeAttribute('aria-hidden');
    document.body.style.overflow = 'hidden';
    document.body.style.position = 'fixed';
    document.body.style.top = `-${scrollY}px`;
    document.body.style.width = '100%';
  }
  function closeMenu() {
    menu?.classList.remove('is-open');
    menu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';
    window.scrollTo(0, scrollY);
  }

  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  // Close on overlay click (outside inner panel).
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) closeMenu();
  });

  // Accordion sub-menus.
  document.querySelectorAll('.mob-nav-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const sub = targetId ? document.getElementById(targetId) : null;
      if (!sub) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      if (isOpen) { sub.hidden = true; } else { sub.hidden = false; }
    });
  });

  // Close menu on nav link click.
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
</script>

