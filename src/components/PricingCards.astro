---
import { pricingCards } from '../data/site';

const categoryLabel = ['One-off Clean', 'Recurring Clean', 'Bond Clean'];
const fineprint = 'Price estimate for a standard home. Final quote confirmed after enquiry.';
---

<section class="pricing-section">
  <div class="pricing-head">
    <h2 class="pricing-h2">Choose your clean</h2>
    <p class="pricing-sub">
      Eco-friendly products, police-checked cleaners, and flexible scheduling on every visit.
    </p>
  </div>

  <div class="pricing-grid">
    {pricingCards.map((card, i) => (
      <div class={`pricing-card ${card.featured ? 'is-featured' : ''}`}>
        <div class={`pricing-banner ${card.featured ? '' : 'pricing-banner--ghost'}`}>
          {card.featured && (
            <>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <span>Most Popular</span>
            </>
          )}
        </div>

        <div class="pricing-card-inner">
          <!-- Plan name -->
          <h3 class="pricing-card-name">{card.name}</h3>

          <!-- One-line description -->
          <p class="pricing-card-desc">{card.bullets[0]}</p>

          <!-- Divider -->
          <div class="pricing-divider" role="separator"></div>

          <!-- Category label -->
          <p class="pricing-category">{categoryLabel[i]}</p>

          <!-- Hero price -->
          <div class="pricing-price-block">
            <div class="pricing-price">
              <span class="pricing-currency">$</span><span class="pricing-integer">{card.priceFrom}</span>
            </div>
            <p class="pricing-from">{card.label}</p>
            <p class="pricing-period">per clean</p>
          </div>

          <!-- CTA -->
          <div class="pricing-footer">
            <a href={card.cta.href} class={`pricing-btn ${card.featured ? 'is-primary' : ''}`}>{card.cta.text}</a>
          </div>

          <!-- Fine print -->
          <p class="pricing-fine">*{fineprint}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="pricing-trust">
    <div class="pricing-trust-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Police-checked cleaners
    </div>
    <div class="pricing-trust-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      60-second online booking
    </div>
    <div class="pricing-trust-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      Satisfaction guarantee
    </div>
    <div class="pricing-trust-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 11V7a5 5 0 0 1 10 0v4"/><rect x="3" y="11" width="18" height="11" rx="2"/></svg>
      Fully insured
    </div>
  </div>
</section>

<style>
  /* ── Section shell ─────────────────────────────── */
  .pricing-section {
    background-color: #f3f5f8;
    padding: clamp(80px, 10vw, 120px) 20px;
  }

  /* ── Header ────────────────────────────────────── */
  .pricing-head {
    max-width: 640px;
    margin: 0 auto clamp(40px, 5vw, 60px);
    text-align: center;
  }
  .pricing-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #1C244B;
    margin: 0 0 14px;
  }
  .pricing-sub {
    font-family: "Poppins", sans-serif;
    font-size: clamp(15px, 1.3vw, 17px);
    font-weight: 300;
    line-height: 1.6;
    color: #64748b;
    margin: 0;
  }

  /* ── Grid ──────────────────────────────────────── */
  .pricing-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 20px;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ── Card ──────────────────────────────────────── */
  .pricing-card {
    position: relative;
    width: 340px;
    max-width: 100%;
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow:
      0 1px 3px rgba(15, 23, 42, 0.05),
      0 6px 20px rgba(15, 23, 42, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .pricing-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 2px 6px rgba(15, 23, 42, 0.07),
      0 16px 40px rgba(28, 36, 75, 0.14);
  }

  /* Featured card — slightly elevated border */
  .pricing-card.is-featured {
    border-color: rgba(58, 93, 255, 0.3);
    box-shadow:
      0 1px 3px rgba(15, 23, 42, 0.05),
      0 8px 28px rgba(58, 93, 255, 0.14);
  }
  .pricing-card.is-featured:hover {
    box-shadow:
      0 2px 6px rgba(15, 23, 42, 0.07),
      0 20px 44px rgba(58, 93, 255, 0.22);
  }

  /* ── Top banner ────────────────────────────────── */
  .pricing-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 11px 20px;
    font-family: "Poppins", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background-color: #1C244B;
    color: #ffffff;
    line-height: 1;
    min-height: 40px;
  }
  .pricing-banner--ghost {
    background-color: #f1f4f8;
    color: transparent;
    pointer-events: none;
  }

  /* ── Inner padding wrapper ─────────────────────── */
  .pricing-card-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 32px 28px 28px;
    text-align: center;
  }

  /* ── Plan name ─────────────────────────────────── */
  .pricing-card-name {
    font-family: "Poppins", sans-serif;
    font-size: clamp(24px, 2.4vw, 30px);
    font-weight: 600;
    line-height: 1.15;
    color: #1C244B;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  /* ── Description ───────────────────────────────── */
  .pricing-card-desc {
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.55;
    color: #64748b;
    margin: 0 0 22px;
    min-height: 44px;
  }

  /* ── Divider ───────────────────────────────────── */
  .pricing-divider {
    height: 1px;
    background-color: rgba(15, 23, 42, 0.1);
    margin: 0 0 20px;
  }

  /* ── Category label ────────────────────────────── */
  .pricing-category {
    font-family: "Poppins", sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #94a3b8;
    margin: 0 0 18px;
  }

  /* ── Price block ───────────────────────────────── */
  .pricing-price-block {
    margin-bottom: 28px;
  }
  .pricing-price {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    line-height: 1;
    gap: 2px;
  }
  .pricing-currency {
    font-family: "Poppins", sans-serif;
    font-size: 28px;
    font-weight: 500;
    color: #3a5dff;
    margin-top: 10px;
  }
  .pricing-integer {
    font-family: "Poppins", sans-serif;
    font-size: clamp(64px, 7vw, 80px);
    font-weight: 700;
    color: #3a5dff;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .pricing-from {
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #64748b;
    margin: 6px 0 2px;
  }
  .pricing-period {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-weight: 300;
    color: #94a3b8;
    margin: 0;
    letter-spacing: 0.03em;
  }

  /* ── Footer ────────────────────────────────────── */
  .pricing-footer {
    margin-top: auto;
  }

  /* ── CTA button ────────────────────────────────── */
  .pricing-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #1C244B;
    background-color: transparent;
    border: 1.5px solid rgba(28, 36, 75, 0.35);
    border-radius: 8px;
    padding: 14px 24px;
    min-height: 48px;
    line-height: 1;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }
  .pricing-btn:hover {
    background-color: #1C244B;
    border-color: #1C244B;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(28, 36, 75, 0.22);
  }
  .pricing-btn.is-primary {
    background-color: #3a5dff;
    border-color: #3a5dff;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(58, 93, 255, 0.3);
  }
  .pricing-btn.is-primary:hover {
    background-color: #2548f0;
    border-color: #2548f0;
    box-shadow: 0 6px 20px rgba(58, 93, 255, 0.42);
  }

  /* ── Fine print ────────────────────────────────── */
  .pricing-fine {
    font-family: "Poppins", sans-serif;
    font-size: 11px;
    font-weight: 300;
    color: #94a3b8;
    margin: 16px 0 0;
    line-height: 1.5;
  }

  /* ── Trust strip ───────────────────────────────── */
  .pricing-trust {
    max-width: 1100px;
    margin: 52px auto 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 28px 40px;
  }
  .pricing-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Poppins", sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: #64748b;
  }
  .pricing-trust-item svg {
    color: #94a3b8;
    flex-shrink: 0;
  }

  /* ── Mobile carousel ───────────────────────────── */
  @media (max-width: 768px) {
    .pricing-section { padding: clamp(48px, 8vw, 88px) 0; }
    .pricing-head { padding: 0 20px; }
    .pricing-grid {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      max-width: 100%;
      margin: 0;
      padding: 16px 40px 36px 20px;
      gap: 16px;
      scroll-padding-left: 20px;
    }
    .pricing-grid::-webkit-scrollbar { display: none; }
    .pricing-card {
      flex-shrink: 0;
      width: calc(100vw - 60px);
      max-width: 340px;
      scroll-snap-align: start;
    }
    .pricing-trust { padding: 0 20px; }
  }
</style>
