---
// Site-wide lead-capture modal that gates every "Get an Instant Price"
// CTA. The user must enter name + phone + email before they're allowed
// through to /quote. Once submitted in a session we remember the lead
// and let subsequent clicks pass straight through.
//
// The modal is rendered into Layout.astro so it's available on every
// page. Capture happens at the click level — we listen for clicks on
// any in-page link whose pathname resolves to /quote, intercept it,
// and only navigate after the form is filled in.
//
// On submit, the lead is fanned out to whichever destinations are
// configured in src/data/site.ts → leadCapture: a JSON webhook,
// Meta Pixel, Google Ads conversion, and dataLayer (for GTM-installed
// tags). All sends are non-blocking — the user navigates immediately
// while the lead ships in the background via sendBeacon / keepalive.
import { leadCapture } from '../data/site';
const lc = leadCapture;
---

<div
  class="qlg-overlay"
  id="qlgOverlay"
  aria-labelledby="qlgTitle"
  aria-describedby="qlgSub"
  hidden
>
  <div class="qlg-card" role="document">
    <button type="button" class="qlg-close" id="qlgClose" aria-label="Close">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <h2 class="qlg-title" id="qlgTitle">Get your instant price</h2>
    <p class="qlg-sub" id="qlgSub">Tell us about your clean and we&rsquo;ll call you with a tailored price &mdash; usually within the hour during business hours.</p>

    <form class="qlg-form" id="qlgForm" novalidate>
      <fieldset class="qlg-service">
        <legend class="qlg-service-legend">Which clean do you need?</legend>
        <div class="qlg-service-grid">
          <label class="qlg-service-card">
            <input type="radio" name="service" value="regular" />
            <span class="qlg-service-text">
              <span class="qlg-service-title">Regular Clean</span>
              <span class="qlg-service-desc">Weekly, fortnightly or monthly</span>
            </span>
            <span class="qlg-service-check" aria-hidden="true"></span>
          </label>
          <label class="qlg-service-card">
            <input type="radio" name="service" value="oneoff" />
            <span class="qlg-service-text">
              <span class="qlg-service-title">Deep Clean</span>
              <span class="qlg-service-desc">One-off spring or end-of-lease clean</span>
            </span>
            <span class="qlg-service-check" aria-hidden="true"></span>
          </label>
          <label class="qlg-service-card">
            <input type="radio" name="service" value="specialty" />
            <span class="qlg-service-text">
              <span class="qlg-service-title">NDIS, DVA, Agedcare &amp; Insurance</span>
              <span class="qlg-service-desc">Choose services aligned with your care plan, funding or support needs.</span>
            </span>
            <span class="qlg-service-check" aria-hidden="true"></span>
          </label>
        </div>
        <div class="qlg-subservice">
          <span class="qlg-subservice-label">Which type of funding or claim?</span>
          <div class="qlg-subservice-grid">
            <label class="qlg-chip"><input type="radio" name="specialty_type" value="ndis" /><span>NDIS</span></label>
            <label class="qlg-chip"><input type="radio" name="specialty_type" value="dva" /><span>DVA</span></label>
            <label class="qlg-chip"><input type="radio" name="specialty_type" value="aged-care" /><span>Aged Care</span></label>
            <label class="qlg-chip"><input type="radio" name="specialty_type" value="insurance" /><span>Insurance Claim</span></label>
          </div>
          <span class="qlg-error" data-error-for="specialty_type"></span>
        </div>
        <span class="qlg-error" data-error-for="service"></span>
      </fieldset>

      <div class="qlg-field qlg-pcsearch" id="qlgPcSearch">
        <span class="qlg-label">Enter your postcode</span>
        <div class="qlg-pcsearch-box">
          <svg class="qlg-pcsearch-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            class="qlg-pcsearch-input"
            type="text"
            id="qlgSearch"
            inputmode="numeric"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="qlgSuburbList"
            aria-autocomplete="list"
            placeholder="Enter your postcode"
          />
          <button type="button" class="qlg-pcsearch-clear" id="qlgSearchClear" aria-label="Clear" hidden>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
          </button>
        </div>
        <p class="qlg-postcode-status" id="qlgPostcodeStatus" hidden></p>
        <ul class="qlg-pcsearch-list" id="qlgSuburbList" role="listbox" hidden></ul>
        <input type="hidden" name="postcode" id="qlgPostcode" />
        <input type="hidden" name="suburb" id="qlgSuburb" />
        <span class="qlg-error" data-error-for="postcode"></span>
        <span class="qlg-error" data-error-for="suburb"></span>
      </div>

      <label class="qlg-field">
        <span class="qlg-label">Full name</span>
        <input class="qlg-input" type="text" name="name" id="qlgName" autocomplete="name" placeholder="Your name" />
        <span class="qlg-error" data-error-for="name"></span>
      </label>

      <label class="qlg-field">
        <span class="qlg-label">Phone</span>
        <input class="qlg-input" type="tel" name="phone" id="qlgPhone" autocomplete="tel" inputmode="tel" placeholder="0400 000 000" />
        <span class="qlg-error" data-error-for="phone"></span>
      </label>

      <label class="qlg-field">
        <span class="qlg-label">Email</span>
        <input class="qlg-input" type="email" name="email" id="qlgEmail" autocomplete="email" placeholder="you@example.com" />
        <span class="qlg-error" data-error-for="email"></span>
      </label>

      <label class="qlg-field">
        <span class="qlg-label">Notes <span class="qlg-optional">(optional)</span></span>
        <textarea class="qlg-input qlg-textarea" name="notes" id="qlgNotes" rows="2" placeholder="Anything we should know? Pets, parking, preferred day&hellip;"></textarea>
      </label>

      <button type="submit" class="qlg-submit" id="qlgSubmit">
        <span>Get my instant price</span>
        <span class="qlg-submit-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
      </button>

      <p class="qlg-fineprint">
        We use your details to prepare your quote and get in touch &mdash; no payment now.
        See our <a href="/privacy-policies">Privacy Policy</a>.
      </p>
    </form>

    <div class="qlg-success" id="qlgSuccess" hidden>
      <div class="qlg-success-check" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h2 class="qlg-title">Thanks &mdash; you&rsquo;re all set!</h2>
      <p class="qlg-success-msg" id="qlgSuccessMsg">Our team will call you shortly to confirm your tailored price.</p>
      <button type="button" class="qlg-submit qlg-success-done" id="qlgSuccessDone"><span>Done</span></button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ lc }}>
  (function () {
    const STORAGE_KEY = 'naturo:lead';
    const TARGET_PATH = '/quote';
    const config = lc || {};

    // ---- Destination installers ------------------------------------------
    // Each runs once on page load if the relevant ID is configured. The
    // submit-time fan-out below assumes whatever globals these created
    // (fbq / gtag / dataLayer) are available.
    function installMetaPixel(id) {
      if (!id || window.fbq) return;
      // Standard Meta Pixel base snippet, lifted from FB's docs.
      /* eslint-disable */
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      /* eslint-enable */
      window.fbq('init', id);
      window.fbq('track', 'PageView');
    }

    function installGtag(id) {
      if (!id || window.gtag) return;
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', id);
    }

    function installGtm(id) {
      if (!id) return;
      window.dataLayer = window.dataLayer || [];
      if (window.__gtmInstalled) return;
      window.__gtmInstalled = true;
      /* eslint-disable */
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
      /* eslint-enable */
    }

    // ---- Consent gating -------------------------------------------------
    // Marketing / analytics tags only mount AFTER the user accepts cookies.
    // CookieConsent.astro stores the choice in localStorage and dispatches
    // 'naturo:consent-granted' on page load if previously accepted, and
    // again the moment the user clicks "Accept all".
    function installAdvertisingStack() {
      installMetaPixel(config.metaPixelId);
      // GA4 and Google Ads both ride on gtag.js — ID order matters: load
      // GA4 first if both are configured so the GA4 default conversion
      // schema is set up before Ads conversion calls fire.
      if (config.ga4Id) installGtag(config.ga4Id);
      if (config.googleAdsId) installGtag(config.googleAdsId);
      installGtm(config.gtmId);
    }
    function consentGranted() {
      if (window.naturoConsent && window.naturoConsent.granted) return true;
      try {
        const raw = localStorage.getItem('naturo:consent');
        if (raw) return !!JSON.parse(raw).granted;
      } catch (e) {}
      return false;
    }
    if (consentGranted()) {
      installAdvertisingStack();
    } else {
      window.addEventListener('naturo:consent-granted', function () {
        installAdvertisingStack();
      }, { once: true });
    }

    // ---- Tracking-context capture ----------------------------------------
    // Pull UTM params + referrer + landing page once per session. These
    // are the breadcrumbs you actually need for retargeting attribution.
    function captureContext() {
      const KEY = 'naturo:lead-context';
      try {
        const existing = sessionStorage.getItem(KEY);
        if (existing) return JSON.parse(existing);
      } catch (e) { /* fall through */ }
      const params = new URLSearchParams(window.location.search);
      const ctx = {
        utm_source:   params.get('utm_source') || '',
        utm_medium:   params.get('utm_medium') || '',
        utm_campaign: params.get('utm_campaign') || '',
        utm_term:     params.get('utm_term') || '',
        utm_content:  params.get('utm_content') || '',
        gclid:        params.get('gclid') || '',
        fbclid:       params.get('fbclid') || '',
        referrer:     document.referrer || '',
        landing_page: window.location.href,
      };
      try { sessionStorage.setItem(KEY, JSON.stringify(ctx)); } catch (e) {}
      return ctx;
    }
    const trackingContext = captureContext();

    const overlay = document.getElementById('qlgOverlay');
    const form = document.getElementById('qlgForm');
    const closeBtn = document.getElementById('qlgClose');
    if (!overlay || !form) return;
    const firstRadio = form.querySelector('input[name="service"]');
    const submitBtn = document.getElementById('qlgSubmit');
    const titleEl = document.getElementById('qlgTitle');
    const subEl = document.getElementById('qlgSub');
    const successPanel = document.getElementById('qlgSuccess');
    const successMsg = document.getElementById('qlgSuccessMsg');
    const successDone = document.getElementById('qlgSuccessDone');
    if (successDone) successDone.addEventListener('click', function () { closeModal(); });

    // Reset the modal back to the form view (used before each open, in case a
    // previous submission left the thank-you panel showing).
    function resetToForm() {
      if (successPanel) successPanel.setAttribute('hidden', '');
      form.removeAttribute('hidden');
      if (titleEl) titleEl.removeAttribute('hidden');
      if (subEl) subEl.removeAttribute('hidden');
      if (submitBtn) submitBtn.disabled = false;
    }

    let pendingHref = null;
    let lastFocused = null;

    function hasLead() {
      try {
        const raw = sessionStorage.getItem(STORAGE_KEY);
        if (!raw) return false;
        const data = JSON.parse(raw);
        return !!(data && data.service && data.postcode);
      } catch (e) {
        return false;
      }
    }

    function openModal(href) {
      pendingHref = href;
      resetToForm();
      lastFocused = document.activeElement;
      var isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
      if (isTouchDevice) {
        // iOS Safari auto-focuses the first input inside role="dialog" the
        // moment it becomes visible — ignoring tabindex, readonly, and
        // inputmode individually. The only reliable fix is the HTML `inert`
        // attribute, which removes the entire form subtree from the browser's
        // focus-management tree. An inert element is completely unfocusable,
        // so the virtual keyboard never appears on open. We lift `inert` after
        // 500 ms once the animation has settled and the user is ready to type.
        form.setAttribute('inert', '');
        overlay.setAttribute('role', 'dialog');
        overlay.setAttribute('aria-modal', 'true');
        overlay.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
        if (closeBtn) closeBtn.focus();
        setTimeout(function() {
          form.removeAttribute('inert');
        }, 500);
      } else {
        // Desktop: show modal then focus first input so the user can type immediately.
        overlay.setAttribute('role', 'dialog');
        overlay.setAttribute('aria-modal', 'true');
        overlay.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
        setTimeout(function () { if (firstRadio) firstRadio.focus(); }, 50);
      }
    }

    function closeModal() {
      overlay.setAttribute('hidden', '');
      overlay.removeAttribute('role');
      overlay.removeAttribute('aria-modal');
      document.body.style.overflow = '';
      pendingHref = null;
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
    }

    // ---- Focus trap ----
    // While the modal is open, Tab / Shift+Tab cycle within its focusable
    // children instead of leaking out to the page underneath. Required
    // for WCAG 2.1.2.1 (No Keyboard Trap — the inverse: keyboard users
    // shouldn't be able to step out of a modal dialog into hidden UI).
    function getFocusable() {
      const sel = [
        'a[href]',
        'button:not([disabled])',
        'input:not([disabled]):not([type="hidden"])',
        'select:not([disabled])',
        'textarea:not([disabled])',
        '[tabindex]:not([tabindex="-1"])',
      ].join(',');
      return Array.prototype.slice
        .call(overlay.querySelectorAll(sel))
        .filter(function (el) { return el.offsetParent !== null; });
    }
    overlay.addEventListener('keydown', function (ev) {
      if (ev.key !== 'Tab') return;
      const items = getFocusable();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (ev.shiftKey && active === first) {
        ev.preventDefault();
        last.focus();
      } else if (!ev.shiftKey && active === last) {
        ev.preventDefault();
        first.focus();
      }
    });

    function setError(name, message) {
      const el = form.querySelector('[data-error-for="' + name + '"]');
      if (el) el.textContent = message || '';
      const input = form.elements[name];
      // `service` resolves to a RadioNodeList (no setAttribute) — guard for it.
      if (input && typeof input.setAttribute === 'function') {
        if (message) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
      }
    }

    function clearErrors() {
      ['service', 'specialty_type', 'postcode', 'suburb', 'name', 'phone', 'email'].forEach(function (n) { setError(n, ''); });
    }

    function validate(values) {
      let ok = true;
      if (!values.service) {
        setError('service', 'Please choose which clean you need.');
        ok = false;
      }
      if (values.service === 'specialty' && !values.specialtyType) {
        setError('specialty_type', 'Please choose NDIS, DVA, Aged Care or Insurance Claim.');
        ok = false;
      }
      if (!/^\d{4}$/.test((values.postcode || '').replace(/\s/g, ''))) {
        setError('postcode', 'Please enter your 4-digit postcode.');
        ok = false;
      } else if (!values.suburb && !suburbOptional) {
        // A valid postcode must resolve to a selected suburb — unless the
        // lookup genuinely returned nothing or the API was unreachable.
        setError('suburb', 'Please select your suburb from the list.');
        ok = false;
      }
      if (!values.name || values.name.length < 2) {
        setError('name', 'Please enter your name.');
        ok = false;
      }
      if ((values.phone || '').replace(/[^0-9]/g, '').length < 8) {
        setError('phone', 'Please enter a valid phone number.');
        ok = false;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email || '')) {
        setError('email', 'Please enter a valid email.');
        ok = false;
      }
      return ok;
    }

    function isQuoteLink(a) {
      if (!a || a.tagName !== 'A') return false;
      // Skip new-tab / modifier-clicked / explicit-target links — let the
      // browser handle those normally.
      if (a.target && a.target !== '' && a.target !== '_self') return false;
      const raw = a.getAttribute('href');
      if (!raw) return false;
      // Resolve to a pathname we can compare. Anchors / tel: / mailto:
      // / external links all bail here.
      try {
        const url = new URL(a.href, window.location.href);
        if (url.origin !== window.location.origin) return false;
        return url.pathname === TARGET_PATH || url.pathname === TARGET_PATH + '/';
      } catch (e) {
        return false;
      }
    }

    // Click capture — runs before any per-link handler so we can
    // preventDefault on quote links cleanly.
    document.addEventListener('click', function (ev) {
      // Bail on modifier clicks so cmd/ctrl-click still opens new tab.
      if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
      if (ev.button !== undefined && ev.button !== 0) return;
      const a = ev.target && ev.target.closest ? ev.target.closest('a') : null;
      if (!isQuoteLink(a)) return;
      // The popup IS the lead form now — always open it instead of
      // navigating to the /quote page.
      ev.preventDefault();
      openModal(a.href);
    }, true);

    // Close on backdrop click, X button, or Escape.
    overlay.addEventListener('click', function (ev) {
      if (ev.target === overlay) closeModal();
    });
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    document.addEventListener('keydown', function (ev) {
      if (ev.key === 'Escape' && !overlay.hasAttribute('hidden')) closeModal();
    });

    // Live-clear an error as the user starts typing in that field.
    form.addEventListener('input', function (ev) {
      const t = ev.target;
      if (t && t.name) setError(t.name, '');
    });

    // ---- Postcode search → suburb combobox (Zippopotam.us: free/keyless) ----
    // The user types a postcode; matching suburbs drop down below the search
    // box and they pick one. Best-effort: no match / API down → a note shows
    // and they can continue with the postcode alone. The 4-digit postcode and
    // chosen suburb are mirrored into hidden inputs for the rest of the form.
    var searchInput = document.getElementById('qlgSearch');
    var clearBtn = document.getElementById('qlgSearchClear');
    var suburbList = document.getElementById('qlgSuburbList');
    var pcHidden = document.getElementById('qlgPostcode');
    var suburbHidden = document.getElementById('qlgSuburb');
    var pcStatus = document.getElementById('qlgPostcodeStatus');
    var pcSearchWrap = document.getElementById('qlgPcSearch');
    var pcToken = 0, pcDebounce = null, listedSuburbs = false;
    // suburbOptional = true only when the API genuinely returned no suburbs
    // or was unreachable — otherwise a valid postcode requires a picked suburb.
    var suburbOptional = false;

    function esc(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function setStatus(msg) {
      if (!pcStatus) return;
      pcStatus.textContent = msg || '';
      if (msg) pcStatus.removeAttribute('hidden');
      else pcStatus.setAttribute('hidden', '');
    }
    function closeList() {
      if (suburbList) { suburbList.innerHTML = ''; suburbList.setAttribute('hidden', ''); }
      if (searchInput) searchInput.setAttribute('aria-expanded', 'false');
    }
    function selectSuburb(name, stateAbbr, pc) {
      suburbHidden.value = name;
      pcHidden.value = pc;
      searchInput.value = name + ', ' + stateAbbr + ' ' + pc;
      clearBtn.removeAttribute('hidden');
      setError('suburb', '');
      closeList();
    }
    function lookupSuburbs(pc) {
      var token = ++pcToken;
      listedSuburbs = false;
      suburbOptional = false;
      setStatus('Finding suburbs…');
      closeList();
      fetch('https://api.zippopotam.us/au/' + encodeURIComponent(pc))
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (token !== pcToken) return; // a newer lookup superseded this one
          var places = (data && data.places) || [];
          var seen = {}, items = [];
          places.forEach(function (p) {
            var name = (p['place name'] || '').trim();
            var st = (p['state abbreviation'] || '').trim();
            var key = (name + '|' + st).toLowerCase();
            if (name && !seen[key]) { seen[key] = 1; items.push({ name: name, state: st }); }
          });
          if (!items.length) {
            suburbOptional = true;
            setStatus('No suburbs found for that postcode — you can still continue.');
            return;
          }
          listedSuburbs = true;
          suburbOptional = false;
          suburbList.innerHTML = items.map(function (it) {
            return '<li class="qlg-pcsearch-item" role="option" data-name="' + esc(it.name) + '" data-state="' + esc(it.state) + '">'
              + '<span class="qlg-pcsearch-item-name">' + esc(it.name) + '</span> '
              + '<span class="qlg-pcsearch-item-meta">(' + esc(it.state) + ' ' + esc(pc) + ')</span></li>';
          }).join('');
          suburbList.removeAttribute('hidden');
          searchInput.setAttribute('aria-expanded', 'true');
          setStatus('');
        })
        .catch(function () {
          if (token !== pcToken) return;
          suburbOptional = true;
          setStatus('Couldn’t look up suburbs right now — you can still continue.');
        });
    }
    if (searchInput) {
      searchInput.addEventListener('input', function () {
        var raw = searchInput.value;
        clearBtn.toggleAttribute('hidden', !raw);
        suburbHidden.value = ''; // typing invalidates any prior suburb pick
        var digits = raw.replace(/\D/g, '').slice(0, 4);
        pcHidden.value = digits;
        setError('postcode', '');
        if (pcDebounce) clearTimeout(pcDebounce);
        if (/^\d{4}$/.test(digits)) {
          pcDebounce = setTimeout(function () { lookupSuburbs(digits); }, 250);
        } else {
          pcToken++; listedSuburbs = false; suburbOptional = false; closeList(); setStatus('');
        }
      });
      clearBtn.addEventListener('click', function () {
        searchInput.value = ''; pcHidden.value = ''; suburbHidden.value = '';
        clearBtn.setAttribute('hidden', ''); listedSuburbs = false; suburbOptional = false;
        pcToken++; closeList(); setStatus(''); searchInput.focus();
      });
      suburbList.addEventListener('click', function (ev) {
        var li = ev.target.closest('.qlg-pcsearch-item');
        if (!li) return;
        selectSuburb(li.getAttribute('data-name'), li.getAttribute('data-state'), pcHidden.value);
      });
      // Close the dropdown when clicking outside the search field.
      document.addEventListener('click', function (ev) {
        if (pcSearchWrap && !pcSearchWrap.contains(ev.target)) closeList();
      });
    }

    // ---- Fan-out: push the lead to every configured destination ---------
    function shipToWebhook(payload) {
      if (!config.webhookUrl && !config.crmUrl) return;
      var serviceLabels = {
        regular: 'Regular Clean',
        oneoff: 'Deep Clean',
        specialty: 'NDIS, DVA, Agedcare & Insurance',
      };
      var specialtyLabels = { ndis: 'NDIS', dva: 'DVA', 'aged-care': 'Aged Care', insurance: 'Insurance Claim' };
      var cleanType = serviceLabels[payload.service] || payload.service || '';
      if (payload.service === 'specialty' && payload.specialty_type) {
        cleanType = 'Specialist — ' + (specialtyLabels[payload.specialty_type] || payload.specialty_type);
      }
      // Sophiie CRM lead-intake accepts { name, email, phone, message }; fold
      // the clean type, location and notes into the message so nothing is lost.
      var lines = [];
      if (cleanType) lines.push('Service: ' + cleanType);
      var loc = ((payload.suburb || '') + ' ' + (payload.postcode || '')).trim();
      if (loc) lines.push('Location: ' + loc);
      if (payload.notes) lines.push('Notes: ' + payload.notes);
      lines.push('Submitted via naturogroup.com.au');
      var crmPayload = {
        name: payload.name || '',
        email: payload.email || '',
        phone: payload.phone || '',
        message: lines.join('\n'),
      };
      if (config.webhookUrl) {
        try {
          fetch(config.webhookUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(crmPayload),
            keepalive: true,
          }).catch(function () { /* best-effort */ });
        } catch (e) { /* swallow */ }
      }
      // Also post to the Sophiie CRM (Inbox + auto-capture), non-blocking.
      if (config.crmUrl) {
        try {
          fetch(config.crmUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(crmPayload),
            keepalive: true,
          }).catch(function () {});
        } catch (e) {}
      }
    }

    function shipToMetaPixel(payload) {
      if (!config.metaPixelId || typeof window.fbq !== 'function') return;
      try {
        window.fbq('track', 'Lead', {
          content_name: 'Instant Price Gate',
          content_category: 'quote',
        }, {
          // eventID lets you de-dupe with server-side Conversions API later.
          eventID: payload.event_id,
        });
      } catch (e) {}
    }

    function shipToGoogleAds(payload) {
      if (!config.googleAdsId || typeof window.gtag !== 'function') return;
      try {
        const sendTo = config.googleAdsLabel
          ? config.googleAdsId + '/' + config.googleAdsLabel
          : config.googleAdsId;
        window.gtag('event', 'conversion', {
          send_to: sendTo,
          transaction_id: payload.event_id,
        });
        // Also fire a generate_lead event so GA4 / other gtag listeners
        // can build remarketing audiences off it.
        window.gtag('event', 'generate_lead', {
          currency: 'AUD',
          value: 0,
          transaction_id: payload.event_id,
        });
      } catch (e) {}
    }

    function shipToDataLayer(payload) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'lead_captured',
        lead: {
          service: payload.service,
          specialty_type: payload.specialty_type,
          postcode: payload.postcode,
          suburb: payload.suburb,
          name: payload.name,
          phone: payload.phone,
          email: payload.email,
        },
        source: payload.source,
        event_id: payload.event_id,
      });
    }

    function shipLead(values) {
      // Single shared event_id so destinations can be de-duped later.
      const eventId = (window.crypto && window.crypto.randomUUID)
        ? window.crypto.randomUUID()
        : 'lead_' + Date.now() + '_' + Math.random().toString(36).slice(2, 10);
      const payload = {
        event: 'lead_captured',
        event_id: eventId,
        captured_at: new Date().toISOString(),
        service: values.service,
        specialty_type: values.specialtyType,
        postcode: values.postcode,
        suburb: values.suburb,
        name: values.name,
        phone: values.phone,
        email: values.email,
        notes: values.notes,
        source: trackingContext,
        page: {
          url: window.location.href,
          path: window.location.pathname,
          title: document.title,
        },
      };
      shipToWebhook(payload);
      shipToMetaPixel(payload);
      shipToGoogleAds(payload);
      shipToDataLayer(payload);
    }

    form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      clearErrors();
      const serviceField = form.elements['service'];
      const specialtyField = form.elements['specialty_type'];
      const suburbEl = form.elements['suburb'];
      const service = (serviceField && serviceField.value) || '';
      const values = {
        service: service,
        specialtyType: (service === 'specialty' && specialtyField) ? (specialtyField.value || '') : '',
        postcode: (form.elements['postcode'].value || '').trim(),
        suburb: (suburbEl && suburbEl.value) || '',
        name: (form.elements['name'].value || '').trim(),
        phone: (form.elements['phone'].value || '').trim(),
        email: (form.elements['email'].value || '').trim(),
        notes: (form.elements['notes'].value || '').trim(),
      };
      if (!validate(values)) return;
      if (submitBtn) submitBtn.disabled = true; // guard against double-submits
      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(values));
      } catch (e) { /* private mode etc — fine, just navigate. */ }
      // Fire-and-forget the lead to every configured destination. This
      // is non-blocking — sendBeacon / keepalive ensure the request
      // completes even after we navigate.
      shipLead(values);
      // Show the in-popup thank-you instead of navigating anywhere.
      if (successMsg) {
        var first = (values.name || '').split(' ')[0];
        successMsg.textContent = (first ? first + ', our' : 'Our') + ' team will call you shortly to confirm your tailored price.';
      }
      form.setAttribute('hidden', '');
      if (titleEl) titleEl.setAttribute('hidden', '');
      if (subEl) subEl.setAttribute('hidden', '');
      if (successPanel) successPanel.removeAttribute('hidden');
    });
  })();
</script>

<style>
