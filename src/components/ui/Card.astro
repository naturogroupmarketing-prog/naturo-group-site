---
type Variant = 'flat' | 'elevated' | 'bordered';
type Padding = 'sm' | 'md' | 'lg';

interface Props {
  variant?: Variant;
  padding?: Padding;
  hoverable?: boolean;
  href?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'bordered',
  padding = 'md',
  hoverable = false,
  href,
  ariaLabel,
  class: className = '',
} = Astro.props;

const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  aria-label={ariaLabel}
  class:list={['card', `card-${variant}`, `card-pad-${padding}`, hoverable && 'card-hoverable', className]}
>
  <slot />
</Tag>

<style>
  .card {
    display: block;
    background-color: var(--c-bg);
    border-radius: var(--r-lg);
    color: var(--c-slate);
    text-decoration: none;
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .card-flat     { background-color: var(--c-surface); }
  .card-elevated { box-shadow: var(--shadow-sm); }
  .card-bordered { border: 1px solid var(--c-border); }

  .card-pad-sm { padding: var(--s-5); }
  .card-pad-md { padding: var(--s-6); }
  .card-pad-lg { padding: var(--s-8); }

  .card-hoverable:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--c-border-soft);
  }
  .card-hoverable:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
</style>
