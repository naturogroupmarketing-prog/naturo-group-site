---
// Conversational, one-question-at-a-time lead capture — a premium "chat with
// an assistant" experience that gates every "Get a Free Quote" CTA. It
// collects clean type → location → contact → notes across animated steps and
// ships the lead to the SAME backend as before (Sophiie CRM +
// Meta/Google/GTM analytics). No prices are shown — it's lead capture.
import { leadCapture } from '../data/site';
const lc = leadCapture;
---

<div class="qlg-overlay" id="qlgOverlay" aria-labelledby="qlgHeading" hidden>
  <div class="qlg-card" role="document">
    <button type="button" class="qlg-close" id="qlgClose" aria-label="Close">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Chrome: back + progress (shown on the question steps) -->
    <div class="qlg-chrome" id="qlgChrome" hidden>
      <button type="button" class="qlg-back" id="qlgBack" aria-label="Go back">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        <span>Back</span>
      </button>
      <div class="qlg-progress">
        <span class="qlg-progress-label" id="qlgProgressLabel" aria-live="polite">Question 1 of 5</span>
        <div class="qlg-progress-track"><div class="qlg-progress-fill" id="qlgProgressFill"></div></div>
      </div>
    </div>

    <form class="qlg-stage" id="qlgForm" novalidate>
      <!-- Spam trap; see .nl-hp in global.css. -->
      <div class="nl-hp" aria-hidden="true">
        <label>Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </div>
      <!-- STEP 0 · intro -->
      <section class="qlg-screen" data-step="intro">
        <div class="qlg-intro">
          <h2 class="qlg-heading" id="qlgHeading"><span class="qlg-wave" aria-hidden="true">👋</span> Hi, I'm Naturo.</h2>
          <p class="qlg-lede">I'll help you organise the right clean in under 30&nbsp;seconds. Let's start with one quick question.</p>
          <button type="button" class="qlg-btn qlg-btn-primary" id="qlgStart">
            <span>Start My Free Quote</span>
            <span class="qlg-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </button>
        </div>
      </section>

      <!-- STEP 1 · service -->
      <section class="qlg-screen" data-step="service" hidden>
        <h2 class="qlg-q" tabindex="-1">What type of clean are you looking for?</h2>
        <div class="qlg-options" id="qlgServiceOptions">
          <button type="button" class="qlg-option" data-service="regular" data-label="Regular Home Cleaning">
            <span class="qlg-option-icon" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 48 48" fill="none"><rect x="7" y="10" width="30" height="28" rx="3" stroke="currentColor" stroke-width="2"/><line x1="7" y1="18" x2="37" y2="18" stroke="currentColor" stroke-width="2"/><line x1="14" y1="6" x2="14" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="30" y1="6" x2="30" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M24 22l-5 8h4l-2 7 6-9h-4l1-6z" fill="#ff5f1f"/></svg></span>
            <span class="qlg-option-text">
              <span class="qlg-option-title">Regular Home Cleaning</span>
              <span class="qlg-option-desc">Weekly, fortnightly or monthly</span>
            </span>
            <span class="qlg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          </button>
          <button type="button" class="qlg-option" data-service="oneoff" data-label="Deep Clean">
            <span class="qlg-option-icon" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 48 48" fill="none"><rect x="10" y="22" width="28" height="18" rx="4" stroke="currentColor" stroke-width="2"/><path d="M18 22v-7a6 6 0 0 1 12 0v7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="17" y1="29" x2="31" y2="29" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="17" y1="34" x2="31" y2="34" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="38" cy="10" r="3.5" fill="#ff5f1f"/><circle cx="43" cy="17" r="2.2" fill="#ff5f1f"/><circle cx="40" cy="5" r="1.8" fill="#ff5f1f"/></svg></span>
            <span class="qlg-option-text">
              <span class="qlg-option-title">Deep Clean</span>
              <span class="qlg-option-desc">One-off detailed clean</span>
            </span>
            <span class="qlg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          </button>
          <button type="button" class="qlg-option" data-service="specialty" data-specialty="ndis-dva-agedcare" data-label="NDIS, DVA & Aged Care">
            <span class="qlg-option-icon" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 48 48" fill="none"><path d="M24 41C24 41 6 31 6 18.5C6 12.7 10.5 9 15 9c3.4 0 6.6 1.8 9 5 2.4-3.2 5.6-5 9-5 4.5 0 9 3.7 9 9.5C42 31 24 41 24 41z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M18 23l4.5 4.5L31 18" stroke="#ff5f1f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="qlg-option-text">
              <span class="qlg-option-title">NDIS, DVA &amp; Aged Care</span>
              <span class="qlg-option-desc">Government funded services</span>
            </span>
            <span class="qlg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          </button>
          <button type="button" class="qlg-option" data-service="specialty" data-specialty="insurance" data-label="Insurance Claim">
            <span class="qlg-option-icon" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 48 48" fill="none"><path d="M24 7l14 4.8v8.7C38 30 32 36.5 24 40c-8-3.5-14-10-14-19.5v-8.7L24 7z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M18 23.5l4.5 4.5L31 19" stroke="#ff5f1f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="qlg-option-text">
              <span class="qlg-option-title">Insurance Claim</span>
              <span class="qlg-option-desc">Claim-related cleaning</span>
            </span>
            <span class="qlg-option-tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          </button>
        </div>
      </section>

      <!-- STEP 2 · location -->
      <section class="qlg-screen" data-step="location" hidden>
        <h2 class="qlg-q" tabindex="-1">Where do you need the clean?</h2>
        <div class="qlg-field qlg-pcsearch" id="qlgPcSearch">
          <div class="qlg-pcsearch-box">
            <svg class="qlg-pcsearch-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input class="qlg-pcsearch-input" type="text" id="qlgSearch" inputmode="numeric" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="qlgSuburbList" aria-autocomplete="list" aria-label="Suburb or postcode" placeholder="Enter your postcode" />
            <button type="button" class="qlg-pcsearch-clear" id="qlgSearchClear" aria-label="Clear" hidden>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
            </button>
          </div>
          <p class="qlg-postcode-status" id="qlgPostcodeStatus" hidden></p>
          <ul class="qlg-pcsearch-list" id="qlgSuburbList" role="listbox" hidden></ul>
          <input type="hidden" name="postcode" id="qlgPostcode" />
          <input type="hidden" name="suburb" id="qlgSuburb" />
          <input type="hidden" id="qlgSuburbState" />
          <span class="qlg-error" data-error-for="suburb"></span>
        </div>

        <div class="qlg-serviced" id="qlgServiced" hidden>
          <span class="qlg-serviced-check" aria-hidden="true">✅</span>
          <span><strong>Great news!</strong> We service your area.</span>
        </div>
        <div class="qlg-notserviced" id="qlgNotServiced" hidden>
          <p>We don't currently cover that area — but leave your details and we'll point you to a trusted local where we can.</p>
        </div>

        <button type="button" class="qlg-btn qlg-btn-primary" id="qlgLocationNext" disabled>
          <span>Continue</span>
          <span class="qlg-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </button>
      </section>

      <!-- STEP 3 · the home itself -->
      <!--
        What a quote actually depends on. Counts are selects rather than free
        text so an answer is always a number we can price against — "3ish" and
        "three" and "3 + study" all cost somebody a phone call to resolve.
        Only bedrooms and bathrooms are required: they are the two that no
        cleaning quote can be built without, and gating the rest would cost
        leads for detail a person can confirm on the follow-up call.
      -->
      <section class="qlg-screen" data-step="home" hidden>
        <h2 class="qlg-q" tabindex="-1">Tell us about your home</h2>
        <p class="qlg-sub">This is what we price the clean on — it only takes a moment.</p>

        <div class="qlg-grid">
          <label class="qlg-field">
            <span class="qlg-label">Bedrooms</span>
            <select class="qlg-input qlg-select" name="bedrooms" id="qlgBedrooms">
              <option value="">Select</option>
              <option value="Studio">Studio</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
              <option value="6+">6+</option>
            </select>
            <span class="qlg-error" data-error-for="bedrooms"></span>
          </label>

          <label class="qlg-field">
            <span class="qlg-label">Bathrooms</span>
            <select class="qlg-input qlg-select" name="bathrooms" id="qlgBathrooms">
              <option value="">Select</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5+">5+</option>
            </select>
            <span class="qlg-error" data-error-for="bathrooms"></span>
          </label>

          <label class="qlg-field">
            <span class="qlg-label">Living rooms</span>
            <select class="qlg-input qlg-select" name="living_rooms" id="qlgLiving">
              <option value="">Select</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4+">4+</option>
            </select>
          </label>

          <label class="qlg-field">
            <span class="qlg-label">Kitchens</span>
            <select class="qlg-input qlg-select" name="kitchens" id="qlgKitchens">
              <option value="">Select</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3+">3+</option>
            </select>
          </label>

          <label class="qlg-field qlg-field-wide">
            <span class="qlg-label">How many storeys?</span>
            <select class="qlg-input qlg-select" name="storeys" id="qlgStoreys">
              <option value="">Select</option>
              <option value="Single storey">Single storey</option>
              <option value="Double storey">Double storey</option>
              <option value="Three or more">Three or more</option>
            </select>
          </label>
        </div>

        <label class="qlg-field">
          <span class="qlg-label">Is there a separate toilet as well?</span>
          <select class="qlg-input qlg-select" name="additional_toilet" id="qlgToilet">
            <option value="">Select</option>
            <option value="No">No</option>
            <option value="Yes — 1 extra">Yes &mdash; 1 extra</option>
            <option value="Yes — 2 or more">Yes &mdash; 2 or more</option>
          </select>
        </label>

        <label class="qlg-field">
          <span class="qlg-label">Butler&rsquo;s pantry or second kitchen?</span>
          <select class="qlg-input qlg-select" name="butler_pantry" id="qlgPantry">
            <option value="">Select</option>
            <option value="No">No</option>
            <option value="Yes">Yes</option>
          </select>
        </label>

        <label class="qlg-field">
          <span class="qlg-label">Would you like the laundry cleaned?</span>
          <select class="qlg-input qlg-select" name="laundry" id="qlgLaundry">
            <option value="">Select</option>
            <option value="Yes">Yes</option>
            <option value="No">No</option>
          </select>
        </label>

        <button type="submit" class="qlg-btn qlg-btn-primary" id="qlgHomeNext">
          <span>Continue</span>
          <span class="qlg-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </button>
      </section>

      <!-- STEP 4 · contact -->
      <section class="qlg-screen" data-step="contact" hidden>
        <h2 class="qlg-q" tabindex="-1">Where should we send your personalised quote?</h2>
        <label class="qlg-field">
          <span class="qlg-label">Full name</span>
          <input class="qlg-input" type="text" name="name" id="qlgName" autocomplete="name" placeholder="Your name" />
          <span class="qlg-error" data-error-for="name"></span>
        </label>
        <label class="qlg-field">
          <span class="qlg-label">Phone number</span>
          <input class="qlg-input" type="tel" name="phone" id="qlgPhone" autocomplete="tel" inputmode="tel" placeholder="0400 000 000" />
          <span class="qlg-help">We'll only contact you regarding your quote.</span>
          <span class="qlg-error" data-error-for="phone"></span>
        </label>
        <label class="qlg-field">
          <span class="qlg-label">Email address</span>
          <input class="qlg-input" type="email" name="email" id="qlgEmail" autocomplete="email" placeholder="you@example.com" />
          <span class="qlg-error" data-error-for="email"></span>
        </label>
        <button type="submit" class="qlg-btn qlg-btn-primary" id="qlgContactNext">
          <span>Continue</span>
          <span class="qlg-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </button>
      </section>

      <!-- STEP 5 · notes -->
      <section class="qlg-screen" data-step="notes" hidden>
        <h2 class="qlg-q" tabindex="-1">Anything you'd like us to know?</h2>
        <textarea class="qlg-input qlg-textarea" name="notes" id="qlgNotes" rows="3" placeholder="Pets · Parking · Preferred day · Access instructions · Special requests"></textarea>
        <button type="submit" class="qlg-btn qlg-btn-primary qlg-btn-final" id="qlgSubmit">
          <span>Get My Free Personalised Quote</span>
          <span class="qlg-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </button>
        <button type="button" class="qlg-skip" id="qlgSkip">Skip</button>
        <p class="qlg-reassure">🔒 No obligation. Your details stay private. We'll usually contact you within 30–60&nbsp;minutes during business hours.</p>
      </section>

      <!-- STEP 6 · done -->
      <section class="qlg-screen" data-step="done" hidden>
        <div class="qlg-done">
          <span class="qlg-done-check" aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          <h2 class="qlg-heading">You're all set!</h2>
          <p class="qlg-lede">Thanks for contacting Naturo Group. We're preparing your personalised quote now. A member of our team will usually contact you within the hour during business hours.</p>
          <button type="button" class="qlg-btn qlg-btn-primary" id="qlgDone"><span>Done</span></button>
        </div>
      </section>
    </form>
  </div>
</div>

<script is:inline define:vars={{ lc }}>
  (function () {
    const STORAGE_KEY = 'naturo:lead';
    const TARGET_PATH = '/quote';
    const config = lc || {};
    // States we service — a suburb outside these shows the "not covered" note.
    const SERVICED_STATES = ['NSW', 'QLD', 'VIC', 'ACT'];

    // ---- Destination installers ------------------------------------------
    function installMetaPixel(id) {
      if (!id || window.fbq) return;
      /* eslint-disable */
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      /* eslint-enable */
      window.fbq('init', id);
      window.fbq('track', 'PageView');
    }
    // gtag.js is loaded once, but every destination — each GA4 property, plus
    // the Google Ads conversion ID — needs its own config call.
    //
    // The previous guard bailed out as soon as window.gtag existed, so only
    // the FIRST id was ever configured and the Google Ads ID on the next line
    // was silently never set up. Track configured ids individually instead.
    function installGtag(id) {
      if (!id) return;
      window.dataLayer = window.dataLayer || [];
      if (!window.gtag) {
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
        document.head.appendChild(s);
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
      }
      window.__gtagIds = window.__gtagIds || {};
      if (window.__gtagIds[id]) return;
      window.__gtagIds[id] = true;
      window.gtag('config', id);
    }
    function installGtm(id) {
      if (!id) return;
      window.dataLayer = window.dataLayer || [];
      if (window.__gtmInstalled) return;
      window.__gtmInstalled = true;
      /* eslint-disable */
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
      /* eslint-enable */
    }
    // Microsoft Clarity — session replay and heatmaps.
    //
    // It sits with the other tags rather than in the head so it inherits the
    // same consent gate: Clarity records what a visitor does on the page, so
    // loading it before someone has accepted cookies would be the one tag
    // here that most clearly should not.
    //
    // The page-context tags mirror the taxonomy in Analytics.astro, so a
    // replay can be filtered to "deep clean, Port Macquarie" in Clarity's UI
    // and lined up against the same segment in GA4. Only the build-time
    // context is sent — never a name, email, phone or anything a visitor
    // typed. `clarity()` queues calls made before the script loads, so these
    // are safe to issue immediately.
    function installClarity(id) {
      if (!id || window.__clarityInstalled) return;
      window.__clarityInstalled = true;
      /* eslint-disable */
      (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+encodeURIComponent(i);y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,'clarity','script',id);
      /* eslint-enable */
      try {
        var ctx = (window.naturoAnalytics && window.naturoAnalytics.pageContext()) || {};
        Object.keys(ctx).forEach(function (k) {
          if (ctx[k]) window.clarity('set', k, String(ctx[k]));
        });
      } catch (e) { /* best-effort: a missing tag is not worth breaking the page */ }
    }
    function installAdvertisingStack() {
      installMetaPixel(config.metaPixelId);
      (config.ga4Ids || []).forEach(function (gaId) { installGtag(gaId); });
      if (config.googleAdsId) installGtag(config.googleAdsId);
      installGtm(config.gtmId);
      installClarity(config.clarityProjectId);
    }
    function consentGranted() {
      if (window.naturoConsent && window.naturoConsent.granted) return true;
      try {
        const raw = localStorage.getItem('naturo:consent');
        if (raw) return !!JSON.parse(raw).granted;
      } catch (e) {}
      return false;
    }
    if (consentGranted()) {
      installAdvertisingStack();
    } else {
      window.addEventListener('naturo:consent-granted', function () {
        installAdvertisingStack();
      }, { once: true });
    }

    // ---- Tracking-context capture ---------------------------------------
    function captureContext() {
      const KEY = 'naturo:lead-context';
      try {
        const existing = sessionStorage.getItem(KEY);
        if (existing) return JSON.parse(existing);
      } catch (e) { /* fall through */ }
      const params = new URLSearchParams(window.location.search);
      const ctx = {
        utm_source:   params.get('utm_source') || '',
        utm_medium:   params.get('utm_medium') || '',
        utm_campaign: params.get('utm_campaign') || '',
        utm_term:     params.get('utm_term') || '',
        utm_content:  params.get('utm_content') || '',
        gclid:        params.get('gclid') || '',
        fbclid:       params.get('fbclid') || '',
        referrer:     document.referrer || '',
        landing_page: window.location.href,
      };
      try { sessionStorage.setItem(KEY, JSON.stringify(ctx)); } catch (e) {}
      return ctx;
    }
    const trackingContext = captureContext();

    const overlay = document.getElementById('qlgOverlay');
    const form = document.getElementById('qlgForm');
    const card = overlay ? overlay.querySelector('.qlg-card') : null;
    const closeBtn = document.getElementById('qlgClose');
    if (!overlay || !form) return;

    const chrome = document.getElementById('qlgChrome');
    const backBtn = document.getElementById('qlgBack');
    const progressLabel = document.getElementById('qlgProgressLabel');
    const progressFill = document.getElementById('qlgProgressFill');
    const screens = {};
    Array.prototype.forEach.call(form.querySelectorAll('.qlg-screen'), function (s) { screens[s.getAttribute('data-step')] = s; });

    // ---- State (persists across Back/Forward within the session) --------
    const STEPS = ['intro', 'service', 'location', 'home', 'contact', 'notes', 'done'];
    const QNUM = { service: 1, location: 2, home: 3, contact: 4, notes: 5 };
    const QTOTAL = 5;
    const state = { service: '', serviceLabel: '', specialtyType: '', postcode: '', suburb: '', suburbState: '', name: '', phone: '', email: '', notes: '' };
    let stepIndex = 0;
    let pendingHref = null, lastFocused = null;

    function setError(name, message) {
      const el = form.querySelector('[data-error-for="' + name + '"]');
      if (el) el.textContent = message || '';
      const input = form.elements[name];
      if (input && typeof input.setAttribute === 'function') {
        if (message) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
      }
    }
    function clearErrors() {
      ['name', 'phone', 'email', 'suburb'].forEach(function (n) { setError(n, ''); });
    }

    var isTouch = window.matchMedia('(pointer: coarse)').matches
      || (navigator.maxTouchPoints || 0) > 0
      || ('ontouchstart' in window);
    function focusStep(name) {
      const el = screens[name];
      if (!el) return;
      let target = null;
      if (name === 'intro') target = document.getElementById('qlgStart');
      else if (name === 'service') target = el.querySelector('.qlg-option');
      else if (name === 'done') target = document.getElementById('qlgDone');
      else {
        // location / contact / notes lead with a text field. Focusing it on a
        // touch device pops the on-screen keyboard, which covers the form — so
        // on touch we move focus to the question heading (no keyboard) and let
        // the visitor tap the field themselves when they're ready.
        const field = name === 'location' ? document.getElementById('qlgSearch')
          : name === 'home' ? document.getElementById('qlgBedrooms')
          : name === 'contact' ? document.getElementById('qlgName')
          : document.getElementById('qlgNotes');
        target = isTouch ? el.querySelector('.qlg-q') : field;
      }
      if (target) setTimeout(function () { try { target.focus({ preventScroll: true }); } catch (e) { target.focus(); } }, 60);
    }

    function showStep(name, dir) {
      stepIndex = STEPS.indexOf(name);
      Object.keys(screens).forEach(function (k) {
        const s = screens[k];
        s.hidden = (k !== name);
        s.classList.remove('qlg-in-right', 'qlg-in-left');
      });
      const el = screens[name];
      // force reflow so the animation restarts each time
      void el.offsetWidth;
      el.classList.add(dir === 'back' ? 'qlg-in-left' : 'qlg-in-right');
      if (card) card.scrollTop = 0;
      // chrome: progress + back on the question steps only
      const q = QNUM[name];
      if (q) {
        chrome.hidden = false;
        progressLabel.textContent = 'Question ' + q + ' of ' + QTOTAL;
        progressFill.style.width = (q / QTOTAL * 100) + '%';
      } else {
        chrome.hidden = true;
      }
      focusStep(name);
    }

    function goBack() {
      const name = STEPS[stepIndex];
      if (name === 'service') showStep('intro', 'back');
      else if (name === 'location') showStep('service', 'back');
      else if (name === 'home') showStep('location', 'back');
      else if (name === 'contact') showStep('home', 'back');
      else if (name === 'notes') showStep('contact', 'back');
    }

    // ---- Step 1: service cards (select → animate → auto-advance) ---------
    Array.prototype.forEach.call(document.querySelectorAll('#qlgServiceOptions .qlg-option'), function (opt) {
      opt.addEventListener('click', function () {
        Array.prototype.forEach.call(document.querySelectorAll('#qlgServiceOptions .qlg-option'), function (o) {
          o.classList.remove('is-selected'); o.removeAttribute('aria-pressed');
        });
        opt.classList.add('is-selected');
        opt.setAttribute('aria-pressed', 'true');
        state.service = opt.getAttribute('data-service') || '';
        state.serviceLabel = opt.getAttribute('data-label') || '';
        state.specialtyType = opt.getAttribute('data-specialty') || '';
        setTimeout(function () { if (STEPS[stepIndex] === 'service') showStep('location', 'next'); }, 420);
      });
    });

    // ---- Step 3: the home ------------------------------------------------
    // Only bedrooms and bathrooms are enforced. They are the two numbers no
    // cleaning quote can be built without; everything else materially affects
    // the price but can be confirmed on the call, and gating on all eight would
    // trade leads for detail we can ask for later.
    function homeValue(field) {
      const el = form.elements[field];
      return el ? (el.value || '').trim() : '';
    }

    function validateHome() {
      let ok = true;
      if (!homeValue('bedrooms')) { setError('bedrooms', 'How many bedrooms?'); ok = false; }
      if (!homeValue('bathrooms')) { setError('bathrooms', 'And how many bathrooms?'); ok = false; }
      if (ok) {
        state.bedrooms = homeValue('bedrooms');
        state.bathrooms = homeValue('bathrooms');
        state.livingRooms = homeValue('living_rooms');
        state.kitchens = homeValue('kitchens');
        state.storeys = homeValue('storeys');
        state.additionalToilet = homeValue('additional_toilet');
        state.butlerPantry = homeValue('butler_pantry');
        state.laundry = homeValue('laundry');
      }
      return ok;
    }

    // ---- Step 4: contact validation (friendly) --------------------------
    function validateContact() {
      let ok = true;
      const name = (form.elements['name'].value || '').trim();
      const phone = (form.elements['phone'].value || '').trim();
      const email = (form.elements['email'].value || '').trim();
      if (!name || name.length < 2) { setError('name', 'What should we call you?'); ok = false; }
      if (phone.replace(/[^0-9]/g, '').length < 8) { setError('phone', 'A valid phone number, please.'); ok = false; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError('email', 'Double-check your email?'); ok = false; }
      if (ok) { state.name = name; state.phone = phone; state.email = email; }
      return ok;
    }

    // ---- Submit → ship the lead → thank-you -----------------------------
    let submitted = false;
    function submitLead() {
      if (submitted) return;
      submitted = true;
      state.notes = (form.elements['notes'].value || '').trim();
      try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
      var delivery = shipLead(state);
      // Show the confirmation immediately — waiting on the network before
      // acknowledging a submit is its own kind of bad — then correct it if the
      // lead turns out not to have reached anywhere. Telling someone they are
      // "all set" when nothing received their details is the worse failure.
      showStep('done', 'next');
      if (delivery && delivery.then) {
        delivery.then(function (r) {
          if (!r || r.delivered) return;
          var done = form.querySelector('[data-step="done"]');
          if (!done) return;
          done.classList.add('is-undelivered');
          var heading = done.querySelector('.qlg-heading');
          var lede = done.querySelector('.qlg-lede');
          if (heading) heading.textContent = 'Please give us a call';
          if (lede) {
            lede.textContent = window.naturoLeads
              ? window.naturoLeads.failureMessage()
              : 'We could not confirm your enquiry reached us. Please call us so we do not miss you.';
          }
        });
      }
    }

    // ---- Ship the lead to every destination (unchanged backend) ---------
    function shipToWebhook(payload) {
      // No early return on "nothing configured" — the caller now depends on a
      // promise coming back, and the shared layer already reports an
      // unconfigured setup as delivered rather than as a failure.
      var serviceLabels = { regular: 'Regular Home Cleaning', oneoff: 'Deep Clean', specialty: 'NDIS, DVA, Aged Care & Insurance' };
      var serviceLabel = payload.serviceLabel || serviceLabels[payload.service] || payload.service || '';
      // Sophiie CRM lead-intake accepts { name, email, phone, message }; fold the
      // full enquiry into the message so nothing is lost.
      var lines = [];
      if (serviceLabel) lines.push('Service: ' + serviceLabel);
      var loc = ((payload.suburb || '') + ' ' + (payload.postcode || '')).trim();
      if (loc) lines.push('Location: ' + loc);
      if (payload.notes) lines.push('Notes: ' + payload.notes);
      lines.push('Submitted via naturogroup.com.au');
      var crmPayload = {
        name: payload.name || '',
        email: payload.email || '',
        phone: payload.phone || '',
        message: lines.join('\n'),
        // Marketing attribution. Without this the CRM can only ever record
        // "Web form" as the source, so no lead can be traced back to the
        // campaign, keyword or landing page that produced it.
        lead_id: payload.lead_id || '',
        service: payload.service_key || '',
        service_location: payload.service_location || '',
        lead_type: payload.specialty_type || 'standard',
        form_location: 'quote_lead_gate',
        attribution: payload.attribution || {},
        // Passed as fields, NOT folded into `message` above: the CRM's intake
        // labels any extra key it receives ("Bedrooms: 3"), so doing both would
        // print every answer twice in the Inbox.
        bedrooms: payload.bedrooms || '',
        bathrooms: payload.bathrooms || '',
        living_rooms: payload.living_rooms || '',
        kitchens: payload.kitchens || '',
        storeys: payload.storeys || '',
        additional_toilet: payload.additional_toilet || '',
        butler_pantry: payload.butler_pantry || '',
        laundry: payload.laundry || '',
      };
      // Delivery (and the checking of it) lives in the shared layer so all
      // four lead paths behave the same way. Returns a promise the caller
      // uses to correct the confirmation screen if nothing accepted the lead.
      if (window.naturoLeads) return window.naturoLeads.deliver(crmPayload);
      return Promise.resolve({ delivered: true });
    }
    function shipToMetaPixel(payload) {
      if (!config.metaPixelId || typeof window.fbq !== 'function') return;
      try {
        window.fbq('track', 'Lead', { content_name: 'Instant Price Gate', content_category: 'quote' }, { eventID: payload.event_id });
      } catch (e) {}
    }
    function shipToGoogleAds(payload) {
      if (!config.googleAdsId || typeof window.gtag !== 'function') return;
      try {
        const sendTo = config.googleAdsLabel ? config.googleAdsId + '/' + config.googleAdsLabel : config.googleAdsId;
        window.gtag('event', 'conversion', { send_to: sendTo, transaction_id: payload.event_id });
        window.gtag('event', 'generate_lead', { currency: 'AUD', value: 0, transaction_id: payload.event_id });
      } catch (e) {}
    }
    // The modal's internal service values map onto the shared analytics
    // taxonomy so reporting is consistent with the service pages.
    function serviceKey(values) {
      if (values.service === 'regular') return 'residential_cleaning';
      if (values.service === 'oneoff') return 'deep_cleaning';
      if (values.service === 'specialty') {
        return values.specialtyType === 'insurance' ? 'insurance_cleaning' : 'ndis_cleaning';
      }
      return '';
    }

    /**
     * Lead event for GA4/GTM.
     *
     * This previously pushed the customer's name, phone and email straight
     * into window.dataLayer. Any GTM tag reads the dataLayer, so that put raw
     * personal information one misconfigured tag away from Google and Meta —
     * against GA4's terms and Australian privacy obligations. Only
     * non-identifying business dimensions are sent now; the lead_id is the
     * join key back to the CRM, which is where the contact details live.
     */
    function shipToDataLayer(payload) {
      var na = window.naturoAnalytics;
      var params = {
        lead_id: payload.lead_id,
        service: payload.service_key,
        service_location: payload.service_location,
        lead_type: payload.specialty_type || 'standard',
        form_location: 'quote_lead_gate',
        currency: 'AUD',
        value: 0,
      };
      if (na) { na.track('generate_lead', params); return; }
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(Object.assign({ event: 'generate_lead' }, params));
    }
    function shipLead(values) {
      const na = window.naturoAnalytics;
      const eventId = (window.crypto && window.crypto.randomUUID)
        ? window.crypto.randomUUID()
        : 'lead_' + Date.now() + '_' + Math.random().toString(36).slice(2, 10);
      // One id per lead, shared by GA4, Google Ads and the CRM so the same
      // enquiry can be followed end to end without sending any PII to Google.
      const leadId = na ? na.newLeadId() : eventId;
      const ctx = na ? na.pageContext() : {};
      const payload = {
        event: 'lead_captured',
        event_id: eventId,
        lead_id: leadId,
        captured_at: new Date().toISOString(),
        service: values.service,
        service_key: serviceKey(values),
        service_location: values.suburb ? String(values.suburb).toLowerCase().replace(/[^a-z0-9]+/g, '_') : (ctx.service_location || ''),
        serviceLabel: values.serviceLabel,
        specialty_type: values.specialtyType,
        postcode: values.postcode,
        suburb: values.suburb,
        name: values.name,
        phone: values.phone,
        email: values.email,
        notes: values.notes,
        // The property answers, as given. Kept as separate fields rather than
        // folded into the notes so the CRM can label and later query them.
        bedrooms: values.bedrooms,
        bathrooms: values.bathrooms,
        living_rooms: values.livingRooms,
        kitchens: values.kitchens,
        storeys: values.storeys,
        additional_toilet: values.additionalToilet,
        butler_pantry: values.butlerPantry,
        laundry: values.laundry,
        source: trackingContext,
        attribution: na ? na.attributionFields() : {},
        page: { url: window.location.href, path: window.location.pathname, title: document.title },
      };
      var delivery = shipToWebhook(payload);
      shipToMetaPixel(payload);
      shipToGoogleAds(payload);
      shipToDataLayer(payload);
      return delivery;
    }

    // ---- Step 2: postcode → suburb combobox + serviced check ------------
    var searchInput = document.getElementById('qlgSearch');
    var clearBtn = document.getElementById('qlgSearchClear');
    var suburbList = document.getElementById('qlgSuburbList');
    var pcHidden = document.getElementById('qlgPostcode');
    var suburbHidden = document.getElementById('qlgSuburb');
    var suburbStateHidden = document.getElementById('qlgSuburbState');
    var pcStatus = document.getElementById('qlgPostcodeStatus');
    var pcSearchWrap = document.getElementById('qlgPcSearch');
    var servicedPanel = document.getElementById('qlgServiced');
    var notServicedPanel = document.getElementById('qlgNotServiced');
    var locationNext = document.getElementById('qlgLocationNext');
    var pcToken = 0, pcDebounce = null, listedSuburbs = false, suburbOptional = false;
    // pcInvalid = true when the entered value isn't a real 4-digit AU postcode.
    var pcInvalid = false;

    function esc(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function setStatus(msg, warn) {
      if (!pcStatus) return;
      pcStatus.textContent = msg || '';
      pcStatus.classList.toggle('is-warn', !!warn);
      if (msg) pcStatus.removeAttribute('hidden'); else pcStatus.setAttribute('hidden', '');
    }
    function closeList() {
      if (suburbList) { suburbList.innerHTML = ''; suburbList.setAttribute('hidden', ''); }
      if (searchInput) searchInput.setAttribute('aria-expanded', 'false');
    }
    function resetLocationPanels() {
      servicedPanel.hidden = true;
      notServicedPanel.hidden = true;
    }
    function updateLocationNext() {
      const ready = /^\d{4}$/.test(pcHidden.value) && !pcInvalid && (!!suburbHidden.value || suburbOptional);
      locationNext.disabled = !ready;
    }
    function onSuburbChosen(stateAbbr) {
      state.postcode = pcHidden.value;
      state.suburb = suburbHidden.value;
      state.suburbState = stateAbbr || '';
      const serviced = SERVICED_STATES.indexOf((stateAbbr || '').toUpperCase()) !== -1;
      servicedPanel.hidden = !serviced;
      notServicedPanel.hidden = serviced;
      updateLocationNext();
      if (serviced) {
        setTimeout(function () { if (STEPS[stepIndex] === 'location' && suburbHidden.value) showStep('home', 'next'); }, 1300);
      }
    }
    function selectSuburb(name, stateAbbr, pc) {
      suburbHidden.value = name;
      suburbStateHidden.value = stateAbbr || '';
      pcHidden.value = pc;
      searchInput.value = name + ', ' + stateAbbr + ' ' + pc;
      clearBtn.removeAttribute('hidden');
      setError('suburb', '');
      closeList();
      onSuburbChosen(stateAbbr);
    }
    function lookupSuburbs(pc) {
      var token = ++pcToken;
      listedSuburbs = false;
      suburbOptional = false;
      pcInvalid = false;
      setStatus('Checking postcode…');
      closeList();
      fetch('https://api.zippopotam.us/au/' + encodeURIComponent(pc))
        .then(function (r) {
          if (r.status === 404) return { __notReal: true };  // no such AU postcode
          if (!r.ok) return { __error: true };                // server hiccup
          return r.json();
        })
        .then(function (data) {
          if (token !== pcToken) return;
          if (data && data.__notReal) {
            pcInvalid = true;
            setStatus('Hmm, that postcode doesn’t look right — mind checking it?', true);
            updateLocationNext();
            return;
          }
          if (data && data.__error) {
            suburbOptional = true;
            setStatus('We couldn’t check that just now — you can still continue.');
            updateLocationNext();
            return;
          }
          var places = (data && data.places) || [];
          var seen = {}, items = [];
          places.forEach(function (p) {
            var name = (p['place name'] || '').trim();
            var st = (p['state abbreviation'] || '').trim();
            var key = (name + '|' + st).toLowerCase();
            if (name && !seen[key]) { seen[key] = 1; items.push({ name: name, state: st }); }
          });
          if (!items.length) {
            pcInvalid = true;
            setStatus('Hmm, that postcode doesn’t look right — mind checking it?', true);
            updateLocationNext();
            return;
          }
          listedSuburbs = true;
          suburbOptional = false;
          pcInvalid = false;
          suburbList.innerHTML = items.map(function (it) {
            return '<li class="qlg-pcsearch-item" role="option" data-name="' + esc(it.name) + '" data-state="' + esc(it.state) + '">'
              + '<span class="qlg-pcsearch-item-name">' + esc(it.name) + '</span> '
              + '<span class="qlg-pcsearch-item-meta">(' + esc(it.state) + ' ' + esc(pc) + ')</span></li>';
          }).join('');
          suburbList.removeAttribute('hidden');
          searchInput.setAttribute('aria-expanded', 'true');
          setStatus('');
          updateLocationNext();
        })
        .catch(function () {
          if (token !== pcToken) return;
          suburbOptional = true;
          setStatus('Couldn’t look up suburbs right now — you can still continue.');
          updateLocationNext();
        });
    }
    if (searchInput) {
      searchInput.addEventListener('input', function () {
        var raw = searchInput.value;
        clearBtn.toggleAttribute('hidden', !raw);
        suburbHidden.value = '';
        suburbStateHidden.value = '';
        resetLocationPanels();
        if (pcDebounce) clearTimeout(pcDebounce);
        pcToken++;                 // cancel any in-flight lookup
        listedSuburbs = false;
        suburbOptional = false;
        pcInvalid = false;
        closeList();
        // Australian postcodes are exactly 4 digits — don't silently truncate
        // a longer number (e.g. 4353636); flag it so the user can't move on.
        var digits = raw.replace(/\D/g, '');
        if (digits.length === 4) {
          pcHidden.value = digits;
          setStatus('');
          pcDebounce = setTimeout(function () { lookupSuburbs(digits); }, 300);
        } else {
          pcHidden.value = '';
          if (digits.length > 4) {
            pcInvalid = true;
            setStatus('An Australian postcode is 4 digits — mind checking that?', true);
          } else {
            setStatus('');
          }
        }
        updateLocationNext();
      });
      clearBtn.addEventListener('click', function () {
        searchInput.value = ''; pcHidden.value = ''; suburbHidden.value = ''; suburbStateHidden.value = '';
        clearBtn.setAttribute('hidden', ''); listedSuburbs = false; suburbOptional = false; pcInvalid = false;
        pcToken++; closeList(); setStatus(''); resetLocationPanels(); updateLocationNext(); searchInput.focus();
      });
      suburbList.addEventListener('click', function (ev) {
        var li = ev.target.closest('.qlg-pcsearch-item');
        if (!li) return;
        selectSuburb(li.getAttribute('data-name'), li.getAttribute('data-state'), pcHidden.value);
      });
      document.addEventListener('click', function (ev) {
        if (pcSearchWrap && !pcSearchWrap.contains(ev.target)) closeList();
      });
    }
    locationNext.addEventListener('click', function () {
      if (locationNext.disabled) return;
      if (!state.postcode) state.postcode = pcHidden.value;
      if (!state.suburb) state.suburb = suburbHidden.value;
      showStep('contact', 'next');
    });

    // ---- Buttons / navigation -------------------------------------------
    document.getElementById('qlgStart').addEventListener('click', function () { showStep('service', 'next'); });
    backBtn.addEventListener('click', goBack);
    document.getElementById('qlgSkip').addEventListener('click', function () { submitLead(); });
    document.getElementById('qlgDone').addEventListener('click', function () { closeModal(); });

    form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      const name = STEPS[stepIndex];
      if (name === 'location') { if (!locationNext.disabled) locationNext.click(); }
      else if (name === 'home') { clearErrors(); if (validateHome()) showStep('contact', 'next'); }
      else if (name === 'contact') { clearErrors(); if (validateContact()) showStep('notes', 'next'); }
      else if (name === 'notes') { submitLead(); }
    });

    // ---- Open / close ----------------------------------------------------
    function openModal(href) {
      pendingHref = href;
      submitted = false;
      lastFocused = document.activeElement;
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
      showStep('intro', 'next');
    }
    function closeModal() {
      overlay.setAttribute('hidden', '');
      overlay.removeAttribute('role');
      overlay.removeAttribute('aria-modal');
      document.body.style.overflow = '';
      pendingHref = null;
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    }

    // Focus trap (WCAG 2.1.2.1)
    function getFocusable() {
      const sel = ['a[href]', 'button:not([disabled])', 'input:not([disabled]):not([type="hidden"])', 'select:not([disabled])', 'textarea:not([disabled])', '[tabindex]:not([tabindex="-1"])'].join(',');
      return Array.prototype.slice.call(overlay.querySelectorAll(sel)).filter(function (el) { return el.offsetParent !== null; });
    }
    overlay.addEventListener('keydown', function (ev) {
      if (ev.key !== 'Tab') return;
      const items = getFocusable();
      if (!items.length) return;
      const first = items[0], last = items[items.length - 1], active = document.activeElement;
      if (ev.shiftKey && active === first) { ev.preventDefault(); last.focus(); }
      else if (!ev.shiftKey && active === last) { ev.preventDefault(); first.focus(); }
    });
    overlay.addEventListener('click', function (ev) { if (ev.target === overlay) closeModal(); });
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    document.addEventListener('keydown', function (ev) {
      if (ev.key === 'Escape' && !overlay.hasAttribute('hidden')) closeModal();
    });

    // ---- Intercept every "Get a Free Quote" (/quote) link -----------
    function isQuoteLink(a) {
      if (!a || a.tagName !== 'A') return false;
      if (a.target && a.target !== '' && a.target !== '_self') return false;
      const raw = a.getAttribute('href');
      if (!raw) return false;
      try {
        const url = new URL(a.href, window.location.href);
        if (url.origin !== window.location.origin) return false;
        return url.pathname === TARGET_PATH || url.pathname === TARGET_PATH + '/';
      } catch (e) { return false; }
    }
    document.addEventListener('click', function (ev) {
      if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
      if (ev.button !== undefined && ev.button !== 0) return;
      const a = ev.target && ev.target.closest ? ev.target.closest('a') : null;
      if (!isQuoteLink(a)) return;
      if (window.location.pathname === TARGET_PATH || window.location.pathname === TARGET_PATH + '/') return;
      ev.preventDefault();
      openModal(a.href);
    }, true);
  })();
</script>

<style>
  /* ============================ Overlay + card ======================== */
  .qlg-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(15, 23, 42, 0.55);
    animation: qlg-fade 200ms ease-out;
    overflow-y: auto;
  }
  .qlg-overlay[hidden] { display: none; }
  @keyframes qlg-fade { from { opacity: 0; } to { opacity: 1; } }

  .qlg-card {
    position: relative;
