---
// Per-city hiring page: /cleaning-jobs-port-macquarie/, /cleaning-jobs-geelong/
//
// Exists because "cleaning jobs <city>" searches had nothing on the site to
// land on — only the national /career/ page, whose single JobPosting spans
// eight cities. Google for Jobs ranks one-job-one-place listings; that is how
// Indeed and Seek show up for these searches. Each city here gets its own
// posting with a single jobLocation.
//
// All pay, requirement and process copy comes from src/data/career.ts, the
// same source the national page uses. Nothing here is city-specific except
// the suburbs served and the kind of work — both taken from pages the site
// already publishes.
//
// The layout is a job-board listing, not a marketing page: header card with
// title, employer, pay, work type, location and hours; description on the
// left; a pinned job-details panel on the right; and the application form at
// the bottom of the same page. Candidates arriving from a job search expect
// Seek's shape, and bouncing them to /career/ to apply lost them.
import Layout from '../layouts/Layout.astro';
import FAQ from '../components/FAQ.astro';
import ApplyForm from '../components/ApplyForm.astro';
import { site } from '../data/site';
import { benefits, wellLook, niceToHave, steps, dailyWork, careerCities, payRange, payLine, jobTitle, type CareerCity } from '../data/career';

export function getStaticPaths() {
  return careerCities.map((c) => ({ params: { city: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: CareerCity };
const pageUrl = `${site.url}/cleaning-jobs-${c.slug}`;
// Applicants apply on this page now, the way a Seek or Indeed listing works.
// The form is the same component /career/ uses, so the fields and the CRM
// delivery are identical — only form_location and job_city differ.
const applyHref = '#apply';

// Same posting window the national page uses.
const today = new Date();
const validThrough = new Date(today);
validThrough.setFullYear(validThrough.getFullYear() + 1);
const isoToday = today.toISOString().split('T')[0];
const isoValidThrough = validThrough.toISOString().split('T')[0];

const listedOn = today.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });

// The summary rows a job board puts at the top of a listing, in the order
// candidates scan them: pay, work type, where, when.
const jobMeta = [
  { icon: 'pay', text: `$${payRange.min.toFixed(2)} – $${payRange.max.toFixed(2)} per hour incl. super & vehicle allowance` },
  { icon: 'type', text: 'Full time, Part time and Casual — employee roles, no ABN' },
  { icon: 'place', text: `${c.city} ${c.state} ${c.postcode} · ${c.region}` },
  { icon: 'clock', text: 'Monday to Friday, 8am–4pm. No nights, no weekends' },
];

const jobDetails = [
  { label: 'Pay', value: `$${payRange.min.toFixed(2)} – $${payRange.max.toFixed(2)} per hour` },
  { label: 'Work type', value: 'Permanent part time, full time or casual' },
  { label: 'Classification', value: 'Cleaning Services (Trades & Services)' },
  { label: 'Location', value: `${c.city} ${c.state} ${c.postcode}` },
  { label: 'Hours', value: 'Mon–Fri, 8am–4pm. School-hours shifts available' },
  { label: 'Checks', value: 'National Police Check + NDIS Worker Screening' },
  { label: 'Start', value: 'Immediate start for the right candidates' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'JobPosting',
    title: `${jobTitle} | ${c.city}`,
    description: c.intro.join(' '),
    datePosted: isoToday,
    validThrough: isoValidThrough,
    // Employee roles only — the listing is explicit that this is not ABN or
    // contractor work. Casual has no schema.org value; PART_TIME covers it.
    employmentType: ['FULL_TIME', 'PART_TIME'],
    hiringOrganization: {
      '@type': 'Organization',
      name: site.name,
      sameAs: site.url,
      logo: `${site.url}/images/logo.png`,
    },
    // One place, on purpose. streetAddress deliberately omitted: cleaners work
    // in clients' homes, and there is no site address to give.
    jobLocation: {
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        addressLocality: c.city,
        addressRegion: c.state,
        postalCode: c.postcode,
        addressCountry: 'AU',
      },
    },
    applicantLocationRequirements: { '@type': 'Country', name: 'Australia' },
    // The form is on this page now, so Google for Jobs can mark it apply-here.
    directApply: true,
    baseSalary: {
      '@type': 'MonetaryAmount',
      currency: payRange.currency,
      value: {
        '@type': 'QuantitativeValue',
        minValue: payRange.min,
        maxValue: payRange.max,
        unitText: payRange.unit,
      },
    },
    industry: 'Residential & Disability Support Cleaning',
    qualifications:
      'A reliable car and current Australian driver’s licence; living within about 25 minutes of the town centre; available at least two weekdays between 8am and 4pm; willing to complete a National Police Check and NDIS Worker Screening Check; working rights in Australia.',
    responsibilities: dailyWork.join('; '),
    jobBenefits:
      'Superannuation and vehicle allowance included; paid induction and training; paid travel between jobs; all equipment, uniforms and products supplied; career progression to Team Leader and Management.',
    workHours: 'Monday to Friday, 8am–4pm. No nights or weekends. School-hours shifts available.',
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Careers', item: `${site.url}/career` },
      { '@type': 'ListItem', position: 3, name: `Cleaning Jobs ${c.city}`, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
// Monochrome line icons for the summary rows, inlined so the listing header
// costs no extra request.
const icons: Record<string, string> = {
  pay: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M14.5 9.2a3 3 0 0 0-5 2.2c0 2.6 5 1.6 5 4.2a3 3 0 0 1-5 2.1"/><path d="M12 6.5v11"/></svg>',
  type: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg>',
  place: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>',
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/></svg>',
};
---

<Layout
  title={`Cleaning Jobs in ${c.city} ${c.state} ${c.postcode}`}
  description={`Cleaner jobs in ${c.city} ${c.state}. Permanent & casual employee roles, $${payRange.min}/hr incl. super. No nights or weekends, paid training. Apply now.`}
  schema={schema}
>
  <!-- 1. Listing header — the job-board pattern: title, employer, the four
       facts candidates scan for, and Apply in reach without scrolling. -->
  <section class="jb-top">
    <div class="container-site jb-top-inner">
      <nav class="jb-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/career/">Cleaning jobs</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{c.city}</span>
      </nav>

      <div class="jb-card">
        <p class="jb-listed">Listed {listedOn} · Immediate start available</p>
        <h1 class="jb-title">{jobTitle}</h1>
        <p class="jb-org">
          <span class="jb-org-name">{site.name}</span>
          <span class="jb-dot" aria-hidden="true">·</span>
          <span>{c.city} {c.state} {c.postcode}</span>
        </p>

        <ul class="jb-meta">
          {jobMeta.map((m) => (
            <li class="jb-meta-row">
              <span class="jb-ico" aria-hidden="true" set:html={icons[m.icon]} />
              <span>{m.text}</span>
            </li>
          ))}
        </ul>

        <div class="jb-actions">
          <a href={applyHref} class="jb-apply"><span>Apply now</span><span class="jb-apply-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span></a>
          <a href={site.phoneHref} class="jb-call">Or call {site.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. The listing body: description on the left, the job-details panel
       pinned on the right, exactly as a job board lays it out. -->
  <section class="jb-body">
    <div class="container-site jb-body-inner">
      <article class="jb-desc">
        <h2 class="jb-h2">About the role</h2>
        {c.intro.map((p) => <p class="jb-p">{p}</p>)}

        <h2 class="jb-h2">Your daily work</h2>
        <ul class="jb-list">
          {dailyWork.map((w) => <li>{w}</li>)}
        </ul>

        <h2 class="jb-h2">What you must have</h2>
        <p class="jb-p jb-p-tight">These are the hard requirements. Applications that don’t meet them can’t be considered.</p>
        <ul class="jb-list">
          {wellLook.map((t) => <li>{t}</li>)}
        </ul>

        <h2 class="jb-h2">What we look for</h2>
        <p class="jb-p jb-p-tight">Preferred, not essential — we’ll train the right person.</p>
        <ul class="jb-list jb-list-plus">
          {niceToHave.map((t) => <li>{t}</li>)}
        </ul>

        <h2 class="jb-h2">What we offer</h2>
        <dl class="jb-benefits">
          {benefits.map((b) => (
            <div class="jb-benefit">
              <dt>{b.title}</dt>
              <dd>{b.body}</dd>
            </div>
          ))}
        </dl>

        <h2 class="jb-h2">How the application process works</h2>
        <ol class="jb-steps">
          {steps.map((s) => (
            <li>
              <span class="jb-step-n">{s.n}</span>
              <span class="jb-step-body">
                <strong>{s.title}</strong>
                <span>{s.body}</span>
              </span>
            </li>
          ))}
        </ol>

        <div class="jb-inline-cta">
          <a href={applyHref} class="jb-apply"><span>Apply for this job</span><span class="jb-apply-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span></a>
          <p class="jb-inline-note">Two minutes. Tell us whether you want permanent or casual hours — your local Team Leader calls within 48 hours.</p>
        </div>
      </article>

      <aside class="jb-side" aria-label="Job details">
        <div class="jb-panel">
          <h2 class="jb-panel-h">Job details</h2>
          <dl class="jb-details">
            {jobDetails.map((d) => (
              <div class="jb-detail">
                <dt>{d.label}</dt>
                <dd>{d.value}</dd>
              </div>
            ))}
          </dl>
          <a href={applyHref} class="jb-apply jb-apply-block"><span>Apply now</span><span class="jb-apply-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span></a>
          <p class="jb-panel-note">{payLine}. Questions? Call <a href={site.phoneHref}>{site.phone}</a>.</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- 3. FAQ -->
  <FAQ
    items={c.faqs}
    eyebrow={`Cleaning jobs ${c.city} — common questions`}
    subheading={`What cleaners ask before joining the ${c.city} team.`}
  />

  <!-- 4. Where the work is -->
  <section class="jb-where">
    <div class="container-site" style="max-width: 1160px;">
      <h2 class="jb-where-h">Where our {c.city} cleaners work</h2>
      <div class="jb-suburbs">
        {c.suburbs.map((s) => <a href={`/${s.slug}/`}>{s.name}</a>)}
      </div>
      <p class="jb-where-note">Looking for a cleaner rather than a job?</p>
      <p class="jb-where-links">
        <a href={c.hubHref}>{c.hubLabel} &rarr;</a>
        <span aria-hidden="true">·</span>
        <a href="/career/">All cleaning jobs &rarr;</a>
      </p>
    </div>
  </section>

  <!-- 5. Apply — the same form, the same CRM path, as /career/ -->
  <ApplyForm
    heading={`Apply for cleaning jobs in ${c.city}`}
    formLocation={`cleaning-jobs-${c.slug}`}
    jobCity={c.city}
  />
</Layout>

<style>
  /* ---------------------------------------------------------------------
     Job-board listing layout. Deliberately plain: no photo hero, no marketing
     furniture above the fold. A candidate arriving from a "cleaning jobs
     <city>" search wants pay, hours, location and Apply — the same four
     things Seek and Indeed lead with — and the page gives them in that order.
     --------------------------------------------------------------------- */
  .jb-top {
    background: linear-gradient(150deg, #e8eeff 0%, #f0f4ff 60%, #edf2ff 100%);
    padding: clamp(28px, 4vw, 48px) 0 clamp(40px, 5vw, 64px);
    border-bottom: 1px solid rgba(15, 23, 42, 0.07);
    scroll-margin-top: 100px;
  }
  .jb-top-inner { max-width: 1160px; }

  .jb-crumbs {
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: rgb(100, 116, 139);
    margin-bottom: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .jb-crumbs a { color: rgb(100, 116, 139); text-decoration: none; }
  .jb-crumbs a:hover { color: #3a5dff; text-decoration: underline; }

  .jb-card {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    padding: clamp(26px, 3.4vw, 40px);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 4px 18px rgba(15, 23, 42, 0.05);
  }
  .jb-listed {
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #3a5dff;
    margin: 0 0 12px;
  }
  .jb-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(28px, 3.6vw, 42px);
    font-weight: 300;
    line-height: 1.14;
    letter-spacing: -0.015em;
    color: #0f172a;
    margin: 0 0 10px;
  }
  .jb-org {
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 300;
    color: rgb(71, 85, 105);
    margin: 0 0 22px;
  }
  .jb-org-name { font-weight: 500; color: #0f172a; }
  .jb-dot { margin: 0 8px; color: rgba(15, 23, 42, 0.3); }

  .jb-meta { list-style: none; margin: 0 0 26px; padding: 0; display: grid; gap: 12px; }
  .jb-meta-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.5;
    color: rgb(51, 65, 85);
  }
  .jb-ico { flex: none; width: 20px; height: 20px; color: #3a5dff; margin-top: 1px; }
  .jb-ico :global(svg) { width: 20px; height: 20px; display: block; }

  .jb-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  /* The site's form submit button, to the pixel: same gradient pill, same
     white icon disc, same lift on hover as .cr-submit / .ct-submit. */
  .jb-apply {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: linear-gradient(135deg, #4a6bff 0%, #2748f2 100%);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    min-height: 44px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(37, 72, 240, 0.32);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .jb-apply:hover { box-shadow: 0 8px 22px rgba(37, 72, 240, 0.45); transform: translateY(-1px); }
  .jb-apply-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background-color: #ffffff;
    border: 1px solid #ffffff;
    color: #1C244B;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .jb-apply-icon svg { display: block; width: 14px; height: 14px; }
  .jb-apply-block { display: flex; width: 100%; margin-top: 20px; }
  .jb-call {
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: rgb(71, 85, 105);
    text-decoration: none;
  }
  .jb-call:hover { color: #3a5dff; text-decoration: underline; }

  /* ---------- Body: description + pinned details panel ---------- */
  .jb-body { background: #ffffff; padding: clamp(40px, 5vw, 64px) 0 clamp(56px, 7vw, 88px); }
  .jb-body-inner {
    max-width: 1160px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .jb-body-inner { grid-template-columns: minmax(0, 1fr); }
    .jb-side { order: -1; }
  }

  .jb-h2 {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #0f172a;
    margin: 40px 0 14px;
  }
  .jb-desc > .jb-h2:first-child { margin-top: 0; }
  .jb-p {
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.7;
    color: rgb(71, 85, 105);
    margin: 0 0 16px;
  }
  .jb-p-tight { margin-bottom: 10px; }

  .jb-list { list-style: none; margin: 0; padding: 0; }
  .jb-list li {
    position: relative;
    padding: 9px 0 9px 28px;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.55;
    color: rgb(51, 65, 85);
  }
  .jb-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 11px;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: #3a5dff;
    color: #fff;
    font-size: 11px;
    line-height: 17px;
    text-align: center;
  }
  .jb-list-plus li::before { content: '+'; background: rgba(58, 93, 255, 0.14); color: #3a5dff; }

  .jb-benefits { margin: 0; display: grid; gap: 16px; }
  .jb-benefit {
    border-left: 2px solid rgba(58, 93, 255, 0.3);
    padding-left: 16px;
  }
  .jb-benefit dt {
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #0f172a;
    margin-bottom: 4px;
  }
  .jb-benefit dd {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.65;
    color: rgb(71, 85, 105);
  }

  .jb-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .jb-steps li { display: flex; gap: 14px; align-items: flex-start; }
  .jb-step-n {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #f1f5f9;
    color: #3a5dff;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 600;
    line-height: 30px;
    text-align: center;
  }
  .jb-step-body { display: grid; gap: 3px; }
  .jb-step-body strong {
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #0f172a;
  }
  .jb-step-body span {
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.65;
    color: rgb(71, 85, 105);
  }

  .jb-inline-cta { margin-top: 36px; padding-top: 28px; border-top: 1px solid rgba(15, 23, 42, 0.08); }
  .jb-inline-note {
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.65;
    color: rgb(71, 85, 105);
    margin: 14px 0 0;
    max-width: 520px;
  }

  /* ---------- The pinned job-details panel ---------- */
  .jb-side { position: sticky; top: 24px; }
  @media (max-width: 900px) { .jb-side { position: static; } }
  .jb-panel {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    padding: 26px 24px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 4px 18px rgba(15, 23, 42, 0.05);
  }
  .jb-panel-h {
    font-family: 'Poppins', sans-serif;
    font-size: 17px;
    font-weight: 500;
    color: #0f172a;
    margin: 0 0 16px;
  }
  .jb-details { margin: 0; display: grid; gap: 14px; }
  .jb-detail dt {
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #0f172a;
    margin-bottom: 4px;
  }
  .jb-detail dd {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.55;
    color: rgb(71, 85, 105);
  }
  .jb-panel-note {
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.6;
    color: rgb(100, 116, 139);
    margin: 14px 0 0;
  }
  .jb-panel-note a { color: #3a5dff; text-decoration: none; }
  .jb-panel-note a:hover { text-decoration: underline; }

  /* ---------- Where the work is ---------- */
