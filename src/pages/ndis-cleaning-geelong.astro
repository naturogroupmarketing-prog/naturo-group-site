---
import Layout from '../layouts/Layout.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import ServiceHero from '../components/ServiceHero.astro';
import ServiceIntro from '../components/ServiceIntro.astro';
import ServiceInclusions from '../components/ServiceInclusions.astro';
import Features from '../components/Features.astro';
import Testimonials from '../components/Testimonials.astro';
import Providers from '../components/Providers.astro';
import FAQ from '../components/FAQ.astro';
import AppPromo from '../components/AppPromo.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { site, ctaPrimary  } from '../data/site';

const pageUrl = `${site.url}/ndis-cleaning-geelong`;

const introBody = [
  'NATURO GROUP supports NDIS participants across Greater Geelong and the Bellarine Peninsula with everyday cleaning so home stays comfortable, safe and easy to live in. We work with plan-managed and self-managed participants every week, with a trained team that aims for consistency — because familiar faces matter.',
  'We handle invoicing and reporting direct to your plan manager or support coordinator so you don\'t have the paperwork. Note: we are not currently a registered NDIS provider, so agency-managed (NDIA-managed) funding cannot be used.',
  'Our plant-based, fragrance-conscious products are chosen specifically for participants with sensory sensitivities, respiratory conditions, allergies or compromised immune systems. We never use harsh chemical cleaners in our participants\' homes.',
];

const introStats = [
  { num: 'NDIS', label: 'Plan & self-managed welcome' },
  { num: '100%', label: 'Non-toxic products' },
  { num: '100%', label: 'Police-checked team' },
];

const inclusions = [
  {
    group: 'Kitchen & living',
    items: [
      'Wipe benches, splashbacks and cabinet fronts',
      'Clean stovetop, microwave and sink',
      'Vacuum and mop floors',
      'Empty bins and replace liners',
    ],
  },
  {
    group: 'Bathrooms & bedrooms',
    items: [
      'Disinfect basins, showers and toilets',
      'Wipe mirrors, tiles and fittings',
      'Change linen on request',
      'Dust surfaces and tidy rooms',
    ],
  },
  {
    group: 'Plan support',
    items: [
      'Direct invoicing to plan managers',
      'Detailed service notes on request',
      'Flexible scheduling around appointments',
      'Police-checked, fully insured cleaners',
    ],
  },
];

const geelongFaqs = [
  {
    q: 'Does Naturo Group work with NDIS plan managers in Geelong?',
    a: 'Yes. We work with plan-managed and self-managed NDIS participants across Greater Geelong and the Bellarine Peninsula. We provide detailed invoices and reports in the format your plan manager requires.',
  },
  {
    q: 'How do I fund NDIS cleaning in Geelong through my plan?',
    a: 'NDIS cleaning falls under Core Supports — Assistance with Daily Life (line item 01). If you are self-managed, you pay us directly and we provide a receipt for your records. If you are plan-managed, we invoice your plan manager directly. Note: we are not a registered NDIS provider, so agency-managed (NDIA-managed) funding cannot currently be used.',
  },
  {
    q: 'What areas of Geelong do you cover for NDIS cleaning?',
    a: 'We service all of Greater Geelong and the Bellarine — including Geelong CBD, Newtown, Highton, Belmont, Geelong West, Lara, Leopold, Ocean Grove, Torquay, Barwon Heads, Armstrong Creek, Grovedale, Waurn Ponds and Mount Duneed.',
  },
  {
    q: 'Will I have the same cleaner each visit?',
    a: 'We match you with a regular Geelong team member wherever possible. Consistency matters enormously for participants who benefit from familiar routines and faces. If your regular cleaner is unavailable, we always notify you in advance.',
  },
  {
    q: 'Are your cleaners trained to work with people with disability?',
    a: "Yes. Our approach is shaped by founder Anna Biram's registered nursing background — our team is trained in dignity of care, patient communication, infection control and adapting to the specific needs of each participant.",
  },
  {
    q: "What eco-friendly products do you use in NDIS participants' homes?",
    a: 'All our products are plant-based, non-toxic and fragrance-conscious — safe for participants with sensory sensitivities, respiratory conditions, allergies or compromised immune systems. We never use harsh chemical cleaners.',
  },
  {
    q: 'Can you also help with aged care cleaning in Geelong?',
    a: 'Yes. We work with My Aged Care providers and Home Care Package recipients across Geelong. Aged care and NDIS cleaning can be combined under a single service agreement if needed.',
  },
  {
    q: 'How do I get started with NDIS cleaning in Geelong?',
    a: "Call 1300 876 472 or complete our online enquiry. We'll confirm your funding type, agree on a cleaning schedule and frequency that suits your plan, and send a service agreement for you or your plan manager to sign.",
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    // Service, not LocalBusiness: Google requires `address` on
    // LocalBusiness, and NATURO GROUP has no premises to name here.
    // `provider` joins this page to the single Organization entity in
    // Layout.astro, which is what the old parentOrganization did.
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    serviceType: 'NDIS cleaning',
    provider: { '@id': `${site.url}/#organization` },
    name: 'NDIS Cleaning in Geelong',
    description:
      'NDIS cleaning services in Geelong for plan-managed and self-managed participants. Police-checked, trained team using eco-conscious products. Serving Greater Geelong and the Bellarine Peninsula.',
    url: pageUrl,
    image: {
      '@type': 'ImageObject',
      url: `${site.url}/images/suburbs/house-cleaning-geelong.jpg`,
      creator: { '@type': 'Organization', name: site.name },
      creditText: site.name,
      copyrightNotice: `© ${new Date().getFullYear()} ${site.name}`,
      license: `${site.url}/terms-of-service`,
      acquireLicensePage: `${site.url}/privacy-policies`,
    },
    areaServed: [
      { '@type': 'City', name: 'Geelong', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Newtown', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Highton', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Belmont', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Geelong West', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Lara', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Leopold', containedInPlace: { '@type': 'State', name: 'Victoria' } },
      { '@type': 'City', name: 'Armstrong Creek', containedInPlace: { '@type': 'State', name: 'Victoria' } },
    ],
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:30',
      closes: '17:00',
    },
    // No aggregateRating. The 4.7 / 48 figure is genuine and verified against
    // the Google Business Profile — but a rating about the business, published
    // on the business's own site, is self-serving and not eligible for a review
    // snippet under Google's Review snippet policy for LocalBusiness and
    // Organization. It cannot win stars in the SERP and it can attract a
    // structured-data manual action. The stars come from the GBP itself.
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Geelong Cleaning', item: `${site.url}/house-cleaning-geelong` },
      { '@type': 'ListItem', position: 3, name: 'NDIS Cleaning Geelong', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: geelongFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="NDIS Cleaning Geelong | Plan & Self-Managed"
  description="NDIS cleaning in Geelong for plan-managed and self-managed participants. Police-checked, eco-conscious team. Greater Geelong & the Bellarine."
  schema={schema}
>
  <!-- 1. Hero -->
  <ServiceHero
    eyebrow="NDIS cleaning · Geelong"
    heading="NDIS Cleaning Services<br />in Geelong"
    tagline="Plan-managed and self-managed welcome. Police-checked. Eco-conscious. Fully insured."
    bg="/images/hero-staff-bathroom.webp"
  />

  <!-- 2. Intro -->
  <ServiceIntro
    kicker="About this service"
    heading="Cleaning that supports your independence in Geelong."
    body={introBody}
    stats={introStats}
  />

  <!-- 3. What's included -->
  <ServiceInclusions
    heading="Everything your home needs, every visit."
    sub="Our Geelong NDIS cleaning covers all the essentials — tailored to your plan goals and your home."
    groups={inclusions}
  />

  <!-- 4. Funding types -->
  <section style="background: #ffffff; padding: clamp(88px, 10vw, 128px) 0;">
    <div class="container-site" style="max-width: 1160px;">
      <div style="text-align: center; max-width: 720px; margin: 0 auto clamp(40px, 5vw, 56px);">
        <h2 style="font-family: 'Poppins', sans-serif; font-size: clamp(32px, 4.5vw, 52px); font-weight: 300; line-height: 1.1; letter-spacing: -0.015em; color: #0f172a; margin: 0 0 16px;">
          How NDIS funding works for cleaning
        </h2>
        <p style="font-family: 'Poppins', sans-serif; font-size: clamp(16px, 1.3vw, 18px); font-weight: 300; line-height: 1.65; color: rgb(71, 85, 105); margin: 0;">
          NDIS cleaning is funded under <strong>Core Supports — Assistance with Daily Life</strong>. Here's how each plan type works.
        </p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
        {[
          {
            type: 'Plan-managed',
            desc: "We invoice your plan manager directly. You don't handle the money — just let us know who your plan manager is and we take care of the rest.",
          },
          {
            type: 'Self-managed',
            desc: 'You pay us directly and we provide a detailed receipt and tax invoice for your NDIS records. Simple and flexible.',
          },
          {
            type: 'Agency-managed',
            desc: 'We are not currently a registered NDIS provider, so NDIA-managed funding cannot be used. Plan-managed and self-managed participants are very welcome.',
          },
        ].map((f) => (
          <div style="background: #ffffff; border: 1px solid rgba(15,23,42,0.08); border-radius: 14px; padding: 28px 26px; box-shadow: 0 1px 2px rgba(15,23,42,0.04), 0 4px 16px rgba(15,23,42,0.05);">
            <h3 style="font-family: 'Poppins', sans-serif; font-size: 20px; font-weight: 500; line-height: 1.2; color: #0f172a; margin: 0 0 14px; padding-bottom: 14px; border-bottom: 1px solid rgba(15,23,42,0.08);">{f.type}</h3>
            <p style="font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 300; line-height: 1.65; color: rgb(71, 85, 105); margin: 0;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Why choose Naturo -->
  <Features />

  <!-- 6. Social proof -->
  <Testimonials />

  <!-- 7. Trusted-by logos -->
  <Providers />

  <!-- 8. FAQ (Geelong-specific) -->
  <FAQ
    items={geelongFaqs}
    eyebrow="NDIS cleaning Geelong — common questions"
    subheading="Everything you need to know about NDIS cleaning in Geelong and the Bellarine."
  />

  <!-- 9. App promo -->
  <AppPromo />

  <!-- 10. Final CTA -->
  <RelatedGuides
    regionLabel="Geelong"
    services={[
      { href: '/house-cleaning-geelong/', text: 'Regular house cleaning in Geelong' },
      { href: '/end-of-lease-cleaning-geelong/', text: 'End of lease cleaning in Geelong' },
    ]}
    guideSlugs={[
      'ndis-cleaning-geelong-guide',
      'end-of-lease-cleaning-geelong-checklist',
      'house-cleaning-cost-geelong',
      'eco-friendly-cleaning-geelong',
    ]}
  />

  <FinalCTA />

  <!-- 11. Suburb links (local SEO) -->
  <section style="background: #ffffff; padding: clamp(64px, 8vw, 96px) 0; border-top: 1px solid rgba(15,23,42,0.06);">
    <div class="container-site" style="max-width: 1160px;">
      <div style="text-align: center; margin-bottom: 40px;">
        <h2 style="font-family: 'Poppins', sans-serif; font-size: clamp(24px, 3vw, 36px); font-weight: 300; line-height: 1.2; letter-spacing: -0.01em; color: #0f172a; margin: 0;">
          NDIS cleaning across Greater Geelong
        </h2>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 40px;">
        {[
          { name: 'Geelong CBD', slug: 'house-cleaning-geelong' },
          { name: 'Newtown', slug: 'house-cleaning-newtown-geelong' },
          { name: 'Highton', slug: 'house-cleaning-highton' },
          { name: 'Belmont', slug: 'house-cleaning-belmont-geelong' },
          { name: 'Geelong West', slug: 'house-cleaning-geelong-west' },
          { name: 'Lara', slug: 'house-cleaning-lara' },
          { name: 'Leopold', slug: 'house-cleaning-leopold' },
          { name: 'Ocean Grove', slug: 'house-cleaning-ocean-grove' },
          { name: 'Torquay', slug: 'house-cleaning-torquay' },
          { name: 'Barwon Heads', slug: 'house-cleaning-barwon-heads' },
          { name: 'Armstrong Creek', slug: 'house-cleaning-armstrong-creek' },
          { name: 'Grovedale', slug: 'house-cleaning-grovedale' },
        ].map((s) => (
          <a
            href={`/${s.slug}/`}
            style="display: inline-block; padding: 8px 18px; border-radius: 999px; border: 1px solid rgba(15,23,42,0.12); font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 300; color: rgb(71, 85, 105); text-decoration: none; transition: border-color 0.2s, color 0.2s;"
          >
            {s.name}
          </a>
        ))}
      </div>
      <div style="text-align: center;">
        <p style="font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 300; color: rgb(100, 116, 139); margin: 0 0 12px;">
          Also see our other specialist services in Geelong:
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; align-items: center;">
          <a href="/end-of-lease-cleaning-geelong/" style="font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 500; color: #467FF7; text-decoration: none;">End of Lease Cleaning Geelong &rarr;</a>
          <span style="color: rgba(15,23,42,0.15);">·</span>
          <a href="/services/aged-care-cleaning/" style="font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 500; color: #467FF7; text-decoration: none;">Aged Care Cleaning &rarr;</a>
          <span style="color: rgba(15,23,42,0.15);">·</span>
          <a href="/services/veterans-cleaning/" style="font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 500; color: #467FF7; text-decoration: none;">Veterans (DVA) Cleaning &rarr;</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
