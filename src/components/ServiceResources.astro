---
// Per-service guide links. Renders nothing when a service has no genuinely
// matching post, so no page gets padded with irrelevant links.
import { postCards } from '../data/posts';

interface Props {
  slugs?: string[];
  serviceTitle: string;
}

const { slugs = [], serviceTitle } = Astro.props;

const cards = slugs
  .map((slug) => postCards.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

{cards.length > 0 && (
  <section class="svc-res-section" aria-labelledby="svc-res-h2">
    <div class="container-site svc-res-inner">
      <div class="svc-res-head">
        <h2 id="svc-res-h2" class="svc-res-h2">
          {serviceTitle} guides
        </h2>
        <p class="svc-res-sub">
          Practical guides from our cleaners, free to read.
        </p>
      </div>

      <div class="svc-res-grid">
        {cards.map((item) => (
          <a class="svc-res-card" href={item.href} aria-label={`Read: ${item.title}`}>
            <span class="svc-res-cat">{item.category}</span>
            <h3 class="svc-res-title">{item.title}</h3>
            <p class="svc-res-body">{item.excerpt}</p>
            <span class="svc-res-meta">
              <span>{item.readMinutes} min read</span>
              <span class="svc-res-arrow" aria-hidden="true">Read article &rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .svc-res-section {
    padding: 64px 0;
    background: #f7f8fa;
  }
  .svc-res-head {
    margin: 0 0 28px;
  }
  .svc-res-h2 {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    color: rgb(15, 23, 42);
    margin: 0 0 8px;
  }
  .svc-res-sub {
    font-size: 1rem;
    color: rgb(91, 94, 102);
    margin: 0;
  }
  .svc-res-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }
  .svc-res-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: #fff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 14px;
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .svc-res-card:hover,
  .svc-res-card:focus-visible {
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    transform: translateY(-2px);
  }
  .svc-res-cat {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #3a5dff;
  }
  .svc-res-title {
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    color: rgb(15, 23, 42);
    margin: 0;
  }
  .svc-res-body {
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgb(91, 94, 102);
    margin: 0;
    flex: 1;
  }
  .svc-res-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 0.85rem;
    color: rgb(91, 94, 102);
    padding-top: 12px;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
  }
  .svc-res-arrow {
    font-weight: 600;
    color: #3a5dff;
  }
</style>
