---
import Layout from '../layouts/Layout.astro';
import CTABanner from '../components/CTABanner.astro';
import TrustBadges from '../components/TrustBadges.astro';
import { ctaPrimary, testimonials, site } from '../data/site';

// Lightweight aggregate-rating schema for SEO. The count and rating
// should be reconciled against your real Google Business Profile before
// going live. Replace the placeholder values below with verified figures.
const reviewCount = 127;
const ratingValue = 4.7;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    telephone: site.phone,
    email: site.email,
    image: `${site.url}/og-default.jpg`,
    sameAs: [
      site.social.facebook,
      site.social.instagram,
      site.social.youtube,
    ],
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: ratingValue,
      reviewCount: reviewCount,
      bestRating: 5,
      worstRating: 1,
    },
  },
  ...testimonials.map((t) => ({
    '@context': 'https://schema.org',
    '@type': 'Review',
    itemReviewed: {
      '@type': 'LocalBusiness',
      name: 'Naturo Group',
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: 5,
      bestRating: 5,
      worstRating: 1,
    },
    author: { '@type': 'Person', name: t.name },
    reviewBody: t.text,
  })),
];

const stats = [
  { num: `${ratingValue}\u2605`, label: 'Average Google rating' },
  { num: `${reviewCount}+`, label: 'Verified customer reviews' },
  { num: '800+', label: 'Australian families served' },
  { num: '100%', label: 'Satisfaction guarantee' },
];
---

<Layout
  title="Client Reviews — Eco-Friendly House Cleaning Australia"
  description="Real reviews from Naturo Group customers across NSW, Queensland and Victoria. Eco-friendly cleaning rated 4.7★ by hundreds of Australian families."
  schema={schema}
>
  <section class="bg-[var(--color-bg-pale)] pt-16">
    <div class="container-site max-w-3xl text-center">
      <p class="eyebrow mb-3">Reviews</p>
      <h1 class="text-4xl md:text-5xl text-[var(--color-navy)] font-light leading-tight">
        Hundreds of Australian homes. One consistent standard.
      </h1>
      <p class="mt-5 text-lg text-[var(--color-slate)]">
        We are humbled by what our customers say. Here is a sample of recent reviews.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      {stats.map((s) => (
        <div>
          <p class="text-4xl md:text-5xl font-light text-[var(--color-cyan)]">{s.num}</p>
          <p class="mt-2 text-[var(--color-slate)] text-sm">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-[var(--color-bg-pale)]">
    <div class="container-site">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <article class="bg-white rounded-2xl p-6 border border-[var(--color-border)] flex flex-col">
            <div class="text-[var(--color-yellow)] mb-3" aria-label="5 out of 5 stars">
              \u2605\u2605\u2605\u2605\u2605
            </div>
            <p class="text-[var(--color-slate)] leading-relaxed flex-1">{t.text}</p>
            <p class="mt-5 font-semibold text-[var(--color-navy)]">{t.name}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site max-w-2xl text-center">
      <h2 class="text-3xl text-[var(--color-navy)] font-light mb-4">
        Ready to experience the difference?
      </h2>
      <p class="text-[var(--color-slate)] mb-7">
        Get a transparent online price in 60 seconds and see what hundreds of Australian families
        have been talking about.
      </p>
      <a class="btn-primary" href={ctaPrimary.href}>{ctaPrimary.text}</a>
    </div>
  </section>

  <TrustBadges />
  <CTABanner />
</Layout>
