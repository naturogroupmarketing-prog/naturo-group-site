---
import {
  site,
  ctaPrimary,
  ctaPhone,
  footerLocations,
  footerInfoLinks,
  footerServiceLinks,
  subFooterLinks,
} from '../data/site';
---

<footer class="footer">
  <div class="footer-glow" aria-hidden="true"></div>

  <div class="container-site footer-top">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label={`${site.name} home`}>
        <img src="/images/logo.avif" alt="Naturo Group" width="170" height="79" />
      </a>
      <p class="footer-desc">{site.description}</p>
      <div class="footer-ctas">
        <a href={ctaPrimary.href} class="footer-btn-primary">
          <span>{ctaPrimary.text}</span>
          <span class="footer-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </a>
        <a href={ctaPhone.href} class="footer-btn-secondary">
          <span>{ctaPhone.text}</span>
          <span class="footer-btn-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
        </a>
      </div>
      {/* Plain 12px text list — Apple's footer uses no all-caps labels;
          the link / value carries its own meaning. */}
      <ul class="footer-meta">
        <li><a href={site.emailHref} class="footer-link">{site.email}</a></li>
        <li><span class="footer-meta-value">{site.hours}</span></li>
      </ul>
    </div>

    <div class="footer-cols">
      <div class="footer-col footer-col-stack">
        <div class="footer-subcol footer-acc">
          <button class="footer-acc-btn" aria-expanded="false">
            <span class="footer-h2">Services</span>
            <svg class="footer-acc-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <ul class="footer-list footer-acc-panel">
            {footerServiceLinks.map((s) => (
              <li><a href={s.href} class="footer-link">{s.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-subcol footer-acc">
          <button class="footer-acc-btn" aria-expanded="false">
            <span class="footer-h2">Company</span>
            <svg class="footer-acc-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <ul class="footer-list footer-acc-panel">
            {footerInfoLinks.map((l) => (
              <li><a href={l.href} class="footer-link">{l.label}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="footer-col footer-col-locations footer-acc">
        <button class="footer-acc-btn" aria-expanded="false">
          <span class="footer-h2">Areas served</span>
          <svg class="footer-acc-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="footer-states footer-acc-panel">
          {Object.entries(footerLocations).map(([state, locs]) => (
            <div class="footer-state">
              <p class="footer-state-name">{state}</p>
              <ul class="footer-state-cities">
                {locs.map((l) => (
                  <li><a href={l.href} class="footer-city-link">{l.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container-site footer-bottom-inner">
      {/* Clean left-aligned stack: pipe-separated legal links on top,
          copyright beneath. Pipes are per-link left borders + first-child reset. */}
      <nav class="footer-sublinks" aria-label="Legal">
        {subFooterLinks.map((l) => (
          <a href={l.href} class="footer-sublink">{l.label}</a>
        ))}
      </nav>
      <p class="footer-copyright">{site.copyright} &middot; {site.abn}</p>
    </div>
  </div>
</footer>

<style>
  /* Apple-inspired footer: cool light-grey background, compact 12px
     typography, dark semibold headings (#1d1d1f), muted-grey links
     (#6e6e73), and #d2d2d7 hairline dividers. */
  .footer {
    position: relative;
    background-color: #f5f5f7;
    color: #6e6e73;
    overflow: hidden;
    isolation: isolate;
    padding-top: clamp(48px, 6vw, 72px);
  }
  /* Glow disabled — Apple footer is flat. Element is kept so removing
     the markup isn't required (display:none keeps the DOM stable). */
  .footer-glow {
    display: none;
  }

  .footer-top {
    position: relative;
    display: grid;
    grid-template-columns: minmax(260px, 320px) 1fr;
    gap: clamp(40px, 5vw, 72px);
    padding-bottom: clamp(36px, 4vw, 56px);
    z-index: 1;
  }
  @media (max-width: 880px) {
    .footer-top { grid-template-columns: 1fr; gap: 48px; }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .footer-logo img {
    /* Footer logo sits in a denser link/legal column, so it doesn't need
       to match the header (170px). 120px reads as a quieter "by the
       way" mark and frees vertical space above the description.
       Logo shows in its native colours against the light footer. */
    width: 120px;
    height: auto;
    display: block;
    opacity: 1;
  }
  .footer-desc {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    line-height: 1.6;
    color: #424245;
    margin: 20px 0 24px;
    max-width: 40ch;
  }
  /* Two equal columns via CSS Grid so the buttons render at exactly
     the same width regardless of label length. (Flex `flex: 1` was off
     by ~4px because intrinsic content sizes differ between the two
     buttons.) Width:100% is required because .footer-brand uses
     `align-items: flex-start`, which would otherwise shrink the stack
     to its widest child. */
  .footer-ctas {
    display: flex;
    flex-direction: column;
    /* Stretch both buttons to the width of the widest (Get an Instant Price)
       so the phone button matches it; the container shrinks to that width. */
    align-items: stretch;
    gap: 12px;
    margin-bottom: 32px;
    width: max-content;
    max-width: 100%;
  }
  .footer-ctas > a { white-space: nowrap; min-width: 0; }
  /* Mobile: let both stacked buttons span the full column width. */
  @media (max-width: 500px) {
    .footer-ctas { width: 100%; }
  }
  .footer-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: linear-gradient(135deg, #4a6bff 0%, #2748f2 100%);
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-family: "Poppins", "Helvetica", sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(37, 72, 240, 0.32);
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .footer-btn-primary:hover {
    box-shadow: 0 8px 22px rgba(37, 72, 240, 0.45);
    transform: translateY(-1px);
  }
  .footer-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: #ffffff;
    color: #1C244B;
    border: 1px solid rgba(28, 36, 75, 0.18);
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    font-family: "Poppins", "Helvetica", sans-serif;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    min-height: 44px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .footer-btn-secondary:hover {
    background: #ffffff;
    color: #1C244B;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.22);
  }
  /* Shared circular icon (right of each footer button) */
  .footer-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .footer-btn-icon svg { display: block; width: 14px; height: 14px; }
  .footer-btn-primary .footer-btn-icon { background-color: #ffffff; border-color: #ffffff; color: #1C244B; }
  .footer-btn-primary:hover .footer-btn-icon { background-color: transparent; border-color: rgba(255, 255, 255, 0.6); color: #ffffff; }
  .footer-btn-secondary .footer-btn-icon { border-color: rgba(58, 93, 255, 0.5); color: #3a5dff; }
  .footer-btn-secondary:hover .footer-btn-icon { background-color: #3a5dff; border-color: #3a5dff; color: #ffffff; }
  .footer-meta {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }
  .footer-meta li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .footer-meta li {
    /* Reset the column layout the old EMAIL/HOURS label list used.
       Now each <li> is a single flat 12px text line. */
    display: block;
    line-height: 1.5;
  }
  .footer-meta-value {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    color: #424245;
  }

  .footer-cols {
    /* Two top-level columns: stacked Services+Company on the left and
       the wider Areas-served block on the right (which renders states
       in their own sub-columns). */
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(24px, 3vw, 48px);
  }
  .footer-col-stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  @media (max-width: 720px) {
    .footer-cols { grid-template-columns: 1fr; }
  }
  .footer-col { min-width: 0; }
  .footer-subcol { min-width: 0; }
  .footer-h2 {
    font-family: "Poppins", sans-serif;
    /* Apple-style: small bold near-black header, no all-caps. */
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: #1d1d1f;
    margin: 0 0 12px;
  }
  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .footer-link {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: #424245;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer-link:hover { color: #1d1d1f; text-decoration: underline; text-underline-offset: 2px; }

  /* Two-column layout for the states: NSW spans the full left column
     (it has the most suburbs), and Queensland + Victoria stack in the
     right column. Order is driven by the data in footerLocations
     (NSW → QLD → VIC), which lines up with :nth-child placement below. */
  .footer-states {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: min-content;
    gap: 24px 40px;
    max-width: 560px;
  }
  .footer-state:nth-child(1) { grid-column: 1; grid-row: 1 / span 2; }
  .footer-state:nth-child(2) { grid-column: 2; grid-row: 1; }
  .footer-state:nth-child(3) { grid-column: 2; grid-row: 2; }
  /* On narrow viewports collapse to a single column so the NSW list
     doesn't get squashed against QLD/VIC. */
  @media (max-width: 480px) {
    .footer-states { grid-template-columns: 1fr; }
    .footer-state:nth-child(1),
    .footer-state:nth-child(2),
    .footer-state:nth-child(3) { grid-column: auto; grid-row: auto; }
  }
  .footer-state-name {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: #1d1d1f;
    margin: 0 0 8px;
  }
  .footer-state-cities {
    list-style: none;
    padding: 0;
    margin: 0;
    /* Single column inside each state — the parent .footer-states grid
       already provides the two-column NSW | (QLD/VIC) split, so each
       state's suburbs stack vertically beneath their state heading. */
    display: flex;
    flex-direction: column;
    gap: 4px;
    line-height: 1.5;
    font-family: "Poppins", sans-serif;
    font-size: 12px;
  }
  .footer-city-link {
    color: #424245;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-city-link:hover {
    color: #1d1d1f;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Apple-style three-section bottom bar: copyright (left), pipe-
     separated legal links (centre), region (right). Same #f5f5f7 bg as
     the rest — the only separator is the hairline above. */
  .footer-bottom {
    position: relative;
    z-index: 1;
    padding: 0;
  }
  .footer-bottom-inner {
    border-top: 1px solid #d2d2d7;
    padding-block: 18px;
    /* Clean left-aligned stack: legal links on top, copyright beneath —
       the long copyright + ABN won't fit one row, so stacking reads as
       intentional rather than an awkward wrap. */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .footer-copyright {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    color: #6e6e73;
    margin: 0;
    line-height: 1.5;
    flex: 0 1 auto;
  }
  /* Pipe-separated inline link list (Apple pattern). Each link gets a
     left border that renders as the divider; first child resets it. */
  .footer-sublinks {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    flex: 0 1 auto;
    justify-content: flex-start;
  }
  .footer-sublink {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    color: #424245;
    text-decoration: none;
    padding: 0 12px;
    border-left: 1px solid #d2d2d7;
    line-height: 1.2;
    transition: color 0.2s ease;
  }
  .footer-sublink:first-child { border-left: none; padding-left: 0; }
  .footer-sublink:last-child { padding-right: 0; }
  .footer-sublink:hover { color: #1d1d1f; text-decoration: underline; text-underline-offset: 2px; }
  /* Region label (right) — Apple's footer puts the country at the far right. */
  .footer-region {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    color: #6e6e73;
    margin: 0;
    line-height: 1.5;
    flex: 0 0 auto;
  }
  /* On narrow viewports stack the three sections vertically so nothing
     gets squashed. */
  @media (max-width: 720px) {
    .footer-bottom-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
    }
    .footer-copyright { text-align: center; }
  }

  /* ─── Footer accordion ─────────────────────────────────────────────────── */
  /* Desktop: button acts as a plain non-interactive heading.
     padding-bottom replaces the old footer-h2 margin so the gap between
     the heading and the list below is handled at the button level. */
  .footer-acc-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    padding: 0 0 12px;
    width: 100%;
    text-align: left;
    cursor: default;
    pointer-events: none;
  }
  /* Reset the margin now that the button's padding handles the gap */
  .footer-acc-btn .footer-h2 { margin: 0; }
  .footer-acc-chevron { display: none; }

  /* Desktop safety: panels always visible regardless of JS / is-open state */
  @media (min-width: 721px) {
    .footer-list.footer-acc-panel { display: flex; }
    .footer-states.footer-acc-panel { display: grid; }
  }

  /* Mobile: Apple-style accordion — separator line, tappable row, panel
     collapses/reveals beneath the heading, chevron rotates when open. */
  @media (max-width: 720px) {
    .footer-col-stack { gap: 0; }
    /* Kill the footer-cols grid gap on mobile so the three accordion
       sections stack flush against each other. */
    .footer-cols { gap: 0; }
    .footer-acc { border-top: 1px solid #d2d2d7; }
    .footer-acc-btn {
      cursor: pointer;
      pointer-events: auto;
      padding: 13px 0;
    }
    .footer-acc-btn .footer-h2 {
      margin: 0;
      font-size: 14px;
    }
    .footer-acc-chevron {
      display: block;
      flex-shrink: 0;
      color: #6e6e73;
      transition: transform 0.25s ease;
    }
    /* Hide panel when closed — when open the original display:flex /
       display:grid rules from .footer-list and .footer-states win. */
    .footer-acc:not(.is-open) .footer-acc-panel { display: none; }
    .footer-acc.is-open .footer-acc-panel { padding-bottom: 16px; }
    .footer-acc.is-open .footer-acc-chevron { transform: rotate(180deg); }
  }
</style>

<script>
  document.querySelectorAll('.footer-acc-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const acc = btn.closest('.footer-acc');
      const isOpen = acc.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  });
</script>
