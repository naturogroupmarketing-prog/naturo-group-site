---
import { specialties } from '../data/site';
---

<section class="bg-[var(--color-navy)] text-white">
  <div class="container-site">
    <div class="max-w-2xl mb-12">
      <h2 class="text-3xl md:text-4xl text-white font-light">Trusted for the work that matters most.</h2>
      <p class="mt-4 text-white/70">Trained for sensitive home environments &mdash; working with NDIS plan managers, aged-care providers, DVA case managers and major insurers every week.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {specialties.map((s) => (
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
          <h3 class="text-lg font-semibold text-white mb-2">{s.title}</h3>
          <p class="text-sm text-white/70 leading-relaxed">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
