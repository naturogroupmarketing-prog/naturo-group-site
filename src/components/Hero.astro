---
import { site, ctaPrimary, ctaPhone } from '../data/site';

const slides = [
  '/images/hero-bathroom.jpg',
  '/images/hero-kitchen.jpg',
  '/images/hero-ocean.jpg',
];
---

<section class="hero relative overflow-hidden">
  <div class="hero-slides absolute inset-0">
    {slides.map((src, i) => (
      <div
        class="hero-slide"
        style={`background-image: url(${src}); animation-delay: ${i * 5}s;`}
      />
    ))}
  </div>
  <div class="hero-overlay absolute inset-0"></div>

  <div class="relative container-site hero-inner flex items-center">
    <!-- w-full so the content stretches to fill the flex parent on
         narrow viewports — without it, this div sizes to its widest
         child (the H1), causing CTAs to render ~30px narrower than
         the matching CTAs in the other banner sections. The max-width
         still caps the column on desktop. -->
    <div class="w-full max-w-[800px]">
      <h1 class="hero-h1" style="color:#ffffff;">
        Eco-friendly<br />House Cleaning<br />in Australia
      </h1>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="hero-cta-stack">
        <a href={ctaPrimary.href} class="hero-btn-primary">{ctaPrimary.text}</a>
        <a href={ctaPhone.href} class="hero-btn-secondary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>{ctaPhone.text}</span>
        </a>
      </div>
      <div class="hero-partners">
        <p class="hero-partners-label">Partners &amp; Providers</p>
        <img src="/images/partners-composite.png" alt="Partners and providers: NRMA, phsa, ipar, Allianz, QBE" class="hero-partners-img" width="300" height="156" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 0;
  }
  .hero-inner {
    /* Standard hero height — match across every page (career, contact, services, post, suburb). */
    height: clamp(640px, 86vh, 800px);
    padding-block: clamp(48px, 8vh, 96px);
  }
  /* On phones the sidebar header + sticky bottom bar already eat ~120px
     of viewport, so a 560px hero pushes the next section well below the
     fold. Cap to ~88dvh so the partner row peeks above the fold. */
  @media (max-width: 640px) {
    .hero-inner {
      height: min(680px, 88dvh);
      padding-block: 36px;
    }
  }
  .hero-h1 {
    font-family: "Poppins", sans-serif;
    font-weight: 300;
    font-size: clamp(30px, 5.2vw, 66px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .hero-tagline {
    font-family: "Poppins", sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: clamp(15px, 1.6vw, 22px);
    line-height: 1.5;
    color: #FEB91C;
    margin-top: 16px;
    letter-spacing: 0.005em;
  }
  .hero-cta-stack {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  @media (max-width: 500px) {
    .hero-cta-stack { flex-direction: column; align-items: stretch; }
  }
  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #3a5dff;
    color: #ffffff;
    border: 1px solid #3a5dff;
    border-radius: 6px;
    padding: 14px 26px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Poppins", "Helvetica", sans-serif;
    line-height: 1;
    letter-spacing: 0.01em;
    min-height: 46px;
    box-shadow: 0 4px 12px rgba(58, 93, 255, 0.28);
    transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    text-align: center;
  }
  .hero-btn-primary:hover {
    background-color: #2548f0;
    border-color: #2548f0;
    box-shadow: 0 6px 18px rgba(58, 93, 255, 0.4);
    transform: translateY(-1px);
  }
  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(2px);
    border-radius: 6px;
    padding: 13px 24px;
    font-size: 15px;
    font-weight: 500;
    font-family: "Poppins", "Helvetica", sans-serif;
    line-height: 1;
    min-height: 46px;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    text-align: center;
  }
  .hero-btn-secondary svg { flex-shrink: 0; }
  .hero-btn-secondary:hover {
    background-color: #ffffff;
    color: #1C244B;
    border-color: #ffffff;
  }

  .hero-overlay {
    background-image: linear-gradient(90deg, rgb(58, 77, 97) 20%, rgba(5, 170, 232, 0) 81%);
    opacity: 0.91;
    pointer-events: none;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    animation: heroFade 15s infinite;
    will-change: opacity;
  }
  /* First slide is immediately visible — prevents the white-page flash
     on refresh before the animation's first frame kicks in. */
  .hero-slide:first-child { opacity: 1; }
  @keyframes heroFade {
    0%, 28% { opacity: 1; }
    33%, 95% { opacity: 0; }
    100% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide { animation: none; }
    .hero-slide:first-child { opacity: 1; }
  }

  .hero-partners {
    margin-top: 40px;
  }
  .hero-partners-label {
    font-family: "Poppins", sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #ffffff;
    margin: 0 0 14px;
  }
  .hero-partners-img {
    width: 280px;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
    opacity: 0.6;
  }
  @media (max-width: 640px) {
    .hero-partners { margin-top: 24px; }
    .hero-partners-label { font-size: 12px; margin-bottom: 10px; }
    .hero-partners-img { width: 240px; }
  }
</style>
