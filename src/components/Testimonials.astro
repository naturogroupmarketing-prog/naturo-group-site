---
import { testimonials as defaultTestimonials } from '../data/site';

interface TestimonialItem { name: string; text: string }
interface Props {
  /** Optional location used in the rating-audience line. */
  location?: string;
  /** Optional override — render these instead of the generic testimonials. */
  items?: TestimonialItem[];
}

const { location, items } = Astro.props;
const ratingAudience = location ? `${location} households` : 'Australian households';
const source = items && items.length ? items : defaultTestimonials;
// Always loop at least twice so the marquee scroll never gaps; if a suburb
// only supplies 2-3 testimonials we triple them so the track is wide enough.
const loop = source.length < 4 ? [...source, ...source, ...source] : [...source, ...source];
---

<section class="testi-section">
  <div class="container-site testi-top">
    <div class="testi-head-left">
      <h2 class="testi-h2">What our customers say</h2>
    </div>
    <div class="testi-head-right">
      <p class="testi-intro">Finding the right cleaner can be tough &mdash; you need someone trustworthy, insured, and reliable. At NATURO GROUP, we deliver spotless results with peace of mind.</p>
      <div class="testi-rating">
        <div class="testi-rating-stars" aria-hidden="true">
          {[1,2,3,4,5].map(() => (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#f0c30b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          ))}
        </div>
        <span class="testi-rating-text">Rated <strong>4.9 / 5</strong> by {ratingAudience}</span>
      </div>
    </div>
  </div>

  <div class="testi-marquee">
    <div class="testi-track">
      {loop.map((t) => (
        <article class="testi-card">
          <svg class="testi-quote" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 7h4v4H7c0 2.2 1.8 4 4 4v2c-3.3 0-6-2.7-6-6V7zm8 0h4v4h-4c0 2.2 1.8 4 4 4v2c-3.3 0-6-2.7-6-6V7z"/></svg>
          <p class="testi-text">{t.text}</p>
          <footer class="testi-footer">
            <img class="testi-logo" src="/images/google-g.webp" alt="" width="32" height="32" loading="lazy" />
            <div class="testi-cite">
              <span class="testi-name">{t.name}</span>
              <div class="testi-stars" aria-label="5 star rating">
                {[1,2,3,4,5].map(() => (
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="#f0c30b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                ))}
              </div>
            </div>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .testi-section {
    background-color: #fafbfc;
    padding: clamp(88px, 10vw, 128px) 0;
  }
  .testi-top {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
    margin-bottom: clamp(40px, 5vw, 56px);
  }
  @media (max-width: 860px) {
    .testi-top { grid-template-columns: 1fr; gap: 24px; }
  }
  .testi-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #0f172a;
    margin: 0;
    text-align: left;
  }
  .testi-intro {
    font-family: "Poppins", sans-serif;
    font-size: clamp(15px, 1.2vw, 17px);
    font-weight: 300;
    line-height: 1.75;
    color: rgb(71, 85, 105);
    margin: 0 0 20px;
  }
  .testi-rating {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .testi-rating-stars {
    display: flex;
    gap: 2px;
  }
  .testi-rating-text {
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: rgb(71, 85, 105);
  }
  .testi-rating-text strong {
    color: #0f172a;
    font-weight: 600;
  }
  .testi-marquee {
    overflow: hidden;
    width: 100%;
    mask-image: linear-gradient(90deg, transparent 0%, #000 5%, #000 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 5%, #000 95%, transparent 100%);
  }
  .testi-track {
    display: flex;
    align-items: stretch;
    gap: 20px;
    animation: testi-scroll 60s linear infinite;
    width: max-content;
    padding: 8px 24px;
  }
  .testi-track:hover { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .testi-track { animation: none; }
  }
  @keyframes testi-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .testi-card {
    position: relative;
    flex-shrink: 0;
    width: 380px;
    height: 320px;
    padding: 28px;
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 6px 20px rgba(15, 23, 42, 0.05);
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 600px) {
    .testi-card { width: 320px; height: 300px; padding: 22px; }
  }
  .testi-quote {
    color: rgba(58, 93, 255, 0.18);
    margin-bottom: 12px;
    flex-shrink: 0;
  }
  .testi-text {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.65;
    color: rgb(51, 65, 85);
    margin: 0;
    flex: 1;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
  }
  .testi-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    flex-shrink: 0;
  }
  .testi-logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .testi-cite {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .testi-name {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #0f172a;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .testi-stars {
    display: flex;
    gap: 1px;
  }
</style>
