---
type Tone = 'cyan' | 'navy' | 'yellow' | 'neutral' | 'success';
type Size = 'sm' | 'md';

interface Props {
  tone?: Tone;
  size?: Size;
  class?: string;
}
const { tone = 'cyan', size = 'sm', class: className = '' } = Astro.props;
---

<span class:list={['badge', `badge-${tone}`, `badge-${size}`, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: inherit;
    font-weight: 500;
    border-radius: var(--r-pill);
    border: 1px solid transparent;
    line-height: 1;
    white-space: nowrap;
  }
  .badge-sm { padding: 4px 10px; font-size: 0.75rem; min-height: 22px; }
  .badge-md { padding: 6px 14px; font-size: 0.8125rem; min-height: 28px; }

  .badge-cyan {
    background-color: rgba(36, 210, 242, 0.12);
    color: var(--c-cyan-700);
    border-color: rgba(36, 210, 242, 0.35);
  }
  .badge-navy {
    background-color: rgba(28, 36, 75, 0.06);
    color: var(--c-navy);
    border-color: rgba(28, 36, 75, 0.18);
  }
  .badge-yellow {
    background-color: rgba(254, 185, 28, 0.18);
    color: #6b4a00;
    border-color: rgba(254, 185, 28, 0.45);
  }
  .badge-neutral {
    background-color: var(--c-surface);
    color: var(--c-slate);
    border-color: var(--c-border);
  }
  .badge-success {
    background-color: rgba(52, 168, 83, 0.12);
    color: #1e7a3a;
    border-color: rgba(52, 168, 83, 0.35);
  }
</style>
