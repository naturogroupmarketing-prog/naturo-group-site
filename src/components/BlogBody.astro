---
import type { BlogSection } from '../data/posts';

interface Props {
  sections: BlogSection[];
}

const { sections } = Astro.props;

const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .slice(0, 60);
---

<div class="blog-body">
  {sections.map((s) => {
    if (s.type === 'p') return <p class="blog-p">{s.text}</p>;
    if (s.type === 'h2') return <h2 id={slug(s.text)} class="blog-h2">{s.text}</h2>;
    if (s.type === 'h3') return <h3 class="blog-h3">{s.text}</h3>;
    if (s.type === 'ul') return (
      <ul class="blog-ul">
        {s.items.map((it) => <li>{it}</li>)}
      </ul>
    );
    if (s.type === 'ol') return (
      <ol class="blog-ol">
        {s.items.map((it) => <li>{it}</li>)}
      </ol>
    );
    if (s.type === 'callout') return (
      <aside class="blog-callout">
        <p class="blog-callout-title">{s.title}</p>
        <p class="blog-callout-body">{s.body}</p>
      </aside>
    );
    if (s.type === 'cta') return (
      <aside class="blog-cta">
        <h3 class="blog-cta-heading">{s.heading}</h3>
        <p class="blog-cta-body">{s.body}</p>
        <a href={s.href} class="blog-cta-btn">{s.label}</a>
      </aside>
    );
    if (s.type === 'faq') return (
      <div class="blog-faq">
        {s.items.map((qa) => (
          <details class="blog-faq-item">
            <summary class="blog-faq-q">{qa.q}</summary>
            <p class="blog-faq-a">{qa.a}</p>
          </details>
        ))}
      </div>
    );
    return null;
  })}
</div>

<style>
  .blog-body {
    font-family: "Poppins", sans-serif;
    color: rgb(71, 85, 105);
    max-width: 720px;
    margin: 0 auto;
  }

  .blog-p {
    font-size: clamp(16px, 1.2vw, 18px);
    font-weight: 300;
    line-height: 1.75;
    margin: 0 0 22px;
  }

  .blog-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #0f172a;
    margin: 44px 0 16px;
    scroll-margin-top: 100px;
  }

  .blog-h3 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 500;
    line-height: 1.3;
    color: #0f172a;
    margin: 28px 0 12px;
  }

  .blog-ul,
  .blog-ol {
    margin: 0 0 22px;
    padding-left: 22px;
    font-size: clamp(16px, 1.2vw, 18px);
    font-weight: 300;
    line-height: 1.75;
  }
  .blog-ul li,
  .blog-ol li { margin-bottom: 8px; }
  .blog-ul li::marker { color: #3a5dff; }
  .blog-ol li::marker { color: #3a5dff; font-weight: 600; }

  .blog-callout {
    background-color: #EFEEE9;
    border-left: 4px solid #3a5dff;
    border-radius: 8px;
    padding: 18px 22px;
    margin: 28px 0;
  }
  .blog-callout-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #3a5dff;
    margin: 0 0 8px;
  }
  .blog-callout-body {
    font-size: clamp(15px, 1.15vw, 17px);
    font-weight: 400;
    line-height: 1.65;
    color: #0f172a;
    margin: 0;
  }

  .blog-cta {
    background-color: #1C244B;
    border-radius: 14px;
    padding: 32px 28px;
    margin: 40px 0;
    text-align: left;
    color: #ffffff;
  }
  .blog-cta-heading {
    font-family: "Poppins", sans-serif;
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 500;
    line-height: 1.25;
    color: #ffffff;
    margin: 0 0 10px;
  }
  .blog-cta-body {
    font-size: clamp(15px, 1.15vw, 17px);
    font-weight: 300;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 20px;
  }
  .blog-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #3a5dff;
    color: #ffffff;
    border: 1px solid #3a5dff;
    border-radius: 6px;
    padding: 12px 22px;
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .blog-cta-btn:hover {
    background-color: #2548f0;
    transform: translateY(-1px);
  }

  .blog-faq {
    margin: 16px 0 8px;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
  }
  .blog-faq-item {
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    padding: 18px 0;
  }
  .blog-faq-q {
    font-family: "Poppins", sans-serif;
    font-size: clamp(16px, 1.3vw, 18px);
    font-weight: 500;
    color: #0f172a;
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 28px;
  }
  .blog-faq-q::-webkit-details-marker { display: none; }
  .blog-faq-q::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    color: #3a5dff;
    font-size: 22px;
    font-weight: 300;
    line-height: 1;
  }
  details[open] .blog-faq-q::after { content: '\2212'; }
  .blog-faq-a {
    font-size: clamp(15px, 1.15vw, 17px);
    font-weight: 300;
    line-height: 1.65;
    color: rgb(71, 85, 105);
    margin: 12px 0 0;
  }
</style>
