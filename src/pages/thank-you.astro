---
import Layout from '../layouts/Layout.astro';
import { ctaPhone, site } from '../data/site';
const reviewUrl = site.googleReviewUrl;
---

<Layout
  title="Enquiry Received — Naturo Group"
  description="Thanks for your enquiry. Our coordinator will be in touch within the hour during business hours to lock in your clean."
  noindex
>
  <!-- Hero -->
  <section class="ty-hero">
    <div class="container-site ty-hero-inner">
      <div class="ty-icon-wrap" aria-hidden="true">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12.5l4.5 4.5L19 7" />
        </svg>
      </div>
      <h1 class="ty-h1">Thanks &mdash; your enquiry is in.</h1>
      <p class="ty-sub">
        Our coordinator will reach out within the hour during business hours to confirm your
        postcode, lock in your time and finalise the price.
      </p>
      <div class="ty-ctas">
        <a class="btn-primary" href={ctaPhone.href}>Call {ctaPhone.text}</a>
        <a class="btn-secondary" href="/">Back to home</a>
      </div>
    </div>
  </section>

  <!-- What happens next -->
  <section class="ty-steps">
    <div class="container-site">
      <h2 class="ty-steps-h2">What happens next</h2>
      <div class="ty-steps-grid">
        <div class="ty-step-card">
          <p class="ty-step-label">Step 1</p>
          <h3 class="ty-step-h3">We confirm your area</h3>
          <p class="ty-step-body">We double-check we service your postcode and any special access requirements.</p>
        </div>
        <div class="ty-step-card">
          <p class="ty-step-label">Step 2</p>
          <h3 class="ty-step-h3">We lock in the price</h3>
          <p class="ty-step-body">A short call (or SMS, if you prefer) to confirm the final price and any extras.</p>
        </div>
        <div class="ty-step-card">
          <p class="ty-step-label">Step 3</p>
          <h3 class="ty-step-h3">Your team is booked</h3>
          <p class="ty-step-body">You&rsquo;ll receive an email and SMS with the cleaners assigned to your home.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Google review nudge -->
  <section class="ty-review">
    <div class="container-site ty-review-inner">
      <h2 class="ty-review-h2">Had a great clean? Tell Google.</h2>
      <p class="ty-review-body">
        Reviews help local families find a cleaner they can trust &mdash; and our small team really appreciates every one. Takes under a minute.
      </p>
      <a class="ty-review-btn" href={reviewUrl} target="_blank" rel="noopener noreferrer">
        Leave us a Google review &#8599;
      </a>
    </div>
  </section>

  <!-- Need help -->
  <section class="ty-contact">
    <div class="container-site ty-contact-inner">
      <h2 class="ty-contact-h2">Need to talk now?</h2>
      <p class="ty-contact-body">
        Call <a href={ctaPhone.href}>{ctaPhone.text}</a> or email
        <a href={site.emailHref}>{site.email}</a> &mdash; we usually reply within the hour during business hours.
      </p>
    </div>
  </section>

  <script is:inline>
    (function () {
      try {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'quote_submitted', page: { url: window.location.href, title: document.title } });
        if (typeof window.fbq === 'function') window.fbq('track', 'SubmitApplication');
        if (typeof window.gtag === 'function') window.gtag('event', 'quote_submitted', { event_category: 'lead', event_label: 'quote_form' });
      } catch (e) {}
    })();
  </script>
</Layout>

<style>
  /* ── Hero ── */
  .ty-hero {
    background-color: #f9fafd;
    padding: clamp(72px, 9vw, 120px) 0 clamp(56px, 7vw, 96px);
  }
  .ty-hero-inner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }
  .ty-icon-wrap {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(70, 127, 247, 0.12);
    color: #467FF7;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
  }
  .ty-eyebrow {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #467FF7;
    margin: 0 0 16px;
  }
  .ty-h1 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #1C244B;
    margin: 0 0 20px;
  }
  .ty-sub {
    font-family: "Poppins", sans-serif;
    font-size: clamp(16px, 1.4vw, 18px);
    font-weight: 300;
    line-height: 1.7;
    color: #324A6D;
    margin: 0 0 36px;
  }
  .ty-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  /* ── Steps ── */
  .ty-steps {
    background-color: #ffffff;
    padding: clamp(56px, 7vw, 96px) 0;
  }
  .ty-steps-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 300;
    color: #1C244B;
    text-align: center;
    margin: 0 0 clamp(32px, 4vw, 48px);
    letter-spacing: -0.01em;
  }
  .ty-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }
  @media (max-width: 720px) {
    .ty-steps-grid { grid-template-columns: 1fr; max-width: 480px; }
  }
  .ty-step-card {
    background: #f9fafd;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 28px 24px;
  }
  .ty-step-label {
    font-family: "Poppins", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #467FF7;
    margin: 0 0 10px;
  }
  .ty-step-h3 {
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: #1C244B;
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .ty-step-body {
    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.65;
    color: #324A6D;
    margin: 0;
  }

  /* ── Google Review nudge ── */
  .ty-review {
    background-color: #eef3ff;
    padding: clamp(48px, 6vw, 80px) 0;
    border-top: 1px solid #d4e0ff;
    border-bottom: 1px solid #d4e0ff;
  }
  .ty-review-inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }
  .ty-review-eyebrow {
    font-family: "Poppins", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #467FF7;
    margin: 0 0 12px;
  }
  .ty-review-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(20px, 2.5vw, 26px);
    font-weight: 300;
    color: #1C244B;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
  }
  .ty-review-body {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.7;
    color: #324A6D;
    margin: 0 0 28px;
  }
  .ty-review-btn {
    display: inline-block;
    background: #467FF7;
    color: #fff;
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 500;
    padding: 14px 32px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .ty-review-btn:hover { background: #2f62d4; }

  /* ── Contact ── */
  .ty-contact {
    background-color: #f9fafd;
    padding: clamp(48px, 6vw, 80px) 0;
  }
  .ty-contact-inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }
  .ty-contact-h2 {
    font-family: "Poppins", sans-serif;
    font-size: clamp(20px, 2.5vw, 26px);
    font-weight: 300;
    color: #1C244B;
    margin: 0 0 14px;
  }
  .ty-contact-body {
    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.7;
    color: #324A6D;
    margin: 0;
  }
  .ty-contact-body a {
    color: #467FF7;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
