---
// Local DVA page for Port Macquarie.
//
// Why it exists: the query "dva cleaning port macquarie" was being answered by
// the national /services/veterans-cleaning/ page, which never names the town,
// and a competitor with a Port Macquarie-specific DVA page outranked it. This
// mirrors the NDIS Port Macquarie page, which already ranks locally.
//
// Every claim here is lifted from serviceDetail.ts (veterans-cleaning) and the
// Port Macquarie data that already ships. Nothing about DVA eligibility,
// programme rates, or provider-approval status is asserted — the case manager
// confirms entitlement; we coordinate with them. Keep it that way.
import Layout from '../layouts/Layout.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import ServiceHero from '../components/ServiceHero.astro';
import ServiceIntro from '../components/ServiceIntro.astro';
import ServiceInclusions from '../components/ServiceInclusions.astro';
import Features from '../components/Features.astro';
import Testimonials from '../components/Testimonials.astro';
import Providers from '../components/Providers.astro';
import FAQ from '../components/FAQ.astro';
import AppPromo from '../components/AppPromo.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { site } from '../data/site';

const pageUrl = `${site.url}/dva-cleaning-port-macquarie`;

const introBody = [
  'NATURO GROUP cleans for DVA Gold and White card holders across Port Macquarie and the wider Hastings region every week. We coordinate directly with your DVA case manager and supply detailed visit reports for your file, so the paperwork is handled and your home is looked after by people who take the role seriously.',
  'Our team is police-checked and aims for consistency — the same friendly cleaner wherever possible, because familiar faces matter when someone is coming into your home. Visits are scheduled around your routine, medical appointments and care arrangements, not the other way round.',
  'We use plant-based, fragrance-conscious products throughout. They are chosen for people with respiratory conditions, allergies, sensory sensitivities or compromised immune systems, and we never bring harsh chemical cleaners into a client\'s home.',
];

const introStats = [
  { num: 'DVA', label: 'Gold & White card holders welcome' },
  { num: '100%', label: 'Non-toxic products' },
  { num: '100%', label: 'Police-checked team' },
];

const inclusions = [
  {
    group: 'Kitchen & living',
    items: [
      'Wipe benches, splashbacks and cabinet fronts',
      'Clean stovetop, microwave and sink',
      'Vacuum and mop floors',
      'Empty bins and replace liners',
    ],
  },
  {
    group: 'Bathrooms & bedrooms',
    items: [
      'Disinfect basins, showers and toilets',
      'Wipe mirrors, tiles and fittings',
      'Make beds, with a sheet change on request',
      'Dust surfaces and tidy rooms',
    ],
  },
  {
    group: 'Working with DVA',
    items: [
      'Coordinate with your DVA case manager',
      'Detailed visit reports for your file',
      'Consistent cleaning team where possible',
      'Police-checked, fully insured cleaners',
    ],
  },
];

const portMacFaqs = [
  {
    q: 'Do you clean for DVA card holders in Port Macquarie?',
    a: 'Yes. NATURO GROUP cleans for DVA Gold and White card holders across Port Macquarie and the Hastings region every week, and we coordinate with your DVA case manager throughout.',
  },
  {
    q: 'How do I arrange DVA-funded cleaning in Port Macquarie?',
    a: 'Call 1300 876 472 or send an enquiry. We confirm your DVA card details and what help you need, then arrange visits in line with the plan your case manager has set. Your case manager confirms what you are eligible for — we handle the cleaning and the reporting.',
  },
  {
    q: 'What areas around Port Macquarie do you cover for DVA cleaning?',
    a: 'We service Port Macquarie and the wider Hastings region — including Wauchope, Lake Cathie, Bonny Hills, Laurieton, North Haven, Lighthouse Beach, Settlement Point, Thrumster and surrounding areas.',
  },
  {
    q: 'Will I have the same cleaner each visit?',
    a: 'We match you with a regular Port Macquarie team member wherever possible. Consistency matters a great deal for clients who prefer familiar routines and faces. If your regular cleaner is unavailable, we always let you know in advance.',
  },
  {
    q: 'Do you report back to my DVA case manager?',
    a: 'Yes. We supply detailed visit reports for your case manager’s file, so there is a clear record of what was done and when without you having to chase it.',
  },
  {
    q: 'Are your cleaners trained to work with older Australians and veterans?',
    a: "Yes. Our approach is shaped by founder Anna Biram's registered nursing background — the team is trained in dignity of care, patient communication, infection control and adapting to each client's needs and routine.",
  },
  {
    q: 'What products do you use in a DVA client’s home?',
    a: 'All our products are plant-based, non-toxic and fragrance-conscious — chosen for people with respiratory conditions, allergies, sensory sensitivities or compromised immune systems. We never use harsh chemical cleaners.',
  },
  {
    q: 'Can you also help with aged care or NDIS cleaning in Port Macquarie?',
    a: 'Yes. We work with Home Care Package recipients and with plan-managed and self-managed NDIS participants across the Port Macquarie area. Where a household has more than one arrangement in place, we can usually run them under a single service agreement.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    // Service, not LocalBusiness: see the NDIS Port Macquarie page for why.
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    serviceType: 'DVA cleaning',
    provider: { '@id': `${site.url}/#organization` },
    name: 'DVA Cleaning in Port Macquarie',
    description:
      'In-home cleaning for DVA Gold and White card holders in Port Macquarie, coordinated with your DVA case manager. Police-checked, trained team using eco-conscious products. Serving Port Macquarie, Wauchope, Lake Cathie and the Hastings region.',
    url: pageUrl,
    image: {
      '@type': 'ImageObject',
      url: `${site.url}/images/suburbs/cleaners-port-macquarie.jpg`,
      creator: { '@type': 'Organization', name: site.name },
      creditText: site.name,
      copyrightNotice: `© ${new Date().getFullYear()} ${site.name}`,
      license: `${site.url}/terms-of-service`,
      acquireLicensePage: `${site.url}/privacy-policies`,
    },
    audience: {
      '@type': 'Audience',
      audienceType: 'DVA Gold and White card holders',
    },
    areaServed: [
      { '@type': 'City', name: 'Port Macquarie', containedInPlace: { '@type': 'State', name: 'New South Wales' } },
      { '@type': 'City', name: 'Wauchope', containedInPlace: { '@type': 'State', name: 'New South Wales' } },
      { '@type': 'City', name: 'Lake Cathie', containedInPlace: { '@type': 'State', name: 'New South Wales' } },
      { '@type': 'City', name: 'Bonny Hills', containedInPlace: { '@type': 'State', name: 'New South Wales' } },
      { '@type': 'City', name: 'Laurieton', containedInPlace: { '@type': 'State', name: 'New South Wales' } },
      { '@type': 'City', name: 'North Haven', containedInPlace: { '@type': 'State', name: 'New South Wales' } },
    ],
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:30',
      closes: '17:00',
    },
    // No aggregateRating — self-serving on the business's own site; the stars
    // come from the Google Business Profile.
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Port Macquarie Cleaning', item: `${site.url}/cleaners-port-macquarie` },
      { '@type': 'ListItem', position: 3, name: 'DVA Cleaning Port Macquarie', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: portMacFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="DVA Cleaning Port Macquarie | 1300 876 472"
  description="Need DVA cleaning in Port Macquarie? Call NATURO GROUP on 1300 876 472. Gold & White card holders welcome. Police-checked, eco-conscious team."
  schema={schema}
>
  <!-- 1. Hero -->
  <ServiceHero
    eyebrow="DVA cleaning · Port Macquarie"
    heading="DVA Cleaning Services<br />in Port Macquarie"
    tagline="Respectful in-home cleaning for DVA Gold and White card holders in Port Macquarie, coordinated with your case manager. Police-checked. Eco-conscious. Fully insured."
    bg="/images/hero-staff-bathroom.webp"
  />

  <!-- 2. Intro -->
  <ServiceIntro
    kicker="About this service"
    heading="A clean home, with the respect you’ve earned."
    body={introBody}
    stats={introStats}
  />

  <!-- 3. What's included -->
  <ServiceInclusions
    heading="Everything your home needs, every visit."
    sub="Our Port Macquarie DVA cleaning covers the essentials — arranged around the plan your case manager has set and the way you like your home kept."
    groups={inclusions}
  />

  <!-- 4. How it works -->
  <section style="background: #ffffff; padding: clamp(88px, 10vw, 128px) 0;">
    <div class="container-site" style="max-width: 1160px;">
      <div style="text-align: center; max-width: 720px; margin: 0 auto clamp(40px, 5vw, 56px);">
        <h2 style="font-family: 'Poppins', sans-serif; font-size: clamp(32px, 4.5vw, 52px); font-weight: 300; line-height: 1.1; letter-spacing: -0.015em; color: #0f172a; margin: 0 0 16px;">
          How DVA cleaning works with us
        </h2>
        <p style="font-family: 'Poppins', sans-serif; font-size: clamp(16px, 1.3vw, 18px); font-weight: 300; line-height: 1.65; color: rgb(71, 85, 105); margin: 0;">
          Your DVA case manager confirms what you are entitled to. We take it from there.
        </p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
        {[
          {
            type: '1. Confirm your details',
            desc: 'Call us or send an enquiry. We confirm your DVA Gold or White card details and what help you need at home.',
          },
          {
            type: '2. Visits set to your plan',
            desc: 'We arrange visits in line with the plan your case manager has set, scheduled around your routine and appointments.',
          },
          {
            type: '3. Reports for your file',
            desc: 'After each visit we supply a detailed report to your case manager, so the record is kept without you having to chase it.',
          },
        ].map((f) => (
          <div style="background: #ffffff; border: 1px solid rgba(15,23,42,0.08); border-radius: 14px; padding: 28px 26px; box-shadow: 0 1px 2px rgba(15,23,42,0.04), 0 4px 16px rgba(15,23,42,0.05);">
            <h3 style="font-family: 'Poppins', sans-serif; font-size: 20px; font-weight: 500; line-height: 1.2; color: #0f172a; margin: 0 0 14px; padding-bottom: 14px; border-bottom: 1px solid rgba(15,23,42,0.08);">{f.type}</h3>
            <p style="font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 300; line-height: 1.65; color: rgb(71, 85, 105); margin: 0;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Why choose Naturo -->
  <Features />

  <!-- 6. Social proof -->
  <Testimonials />

  <!-- 7. Trusted-by logos -->
  <Providers />

  <!-- 8. FAQ (Port Macquarie-specific) -->
  <FAQ
    items={portMacFaqs}
    eyebrow="DVA cleaning Port Macquarie — common questions"
    subheading="Everything you need to know about DVA cleaning in Port Macquarie and the Hastings region."
  />

  <!-- 9. App promo -->
  <AppPromo />

  <!-- 10. Related -->
  <RelatedGuides
    regionLabel="Port Macquarie"
    services={[
      { href: '/cleaners-port-macquarie/', text: 'Regular house cleaning in Port Macquarie' },
      { href: '/ndis-cleaning-port-macquarie/', text: 'NDIS cleaning in Port Macquarie' },
      { href: '/services/aged-care-cleaning/', text: 'Aged care cleaning' },
    ]}
    guideSlugs={[
      'house-cleaning-cost-port-macquarie',
      'ndis-cleaning-port-macquarie-guide',
    ]}
  />

  <FinalCTA />

  <!-- 11. Suburb links (local SEO) -->
  <section style="background: #ffffff; padding: clamp(64px, 8vw, 96px) 0; border-top: 1px solid rgba(15,23,42,0.06);">
    <div class="container-site" style="max-width: 1160px;">
      <div style="text-align: center; margin-bottom: 40px;">
        <h2 style="font-family: 'Poppins', sans-serif; font-size: clamp(24px, 3vw, 36px); font-weight: 300; line-height: 1.2; letter-spacing: -0.01em; color: #0f172a; margin: 0;">
          DVA cleaning across Port Macquarie and the Hastings
        </h2>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 40px;">
        {[
          { name: 'Port Macquarie', slug: 'cleaners-port-macquarie' },
          { name: 'Wauchope', slug: 'house-cleaning-wauchope' },
          { name: 'Lake Cathie', slug: 'house-cleaning-lake-cathie' },
          { name: 'Bonny Hills', slug: 'house-cleaning-bonny-hills' },
          { name: 'Laurieton', slug: 'house-cleaning-laurieton' },
          { name: 'North Haven', slug: 'house-cleaning-north-haven' },
          { name: 'Lighthouse Beach', slug: 'house-cleaning-lighthouse-beach' },
          { name: 'Settlement Point', slug: 'house-cleaning-settlement-point' },
        ].map((s) => (
          <a
            href={`/${s.slug}/`}
            style="display: inline-block; padding: 8px 18px; border-radius: 999px; border: 1px solid rgba(15,23,42,0.12); font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 300; color: rgb(71, 85, 105); text-decoration: none; transition: border-color 0.2s, color 0.2s;"
          >
            {s.name}
          </a>
        ))}
      </div>
      <div style="text-align: center;">
        <p style="font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 300; color: rgb(100, 116, 139); margin: 0 0 12px;">
          Living with disability in Port Macquarie? We also clean for NDIS participants.
        </p>
        <a href="/ndis-cleaning-port-macquarie/" style="font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 500; color: #467FF7; text-decoration: none;">
          NDIS Cleaning Port Macquarie &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>
